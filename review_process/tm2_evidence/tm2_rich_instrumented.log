.   matrix `eb' = `ebformer'[1..`=rowsof(`ebformer')',1]'
2130.   matrix `ev' = diag(hadamard(`ebformer'[1..`=rowsof(`ebformer')',2],`ebf
> ormer'[1..`=rowsof(`ebformer')',2]))
2131.   matrix rownames `ev' = :
2132.   matrix rownames `eb' = :
