1818.       if "`att_i'" == "att_i"  |  "`att_it'" == "att_it" |  "`att_itime'"
>  == "att_itime" {
1819.         matrix `wdidpooled' = `wdidpooled' \ ( `___Catt_it_horiz')
1820.         matrix drop `___Catt_it_horiz'
1821.         foreach horiz in `horizlist' {
1822.           local relyr = `horiz' - `min_t' - 1
1823.           local arelyr = abs(`relyr')
1824.           if `relyr' >= 0 local name "post`relyr'"
1825.           if `relyr' == 0 & `oldsyntax' == 1 local name "contemp"
1826.           if `relyr' < 0 local name "pre`arelyr'"
1827.           local rownamespool `rownamespool' ES_ame_it:`name'
1828.         }
1829.       }
1830.     }
1831.   }
1832. 
.   matrix rownames `wdidpooled' = `rownamespool'
1833.   if "`poisson'" == "" matrix colnames `wdidpooled' =  estimate se t p lb
> _95ci ub_95ci   relyr
1834.   if "`poisson'" == "poisson" matrix colnames `wdidpooled' =  estimate se
>  z p lb_95ci ub_95ci   relyr
1835. 
. 
.   * with the success of the above, we should now repeat it by sg
. 
.   if "`subgroups'" != "" {
1836.     if "`suppresssgprimaryeffects'" == "" {
1837.       local sgnum 0
1838.       local sgmatricestodrop
1839.       foreach sgcase in `sglist' {
1840.         local sglistlength = wordcount("`sglist'")
1841.         *sgpre is for any sg; sghaspre is the sg being looped through. sg
> haspre yes is a default addressed later and updated only if necessary
.         local sghaspre yes
1842.         local ++sgnum
1843.         * begin constructing results matrix
.         * initialize column names
.         * add the main estimates, pre-treatment estimates, and continuous tre
> atment only average marginal effects (and pre-treatment analogues) + spacers
.         local firsttimethrough 1
1844.         local sgrowkeep
1845.         local roundlist
1846.         if  "`sgpre'" == "1" local roundlist pre
1847.         if "`contreat'" != "" & "`roundlist'" != "" local roundlist pre c
> ont contpre
1848.         if "`contreat'" != "" & "`roundlist'" == "" local roundlist cont
1849.         foreach round in main `roundlist' {
1850.           foreach object in `att'  `att_it' `att_i' `att_itime' {
1851.             local processedobject `object'_s
1852.             if "`round'" == "pre" local processedobject `object'_pre_s
1853.             if "`round'" == "cont" local processedobject C`object'_s
1854.             if "`round'" == "contpre" local processedobject C`object'_pre
> _s
1855. 
.             * we require this since not all SGs have pre-treatment averages m
> anufactured
.             local truerow `sgnum'
1856.             if ("`round'" == "pre" | "`round'" == "contpre")  {
1857.               if "`sghaspre'" == "yes" {
1858.                 local sgsafetytest: rownames  `___`processedobject''
1859.                 local wordcounter 1
1860.                 local truerow
1861.                 foreach word in `sgsafetytest' {
1862.                   local word = subinstr("`word'","bn.`subgroups'","",.)
1863.                   local word = subinstr("`word'",".`subgroups'","",.)
1864.                   if "`word'" == "`sgcase'" local truerow `wordcounter'
1865.                   * include an adjustment in case only 1 sg group exists
.                   if strpos("`word'","`subgroups'") == 0 & `sglistlength' == 
> 1 local truerow `wordcounter'
1866.                   local ++wordcounter
1867.                 }
1868.                 if "`truerow'" == "" local sghaspre no
1869.               }
1870.               else{
1871.                 local truerow
1872.               }
1873.             }
1874. 
.             if `firsttimethrough' == 1 tempname wdid_sg`sgcase'
1875.             if `firsttimethrough' == 1 & ("`sghaspre'" == "yes" | "`round
> '" == "cont") matrix `wdid_sg`sgcase'' = ( `___`processedobject''[`truerow',1
> ..6],.)
1876.             if `firsttimethrough' == 0 & ("`sghaspre'" == "yes" | "`round
> '" == "cont") matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \  ( `___`processe
> dobject''[`truerow',1..6],.)
1877.             * record, in (round x object) order, whether this non-ES row 
> was appended, so the
.             * rowname filter below can name exactly the rows that exist (see 
> the note there)
.             if ("`sghaspre'" == "yes" | "`round'" == "cont") local sgrowkeep 
> `sgrowkeep' 1
1878.             else local sgrowkeep `sgrowkeep' 0
1879.             if  "`truerow'" != "" local firsttimethrough 0
1880.             local sgmatricestodrop `sgmatricestodrop' `___`processedobjec
> t''
1881.           }
1882.         }
1883. 
.         * if horizon estimates are to be produced, present them here
.         if `espre' + `espl'  > 0 {
1884.           if "`att'" == "att" {
1885.             matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \ `___att_horiz_
> s`sgcase''
1886.             matrix drop `___att_horiz_s`sgcase''
1887.           }
1888.           if "`att_i'" == "att_i"  |  "`att_it'" == "att_it" |  "`att_iti
> me'" == "att_itime" {
1889.             matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \ `___att_it_hor
> iz_s`sgcase''
1890.             matrix drop `___att_it_horiz_s`sgcase''
1891.           }
1892.           if "`contreat'" != "" {
1893.             if "`att'" == "att" {
1894.               matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \  `___att_Cho
> riz_s`sgcase''
1895.               matrix drop `___att_Choriz_s`sgcase''
1896.             }
1897.             if "`att_i'" == "att_i"  |  "`att_it'" == "att_it" |  "`att_i
> time'" == "att_itime" {
1898.               matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \  `___att_it_
> Choriz_s`sgcase''
1899.               matrix drop `___att_it_Choriz_s`sgcase''
1900.             }
1901.           }
1902.         }
1903. 
.         * ensure sg rownames are stripped of irrelevant es levels
.         local rownamessg
1904.         local sgnonesidx 0
1905.         foreach rownametest in `rownamespool' {
1906.           if strpos("`rownametest'","ES_")==0 {
1907.             * the pooled non-ES rownames were generated by the same (roun
> d x object) loop that
.             * fills `wdid_sg`sgcase'' above, in the same order, so the k-th p
> ooled non-ES name is
.             * the k-th sg non-ES row. keep it iff that row was actually appen
> ded: naming these
.             * rows from the FINAL value of sghaspre instead lets an early pre
>  round append a row
.             * whose name a later pre round then suppresses, leaving the namel
> ist shorter than the
.             * matrix -- which stata silently pads by repeating the LAST name 
> (r(0), no warning),
.             * shifting every later row onto the label of the NEXT quantity an
> d duplicating a colname
.             local ++sgnonesidx
1908.             local sgkeeprow : word `sgnonesidx' of `sgrowkeep'
1909.             if "`sgkeeprow'" == "1" local rownamessg `rownamessg' `rownam
> etest'
1910.           }
1911.           else{
1912.             local testtext = subinstr("`rownametest'","ES_att_it:","",.)
1913.             local testtext = subinstr("`testtext'","ES_ame_it:","",.)
1914.             local testtext = subinstr("`testtext'","ES_ame:","",.)
1915.             local testtext = subinstr("`testtext'","ES_att:","",.)
1916.             local testtext = subinstr("`testtext'"," ","",.)
1917.             if strpos("`relyrlist_s`sgcase'' ","`testtext' ") != 0 local 
> rownamessg `rownamessg' `rownametest'
1918.             * note: the spaces above are required to avoid triggering "1 
> is present" when presented with "11"
.           }
1919.         }
1920.         matrix rownames `wdid_sg`sgcase'' = `rownamessg'
1921.         local rownamessg`sgcase' `rownamessg'
1922.         if "`poisson'" == "" matrix colnames `wdid_sg`sgcase'' =  estimat
> e se t p lb_95ci ub_95ci   relyr
1923.         if "`poisson'" == "poisson" matrix colnames `wdid_sg`sgcase'' =  
> estimate se z p lb_95ci ub_95ci   relyr
1924. 
. 
.       }
1925. 
.       foreach matdrop in `sgmatricestodrop' {
1926.         * do matrix clean up
.         cap matrix drop `matdrop'
1927.       }
1928. 
.     }
1929. 
.     ******* give column names to the pwsgs matrices; their default rownames a
> re ok i think with eq name modifications
.     ******* also, stack them into one
.     if wordcount("`sglist'") > 1 {
1930.       tempname pwsgs
1931.       local itemround 0
1932.       foreach item in `att'  `att_it' `att_i' `att_itime' {
1933.         matrix rownames `pwsgs_`item'' = `item':
1934.         if `itemround' == 0 matrix `pwsgs' = `pwsgs_`item''
1935.         if `itemround' == 1 matrix `pwsgs' = `pwsgs' \ `pwsgs_`item''
1936.         matrix drop `pwsgs_`item''
1937.         local itemround 1
1938.         if ("`prepwok_`item''" !=  "") & ( (`espre' > 0 & "`esfixedbasepe
> riod'" == "") | ("`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativet
> o' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == "")))) ){
1939.             matrix rownames `prepwsgs_`item'' = pre_`item':
1940.             matrix `pwsgs' = `pwsgs' \ `prepwsgs_`item''
1941.             matrix drop `prepwsgs_`item''
1942.         }
1943.       }
1944.       if "`contreat'" != ""  {
1945.         foreach item in `att'  `att_it' `att_i' `att_itime' {
1946.           local itemtext = subinstr("`item'","att","ame",.)
1947.           matrix rownames `pwsgs_C`item'' = `itemtext':
1948.           matrix `pwsgs' = `pwsgs' \ `pwsgs_C`item''
1949.           matrix drop `pwsgs_C`item''
1950.           if ("`prepwok_C`item''" != "") & ( (`espre' > 0 & "`esfixedbase
> period'" == "") | ("`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativ
> eto' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == ""))))) {
1951.                 matrix rownames `prepwsgs_C`item'' = pre_`itemtext':
1952.                 matrix `pwsgs' = `pwsgs' \ `prepwsgs_C`item''
1953.                 matrix drop `prepwsgs_C`item''
1954.           }
1955.         }
1956.       }
1957.       if "`poisson'" == "" matrix colnames `pwsgs' =  estimate se t p lb_
> 95ci ub_95ci
1958.       if "`poisson'" == "poisson" matrix colnames `pwsgs' =  estimate se 
> z p lb_95ci ub_95ci
1959. 
.     }
1960.   }
1961. 
. 
