 51.       local xlabelstarter xlabel(`initialflagt' "*"
 52.         forval xlabeltick = `min'(1)`max' {
 53.           local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'"
 54.         }
 55.         local xlabelstarter `xlabelstarter' )
 56. 
.     }
 57.     else{
 58.       qui   gstats sum relyr, meanonly
