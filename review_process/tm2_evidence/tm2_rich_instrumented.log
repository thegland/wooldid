. cap program drop dumpres

. program define dumpres
  1.   args cfg rc
  2.   tempname fh
  3.   file open `fh' using "`cfg'.csv", write replace
  4.   file write `fh' "rc|`rc'" _n
  5.   qui ds
  6.   file write `fh' `"varlist|`r(varlist)'"' _n
  7.   local escalars : e(scalars)
  8.   foreach s of local escalars {
  9.     local v : di %21x e(`s')
 10.     file write `fh' "scalar|`s'|`v'" _n
 11.   }
 12.   local emacros : e(macros)
 13.   foreach m of local emacros {
 14.     file write `fh' `"macro|`m'|`e(`m')'"' _n
 15.   }
 16.   local emats : e(matrices)
 17.   foreach m of local emats {
 18.     tempname M
 19.     cap matrix `M' = e(`m')
 20.     if _rc != 0 continue
 21.     local R = rowsof(`M')
 22.     local C = colsof(`M')
 23.     local rn : rowfullnames `M'
 24.     local cn : colfullnames `M'
 25.     file write `fh' `"matnames|`m'|`R'x`C'|`rn'|`cn'"' _n
 26.     forval r = 1/`R' {
 27.       forval c = 1/`C' {
 28.         local v : di %21x `M'[`r',`c']
 29.         file write `fh' "mat|`m'|`r'|`c'|`v'" _n
 30.     }
 31.     }
 32.     cap matrix drop `M'
 33.   }
 34.   file close `fh'
 35. end

. 
. clear

. set seed 20260824

. set obs 15
Number of observations (_N) was 0, now 15.

. gen i = _n

. gen ttre = cond(i<=12, i+3, .)
(3 missing values generated)

. expand 8
(105 observations created)

. bysort i: gen unit = _n

. gen dose = exp(0.6*runiform() + 0.15*mod(i+unit,6))

. expand 16
(1,800 observations created)

. bysort i unit: gen t = _n

. gen sg = mod(i,3)+1

. gen post = (t >= ttre & ttre < .)

. gen pret = cond(ttre < . & t < ttre, (0.08 + 0.06*sg)*dose*(t-ttre), 0)

. gen y = 0.5*dose + 0.6*dose*post + pret + 0.1*i + 0.05*t + rnormal()*0.35

. drop post pret

. ereturn clear

