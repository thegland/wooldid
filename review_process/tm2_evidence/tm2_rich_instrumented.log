. * ===========================================================================
> =
. * F4 helper subprograms (kept out of the worker to conserve its size headroom
> )
. * ===========================================================================
> =
. 
. * warn when an effective onset lands on a period not observed in the data - o
> n panels
. * whose t is not unit-spaced (e.g. biennial), an off-grid anticipation shift 
> can merely
. * relabel horizons (pooled reference), move the fixed reference period in uni
> ntended
. * ways (esfixedbaseperiod), or make estimation fail
. cap prog drop wooldid_anticgrid

. prog def wooldid_anticgrid
  1. version 16.0
  2.   syntax , tvar(string) ttrevar(string) ifv(string)
  3.   qui glevelsof `ttrevar' if `ifv' == 1 & `ttrevar' != ., local(anticonset
> s)
  4.   local anticoffgrid
  5.   foreach anticv of local anticonsets {
  6.     qui count if `tvar' == `anticv' & `ifv' == 1
  7.     if r(N) == 0 local anticoffgrid `anticoffgrid' `anticv'
  8.   }
  9.   if "`anticoffgrid'" != "" {
 10.     dis as text "Caution: anticipation() is expressed in the units of `tva
> r', and the effective onset value(s) `anticoffgrid' fall on period(s) not obs
> erved in the data. Depending on the specification, this can merely relabel ho
> rizons, move the reference period in unintended ways, or cause estimation to 
> fail. Verify that the anticipation length matches the spacing of `tvar'."
 11.   }
 12. end

. 
. * under esfixedbaseperiod, report units dropped only BECAUSE the anticipation
>  shift
. * moved their reference period onto a period they are not observed in (called
>  after the
. * reference-period screen zeroes ifvar, before ttre is nulled for the dropped
>  units)
. cap prog drop wooldid_anticesf

. prog def wooldid_anticesf
  1. version 16.0
  2.   syntax , ivar(string) tvar(string) rawttre(string) refobs(string) esrel(
> string) antic(string) ttrevar(string) ifv(string)
  3.   * the raw-reference check must use the SAME domain the reference screen 
> itself used:
.   * rows in-sample before this screen ran. the screen has already zeroed ifv 
> for its own
.   * victims, so that domain = still-in-sample rows plus the just-zeroed victi
> ms. without
.   * this restriction, a raw reference observed only on rows an EARLIER screen
>  (e.g. a
.   * user if()) had excluded would mis-attribute an unrelated drop to the shif
> t
.   tempvar rawref rawrefobs
  4.   qui gen byte `rawref' = `tvar' == `rawttre' + `esrel' if `ifv' == 1 | (`
> refobs' == 0 & `ttrevar' != .)
  5.   qui gegen `rawrefobs' = max(`rawref'), by(`ivar')
  6.   qui count if `refobs' == 0 & `ttrevar' != . & `rawrefobs' == 1
  7.   if r(N) > 0 {
  8.     local anticdropobs = r(N)
  9.     tempvar antictag
 10.     qui gegen `antictag' = tag(`ivar') if `refobs' == 0 & `ttrevar' != . &
>  `rawrefobs' == 1
 11.     qui count if `antictag' == 1
 12.     dis as text "Caution: anticipation(`antic') places the effective refer
> ence period of `r(N)' unit(s) on a period unusable for them (not observed, or
>  dropped for lack of a comparison unit); those unit(s) and their `anticdropob
> s' observations are dropped (their reference period would have been usable wi
> thout the anticipation shift)."
 13.     qui drop `antictag'
 14.   }
 15.   qui drop `rawref' `rawrefobs'
 16. end

. 
. * ===========================================================================
> =
. * E1 subprogram: build the "every subgroup margin is equal" constraint chain 
> for
. * -test- out of the coefficient names Stata itself posted in e(b) after
. *   margins ..., over(<sg>) pwcompare(effects) <marginsdof> post
. * The names are READ BACK (colnames/coleq), never constructed from subgroup
. * values, so they are valid by construction whatever the level values, level
. * labels or variable name length; omitted (o.) columns are skipped. -half-
. * selects the binary layout, where the posted e(b) carries the base-outcome h
> alf
. * followed by the 1.<targetflag> half and only the second half is wanted;
. * without -half- (continuous treatment) every column is used.
. * Returns: sgchain (the chain, empty if fewer than 2 usable columns)
. *          sgchainn (number of usable columns; the caller must require > 1,
. *          since a one-term chain would test that margin against 0 instead)
. * A subprogram because wooldid_worker sits near Stata's per-program compiled-
> size
. * ceiling and this is used at four call sites.
. * ===========================================================================
> =
. cap prog drop wooldid_sgchain

. prog def wooldid_sgchain
  1. version 16.0
  2.   syntax [, HALF]
  3.   tempname sgcb
  4.   matrix `sgcb' = e(b)
  5.   local sgck = colsof(`sgcb')
  6.   local sgccn : colnames `sgcb'
  7.   local sgcce : coleq `sgcb'
  8.   local sgcj0 = 1
  9.   if "`half'" == "half" local sgcj0 = floor(`sgck'/2) + 1
 10.   local sgcchain
 11.   local sgcn 0
 12.   forval sgcj = `sgcj0'/`sgck' {
 13.     local sgcnm : word `sgcj' of `sgccn'
 14.     local sgceq : word `sgcj' of `sgcce'
 15.     if strmatch("`sgcnm'","*o.*") continue
 16.     local sgcn = `sgcn' + 1
 17.     if `sgcn' == 1 local sgcchain [`sgceq']`sgcnm'
 18.     else local sgcchain `sgcchain' = [`sgceq']`sgcnm'
 19.   }
 20.   if `sgcn' < 2 local sgcchain
 21.   c_local sgchain `"`sgcchain'"'
 22.   c_local sgchainn `sgcn'
 23. end

. 
