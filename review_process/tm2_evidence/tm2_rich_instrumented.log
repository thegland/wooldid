. 
. * NFADV-01/02/05: the adversarial pre-trend machinery. One caller replaces th
> e four
. * near-identical frame/svmat/`test' blocks in wooldid_worker (per-program siz
> e ceiling).
. * Inputs are the F2 event-study capture of the SAME margins run (b 1xk, V kxk
>  full
. * covariance), the aligned relative-time column relyr (kx1), min_t, esrelativ
> eto, and
. * the reference-regime/timetrends/altmethod flags. It does two things:
. *  (1) fits the DISPLAY LINE by the same unweighted OLS `reg b t' the old in-
> worker
. *      frames ran - identical rows (real horizon coefficients in horizon orde
> r, then
. *      the planted zero-valued reference row(s)) and the identical internal r
> egressor
. *      t = relyr + min_t + 1 (the worker's LOAD-BEARING identity), so the pub
> lished
. *      slope is bit-identical to the old one - and re-expresses the intercept
>  at
. *      relative time 0 (NFADV-05: the old _cons was the fitted value at relyr
>  =
. *      -min_t-1), publishing columns [slope, intercept_rt0];
. *  (2) computes a CALIBRATED p-value on the event-study covariance, esfixedba
> seperiod
. *      only (the pooled reference has no single omitted period; the worker pr
> ints one
. *      Caution per run and the line is returned without inference). Primary =
>  a
. *      minimum-distance test of the composite null that all horizon effects l
> ie on
. *      SOME line (NFADV-01: the old code froze the fitted line as text consta
> nts in
. *      `test', a weighted chi-square whose null size depends on the margins V
> CV).
. *      Altmethod = the post coefficients tested against the pre-period-line f
> orecasts
. *      using the FULL forecast covariance S = V_QQ + A V_PP A' - A V_PQ - V_Q
> P A'
. *      (NFADV-02: the old code used V_QQ alone, anti-conservative). The stati
> stics
. *      live in mata (wooldid_advx, end of file); F vs chi-squared reference f
> ollows
. *      the wooldid_ptp df_r convention.
. * Returns r(status): "ok" (line + p), "nop" (line only), "gapskip" (nothing -
>  the B16
. * gap backstop: the altmethod fit sample has no real pre-period coefficient).
. cap prog drop wooldid_advstat

. prog def wooldid_advstat, rclass
  1. version 16.0
  2.   syntax , b(string) v(string) relyr(string) mint(string) esrel(string) [d
> fr(string) esf(string) tt(string) alt(string) sg(string)]
  3. 
.   * B16 gap backstop (altmethod): the planted reference row(s) always satisfy
>  the
.   * pre-period cut, so require at least one REAL pre-period coefficient beyon
> d them
.   * (both regimes' cuts reduce to relyr <= -1: esf uses t <= min_t and the po
> oled
.   * regime uses t <= espre with espre = min_t)
.   if "`alt'" != "" {
  4.     mata: st_local("advnpre", strofreal(sum(st_matrix("`relyr'") :<= -1)))
  5.     if `advnpre' < 1 {
  6.       if "`sg'" == "" dis as text "Caution: adversarial pre-trend testing 
> was cancelled: after accounting for gaps in the data, too few pre-treatment c
> oefficients remain to fit the adversarial reference line."
  7.       else dis as text "Caution: the adversarial pre-trend test was skippe
> d for subgroup `sg': after accounting for gaps in the data, too few pre-treat
> ment coefficients remain to fit the reference line."
  8.       return local status gapskip
  9.       exit
 10.     }
 11.   }
 12. 
.   * the display line. rows are assembled exactly as the old adversarial frame
> s were:
.   * real coefficients first (b transposed against t = relyr + min_t + 1), the
> n the
.   * planted reference row(s) - esf: relyr = esrelativeto (preceded by esrelat
> iveto - 1
.   * under timetrends); pooled: one horizon below the earliest real horizon pr
> esent.
.   * missing coefficients become 0, as the old frame's `replace b = 0 if b == 
> .' did.
.   local k = rowsof(`relyr')
 13.   tempname advF advB advL
 14.   matrix `advF' = `b'' , (`relyr' + J(`k',1,`mint'+1))
 15.   forval advi = 1/`k' {
 16.     if `advF'[`advi',1] >= . matrix `advF'[`advi',1] = 0
 17.   }
 18.   if "`esf'" != "" {
 19.     if "`tt'" != "" matrix `advF' = `advF' \ (0, `esrel'+`mint')
 20.     matrix `advF' = `advF' \ (0, `esrel'+`mint'+1)
 21.   }
 22.   else {
 23.     mata: st_local("advminr", strofreal(min(st_matrix("`relyr'"))))
 24.     matrix `advF' = `advF' \ (0, `advminr'+`mint')
 25.   }
 26.   qui frame
 27.   local advfr0 `r(currentframe)'
 28.   tempname advfr
 29.   frame create `advfr'
 30.   frame change `advfr'
 31.   qui svmat double `advF'
 32.   local advcut
 33.   if "`alt'" != "" local advcut if `advF'2 <= `mint'
 34.   qui reg `advF'1 `advF'2 `advcut'
 35.   matrix `advB' = e(b)
 36.   frame change `advfr0'
 37.   frame drop `advfr'
 38.   * the little reg clobbered e(); put the main model back (stored at worke
> r start)
.   qui est restore ___wooldidfullmodel
 39.   matrix `advL' = (`advB'[1,1], `advB'[1,2] + (`mint'+1)*`advB'[1,1])
 40.   matrix colnames `advL' = slope intercept_rt0
 41.   matrix rownames `advL' = y1
 42. 
.   * inference (esf only; on the F2 covariance, in mata)
.   local advstatus nop
 43.   if "`esf'" != "" {
 44.     local advdfr .
 45.     if "`dfr'" != "" & "`dfr'" != "." {
 46.       if real("`dfr'") > 0 & real("`dfr'") < . local advdfr `dfr'
 47.     }
 48.     tempname advP
 49.     local advpstat
 50.     mata: wooldid_advx("`b'", "`v'", "`relyr'", `esrel', ("`tt'"!=""), ("`
> alt'"!=""), `advdfr', "`advP'")
 51.     if "`advpstat'" == "ok" {
 52.       return scalar p = scalar(`advP')
 53.       local advstatus ok
 54.     }
 55.     else {
 56.       * covers rank-0/degenerate covariance (e.g. timetrends), missing ent
> ries, a
.       * residual outside the covariance's column space, and no testable resid
> ual
.       * dimensions (e.g. only two real horizons under the primary composite n
> ull)
.       if "`sg'" == "" dis as text "Caution: adversarial: the composite-null c
> ovariance is degenerate; no p-value computed."
 57.       else dis as text "Caution: adversarial: the composite-null covarianc
> e is degenerate for subgroup `sg'; no p-value computed."
 58.     }
 59.   }
 60.   return local status `advstatus'
 61.   return matrix line = `advL'
 62. end

