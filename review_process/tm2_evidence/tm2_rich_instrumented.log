 38.     error 198
 39.   }
 40.   if "`permmethod'" == "probabilities" {
 41.     cap confirm numeric variable `clus'
 42.     if _rc != 0 {
 43.       dis as error "Error: permute(probabilities) requires a numeric clust
> er variable (the permprobs() grammar lists clusters by numeric value)."
 44.       error 198
 45.     }
 46.     if `"`permprobs'"' == "" {
 47.       dis as error "Error: permute(probabilities) requires permprobs()."
 48.       error 198
 49.     }
 50.     if "`permexact'" != "" {
 51.       dis as error "Error: permute(probabilities) supports permreps() only
> , not permexact."
 52.       error 198
 53.     }
 54.     if `permreps' <= 0 {
 55.       dis as error "Error: permute(probabilities) requires permreps()."
 56.       error 198
 57.     }
 58.   }
 59.   if "`permmethod'" == "shuffle" {
 60.     if `"`permprobs'"' != "" {
 61.       dis as error "Error: permprobs() is only for permute(probabilities).
> "
 62.       error 198
 63.     }
 64.     if "`permexact'" != "" & `permreps' > 0 {
 65.       dis as error "Error: specify permreps() or permexact, not both."
 66.       error 198
 67.     }
 68.     if "`permexact'" == "" & `permreps' <= 0 {
 69.       dis as error "Error: permute(shuffle) requires permreps() or permexa
> ct."
 70.       error 198
 71.     }
 72.   }
 73.   if wordcount("`clus'") != 1 {
 74.     dis as error "Error: permute() requires cluster() with a single variab
> le - the unit whose treatment-onset assignment is randomized."
 75.     error 198
 76.   }
 77. 
.   * sample for the data checks: the user's if-restriction, rows with a cluste
> r value
.   tempvar insmp
 78.   * NFPERM-03: exact-one rule ((exp)==1), matching estimation's if-semanti
> cs (8d7bd01):
.   * native truth admitted rows with if-values like 2 or missing into the rand
> omization
.   * design that never enter estimation (false r459 nesting errors on bare-fla
> g ifs;
.   * design-population drift). byte-parallel with permrun's smp below
.   if `"`ifr'"' != "" qui gen byte `insmp' = ((`ifr') == 1) & !missing(`clus')
 79.   else qui gen byte `insmp' = !missing(`clus')
 80.   qui replace `insmp' = 0 if `insmp' >= .
 81. 
.   * the level accounting treats all missing codes as the single never-treated
>  group,
.   * but enumeration/probability matching distinguishes extended missings; req
> uire the
.   * plain-missing convention outright
.   qui count if `insmp' & `ttrevar' > .
 82.   if r(N) > 0 {
 83.     dis as error "Error: permute() requires never-treated observations cod
> ed as plain missing (.) in the timing variable; `r(N)' in-sample observation(
> s) carry extended missing codes (.a, .b, ...)."
 84.     error 459
 85.   }
 86. 
.   * nesting (author's brief): each cluster must sit inside exactly one treatm
> ent-onset
.   * level - onset constant within cluster, and treated/never-treated rows nev
> er mixed
.   tempvar tmin tmax ntr nnv
 87.   qui gegen double `tmin' = min(`ttrevar') if `insmp', by(`clus')
 88.   qui gegen double `tmax' = max(`ttrevar') if `insmp', by(`clus')
 89.   qui gegen double `ntr' = total(!missing(`ttrevar')) if `insmp', by(`clus
> ')
 90.   qui gegen double `nnv' = total(missing(`ttrevar')) if `insmp', by(`clus'
> )
 91.   qui count if `insmp' & ((`ntr' > 0 & `nnv' > 0) | (`ntr' > 0 & `tmin' !=
>  `tmax'))
 92.   if r(N) > 0 {
 93.     dis as error "Error: permute() requires clusters to be subsets of trea
> tment-onset groups (levels of the timing variable, with never-treated its own
>  group), but `r(N)' in-sample observation(s) sit in clusters that mix onset v
> alues or mix treated and never-treated rows."
 94.     error 459
 95.   }
 96. 
.   * strata: clusters must be strict subsets of strata
.   if "`permstrata'" != "" {
 97.     if "`permmethod'" != "shuffle" {
 98.       dis as error "Error: permstrata() is only for permute(shuffle)."
 99.       error 198
100.     }
101.     tempvar smin smax
102.     qui gegen double `smin' = min(`permstrata') if `insmp', by(`clus')
103.     qui gegen double `smax' = max(`permstrata') if `insmp', by(`clus')
104.     qui count if `insmp' & (`smin' != `smax' | missing(`permstrata'))
105.     if r(N) > 0 {
106.       dis as error "Error: permstrata() requires every cluster to sit insi
> de a single stratum with no missing stratum values (`r(N)' in-sample observat
> ion(s) violate this)."
107.       error 459
108.     }
109.   }
110. 
.   * enough freedom to randomize: at least 2 clusters and 2 distinct onset gro
> ups
.   tempvar ctag consv
111.   qui gegen byte `ctag' = tag(`clus') if `insmp'
112.   qui count if `ctag' == 1
113.   local permnclus = r(N)
114.   qui gen double `consv' = cond(`ntr' > 0, `tmin', .) if `ctag' == 1
115.   qui glevelsof `consv' if `ctag' == 1, missing local(permlvls)
116.   local permnlvl : word count `permlvls'
117.   if `permnclus' < 2 | `permnlvl' < 2 {
118.     dis as error "Error: permute() found `permnclus' cluster(s) across `pe
> rmnlvl' treatment-onset group(s); there is nothing to randomize."
119.     error 459
120.   }
121. 
.   * permute(probabilities): validate the permprobs() grammar against the data
> 's actual
.   * onset levels and cluster values (the same mata parser the engine uses, ru
> n in
.   * check-only mode, so the two can never drift)
.   if "`permmethod'" == "probabilities" {
122.     qui glevelsof `ttrevar' if `insmp', missing local(permonslvls)
123.     qui glevelsof `clus' if `insmp', local(permclusvals)
124.     local permperr
125.     mata: wooldid_permp(st_local("permprobs"), "`ttrevar'", "`permonslvls'
> ", "`permclusvals'", "", "")
126.     if "`permperr'" != "" {
127.       dis as error "`permperr'"
128.       error 198
129.     }
130.   }
131. end

. 
. 
. *** F6: the permutation engine. builds the cluster->onset map, generates assi
> gnments
. *** (mata: wooldid_permx), runs the rep loop as nested quiet wooldid calls on
>  a
. *** permuted onset column, and hands the summary statistics back to the shell
>  via
. *** c_local (the shell restores the observed results and posts them to e())
. cap prog drop wooldid_permrun

. prog def wooldid_permrun
  1. version 16.0
  2.   syntax , y(varname) i(varname) t(varname) ttrevar(varname) clus(varlist)
>  permute(string) estimands(string) distname(string) [permreps(integer 0) PERM
> EXact permstrata(varname numeric) permprobs(string asis) PERMTStat repopts(st
> ring asis) wtype(string) wexp(string) ifr(string asis) compname(string)]
  3. 
.   * comparison-statistic scalars, filled by the mandatory rep-0 run below (NF
> PERM-10)
.   tempname wdpo1 wdpo2 wdpo3 wdpo4
  4. 
.   * one row per cluster: its onset level and (optional) stratum
.   tempvar smp
  5.   if `"`ifr'"' != "" {
  6.     * NFPERM-03: exact-one rule, byte-parallel with permctl's insmp
.     qui gen byte `smp' = ((`ifr') == 1)
  7.     qui replace `smp' = 0 if `smp' >= .
  8.   }
  9.   else qui gen byte `smp' = 1
 10.   qui replace `smp' = 0 if missing(`clus')
 11.   tempname mpfr
 12.   frame put `clus' `ttrevar' `permstrata' if `smp', into(`mpfr')
 13.   frame `mpfr' {
 14.     qui bysort `clus': keep if _n == 1
 15.     if "`permstrata'" == "" {
 16.       tempvar onestr
 17.       qui gen byte `onestr' = 1
 18.       local permstrata `onestr'
 19.     }
 20.     qui sort `permstrata' `clus'
 21.     qui gen double __wdpassign = .
 22.     * NFPERM-02: freeze the generation-time row identity. the assignment m
> atrix is
.     * generated in the (strata, cluster) sort order above, but frlink below R
> E-SORTS
.     * this frame by the cluster key (frlink is sortpreserve for the master fr
> ame only),
.     * so a positional _n read at application time attaches assignments to the
>  WRONG
.     * clusters whenever ascending cluster order crosses stratum order - silen
> tly wrong
.     * stratified inference (probed: crossing-strata exact designs reported p=
> 0 with the
.     * observed assignment absent from their own enumeration). __wdprow keys e
> ach row to
.     * its generation-time matrix row, making any later reorder harmless
.     qui gen long __wdprow = _n
 23.   }
 24. 
.   * assignments + counts (mata): fills the C x R matrix, sets wdp_R, the poss
> ible-
.   * assignment count (double + string), and caution flags
.   tempname wdpassign wdpP wdpL
 25.   if "`permute'" == "probabilities" {
 26.     * re-run the shared parser in engine mode: fills the probability matri
> x (rows in
.     * ascending cluster order = the map frame's order) and the level vector
.     frame `mpfr' {
 27.       qui glevelsof `ttrevar', missing local(permonslvls)
 28.       qui glevelsof `clus', local(permclusvals)
 29.     }
 30.     local permperr
 31.     mata: wooldid_permp(st_local("permprobs"), "`ttrevar'", "`permonslvls'
> ", "`permclusvals'", "`wdpP'", "`wdpL'")
 32.     if "`permperr'" != "" {
 33.       dis as error "`permperr'"
 34.       error 198
 35.     }
 36.   }
 37.   mata: wooldid_permx("`mpfr'", "`ttrevar'", "`permstrata'", `permreps', (
> "`permexact'" != ""), "`wdpassign'", "`wdpP'", "`wdpL'")
 38.   if "`wdp_caut0'" != "" dis as text "Caution: `wdp_caut0'"
 39.   if "`wdp_err'" != "" {
 40.     dis as error "`wdp_err'"
 41.     error 198
 42.   }
 43.   * NFPERM-09: conditionally degenerate designs (every stratum onset-homog
> eneous, or every
.   * permprobs() row deterministic) pass the global freedom precheck but admit
>  exactly one
.   * possible assignment; they formerly ran to completion reporting a useless 
> p (p=1, or
.   * p=1/(R+1) when a deterministic table targets a non-observed assignment). 
> both
.   * generators report the support count in wdp_npd, and M==1 iff lnM==0 exact
> ly (the
.   * per-stratum lnfactorial terms cancel exactly; smallest nondegenerate M is
>  2), so the
.   * numeric compare cannot false-fire. placed BEFORE the reps-vs-support caut
> ions so a
.   * degenerate run is refused rather than first advised to consider permexact
.   if real("`wdp_npd'") == 1 {
 44.     dis as error "Error: the requested randomization design admits only on
> e possible assignment (every stratum is onset-homogeneous, or every permprobs
> () row is deterministic); there is nothing to randomize."
 45.     error 459
 46.   }
 47.   if "`wdp_caut1'" != "" dis as text "Caution: `wdp_caut1'"
 48.   if "`wdp_caut2'" != "" dis as text "Caution: `wdp_caut2'"
 49. 
.   * link the map into the data once; each rep refreshes the onset column from
>  it
.   tempvar lnk repons
 50.   qui frlink m:1 `clus', frame(`mpfr') generate(`lnk')
 51.   local ndone 0
 52.   local nfail 0
 53.   tempname res
 54.   matrix `res' = J(`wdp_R', `: word count `estimands'', .)
 55.   local wtif
 56.   if "`wtype'" != "" local wtif [`wtype'=`wexp']
 57.   if `"`ifr'"' != "" local wtif `wtif' if (`ifr')
 58.   local repcall `y' `i' `t'
 59.   * statistic-path consistency: draws are estimated under fastnose, whose 
> point
.   * estimates differ from the full run's in the last digits (the F9 contract)
> , so the
.   * comparison statistic comes from a rep-0 fastnose run of the TRUE assignme
> nt - this
.   * keeps the exact test's observed-is-a-member property bitwise. the display
>  still
.   * shows the full run's estimate. the statistics are held in tempname SCALAR
> S: a
.   * local's decimal round-trip re-parses one ulp off, which breaks the
.   * observed-is-a-member property (measured: b >= local-copy-of-b evaluates F
> ALSE)
.   cap qui wooldid `repcall' `ttrevar' `wtif' , `repopts'
 60.   * NFPERM-10: the comparator fit and its scalars must be valid. formerly 
> a rep-0
.   * failure fell through silently (retaining full-run-provenance scalars, bre
> aking the
.   * exact test's bitwise observed-is-a-member property), and a missing compar
> ison
.   * statistic (e.g. a degenerate observed SE under permtstat) silently zeroed
>  every
.   * tail count - exact p = 0 with no message. the shell restores the observed
.   * estimation results bit-intact on these error paths
.   if _rc == 1 error 1
 61.   if _rc != 0 {
 62.     dis as error "Error: the rep-0 comparison run of the observed assignme
> nt failed (rc `=_rc'); permutation inference is impossible. The observed esti
> mation results are unaffected."
 63.     error 459
 64.   }
 65.   local ec 0
 66.   foreach ee in `estimands' {
 67.     local ++ec
 68.     if "`permtstat'" == "" cap scalar `wdpo`ec'' = _b[main_`ee']
 69.     else cap scalar `wdpo`ec'' = _b[main_`ee']/_se[main_`ee']
 70.     if _rc != 0 {
 71.       dis as error "Error: the observed comparison statistic for `ee' coul
> d not be read from the rep-0 run; permutation inference is impossible."
 72.       error 459
 73.     }
 74.     if missing(`wdpo`ec'') {
 75.       dis as error "Error: the observed comparison statistic for `ee' is m
> issing (unidentified observed estimate or standard error); permutation infere
> nce is impossible."
 76.       error 459
 77.     }
 78.   }
 79.   * NFPERM-12 (lean kernel): export the comparison statistics actually use
> d for the
.   * tail counts, guarded valid above; the caller posts them as e(perm_compara
> tor)
.   if "`compname'" != "" {
 80.     matrix `compname' = J(1, `: word count `estimands'', .)
 81.     local ec 0
 82.     foreach ee in `estimands' {
 83.       local ++ec
 84.       matrix `compname'[1, `ec'] = `wdpo`ec''
 85.     }
 86.     matrix colnames `compname' = `estimands'
 87.   }
 88.   forval r = 1/`wdp_R' {
 89.     frame `mpfr': qui replace __wdpassign = el("`wdpassign'", __wdprow, `r
> ')
 90.     cap drop `repons'
 91.     qui frget `repons' = __wdpassign, from(`lnk')
 92.     cap qui wooldid `repcall' `repons' `wtif' , `repopts'
 93.     local badrep 0
 94.     if _rc != 0 local badrep 1
 95.     if `badrep' == 0 {
 96.       local ec 0
 97.       foreach ee in `estimands' {
 98.         local ++ec
 99.         if "`permtstat'" == "" {
100.           cap matrix `res'[`r', `ec'] = _b[main_`ee']
101.           * NFPERM-10: mirror the t-branch missing check so whole-row blan
> king keeps a
.           * single completed-row set (nuse == ndone for every column)
.           if _rc == 0 {
102.             if missing(`res'[`r', `ec']) local badrep 1
103.           }
104.         }
105.         else {
106.           cap matrix `res'[`r', `ec'] = _b[main_`ee']/_se[main_`ee']
107.           if _rc == 0 {
108.             if missing(`res'[`r', `ec']) local badrep 1
109.           }
110.         }
111.         if _rc != 0 local badrep 1
112.       }
113.     }
114.     if `badrep' == 0 local ++ndone
115.     else {
116.       local ++nfail
117.       * blank the whole row: a partially-failed rep (reachable under permt
> stat with a
.       * degenerate SE on one of several estimands) must not leak its good col
> umns into
.       * the per-estimand summaries, and the permdist packing keys on column 1
.       local ec 0
118.       foreach ee in `estimands' {
119.         local ++ec
120.         cap matrix `res'[`r', `ec'] = .
121.       }
122.     }
123.   }
124.   cap drop `lnk'
125.   cap drop `repons'
126.   frame drop `mpfr'
127. 
.   if `ndone' < max(20, `wdp_R'/2) & "`permexact'" == "" {
128.     dis as error "Error: only `ndone' of `wdp_R' permutation replications 
> estimated successfully; too few for inference. Check whether reassigned onset
>  configurations are frequently inestimable on these data."
129.     error 459
130.   }
131.   * NFPERM-01 (lean residue): under permexact ANY failure means the enumer
> ation is
.   * incomplete, so the caution fires at nfail > 0 with wording that states th
> e
.   * substance; sampled mode keeps the 10% threshold (adjudicated accounting d
> esign)
.   if `nfail' > 0 & "`permexact'" != "" dis as text "Caution: `nfail' of `wdp_
> R' enumerated assignments failed to estimate, so the exact enumeration is inc
> omplete; the reported exact p-value is a share over completed assignments onl
> y (the observed-is-a-member and 2/M-floor readings no longer apply)."
132.   else if `nfail' > 0 & `nfail' > 0.1*`wdp_R' dis as text "Caution: `nfail
> ' of `wdp_R' permutation replications failed to estimate and were excluded."
133. 
.   * summaries per estimand: add-one two-sided p (exact: plain share - the obs
> erved
.   * assignment is a member of the enumeration), 5th/95th percentile band, SD
.   tempname rsfr
134.   matrix `distname' = J(`ndone', `: word count `estimands'', .)
135.   local ec 0
136.   foreach ee in `estimands' {
137.     local ++ec
138.     frame create `rsfr' double s
139.     frame `rsfr' {
140.       qui set obs `wdp_R'
141.       qui replace s = el("`res'", _n, `ec')
142.       qui drop if missing(s)
143.       qui count if abs(s) >= abs(`wdpo`ec'')
144.       local nex = r(N)
145.       qui count
146.       local nuse = r(N)
147.       _pctile s, p(5 95)
148.       local lb = r(r1)
149.       local ub = r(r2)
150.       qui sum s
151.       * NFPERM-11: an exact enumeration IS the complete population of assi
> gnments, so
.       * report the population SD (denominator M); sampled draws keep the n-1 
> sample SD.
.       * r(Var) is full double precision - no display-rounding hazard
.       if "`permexact'" != "" local sdv = sqrt(r(Var)*(r(N)-1)/r(N))
152.       else local sdv = r(sd)
153.       if `sdv' == 0 dis as text "Caution: the permuted `ee' distribution i
> s degenerate (every completed draw equals every other); the permutation p-val
> ue is uninformative."
154.       local q95 .
155.       if "`permtstat'" != "" {
156.         qui gen double abss = abs(s)
157.         _pctile abss, p(95)
158.         local q95 = r(r1)
159.         qui drop abss
160.       }
161.     }
162.     frame drop `rsfr'
163.     if "`permexact'" != "" local p_`ee' = `nex'/`nuse'
164.     else local p_`ee' = (1 + `nex')/(`nuse' + 1)
165.     c_local wdp_r_p_`ee' `p_`ee''
166.     c_local wdp_r_lb_`ee' `lb'
167.     c_local wdp_r_ub_`ee' `ub'
168.     c_local wdp_r_sd_`ee' `sdv'
169.     c_local wdp_r_q_`ee' `q95'
170.   }
171.   * dense permdist matrix (completed rows only), built once from res
.   local rr 0
172.   forval r = 1/`wdp_R' {
173.     if !missing(el("`res'", `r', 1)) {
174.       local ++rr
175.       local ec 0
176.       foreach ee in `estimands' {
177.         local ++ec
178.         matrix `distname'[`rr', `ec'] = el("`res'", `r', `ec')
179.       }
180.     }
181.   }
182.   matrix colnames `distname' = `estimands'
183. 
.   c_local wdp_r_reps `wdp_R'
184.   c_local wdp_r_done `ndone'
185.   c_local wdp_r_fail `nfail'
186.   c_local wdp_r_npd `wdp_npd'
187.   c_local wdp_r_nps `wdp_nps'
188. end

. 
