.   ***************************************************************************
> ************************************************
.   ****************************         EVENT-STUDY COMPOSITION DIAGNOSTICS (F
> 8)       **************************************
.   ***************************************************************************
> ************************************************
.   * per reported horizon: distinct treatment-onset cohorts, distinct units of
>  i (= the number of
.   * unit-by-period coefficients averaged at that horizon), distinct clusters,
>  estimation-sample
.   * observations, and the horizon's share of the reported-window treated weig
> ht under both weight
.   * concepts the event studies use (w_att = w x customweightmultiplier; w_att
> _it = that divided by
.   * the i-by-t cell weight total, replicating the weight construction above -
>  the tempvars
.   * themselves are estimand-gated and w_per_it is already dropped, so the sha
> res are recomputed
.   * here so the matrix has fixed width regardless of which estimands were req
> uested). rows come
.   * from the SAME relyrcolumn / relyrcolumn_s<sg> sources as the reported ES 
> matrices, so they
.   * align one-for-one with the ES_* blocks (horizons without a surviving coef
> ficient get no row).
.   * composition is a descriptive counts-and-totals screen, not a test: flat c
> olumns rule out
.   * changes in these REPORTED summaries (a cohort entering/leaving, a unit-co
> unt or weight-mass
.   * shift); they do not rule out turnover of WHICH units contribute at unchan
> ged counts, since
.   * identities are not stored. moving columns do not by themselves establish 
> composition bias.
.   * this block runs NO margins call and NO e-class command, so the active e()
>  is untouched and no
.   * est restore is needed. it DOES clear r(); nothing between here and the er
> eturn post consumes
.   * r(). gtools by() is hash-based: the user's sort order is not disturbed.
.   local f8keys
1962.   if `espre' + `espl' > 0 {
1963.     tempvar f8wa f8wpit f8wit
1964.     qui gen double `f8wa' = `w' `customweighttext'
1965.     qui gegen double `f8wpit' = total(`esamp' * `w'), by(`i' `t')
1966.     qui gen double `f8wit' = `f8wa'/`f8wpit'
1967.     qui replace `f8wit' = 0 if `f8wit' == .
1968.     local f8cluster
1969.     if "`cluster'" != "" & wordcount("`cluster'") == 1 local f8cluster `c
> luster'
1970.     tempvar f8in f8tagc f8tagi f8tagcl f8tagt f8nc f8nu f8ncl f8n f8w f8w
> i
1971.     qui gen byte `f8in' = (`esamp' == 1 & `targetflag' == 1 & `_t' >= `ho
> rizonstarter' & `_t' <= `horizonend')
1972.     qui gegen byte   `f8tagc'  = tag(`_t' `ttre') if `f8in'
1973.     qui gegen byte   `f8tagi'  = tag(`_t' `_i')   if `f8in'
1974.     qui gegen byte   `f8tagt'  = tag(`_t')        if `f8in'
1975.     qui gegen long   `f8nc'    = total(`f8tagc') if `f8in', by(`_t')
1976.     qui gegen long   `f8nu'    = total(`f8tagi') if `f8in', by(`_t')
1977.     if "`f8cluster'" != "" {
1978.       qui gegen byte `f8tagcl' = tag(`_t' `f8cluster') if `f8in'
1979.       qui gegen long `f8ncl'   = total(`f8tagcl') if `f8in', by(`_t')
1980.     }
1981.     else {
1982.       qui gen byte `f8tagcl' = .
1983.       qui gen double `f8ncl' = .
1984.     }
1985.     qui gegen long   `f8n'     = count(1)       if `f8in', by(`_t')
1986.     qui gegen double `f8w'     = total(`f8wa')  if `f8in', by(`_t')
1987.     qui gegen double `f8wi'    = total(`f8wit') if `f8in', by(`_t')
1988.     tempname f8raw
1989.     cap mkmat `_t' `f8nc' `f8nu' `f8ncl' `f8n' `f8w' `f8wi' if `f8tagt' =
> = 1, matrix(`f8raw')
1990.     local f8rawrc = _rc
1991.     cap drop `f8in' `f8tagc' `f8tagi' `f8tagcl' `f8tagt' `f8nc' `f8nu' `f
> 8ncl' `f8n' `f8w' `f8wi'
1992.     if `f8rawrc' == 0 {
1993.       tempname f8m
1994.       local f8nr = rowsof(`relyrcolumn')
1995.       matrix `f8m' = J(`f8nr', 8, 0)
1996.       local f8wtot = 0
1997.       local f8witot = 0
1998.       local f8rn
1999.       forval f8i = 1/`f8nr' {
2000.         local f8rv = `relyrcolumn'[`f8i',1]
2001.         local f8h  = `f8rv' + `min_t' + 1
2002.         if `f8rv' < 0 local f8rn `f8rn' pre`=abs(`f8rv')'
2003.         else if `f8rv' == 0 & `oldsyntax' == 1 local f8rn `f8rn' contemp
2004.         else local f8rn `f8rn' post`f8rv'
2005.         matrix `f8m'[`f8i',8] = `f8rv'
2006.         forval f8r = 1/`=rowsof(`f8raw')' {
2007.           if `f8raw'[`f8r',1] == `f8h' {
2008.             matrix `f8m'[`f8i',1] = `f8raw'[`f8r',2]
2009.             matrix `f8m'[`f8i',2] = `f8raw'[`f8r',3]
2010.             matrix `f8m'[`f8i',3] = `f8raw'[`f8r',4]
2011.             matrix `f8m'[`f8i',4] = `f8raw'[`f8r',5]
2012.             matrix `f8m'[`f8i',5] = `f8raw'[`f8r',6]
2013.             matrix `f8m'[`f8i',6] = `f8raw'[`f8r',6]
2014.             matrix `f8m'[`f8i',7] = `f8raw'[`f8r',7]
2015.             local f8wtot = `f8wtot' + `f8raw'[`f8r',6]
2016.             local f8witot = `f8witot' + `f8raw'[`f8r',7]
2017.           }
2018.         }
2019.       }
2020.       * share denominators accumulate over the matched (reported) horizon
> s only, so each
.       * share column sums to 1 by construction
.       forval f8i = 1/`f8nr' {
2021.         if `f8wtot' > 0 & `f8wtot' < .   matrix `f8m'[`f8i',6] = `f8m'[`f
> 8i',6]/`f8wtot'
2022.         if `f8witot' > 0 & `f8witot' < . matrix `f8m'[`f8i',7] = `f8m'[`f
> 8i',7]/`f8witot'
2023.       }
2024.       matrix rownames `f8m' = `f8rn'
2025.       matrix colnames `f8m' = ncohorts nunits nclusters nobs sumw_att wsh
> are_att wshare_att_it relyr
2026.       local f8mat_main `f8m'
2027.       local f8keys `f8keys' main
2028.       * reference-pool and whole-treated-sample coverage scalars (the rep
> orted window need not
.       * exhaust the treated sample; under esfixedbaseperiod no reference stat
> s exist elsewhere)
.       tempvar f8refc f8refu
2029.       qui count if `esamp' == 1 & `_t' == 0 & `ttre' != .
2030.       local f8refN = r(N)
2031.       qui gegen byte `f8refc' = tag(`ttre') if `esamp' == 1 & `_t' == 0 &
>  `ttre' != .
2032.       qui gegen byte `f8refu' = tag(`i')    if `esamp' == 1 & `_t' == 0 &
>  `ttre' != .
2033.       qui count if `f8refc' == 1
2034.       local f8refncoh = r(N)
2035.       qui count if `f8refu' == 1
2036.       local f8refnunits = r(N)
2037.       qui drop `f8refc' `f8refu'
2038.       qui sum `f8wa' if `esamp' == 1 & `_t' == 0 & `ttre' != ., meanonly
2039.       local f8refW = cond(r(N) > 0, r(sum), 0)
2040.       qui count if `esamp' == 1 & `ttre' != .
2041.       local f8trtN = r(N)
2042.       qui sum `f8wa' if `esamp' == 1 & `ttre' != ., meanonly
2043.       local f8trtW = cond(r(N) > 0, r(sum), 0)
2044.     }
2045.     cap matrix drop `f8raw'
2046. 
.     * ---- subgroup scopes: one extra pass keyed on (_t, sg) covers every sub
> group at once ----
.     if "`subgroups'" != "" & "`suppresssgprimaryeffects'" == "" {
2047.       tempvar f8sin f8stagc f8stagi f8stagcl f8stagt f8snc f8snu f8sncl f
> 8sn f8sw f8swi
2048.       qui gen byte `f8sin' = (`esamp' == 1 & `targetflag' == 1 & `_t' >= 
> `horizonstarter' & `_t' <= `horizonend' & `subgroups' < .)
2049.       qui gegen byte   `f8stagc'  = tag(`_t' `subgroups' `ttre') if `f8si
> n'
2050.       qui gegen byte   `f8stagi'  = tag(`_t' `subgroups' `_i')   if `f8si
> n'
2051.       qui gegen byte   `f8stagt'  = tag(`_t' `subgroups')        if `f8si
> n'
2052.       qui gegen long   `f8snc'    = total(`f8stagc') if `f8sin', by(`_t' 
> `subgroups')
2053.       qui gegen long   `f8snu'    = total(`f8stagi') if `f8sin', by(`_t' 
> `subgroups')
2054.       if "`f8cluster'" != "" {
2055.         qui gegen byte `f8stagcl' = tag(`_t' `subgroups' `f8cluster') if 
> `f8sin'
2056.         qui gegen long `f8sncl'   = total(`f8stagcl') if `f8sin', by(`_t'
>  `subgroups')
2057.       }
2058.       else {
2059.         qui gen byte `f8stagcl' = .
2060.         qui gen double `f8sncl' = .
2061.       }
2062.       qui gegen long   `f8sn'     = count(1)        if `f8sin', by(`_t' `
> subgroups')
2063.       qui gegen double `f8sw'     = total(`f8wa')   if `f8sin', by(`_t' `
> subgroups')
2064.       qui gegen double `f8swi'    = total(`f8wit')  if `f8sin', by(`_t' `
> subgroups')
2065.       tempname f8sraw
2066.       cap mkmat `_t' `subgroups' `f8snc' `f8snu' `f8sncl' `f8sn' `f8sw' `
> f8swi' if `f8stagt' == 1, matrix(`f8sraw')
2067.       local f8srawrc = _rc
2068.       cap drop `f8sin' `f8stagc' `f8stagi' `f8stagcl' `f8stagt' `f8snc' `
> f8snu' `f8sncl' `f8sn' `f8sw' `f8swi'
2069.       if `f8srawrc' == 0 {
2070.         foreach sgcase in `sglist' {
2071.           cap confirm matrix `relyrcolumn_s`sgcase''
2072.           if _rc == 0 {
2073.             tempname f8sm
2074.             local f8snr = rowsof(`relyrcolumn_s`sgcase'')
2075.             matrix `f8sm' = J(`f8snr', 8, 0)
2076.             local f8swtot = 0
2077.             local f8switot = 0
2078.             local f8srn
2079.             forval f8i = 1/`f8snr' {
2080.               local f8rv = `relyrcolumn_s`sgcase''[`f8i',1]
2081.               local f8h  = `f8rv' + `min_t' + 1
2082.               if `f8rv' < 0 local f8srn `f8srn' pre`=abs(`f8rv')'
2083.               else if `f8rv' == 0 & `oldsyntax' == 1 local f8srn `f8srn' 
> contemp
2084.               else local f8srn `f8srn' post`f8rv'
2085.               matrix `f8sm'[`f8i',8] = `f8rv'
2086.               forval f8r = 1/`=rowsof(`f8sraw')' {
2087.                 if `f8sraw'[`f8r',1] == `f8h' & `f8sraw'[`f8r',2] == `sgc
> ase' {
2088.                   matrix `f8sm'[`f8i',1] = `f8sraw'[`f8r',3]
2089.                   matrix `f8sm'[`f8i',2] = `f8sraw'[`f8r',4]
2090.                   matrix `f8sm'[`f8i',3] = `f8sraw'[`f8r',5]
2091.                   matrix `f8sm'[`f8i',4] = `f8sraw'[`f8r',6]
2092.                   matrix `f8sm'[`f8i',5] = `f8sraw'[`f8r',7]
2093.                   matrix `f8sm'[`f8i',6] = `f8sraw'[`f8r',7]
2094.                   matrix `f8sm'[`f8i',7] = `f8sraw'[`f8r',8]
2095.                   local f8swtot = `f8swtot' + `f8sraw'[`f8r',7]
2096.                   local f8switot = `f8switot' + `f8sraw'[`f8r',8]
2097.                 }
2098.               }
2099.             }
2100.             forval f8i = 1/`f8snr' {
2101.               if `f8swtot' > 0 & `f8swtot' < .   matrix `f8sm'[`f8i',6] =
>  `f8sm'[`f8i',6]/`f8swtot'
