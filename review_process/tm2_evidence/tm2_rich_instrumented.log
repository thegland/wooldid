. 
. *** F3: mata worker for the gteffects extraction (name parse + table assembly
> ; kept out
. *** of wooldid_worker to conserve compiled-size headroom). the cap mata drop 
> makes the
. *** file safely re-loadable within a session (two-build harnesses, dev reload
> s)
. cap mata: mata drop wooldid_gtx()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void wooldid_gtx(string scalar gtiv, string scalar gttv, string scalar gttf,
>                  string scalar rawname, string scalar sedname, real scalar gt
> mint,
>                  real scalar gthstart, real scalar gthend, string scalar gtdf
> r,
>                  string scalar outname)
> {
>     real matrix cells, raw, out
>     real matrix b, sed
>     string matrix names
>     string scalar pat
>     real scalar j, r, q, df, g, tt, est, v, se, z, p, lb, ub, crit, n
>     names = st_matrixcolstripe("e(b)")[., 2]
>     b = st_matrix("e(b)")
>     sed = st_matrix(sedname)
>     raw = st_matrix(rawname)
>     pat = "^([0-9]+)\." + gtiv + "#([0-9]+)\." + gttv + "#1\." + gttf + "$"
>     cells = J(0, 3, .)
>     for (j = 1; j <= rows(names); j++) {
>         if (regexm(names[j], pat)) cells = cells \ (strtoreal(regexs(1)), str
> toreal(regexs(2)), j)
>     }
>     n = rows(cells)
>     st_local("gtn", strofreal(n))
>     if (n == 0) return
>     df = strtoreal(gtdfr)
>     out = J(n, 15, .)
>     for (r = 1; r <= n; r++) {
>         g = cells[r, 1]
>         tt = cells[r, 2]
>         j = cells[r, 3]
>         est = b[1, j]
>         v = sed[1, j]
>         se = (v < . & v > 0) ? sqrt(v) : .
>         p = lb = ub = .
>         if (se < .) {
>             z = est / se
>             if (df < .) {
>                 p = 2 * ttail(df, abs(z))
>                 crit = invttail(df, .025)
>             }
>             else {
>                 p = 2 * normal(-abs(z))
>                 crit = invnormal(.975)
>             }
>             lb = est - crit * se
>             ub = est + crit * se
>         }
>         out[r, 1] = g
>         out[r, 4] = tt - gtmint - 1
>         out[r, 5] = est
>         out[r, 6] = se
>         out[r, 7] = p
>         out[r, 8] = lb
>         out[r, 9] = ub
>         out[r, 10] = (tt >= gthstart & tt <= gthend)
>         for (q = 1; q <= rows(raw); q++) {
>             if (raw[q, 1] == g & raw[q, 2] == tt) {
>                 out[r, 2] = raw[q, 3]
>                 out[r, 3] = raw[q, 4]
>                 out[r, 11] = raw[q, 5]
>                 out[r, 12] = raw[q, 6]
>                 out[r, 13] = raw[q, 7]
>                 out[r, 14] = raw[q, 8]
>                 out[r, 15] = raw[q, 9]
>                 break
>             }
>         }
>     }
>     out = sort(out, (1, 4))
>     st_matrix(outname, out)
>     st_matrixcolstripe(outname, (J(15, 1, ""), ("i", "onset", "caltime", "rel
> yr", "estimate", "se", "p", "lb_95ci", "ub_95ci", "inwindow", "nobs", "w_att"
> , "w_att_it", "w_att_i", "w_att_itime")'))
> }

: end
-------------------------------------------------------------------------------

. 
. 
. *** F6: assignment generation for permutation inference. fills <assignname> (
> C x R,
. *** frame row order) and c_locals: wdp_R, wdp_npd/wdp_nps (possible-assignmen
> t count,
. *** double and string), wdp_caut0/1/2 (cautions), wdp_err (fatal message, cal
> ler raises)
. cap mata: mata drop wooldid_permx()

. cap mata: mata drop wooldid_permx_enum()

. cap mata: mata drop wooldid_permx_msp()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void wooldid_permx(string scalar fr, string scalar onsv, string scalar strv,
>                    real scalar reps, real scalar exact, string scalar assignn
> ame,
>                    string scalar pname, string scalar lname)
> {
>     real matrix A
>     real colvector ons, str, idx, levels, v
>     real scalar C, si, lnM, M, R, r, k, capexact, capwarn
>     string scalar nps
>     st_local("wdp_err", "")
>     st_local("wdp_caut1", "")
>     st_local("wdp_caut2", "")
>     string scalar curfr
>     curfr = st_framecurrent()
>     st_framecurrent(fr)
>     ons = st_data(., onsv)
>     str = st_data(., strv)
>     st_framecurrent(curfr)
>     C = rows(ons)
>     st_local("wdp_caut0", "")
>     if (pname != "" & rows(st_matrix(pname)) > 0) {
>         wooldid_permxp(ons, st_matrix(pname), st_matrix(lname), reps, assignn
> ame)
>         return
>     }
>     // possible-assignment count: product over strata of multiset-permutation
>  counts
>     lnM = 0
>     for (si = 1; si <= rows(uniqrows(str)); si++) {
>         v = select(ons, str :== uniqrows(str)[si])
>         lnM = lnM + lnfactorial(rows(v))
>         levels = uniqrows(v)
>         for (k = 1; k <= rows(levels); k++) {
>             lnM = lnM - lnfactorial(sum(v :== levels[k] :| (v :>= . :& levels
> [k] :>= .)))
>         }
>     }
>     M = (lnM < 700 ? round(exp(lnM)) : .)
>     if (lnM < 34) nps = strofreal(round(exp(lnM)), "%20.0f")
>     else nps = strofreal(exp(lnM - floor(lnM/ln(10))*ln(10)), "%9.4f") + "e+"
>  + strofreal(floor(lnM/ln(10)), "%3.0f")
>     st_local("wdp_npd", strofreal(M, "%20.0f"))
>     st_local("wdp_nps", strtrim(nps))
>     capexact = 10000
>     capwarn = 1000
>     if (exact) {
>         if (M >= . | M > capexact) {
>             st_local("wdp_err", "Error: permexact requires enumerating every 
> assignment, but there are " + strtrim(nps) + " (ceiling: " + strofreal(capexa
> ct) + "). Use permreps().")
>             return
>         }
>         if (M > capwarn) st_local("wdp_caut1", "permexact is enumerating " + 
> strtrim(nps) + " assignments (over " + strofreal(capwarn) + "); this may be s
> low.")
>         R = M
>     }
>     else {
>         R = reps
>         if (M < . & reps > 0.1*M) st_local("wdp_caut2", "permreps(" + strofre
> al(reps) + ") exceeds 10% of the " + strtrim(nps) + " possible assignments; c
> onsider permexact.")
>     }
>     st_local("wdp_R", strofreal(R))
>     A = J(C, R, .)
>     if (exact) {
>         // enumerate per-stratum multiset permutations, then take the cartesi
> an product
>         A = wooldid_permx_enum(ons, str)
>     }
>     else {
>         for (r = 1; r <= R; r++) {
>             v = ons
>             for (si = 1; si <= rows(uniqrows(str)); si++) {
>                 idx = selectindex(str :== uniqrows(str)[si])
>                 v[idx] = jumble(ons[idx])
>             }
>             A[., r] = v
>         }
>     }
>     st_matrix(assignname, A)
> }

: 
: real matrix wooldid_permx_enum(real colvector ons, real colvector str)
> {
>     real matrix A, B, S1
>     real colvector idx
>     real scalar si, n1, n2, a, b
>     // per-stratum enumerations, combined by cartesian product
>     A = J(rows(ons), 0, .)
>     for (si = 1; si <= rows(uniqrows(str)); si++) {
>         idx = selectindex(str :== uniqrows(str)[si])
>         S1 = wooldid_permx_msp(sort(ons[idx], 1))
>         if (cols(A) == 0) {
>             A = J(rows(ons), cols(S1), .)
>             for (b = 1; b <= cols(S1); b++) A[idx, b] = S1[., b]
>         }
>         else {
>             n1 = cols(A)
>             n2 = cols(S1)
>             B = J(rows(ons), n1*n2, .)
>             for (a = 1; a <= n1; a++) {
>                 for (b = 1; b <= n2; b++) {
>                     B[., (a-1)*n2 + b] = A[., a]
>                     B[idx, (a-1)*n2 + b] = S1[., b]
>                 }
>             }
>             A = B
>         }
>     }
>     return(A)
> }

: 
: real matrix wooldid_permx_msp(real colvector v)
> {
>     real matrix R, S
>     real colvector rest, lv
>     real scalar k, j
>     // all distinct permutations of multiset v (v sorted), columns = permutat
> ions
>     if (rows(v) == 1) return(v)
>     lv = uniqrows(v)
>     R = J(rows(v), 0, .)
>     for (k = 1; k <= rows(lv); k++) {
>         j = selectindex(v :== lv[k] :| (v :>= . :& lv[k] :>= .))[1]
>         if (j == rows(v)) rest = v[|1 \ j-1|]
>         else if (j == 1) rest = v[|2 \ .|]
>         else rest = v[|1 \ j-1|] \ v[|j+1 \ .|]
>         S = wooldid_permx_msp(rest)
>         R = R, (J(1, cols(S), lv[k]) \ S)
>     }
>     return(R)
> }

: end
-------------------------------------------------------------------------------

. 
. 
. *** F6: probabilities-method draws (design distribution): per-cluster categor
> ical
. *** draws from user-specified probabilities; count = product of support sizes
. cap mata: mata drop wooldid_permxp()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void wooldid_permxp(real colvector ons, real matrix P, real rowvector lvl,
>                     real scalar reps, string scalar assignname)
> {
>     real matrix A
>     real colvector cum
>     real scalar C, K, c, r, k, u, lnS, zp, obsk
>     string scalar nps
>     C = rows(ons)
>     K = cols(lvl)
>     lnS = 0
>     zp = 0
>     for (c = 1; c <= C; c++) {
>         lnS = lnS + ln(sum(P[c, .] :> 0))
>         obsk = 0
>         for (k = 1; k <= K; k++) {
>             if (ons[c] == lvl[k]) obsk = k
>         }
>         if (obsk == 0 | (obsk > 0 ? P[c, obsk] <= 0 : 0)) zp = 1
>     }
>     if (lnS < 34) nps = strofreal(round(exp(lnS)), "%20.0f")
>     else nps = strofreal(exp(lnS - floor(lnS/ln(10))*ln(10)), "%9.4f") + "e+"
>  + strofreal(floor(lnS/ln(10)), "%3.0f")
>     st_local("wdp_npd", strofreal((lnS < 700 ? round(exp(lnS)) : .), "%20.0f"
> ))
>     st_local("wdp_nps", strtrim(nps))
>     st_local("wdp_R", strofreal(reps))
>     if (exp(lnS) < . & reps > 0.1*exp(lnS)) st_local("wdp_caut2", "permreps("
>  + strofreal(reps) + ") exceeds 10% of the " + strtrim(nps) + " possible assi
> gnments in the design's support.")
>     if (zp) st_local("wdp_caut0", "the OBSERVED assignment has zero probabili
> ty under the specified design, so the reported p-value is a tail probability 
> under that design distribution, not a randomization test that includes the ob
> served assignment.")
>     A = J(C, reps, .)
>     for (r = 1; r <= reps; r++) {
>         for (c = 1; c <= C; c++) {
>             cum = runningsum(P[c, .])'
>             u = runiform(1, 1)
>             for (k = 1; k <= K; k++) {
>                 if (u <= cum[k] + 1e-12) {
>                     A[c, r] = lvl[k]
>                     k = K + 1
>                 }
>             }
>         }
>     }
>     st_matrix(assignname, A)
> }

: end
-------------------------------------------------------------------------------

. 
. *** F6: the shared permprobs() parser: validates the grammar against the data
> 's onset
. *** levels and cluster values; in engine mode (pname != "") also emits the pr
> obability
. *** matrix with rows in ascending cluster order and the level vector in user 
> order.
. *** on any violation, sets the local permperr (caller raises r(198))
. cap mata: mata drop wooldid_permp()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void wooldid_permp(string scalar spec, string scalar onsname, string scalar l
> vlstr,
>                    string scalar clusstr, string scalar pname, string scalar 
> lname)
> {
>     string vector grp, groups
>     string scalar cur
>     string rowvector tok, dlv, dcl
>     real rowvector lvl, seen, dl, dc
>     real matrix P
>     real colvector cval, ord
>     real scalar G, g, K, C, c, k, j, ssum, v, ing, hit
>     st_local("permperr", "")
>     grp = tokens(subinstr(subinstr(spec, "(", " __GRP__ ", .), ")", " __END__
>  ", .))
>     // regroup
>     groups = J(0, 1, "")
>     cur = ""
>     ing = 0
>     for (g = 1; g <= cols(grp); g++) {
>         if (grp[g] == "__GRP__") {
>             if (ing) {
>                 st_local("permperr", "Error: permprobs() has a '(' inside a g
> roup; check the parentheses.")
>                 return
>             }
>             ing = 1
>             cur = ""
>         }
>         else if (grp[g] == "__END__") {
>             if (!ing) {
>                 st_local("permperr", "Error: permprobs() has an unmatched ')'
> .")
>                 return
>             }
>             ing = 0
>             groups = groups \ cur
>         }
>         else if (ing) cur = cur + " " + grp[g]
>         else {
>             st_local("permperr", "Error: permprobs() has text outside parenth
> esized groups: " + grp[g])
>             return
>         }
>     }
>     if (ing) {
>         st_local("permperr", "Error: permprobs() has an unmatched '('.")
>         return
>     }
>     G = rows(groups)
>     if (G < 2) {
>         st_local("permperr", "Error: permprobs() needs the onset-level group 
> plus one group per cluster.")
>         return
>     }
>     // group 1: onset varname + level order
>     tok = tokens(groups[1])
>     if (cols(tok) < 3) {
>         st_local("permperr", "Error: permprobs() first group must be (onsetva
> r level level ...).")
>         return
>     }
>     if (tok[1] != onsname) {
>         st_local("permperr", "Error: permprobs() first group names '" + tok[1
> ] + "' but the timing variable is '" + onsname + "'.")
>         return
>     }
>     K = cols(tok) - 1
>     lvl = J(1, K, .)
>     for (k = 1; k <= K; k++) {
>         // NFPERM-05: strict token rule. only the literal "." names the never
> -treated
>         // level; any other token must parse to a nonmissing number. previous
> ly a garbage
>         // token strtoreal'd to missing, silently aliasing the never-treated 
> level, and a
>         // duplicate listed level passed the one-way membership check - eithe
> r way a
>         // realized onset level silently vanished from the randomization desi
> gn (rc 0)
>         if (tok[k+1] == ".") lvl[k] = .
>         else {
>             lvl[k] = strtoreal(tok[k+1])
>             if (lvl[k] >= .) {
>                 st_local("permperr", "Error: permprobs() onset level token '"
>  + tok[k+1] + "' is not a number or the never-treated marker '.'.")
>                 return
>             }
>         }
>         // duplicate rejection (mata missing == missing is true, so this also
>  catches a
>         // second '.'); together with the count and exactly-once membership c
> hecks below
>         // this makes listed-vs-realized levels a bijection
>         for (j = 1; j < k; j++) {
>             if (lvl[j] == lvl[k]) {
>                 st_local("permperr", "Error: permprobs() lists onset level '"
>  + tok[k+1] + "' more than once.")
>                 return
>             }
>         }
>     }
>     // level set must equal the data's level set
>     dlv = tokens(lvlstr)
>     if (cols(dlv) != K) {
>         st_local("permperr", "Error: permprobs() lists " + strofreal(K) + " o
> nset levels but the data (within sample) has " + strofreal(cols(dlv)) + ".")
>         return
>     }
>     dl = strtoreal(dlv)
>     for (k = 1; k <= K; k++) {
>         if (sum(dl :== lvl[k]) != 1) {
>             st_local("permperr", "Error: permprobs() onset level '" + tok[k+1
> ] + "' does not match the data's onset levels (" + lvlstr + ").")
>             return
>         }
>     }
>     // cluster groups
>     C = G - 1
>     dcl = tokens(clusstr)
>     if (cols(dcl) != C) {
>         st_local("permperr", "Error: permprobs() has " + strofreal(C) + " clu
> ster group(s) but the data (within sample) has " + strofreal(cols(dcl)) + " c
> luster value(s).")
>         return
>     }
>     cval = J(C, 1, .)
>     P = J(C, K, .)
>     for (g = 2; g <= G; g++) {
>         tok = tokens(groups[g])
>         if (cols(tok) != K + 1) {
>             st_local("permperr", "Error: permprobs() cluster group (" + group
> s[g] + " ) must have the cluster value plus exactly " + strofreal(K) + " prob
> abilities.")
>             return
>         }
>         cval[g-1] = strtoreal(tok[1])
>         ssum = 0
>         for (k = 1; k <= K; k++) {
>             v = strtoreal(tok[k+1])
>             if (v >= . | v < 0) {
>                 st_local("permperr", "Error: permprobs() has an invalid proba
> bility in group (" + groups[g] + " ).")
>                 return
>             }
>             P[g-1, k] = v
>             ssum = ssum + v
>         }
>         if (abs(ssum - 1) > 1e-6) {
>             st_local("permperr", "Error: permprobs() probabilities for cluste
> r value " + tok[1] + " sum to " + strofreal(ssum) + ", not 1.")
>             return
>         }
>         // NFPERM-06: normalize the row so its cumulative sum ends exactly at
>  1 (within
>         // ~K*eps, absorbed by the draw loop's +1e-12 cushion). rows accepted
>  a hair
>         // under 1 by the tolerance formerly left a deficit tail where a unif
> orm draw
>         // matched no probability column, leaving the assignment cell missing
>  - which
>         // downstream is wooldid's never-treated code (silent). division by a
>  positive
>         // ssum preserves zero/positive sign patterns, so the observed-suppor
> t check and
>         // support counts are unaffected; exact-sum rows are bitwise unchange
> d (ssum==1)
>         if (ssum != 1) P[g-1, .] = P[g-1, .] :/ ssum
>     }
>     // cluster set must equal the data's, no duplicates
>     dc = strtoreal(dcl)
>     seen = J(1, C, 0)
>     for (c = 1; c <= C; c++) {
>         hit = 0
>         for (k = 1; k <= C; k++) {
>             if (dc[k] == cval[c]) {
>                 if (seen[k]) {
>                     st_local("permperr", "Error: permprobs() lists cluster va
> lue " + strofreal(cval[c]) + " more than once.")
>                     return
>                 }
>                 seen[k] = 1
>                 hit = 1
>             }
>         }
>         if (!hit) {
>             st_local("permperr", "Error: permprobs() cluster value " + strofr
> eal(cval[c]) + " is not a value of the cluster variable (within sample).")
>             return
>         }
>     }
>     if (pname != "") {
>         // rows in ascending cluster order = the engine's map-frame order
>         ord = order(cval, 1)
>         st_matrix(pname, P[ord, .])
>         st_matrix(lname, lvl)
>     }
> }

: end
-------------------------------------------------------------------------------

. 
. 
. *** NFADV-01/02: the adversarial p-value statistics, called by wooldid_advsta
> t (kept
. *** out of wooldid_worker to conserve compiled-size headroom; the cap mata dr
> op makes
. *** the file safely re-loadable within a session). Inputs are the F2 event-st
> udy
. *** capture (b 1xk, V kxk) and the aligned relative-time column vector; plant
> ed
. *** reference rows carry b = 0 with zero variance. Sets st_local advpstat = "
> ok" and
. *** the scalar `pn' on success, advpstat = "degen" otherwise (never errors).
. ***
. *** alt == 0, primary (NFADV-01): minimum-distance test of the composite null
>  that
. *** all horizon effects lie on SOME line, E[b] = X gamma with X = [1, relyr] 
> and
. *** gamma unknown. gamma is estimated by GLS under a generalized inverse of V
> ; the
. *** minimized distance W = min_g (b - Xg)' V^+ (b - Xg) is computed in the wh
> itened
. *** eigenspace of V (z = L^-1/2 U' b, M = L^-1/2 U' X, W = ||z - M ghat||^2),
>  which
. *** is exactly chi-squared with q = rank(V) - rank(M) degrees of freedom unde
> r the
. *** null. The planted zero-variance reference rows receive zero weight under 
> V^+ and
. *** so are mathematically inert here (they are constants equal to their expec
> tation);
. *** omitting them from the computation is identical to including them.
. ***
. *** alt == 1, altmethod (NFADV-02): the forecast test. P = the altmethod fit 
> set
. *** (real relyr <= -1 plus the planted reference row(s)), Q = the real post h
> orizons.
. *** A = Z_Q (Z_P' Z_P)^-1 Z_P' is the unweighted-OLS forecast operator (the s
> ame fit
. *** as the display line's pre-period cut), d = b_Q - A b_P, and the test cova
> riance
. *** propagates the fitted line's uncertainty and the pre/post covariance:
. *** S = V_QQ + A V_PP A' - A V_PQ - V_QP A'; W = d' S^+ d, q = rank(S). The S
> ^+,
. *** rank, and the residual-in-column-space check share one eigensystem and on
> e
. *** scale-aware tolerance (a residual component outside col(S) is a degenerac
> y, not
. *** a testable direction).
. ***
. *** Both statistics use Ftail(q, dfr, W/q) when dfr is a valid residual df an
> d
. *** chi2tail(q, W) otherwise (the wooldid_ptp convention).
. cap mata: mata drop wooldid_advx()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void wooldid_advx(string scalar bn, string scalar vn, string scalar rn,
>                   real scalar esrel, real scalar tt, real scalar alt,
>                   real scalar dfr, string scalar pn)
> {
>     real colvector b, rel, z, g, r, sel, idxP, idxQ, bP, relP, d, c, resid
>     real matrix V, X, U, T, M, ZP, ZQ, ZZi, Aop, VPP, VPQ, VQQ, S, US
>     real rowvector lam, sv, lamS
>     real scalar k1, np, npr, nq, scale, tol, rankM, q, W, p
>     st_local("advpstat", "degen")
>     b = st_matrix(bn)'
>     V = st_matrix(vn)
>     rel = st_matrix(rn)
>     if (hasmissing(V) | hasmissing(b) | hasmissing(rel)) return
>     if (alt == 0) {
>         X = J(rows(rel), 1, 1), rel
>         V = (V + V')/2
>         U = .
>         lam = .
>         symeigensystem(V, U, lam)
>         scale = max(abs(lam))
>         if (scale <= 0 | scale >= .) return
>         tol = scale*1e-12
>         sel = selectindex(lam' :> tol)
>         k1 = rows(sel)
>         if (k1 == 0) return
>         T = diag(1:/sqrt(lam[sel]')) * U[., sel]'
>         z = T*b
>         M = T*X
>         sv = svdsv(M)
>         rankM = sum(sv :> max(sv)*1e-12)
>         q = k1 - rankM
>         if (q <= 0) return
>         g = svsolve(M, z)
>         r = z - M*g
>         W = r'r
>     }
>     else {
>         idxP = selectindex(rel :<= -1)
>         idxQ = selectindex(rel :>= 0)
>         npr = rows(idxP)
>         nq = rows(idxQ)
>         if (npr == 0 | nq == 0) return
>         bP = b[idxP] \ 0
>         relP = rel[idxP] \ esrel
>         if (tt) {
>             bP = bP \ 0
>             relP = relP \ (esrel - 1)
>         }
>         np = rows(relP)
>         ZP = J(np, 1, 1), relP
>         ZQ = J(nq, 1, 1), rel[idxQ]
>         ZZi = invsym(ZP'ZP)
>         if (ZZi[1,1] == 0 | ZZi[2,2] == 0) return
>         Aop = ZQ*ZZi*ZP'
>         VPP = J(np, np, 0)
>         VPP[|1,1 \ npr,npr|] = V[idxP, idxP]
>         VPQ = J(np, nq, 0)
>         VPQ[|1,1 \ npr,nq|] = V[idxP, idxQ]
>         VQQ = V[idxQ, idxQ]
>         d = b[idxQ] - Aop*bP
>         S = VQQ + Aop*VPP*Aop' - Aop*VPQ - VPQ'*Aop'
>         S = (S + S')/2
>         US = .
>         lamS = .
>         symeigensystem(S, US, lamS)
>         scale = max(abs(lamS))
>         if (scale <= 0 | scale >= .) return
>         tol = scale*1e-12
>         sel = selectindex(lamS' :> tol)
>         q = rows(sel)
>         if (q == 0) return
>         c = US[., sel]'d
>         resid = d - US[., sel]*c
>         if (norm(resid) > 1e-8*max((norm(d), sqrt(scale)))) return
>         W = sum(c:^2 :/ lamS[sel]')
>     }
>     if (W >= .) return
>     if (dfr < .) p = Ftail(q, dfr, W/q)
>     else p = chi2tail(q, W)
>     if (p >= .) return
>     st_numscalar(pn, p)
>     st_local("advpstat", "ok")
> }

: end
-------------------------------------------------------------------------------

