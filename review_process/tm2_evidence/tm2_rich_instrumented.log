 63.       qui set obs `newN'
 64.                         qui replace relyr = `esrelativeto' if _n == _N
 65.                         if "`timetrends'" == "timetrends" qui replace rely
> r = `esrelativeto' - 1 if _n == _N - 1
 66.       qui replace lb_95ci = 0 if _n == _N
 67.       qui replace ub_95ci = 0 if _n == _N
 68.       qui replace estimate = 0 if _n == _N
 69.                         qui replace rownamesvar = "reference" if _n == _N
 70.                         if "`timetrends'" == "timetrends" qui replace lb_9
> 5ci = 0 if _n == _N -1
 71.                         if "`timetrends'" == "timetrends" qui replace ub_9
> 5ci = 0 if _n == _N -1
 72.                         if "`timetrends'" == "timetrends" qui replace esti
> mate = 0 if _n == _N -1
 73.                         if "`timetrends'" == "timetrends" qui replace rown
> amesvar = "reference" if _n == _N - 1
 74.                         if `esrelativeto' < `min' local min `esrelativeto'
 75.                         if "`timetrends'" == "timetrends" if `esrelativeto
> ' -1  < `min' local min = `esrelativeto' - 1
 76.       local xlabelstarter xlabel(
 77.         forval xlabeltick = `min'(1)`max' {
 78.           local asterisk
 79.                                         if `xlabeltick' == `esrelativeto' 
> local asterisk *
 80.                                         if "`timetrends'" == "timetrends" 
> & `xlabeltick' == `esrelativeto' -1 local asterisk *
 81.           local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'`a
> sterisk'"
 82.         }
 83.         local xlabelstarter `xlabelstarter' )
 84.     }
 85.     sort  relyr
 86. 
. 
.     local xlineinserter
 87.     qui   gstats sum relyr, meanonly
 88.     if r(min) < 0 local xlineinserter xline(-0.5,   lpattern(dash) lcolor(
> black))
 89. 
.     * inject elasticity info
.     local elasinj Effects
 90.     if "`semielasticity'" == "eydx" local elasinj "Semi-elasticities"
 91.     local elasinj2 Effects
 92.     if "`contreatelasticitytype'" == "eyex" local elasinj2 Elasticities
 93.     if "`contreatelasticitytype'" == "eydx" local elasinj2 Semi-elasticiti
> es (eydx)
 94.     if "`contreatelasticitytype'" == "dyex" local elasinj2 Semi-elasticiti
> es (dyex)
 95. 
.     * generate and save the actual graphs; then save the data
.     foreach graph in `graphtypes' {
 96.       local graphtext = subinstr("`graph'","ES_","",.)
 97.       local att_it_text ATT_it `elasinj'
 98.       local att_text ATT `elasinj'
 99.       local ame_it_text AME_it `elasinj2'
100.       local ame_text AME `elasinj2'
101.       twoway (connected estimate relyr, color(navy)) (rarea lb_95ci ub_95c
> i relyr,color(navy%50)) if (rownamesvar =="reference" | rownamesvar=="`graph'
> ")  , `xlineinserter' xtitle("Time Relative to Time of Initial Treatment") yt
> itle("``graphtext'_text' on `y' by Horizon") legend(off)   name(`graphtext'_f
> ullmodel, replace) `xlabelstarter'
102.       if "`saveplots'" != "" qui graph save "`saveplots'_`graph'.gph", `re
> place'
103.     }
104. 
. 
.     if "`saveplots'" != "" qui save "`saveplots'_ES.dta", `replace'
105.     clear
106. 
.     * repeat by SG if appropriate
.     if "`subgroups'" != "" & "`suppresssgprimaryeffects'" == "" {
107.       foreach sgcase in `sglist' {
108.         tempname wdidsgmat
109.         matrix `wdidsgmat' = e(wdidsgresults_`sgcase')
110.         qui svmat double `wdidsgmat', names(col)
111.         qui gen rownamesvar = ""
112.         local names : roweq `wdidsgmat'
113.         forvalues i=1/`: word count `names'' {
114.           qui replace rownamesvar=`"`: word `i' of `names''"' in `i'
115.         }
116.         qui drop if relyr == .
117.         qui glevelsof(rownamesvar), clean local(graphtypes)
118.         qui gen postperiod =  relyr >= 0
119.         keep  rownamesvar postperiod relyr  estimate lb_95ci ub_95ci
120. 
.         * add the pre treatment observation
.         if "`esfixedbaseperiod'" == "" {
121.           local newN = _N + 1
122.           qui   gstats sum relyr, meanonly
123.           local max = r(max)
124.           local min = r(min)
125.           local initialflagt = r(min) - 1
126.           qui set obs `newN'
127.           qui replace relyr = `initialflagt' if _n == _N
128.           qui replace lb_95ci = 0 if _n == _N
129.           qui replace ub_95ci = 0 if _n == _N
130.           qui replace estimate = 0 if _n == _N
131.           qui replace rownamesvar = "reference" if _n == _N
132. 
.           local xlabelstarter xlabel(`initialflagt' "*"
133.             forval xlabeltick = `min'(1)`max' {
134.               local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltic
> k'"
135.             }
136.             local xlabelstarter `xlabelstarter' )
137.         }
138.         else{
139.           qui   gstats sum relyr, meanonly
140.           local max = r(max)
141.           local min = r(min)
142.           local newN = _N + 1
143.                                         if "`timetrends'" == "timetrends" 
> local ++newN
144.           qui set obs `newN'
145.           qui replace relyr = `esrelativeto' if _n == _N
146.                                         if "`timetrends'" == "timetrends" 
> qui replace relyr = `esrelativeto' - 1 if _n == _N - 1
147.                                         qui replace lb_95ci = 0 if _n == _
> N
148.           qui replace ub_95ci = 0 if _n == _N
149.           qui replace estimate = 0 if _n == _N
150.                                         qui replace rownamesvar = "referen
> ce" if _n == _N
151.                                         if "`timetrends'" == "timetrends" 
> qui replace lb_95ci = 0 if _n == _N -1
152.           if "`timetrends'" == "timetrends" qui replace ub_95ci = 0 if _n 
> == _N -1
153.           if "`timetrends'" == "timetrends" qui replace estimate = 0 if _n
>  == _N -1
154.                                         if "`timetrends'" == "timetrends" 
> qui replace rownamesvar = "reference" if _n == _N - 1
155. 
.           if `esrelativeto' < `min' local min `esrelativeto'
156.           if "`timetrends'" == "timetrends" if `esrelativeto' -1  < `min' 
> local min = `esrelativeto' - 1
157.           local xlabelstarter xlabel(
158.             forval xlabeltick = `min'(1)`max' {
159.               local asterisk
160.                                                         if `xlabeltick' ==
>  `esrelativeto' local asterisk *
161.                                                         if "`timetrends'" 
> == "timetrends" & `xlabeltick' == `esrelativeto' -1 local asterisk *
162.               local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltic
> k'`asterisk'"
163.             }
164.             local xlabelstarter `xlabelstarter' )
165.         }
166. 
.         sort relyr
167.         foreach graph in `graphtypes' {
168.           local graphtext = subinstr("`graph'","ES_","",.)
169.           local att_it_text ATT_it `elasinj'
170.           local att_text ATT `elasinj'
171.           local ame_it_text AME_it `elasinj2'
172.           local ame_text AME `elasinj2'
173.           twoway (connected estimate relyr, color(navy)) (rarea lb_95ci ub
> _95ci relyr,color(navy%50)) if (rownamesvar =="reference" | rownamesvar=="`gr
> aph'")  , `xlineinserter' xtitle("Time Relative to Time of Initial Treatment"
