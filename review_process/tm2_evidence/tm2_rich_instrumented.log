. * ===========================================================================
> =
. * F7 subprograms: Roth (2022) pre-trend power diagnostics.
. * Implemented as subprograms because wooldid_worker sits close to Stata's
. * per-program compiled-size ceiling (verified: sizable inline additions make
. * the ado fail to load with r(1000)).
. * ===========================================================================
> =
. 
. * parse-time validation for pretrendpower()
. cap prog drop wooldid_ptpcheck

. prog def wooldid_ptpcheck
  1. version 16.0
  2.   syntax , [levels(numlist) esf(string) impv(string) espre(string)]
  3.   if "`impv'" != "" {
  4.     dis as error "Error: pretrendpower() is not compatible with impvalues 
> (no event-study variance-covariance matrix exists under Ibragimov-Muller infe
> rence)."
  5.     error 198
  6.   }
  7.   if "`esf'" == "" {
  8.     dis as error "Error: pretrendpower() requires esfixedbaseperiod. Under
>  the pooled reference the comparison period is a cohort-specific pool of pre-
> periods, so the single omitted reference period that the Roth (2022) linear-t
> rend normalization requires is not defined."
  9.     dis as error "Specify esfixedbaseperiod (with esrelativeto() if you wa
> nt a reference other than -1)."
 10.     error 198
 11.   }
 12.   if `espre' <= 0 {
 13.     dis as error "Error: pretrendpower() requires esprelength() of at leas
> t 1; without pre-treatment event-study coefficients there is nothing to diagn
> ose."
 14.     error 198
 15.   }
 16.   foreach ptpl of local levels {
 17.     if `ptpl' > 0 & `ptpl' < 1 {
 18.       dis as error "Error: pretrendpower() takes power levels in percent (
> for example 80, not .8)."
 19.       error 198
 20.     }
 21.     if `ptpl' != int(`ptpl') | `ptpl' <= 5 | `ptpl' >= 100 {
 22.       dis as error "Error: pretrendpower() power levels must be integers s
> trictly between 5 and 100 (for example 50, 80, 90, 95)."
 23.       error 198
 24.     }
 25.   }
 26. end

. 
. * compute + display + ereturn the diagnostics. Runs AFTER the ereturn post, s
> o it may
. * only use r-class data commands and matrix algebra (an estimation command he
> re would
. * wipe the posted e()). All inputs arrive as passed tempvar names or e() obje
> cts.
. cap prog drop wooldid_ptp

. prog def wooldid_ptp, eclass
  1. version 16.0
  2.   syntax , levels(numlist) [esrel(string) dfr(string) pois(string) poisexp
> (string) tvar(string) ttrevar(string) ivar(string) wvar(string) cwm(string)]
  3. 
.   * duplicate power levels (e.g. pretrendpower(80 80)) would otherwise be pro
> cessed
.   * twice, yielding a duplicated row in e(roth_power_*) and in the displayed 
> table;
.   * keep the first occurrence of each level, preserving the order given
.   local levels : list uniq levels
  4. 
.   local ptpref = `esrel'
  5.   * degrees of freedom: use the regression's residual df when available (t
>  and F
.   * distributions, matching the critical values wooldid's own tables and join
> t tests
.   * use); fall back to normal / chi-squared otherwise (e.g. some poisson path
> s)
.   local ptpdfok 0
  6.   if "`dfr'" != "" & "`dfr'" != "." {
  7.     if real("`dfr'") > 0 & real("`dfr'") < . local ptpdfok 1
  8.   }
  9.   if `ptpdfok' local ptpcrit = invttail(`dfr', .025)
 10.   else local ptpcrit = invnormal(.975)
 11. 
.   * hbar: estimand-weighted mean post-treatment relative period over the FULL
>  post
.   * support of the estimation sample - the pooled estimands aggregate over al
> l post
.   * cells (subpop t >= onset), not only the reported event-study window, and 
> using the
.   * reported window instead understates the implied bias whenever espostlengt
> h is
.   * smaller than the largest post relative period
.   tempvar ptprely ptpwa ptppost ptpnum
 12.   qui gen double `ptprely' = `tvar' - `ttrevar'
 13.   qui gen double `ptpwa' = `wvar'
 14.   if "`cwm'" != "" qui replace `ptpwa' = `ptpwa' * `cwm'
 15.   qui gen byte `ptppost' = e(sample) & `ttrevar' != . & `ptprely' >= 0 & `
> ptprely' < .
 16.   qui gen double `ptpnum' = `ptpwa' * `ptprely' if `ptppost'
 17.   qui sum `ptpnum' if `ptppost', meanonly
 18.   local ptphnum = r(sum)
 19.   qui sum `ptpwa' if `ptppost', meanonly
 20.   local ptphbar_att = cond(r(sum) > 0 & r(sum) < ., `ptphnum'/r(sum), .)
 21.   * att_it-family hbar: weight divided by the (i,t) cell weight total, rep
> licating the
.   * weight-construction block (cell totals use the raw weight, without any cu
> stom
.   * weight multiplier - the documented asymmetry)
.   tempvar ptpwpit ptpwit ptpnum2
 22.   qui gegen double `ptpwpit' = total(cond(e(sample), `wvar', 0)), by(`ivar
> ' `tvar')
 23.   qui gen double `ptpwit' = `ptpwa'/`ptpwpit'
 24.   qui replace `ptpwit' = 0 if `ptpwit' == .
 25.   qui gen double `ptpnum2' = `ptpwit' * `ptprely' if `ptppost'
 26.   qui sum `ptpnum2' if `ptppost', meanonly
 27.   local ptphnum2 = r(sum)
 28.   qui sum `ptpwit' if `ptppost', meanonly
 29.   local ptphbar_it = cond(r(sum) > 0 & r(sum) < ., `ptphnum2'/r(sum), .)
 30.   cap drop `ptprely' `ptpwa' `ptppost' `ptpnum' `ptpwpit' `ptpwit' `ptpnum
> 2'
 31. 
.   local ptpheader 0
 32.   foreach ptpty in att att_it ame ame_it {
 33.     cap confirm matrix e(b_es_`ptpty')
 34.     if _rc != 0 continue
 35.     cap confirm matrix e(V_es_`ptpty')
 36.     if _rc != 0 continue
 37.     tempname ptpb ptpV
 38.     matrix `ptpb' = e(b_es_`ptpty')
 39.     matrix `ptpV' = e(V_es_`ptpty')
 40.     local ptplbl : colnames `ptpb'
 41.     * pre-period indices and the trend vector m = relyr - reference. m is 
> built from
.     * the actual labels: under esrelativeto(< -1) the pre relyrs straddle the
.     * reference, so m carries BOTH signs - no ordering or sign assumption is 
> safe
.     local ptpk 0
 42.     local ptppreidx
 43.     local ptpmvals
 44.     local ptpj 0
 45.     foreach ptpl of local ptplbl {
 46.       local ++ptpj
 47.       if substr("`ptpl'", 1, 3) == "pre" {
 48.         local ++ptpk
 49.         local ptppreidx `ptppreidx' `ptpj'
 50.         local ptpmvals `ptpmvals' `=-real(substr("`ptpl'", 4, .)) - `ptpre
> f''
 51.       }
 52.     }
 53.     if `ptpk' == 0 {
 54.       dis as text "Caution: pretrendpower() requested, but the `ptpty' eve
> nt study has no pre-treatment coefficients; diagnostics skipped for `ptpty'."
 55.       continue
 56.     }
 57.     tempname ptpS ptpbp ptpm
 58.     matrix `ptpS' = J(`ptpk', `ptpk', 0)
 59.     matrix `ptpbp' = J(`ptpk', 1, 0)
 60.     matrix `ptpm' = J(`ptpk', 1, 0)
 61.     local ptpr 0
 62.     foreach ptpi of local ptppreidx {
 63.       local ++ptpr
 64.       matrix `ptpbp'[`ptpr', 1] = `ptpb'[1, `ptpi']
 65.       local ptpmv : word `ptpr' of `ptpmvals'
 66.       matrix `ptpm'[`ptpr', 1] = `ptpmv'
 67.       local ptpc 0
 68.       foreach ptpi2 of local ptppreidx {
 69.         local ++ptpc
 70.         matrix `ptpS'[`ptpr', `ptpc'] = `ptpV'[`ptpi', `ptpi2']
 71.       }
 72.     }
 73.     * screens, in hazard order: a missing element would make invsym abort 
> the run; a
.     * non-positive diagonal (degeneracy sentinel, zero-variance row) would ot
> herwise be
.     * silently g-inversed into a plausible-looking wrong number
.     local ptpbad 0
 74.     forval ptpr = 1/`ptpk' {
 75.       if missing(`ptpbp'[`ptpr', 1]) local ptpbad 1
 76.       if missing(`ptpS'[`ptpr', `ptpr']) | `ptpS'[`ptpr', `ptpr'] <= 0 loc
> al ptpbad 1
 77.       forval ptpc = 1/`ptpk' {
 78.         if missing(`ptpS'[`ptpr', `ptpc']) local ptpbad 1
 79.       }
 80.     }
 81.     if `ptpbad' {
 82.       dis as text "Caution: the `ptpty' pre-period variance-covariance blo
> ck contains missing or non-positive variance entries; pretrendpower() diagnos
> tics skipped for `ptpty'."
 83.       continue
 84.     }
 85.     matrix `ptpS' = (`ptpS' + `ptpS'')/2
 86.     tempname ptpSi ptpwork
 87.     matrix `ptpSi' = invsym(`ptpS')
 88.     local ptpkeff = `ptpk' - diag0cnt(`ptpSi')
 89.     if `ptpkeff' <= 0 {
 90.       dis as text "Caution: the `ptpty' pre-period variance-covariance blo
> ck is not invertible; pretrendpower() diagnostics skipped for `ptpty'."
 91.       continue
 92.     }
 93.     if `ptpkeff' < `ptpk' dis as text "Caution: the `ptpty' pre-period var
> iance-covariance block is rank-deficient (rank `ptpkeff' of `ptpk'). The slop
> e, its CI, the joint test (now `ptpkeff' degrees of freedom), and the detecta
> ble-trend columns then reflect only the linearly independent subset of pre-pe
> riod coefficients a generalized inverse retains - NOT a summary of all pre-pe
> riod evidence - and can differ arbitrarily from statistics built on the disca
> rded coefficients; interpret with care."
 94.     matrix `ptpwork' = `ptpm''*`ptpSi'*`ptpm'
 95.     local ptpc2 = `ptpwork'[1, 1]
 96.     if missing(`ptpc2') | `ptpc2' <= 0 {
 97.       dis as text "Caution: the linear-trend information m'V^(-1)m for `pt
> pty' is not positive; pretrendpower() diagnostics skipped for `ptpty'."
 98.       continue
 99.     }
100.     matrix `ptpwork' = `ptpm''*`ptpSi'*`ptpbp'
101.     local ptpslope = `ptpwork'[1, 1]/`ptpc2'
102.     local ptpse = 1/sqrt(`ptpc2')
103.     local ptpll = `ptpslope' - `ptpcrit'*`ptpse'
104.     local ptpul = `ptpslope' + `ptpcrit'*`ptpse'
105.     matrix `ptpwork' = `ptpbp''*`ptpSi'*`ptpbp'
106.     local ptpW = `ptpwork'[1, 1]
107.     if `ptpdfok' local ptpprep = Ftail(`ptpkeff', `dfr', `ptpW'/`ptpkeff')
108.     else local ptpprep = chi2tail(`ptpkeff', `ptpW')
109.     local ptphbar `ptphbar_att'
110.     if "`ptpty'" == "att_it" | "`ptpty'" == "ame_it" local ptphbar `ptphba
> r_it'
111. 
.     * NIS setup: the pre-test Roth's pretrends package powers - reject when A
> NY pre
.     * coefficient is individually significant (using wooldid's own critical v
> alue)
.     * exact quadrature cost explodes with dimension (~2.9s per evaluation at 
> k=6, ~85
.     * evaluations per power level per type); cap the NIS column at k <= 4 and
>  point
.     * larger designs at the pretrends package, which consumes e(b_es_*)/e(V_e
> s_*)
.     local ptpnisok = (`ptpk' <= 4)
112.     local ptpnissize .
113.     if `ptpnisok' {
114.       tempname ptpsd ptpmrow
115.       matrix `ptpsd' = J(1, `ptpk', 0)
116.       forval ptpr = 1/`ptpk' {
117.         matrix `ptpsd'[1, `ptpr'] = sqrt(`ptpS'[`ptpr', `ptpr'])
118.       }
119.       matrix `ptpmrow' = `ptpm''
120.       cap mata: st_local("ptpnissize", strofreal(1 - mvnormalcvqp(-`ptpcri
> t'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), J(1, `ptpk', 0), vec
> h(st_matrix("`ptpS'"))', 1000), "%21.0g"))
121.       if _rc != 0 local ptpnisok 0
122.       else if missing(real("`ptpnissize'")) local ptpnisok 0
123.     }
124. 
.     local ptpnlev : word count `levels'
125.     tempname ptpmat
126.     matrix `ptpmat' = J(`ptpnlev', 5, .)
127.     local ptprn
128.     local ptplr 0
129.     foreach ptplev of local levels {
130.       local ++ptplr
131.       local ptprn `ptprn' p`ptplev'
132.       matrix `ptpmat'[`ptplr', 1] = `ptplev'
133.       * Wald-based minimum detectable trend: powers the joint pre-trend te
> st above,
.       * using the F distribution with the regression's residual df (a chi-squ
> ared
.       * shortcut is optimistic by ~25 percent at 10 clusters)
.       if `ptpdfok' local ptplam = npnF(`ptpkeff', `dfr', invF(`ptpkeff', `dfr
> ', .95), 1 - `ptplev'/100)
134.       else local ptplam = npnchi2(`ptpkeff', invchi2(`ptpkeff', .95), 1 - 
> `ptplev'/100)
135.       if !missing(`ptplam') {
136.         matrix `ptpmat'[`ptplr', 2] = sqrt(`ptplam'/`ptpc2')
137.         if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 4] = sqrt(`ptplam'
> /`ptpc2')*(`ptphbar' - `ptpref')
138.       }
139.       * NIS-based minimum detectable trend, by bisection on the exact reje
> ction
.       * probability (deterministic quadrature; self-checked against the targe
> t)
.       if `ptpnisok' {
140.         * NFPTP-04: a requested power level at or below the NIS test's nul
> l rejection
.         * rate (its size) is achieved by a zero trend - the mathematically ex
> act boundary
.         * answer. formerly these cells were left missing, indistinguishable f
> rom a
.         * numerical failure
.         if `ptplev'/100 <= real("`ptpnissize'") {
141.           matrix `ptpmat'[`ptplr', 3] = 0
142.           if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 5] = 0
143.         }
144.         if `ptplev'/100 > real("`ptpnissize'") {
145.           local ptpglo = 0
146.           local ptpghi = 8*`ptpse'
147.           local ptpiter 0
148.           local ptppw 0
149.           while `ptppw' < `ptplev'/100 & `ptpiter' < 60 {
150.             local ptpghi = 2*`ptpghi'
151.             cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`ptpc
> rit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpghi'*st_matrix
> ("`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
152.             if _rc != 0 local ptpiter 999
153.             else local ptppw = real("`ptppw2'")
154.             local ++ptpiter
155.           }
156.           if `ptpiter' < 999 {
157.             forval ptpbi = 1/80 {
158.               local ptpgmid = (`ptpglo' + `ptpghi')/2
159.               cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`pt
> pcrit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpgmid'*st_mat
> rix("`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
160.               if _rc == 0 {
161.                 if real("`ptppw2'") < `ptplev'/100 local ptpglo = `ptpgmid
> '
162.                 else local ptpghi = `ptpgmid'
163.               }
164.             }
165.             local ptpgn = (`ptpglo' + `ptpghi')/2
166.             cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`ptpc
> rit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpgn'*st_matrix(
> "`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
167.             if _rc == 0 {
168.               if abs(real("`ptppw2'") - `ptplev'/100) < 1e-4 {
169.                 matrix `ptpmat'[`ptplr', 3] = `ptpgn'
170.                 if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 5] = `ptpg
> n'*(`ptphbar' - `ptpref')
171.               }
172.             }
173.           }
174.         }
175.       }
176.     }
177.     matrix rownames `ptpmat' = `ptprn'
178.     matrix colnames `ptpmat' = power mdt_wald mdt_nis bias_wald bias_nis
