.   *Confirm correct weight usage if using poisson
.   if "`weight'" == "aweight" & "`poisson'" == "poisson" {
 29.     dis as error "Error: poisson only accepts pweights, not aweights."
 30.     error 198
 31.   }
 32. 
.   *Issue warnings related to unconditional se reliability
.   if "`safety'" != "off" & "`unconditionalse'" == "unconditionalse" & ("att_i
> " == "`att_i'" | "att_it" == "`att_it'" | "att_itime" == "`att_itime'" ) {
 33.     dis as error "Error: unconditional standard errors may be unreliable w
> ith non-att estimand types."
 34.     dis as text "Set option safety(off) to disregard this error."
 35.     error 198
 36.   }
 37. 
.   if "`safety'" != "off" & "`unconditionalse'" == "unconditionalse" & ("`weig
> ht'" == "aweight" ) {
 38.     dis " "
 39.     dis as text "Caution: unconditional standard errors may be unreliable 
> with aweights."
 40.     dis as text "Set option safety(off) to suppress this caution."
 41.     dis " "
 42.   }
 43. 
.   if "`adversarial'" == "adversarial" & "`impvalues'" == "impvalues" {
 44.     dis as error "Error: Adversarial Pre-Trends Testing not allowed with I
> bragimov and Muller p-values."
 45.     error 198
 46.   }
 47. 
.   * object to certain specification types when forced to switch to reg or poi
> sson over an hdfe estimator
.   if ("`customvce'" != "" | "`unconditionalse'" != "") & ( "`fe'" != "" | "`c
> cc_absorb'" != "")  {
 48.     dis as text "Caution: unconditional SEs and custom VCE specifications 
> rely on the plain regress command and so are not compatible with absorbed fix
> ed effects."
 49.     dis as text "You must specify anything in fe as controls, manually spe
> cifying any needed i. prefixes."
 50.   }
 51. 
.   * check conditions for using im p-values
.   if "`impvalues'" != "" & "`cluster'" == "" {
 52.     dis as error "Error: Ibragimov and Muller p-values only allowed when c
> lustering; please specify a clustering variable."
 53.     error 198
 54.   }
 55. 
.   if "`impvalues'" != "" & wordcount("`cluster'") > 1 {
 56.     dis as error "Error: Ibragimov and Muller p-values only allowed with a
>  single cluster variable."
 57.     error 198
 58.   }
 59. 
.   * check conditions for using im p-values
.   if "`impvalues'" != "" & ( "`customvce'" != "" | "`unconditionalse'" != "")
>  {
 60.     dis as error "Error: Ibragimov and Muller p-values are not compatible 
> with unconditional SE computation and custom VCE specifications."
 61.     error 198
 62.   }
 63. 
.   * complain if you specify customvce and something else with it
.   if "`customvce'" != "" & ("`robust'" != "" | "`cluster'" != "") {
 64.     dis as error "Error: customvce() is not compatible with robust and clu
> ster(). You must manually specify the contents of reg's vce() statement in th
> is case."
 65.     error 198
 66.   }
 67. 
.   * unconditional SEs are computed by margins via vce(unconditional), which r
> equires the underlying
.   * regression to have been fit with robust or clustered standard errors; cat
> ch this early rather than
.   * failing with a bare r(322) at the first margins call after estimation has
>  completed.
.   * pweights are exempt: they force a robust vce in reg/poisson, satisfying t
> he requirement on their own
.   if "`unconditionalse'" == "unconditionalse" & "`robust'" == "" & "`cluster'
> " == "" & "`customvce'" == "" & "`weight'" != "pweight" {
 68.     dis as error "Error: the option unconditionalse requires specifying ei
> ther robust or clustered standard errors."
 69.     dis as text "Specify robust or cluster(), or provide a robust/clustere
> d vce via customvce()."
 70.     error 198
 71.   }
 72. 
. 
.   *check conditions for using im p-values - in principle, SG estimates could 
> be computed provided SGs never cross cut clusters, but I have not implemented
>  this
.   * NOTE (t10_v3): this gate is LOAD-BEARING for the E1 subgroup restructure 
> - under
.   * impvalues, marginsdof is nose, and a chain `test' after a nose `post' is 
> r(321);
.   * do not relax this pairing without also emptying `sgpost' in the SG-compar
> ison blocks
.   if "`impvalues'" != "" & "`subgroups'" != "" {
 73.     dis as error "Error: Ibragimov and Muller p-values not compatible with
>  subgroups."
 74.     error 198
 75.   }
 76. 
.   * F3: under a continuous treatment the cohort-by-period interaction coeffic
> ients are
.   * intercepts at dose zero, not treatment effects, so the building-block tab
> le would be
.   * silently meaningless there
.   if "`gteffects'" != "" & "`contreat'" != "" {
 77.     dis as error "Error: gteffects is not available with contreat(): the c
> ohort-by-period interaction coefficients are dose-zero intercepts under a con
> tinuous treatment, not treatment effects. Aggregate e(b_es_ame) or the cfx ma
> terials instead."
 78.     error 198
 79.   }
 80. 
. 
.   *check conditions for using im p-values - for CFX plots, we have problems s
> imilar to with SGs, but even worse
.   if "`impvalues'" != "" & "`makecfxplots'" != "" {
 81.     dis as error "Error: Ibragimov and Muller p-values not compatible with
>  continuous treatment effects plots."
 82.     error 198
 83.   }
 84. 
.   * F7 pre-trend power diagnostics: validate the request early (checks live i
> n a
.   * subprogram - the worker is close to Stata's per-program size ceiling)
.   if "`pretrendpower'" != "" wooldid_ptpcheck , levels(`pretrendpower') esf(`
> esfixedbaseperiod') impv(`impvalues') espre(`esprelength')
 85. 
.   * check conditions for using im p-values --
.   * for the joint tests, I have not seen IM characterize multi-way tests. imp
> lementing a test here of some sort would be easy,
.   * but I am not sure if it would technically be valid.
.   if "`impvalues'" != "" & ( "`jointtests'" != "" ){
 86.     dis as error "Error: Ibragimov and Muller p-values are not compatible 
> with the jointtests option."
 87.     error 198
 88.   }
