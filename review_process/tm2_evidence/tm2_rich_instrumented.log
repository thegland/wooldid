.     * only ACROSS periods leaves by-sg att/att_it correct (row-weighted) but 
> makes
.     * att_i/att_itime weight a straddling unit by its weight share rather tha
> n equally ->
.     * caution. domains: missing sg rows belong to no subgroup by design and n
> ever-treated
.     * units never enter any sg subpop, so both are excluded (cond() folds ext
> ended missings)
.     if "`safetyinput'" != "off" {
310.       tempvar f13sgitmin f13sgitmax
311.       qui gegen double `f13sgitmin' = min(cond(`subgroups' >= ., ., `subgr
> oups')) if `ifstatement' & `ttre' != ., by(`i' `t')
312.       qui gegen double `f13sgitmax' = max(cond(`subgroups' >= ., ., `subgr
> oups')) if `ifstatement' & `ttre' != ., by(`i' `t')
313.       cap assert `f13sgitmin' == `f13sgitmax' if `ifstatement' & `ttre' !=
>  .
314.       if _rc != 0 {
315.         dis as error "Error: the subgroup variable `subgroups' varies with
> in `i'-by-`t' cells of the treated estimation sample."
316.         dis as error "wooldid estimates effects at the `i'-by-period level
> , so subgroup estimates built from cells that mix subgroups cannot reflect wi
> thin-cell subgroup differences - each subgroup only reweights the same pooled
>  cell effects, and subgroup contrasts can come back identical even when true 
> effects differ sharply by subgroup."
317.         dis as error "Define `i' at the finer level over which the subgrou
> p varies (e.g., egen newi = group(`i' `subgroups')), or drop the subgroups() 
> option."
318.         dis as error "To ignore this error, specify safety(off)."
319.         error 459
320.       }
321.       qui drop `f13sgitmin' `f13sgitmax'
322.     }
323.     * a unit split across multiple subgroups over time (subgroup varies wi
> thin i across
.     * periods) is refused under default safety - a unit cannot belong to more
>  than one
.     * subgroup, and the share-weighted fallback deserves an explicit opt-in. 
> under
.     * safety(off) the run proceeds with share weighting and a caution (author
>  directive,
.     * 2026-07-28; this check runs regardless of the safety setting)
.     tempvar f13sgimin f13sgimax
324.     qui gegen double `f13sgimin' = min(cond(`subgroups' >= ., ., `subgroup
> s')) if `ifstatement' & `ttre' != ., by(`i')
325.     qui gegen double `f13sgimax' = max(cond(`subgroups' >= ., ., `subgroup
> s')) if `ifstatement' & `ttre' != ., by(`i')
326.     cap assert `f13sgimin' == `f13sgimax' if `ifstatement' & `ttre' != .
327.     if _rc != 0 {
328.       if "`safetyinput'" != "off" {
329.         dis as error "Error: the subgroup variable `subgroups' splits some
>  units of `i' across multiple subgroups over time. A unit cannot belong to mo
> re than one subgroup."
330.         dis as error "To proceed anyway, specify safety(off): by-subgroup 
> att and att_it then weight each observation to its own subgroup as usual, whi
> le att_i and att_itime enter a split unit into each subgroup weighted by its 
> share of sample weight there, rather than with the equal unit weighting those
>  estimands normally imply."
331.         error 459
332.       }
333.       else dis as text "Caution: the subgroup variable `subgroups' splits 
> some units of `i' across multiple subgroups over time; proceeding under safet
> y(off) using share weighting. att_i and att_itime enter a split unit into eac
> h subgroup weighted by its share of sample weight there, rather than with the
>  equal unit weighting those estimands normally imply; by-subgroup att and att
> _it results are unaffected."
334.     }
335.     qui drop `f13sgimin' `f13sgimax'
336.     * long subgroup values overflow stata's 31/32-character name limits wh
> en embedded in
.     * constructed local/matrix/rowname/graph/e() names (the worst prefixes re
> ach 24-25
.     * characters: the makecfxplotsbysg tempnames, the adversarial-by-sg eretu
> rns, and the
.     * pooled pretreatment_SG<value>_att_itime rownames all crash at 8-digit v
> alues; the
.     * bysg tempnames also embed the relative year, so with 3-digit relyr plot
>  requests
.     * even 7-digit values overflow), and values beyond 2,147,483,647 exceed t
> he
.     * factor-variable level cap that margins over() relies on. whether a give
> n run
.     * crashes depends on the options requested, so this is a caution rather t
> han an
.     * error. the sglist domain matches the checks above: only values reaching
>  the
.     * treated estimation sample are ever injected into names
.     local sgmaxlen 0
337.     foreach sgcase in `sglist' {
338.       if strlen("`sgcase'") > `sgmaxlen' local sgmaxlen = strlen("`sgcase'
> ")
339.     }
340.     if `sgmaxlen' >= 8 | (`sgmaxlen' == 7 & "`makecfxplotsbysg'" != "") {
341.       dis as text "Caution: the subgroup variable takes values up to `sgma
> xlen' digits long. wooldid embeds subgroup values in the names of stored resu
> lts, matrices, and plots, and Stata caps such names at 31-32 characters, so v
> alues 8 or more digits long (7, with makecfxplotsbysg and 3-digit relative-ye
> ar plot requests) can sometimes cause unexplained r(198) invalid-name crashes
> ; att_itime results tables, adversarial, and makecfxplotsbysg are most expose
> d. Values above 2,147,483,647 will generally fail outright at Stata's factor-
> variable level cap."
342.       dis as text "If wooldid crashes, recode ID-style subgroup values to 
> small integers first (e.g., egen newsg = group(oldsg))."
343.     }
344.     * initialize these for later
.     foreach sgcase in `sglist' {
345.       local joint_horiz_i_s`sgcase'
346.       local joint_Choriz_i_s`sgcase'
347.     }
348.   }
349. 
. 
. 
. 
. 
. 
.   ***************************************************************************
> ******************************************************
.   ***********************************  PRODUCE LATTICE FOR CONTREAT, CONTINUO
> US TREATMENT VARIABLES  ******************************
.   ***************************************************************************
> ******************************************************
. 
.   * first, create targetflag, a variable that is 1 in relative periods for wh
> ich we are interested in producing treatment effects, and 0 otherwise
.   * this ends up being needed in various places as a matter of convenience in
>  building the regressions as well as elsewhere in making these variables
.   tempvar targetflag
350.   qui gen `targetflag' = `_t' > 0 & `_t' < . if `ifstatement'
351. 
. 
. 
.   * prepare the continuous treatment materials  - this must be done after ttr
> e is fully updated and bad treatments are missinged out
.   * lattice is a thing that allows piecewise estimation of the effect of your
>  continuous treatment
.   * you can pass through any lattice variable you like, or autogenerate one
.   * if you autogenerate, the key concepts here are:
.   * latticenum tells us how many chunks to split the sample into for the piec
> ewise continuous treatment function
.   * latticetype -- specifies how to compute quantiles. all implies over the w
> hole sample, otherwise they are calculated within subsets of the sample speci
> fied by the by variable.
.   *     e.g., if baseX is specified, quantiles are formed in a base period an
> d the boundaries in the base period are used to define the lattice everywhere
.   * the code block below handles autogenerating: it is largely a matter of ge
> nerating percentiles within the correct group of variables
.   * note that piecewise functions threaten the concept of derivatives, so don
> 't expect clean interpretation of AMEs when using a lattice
. 
.   local latticevar
352.   local latticepart2hash
353.   local latticepart1hash
354.   local contreatinj
355. 
.   * note that this thing will first work on making lattices
.   * then work on making the continuous treatment variable text will add it to
>  the regression
.   if "`contreat'" != "" {
356.     * work on the lattice
.     if "`lattice'" != ""  {
357.       * wordcount = 2 implies generate a lattice; wordcount of 1 means you
>  just had the name of the lattice var directly passed through
.       if wordcount("`lattice'") == 2 {
358.         * ignore weights in lattice percentile computation - useful in som
> e situations where weights are not very uniform
.         local latticeweightinserter `weightinserter'
359.         if "`latticeignoreweights'" == "latticeignoreweights" local lattic
> eweightinserter
360. 
.         * begin specifying commands to construct the different types of latti
> ce variables / create ancillary supporting variables
.         tempvar latticevar
361.         local byable
362.         local xtileif
363.         if "`latticetype'" == "baseTreated" local xtileif & `ttre' != .
364.         if "`latticetype'" == "baseTreatedPost" local xtileif & `t' >= `tt
> re' & `ttre' != .
365.         if "`latticetype'" == "baseTreatedPre" local xtileif & `t' < `ttre
> ' & `ttre' != .
366.         if "`latticetype'" == "baseTreatedRef" local xtileif & `t' < `ttre
> ' & `ttre' != . & `_t' == 0
367.         if "`latticetype'" == "byCohort" local byable `i'
368.         if "`latticetype'" == "byTime" local byable `t'
369.         if "`latticetype'" == "byCohortByTime" local byable `i' `t'
370.         if  "`latticetype'" == "byTreated" | "`latticetype'" == "byTreated
> ByTime" {
371.           tempvar evertreated
372.           qui gen `evertreated' = `ttre' != .
373.         }
374.         if   strpos("`latticetype'", "byTtre")!=0 {
375.           tempvar modified_ttre
376.           qui gen double `modified_ttre' = `ttre'
377.           qui replace `modified_ttre' = `minyearobserved' if `ttre' == .
378.           * minyearobserved is just any value not appearing in ttre; ttre 
> is guaranteed to not include that value
.         }
379.         if "`latticetype'" == "byTreated" local byable `evertreated'
380.         if "`latticetype'" == "byTreatedByTime" local byable  `evertreated
> ' `t'
381.         if "`latticetype'" == "byTtre" local byable `modified_ttre'
382.         if "`latticetype'" == "byTtreByTime" local byable  `modified_ttre'
>  `t'
383. 
.         * make the 'base' style lattices - these compute percentiles in the s
> pecified base period (treated units only, treated units post treatment, treat
> ed units pre treatment)
.         * base type needs to be handled special b/c we code this variable wit
> h a loop through the grabbed list of percentiles
.         * for the others, we just use a percentile generator to create them u
> nder the specified conditions
.         if "`latticetype'" == "baseTreatedPost" | "`latticetype'" == "baseTre
> ated" | "`latticetype'" == "baseTreatedPre" | "`latticetype'" == "baseTreated
> Ref" {
384.           gquantiles `contreat' `latticeweightinserter' if `ifstatement' `
> xtileif', _pctile   nquantiles(`latticenum')
385.           gen `latticevar' = 1
386.           forval latticecase = 2(1)`latticenum'{
387.             local percentiletograb = `latticecase'-1
388.             qui replace `latticevar' = `latticevar' + 1 if `contreat' > r(
> r`percentiletograb')
389.           }
390.         }
391.         else {
392.           if "`latticetype'" != "all" qui gquantiles `latticevar' = `contr
> eat' `latticeweightinserter' if `ifstatement' , xtile nquantiles(`latticenum'
> ) by(`byable')
393.           if "`latticetype'" == "all"  qui gquantiles `latticevar' = `cont
> reat' `latticeweightinserter' if `ifstatement' ,   nquantiles(`latticenum') x
> tile
394.         }
395.         qui replace `latticevar' = 0 if `latticevar' == . & `ifstatement'
396.         * null lattice points are sent to 0
.       }
397.       else{
398.         local latticevar `lattice'
399.       }
400.       * build some macros for inserting the lattice variable where needed
.       local latticepart2hash ##i.`latticevar'
401.       local latticepart1hash #i.`latticevar'
402.     }
403.     else{
404.       local latticepart2hash
405.       local latticepart1hash
406.     }
407. 
.     * lattice is done, work on making the continuous treatment variable work
.     * finish up making contreatadder - the code chunk that injects into the r
> egression statement the correct variables needed for estimating continuous tr
> eatment effects
.     * an important part of this is partialling out the base effect of the con
> tinuous treatment variable in a fashion that is invisible to margins
.     * that is to say, when we control for the continuous treatment variable o
> utside of the treated/pre-treated observations, we don't want that to contrib
> ute to treatment effect estimation
.     * we can do that by creating a ringer variable that is equal to contreat 
> but with a different name, or by pushing stuff into the absorb() command
.     * we handle requests for contreat polynomials using c.#c. interactions so
>  that the polynomial terms are legible to margins; we don't care about doing 
> so for the ringer variable though
.     * the ringer copies must be double: gen defaults to float, and a float-tr
> uncated copy of a
.     * double contreat is only approximately collinear with it, weakening the 
> engineered
.     * collinearity drop that keeps the base effect out of the margins-visible
>  terms
.     tempvar ringer
408.     qui gen double `ringer' = `contreat'
409.     local contreatpolypart c.`contreat'
410.     local ringerpoly c.(`ringer'
411.       if `contreatpoly' > 1 {
412.         forval polycount = 2(1)`contreatpoly' {
413.           local contreatpolypart `contreatpolypart'##c.`contreat'
414.           tempvar ringer`polycount'
415.           qui gen double `ringer`polycount'' = `ringer'^`polycount'
416.           local ringerpoly `ringerpoly' `ringer`polycount''
417.         }
418.       }
419.     local ringerpoly `ringerpoly')
420.     local contreatinj   `latticepart2hash'##`contreatpolypart'
421.     local ringerinj   `latticepart1hash'#`ringerpoly'
422.     * the macros above will be used for constructing the contreatcontrols 
> below and the main regression statement
.     * this parens below closes the if contreat == contreat if statement
.   }
423. 
. 
. 
. 
.   ***************************************************************************
> ****************************************
.   ******************************  HANDLE CONTROLS, CRITICALLY, THE CONTREATCO
> NTROLS  ******************************
.   ***************************************************************************
> ****************************************
. 
.   ************ HANDLE REGULAR CONTROLS ****************
.   * direct controls and direct fe don't require modification
. 
.   * controls for coarse case - i.e., where we interacted them with the treatm
> ent dummies. ccc_absorb puts them into absorb - only viable for continuous co
> ntrols of course
.   * the astute eye will notice that coarsecontrolinserter w/ categorical cont
> rols should partial out the main treatment effects
.   * this does not occur b/c this statement is placed toward the end of the re
> gression statement, meaning multicollinearity forces drops among the controls
.   local coarsecontrolinserter
424.   local ccc_absorbinserter
425.   if "`coarsecohortcontrols'" != "" local coarsecontrolinserter i.`_i'#i.`
> _t'#(`coarsecohortcontrols')
426. 
.   if "`ccc_absorb'" != "" {
427.     local ccc_absorbinserter i.`_i'#i.`_t'#c.(`ccc_absorb')
428.   }
429. 
.   * handle interactive controls - these are closer to the object that wooldri
> dge covers in his paper for covariates
.   if "`interactivecontrols'" != "" {
430.     * center the variables by cohort i
.     local interlist
431.     local iter 1
432.     foreach intercon in `interactivecontrols' {
433.       tempvar ic`iter'
434.       qui gen double `ic`iter'' = `intercon'
435.       local interlist `interlist' `ic`iter''
436.       local ++iter
437.     }
438.     qui gstats transform (demean) `interlist'    `weightinserter'   if   `
> ifstatement', by(`i') replace
439. 
.     * there are two sets of objects to introduce:
.     * interactions between the time variable and the raw interactive controls
.     * interactinos between the de-meaned interactive controls and the dummies
>  for treated units' treatment periods
.     * (I think the null untreated dummy X interactive controls object include
> d should be harmless to include / appears to exist in some of Wooldridge's ex
> ample files)
.     local interinject i.`_i'#i.`_t'#i.`targetflag'#c.(`interlist')  i.`t'#c.(
> `interactivecontrols')
440.   }
441. 
. 
.   * handle the time trend option
.   local trendinjector
442.   * the trend enters through a mean-centered double copy of t: with raw ca
> lendar codes
.   * the demeaned i.i#c.t columns lose all precision and the trends go numeric
> ally inert
.   * (silently - rc 0, no caution; measured as low as t ~ 5e5, panel-dependent
> ), and even
.   * at 4-digit years the raw form drifts under affine shifts of t where the c
> entered
.   * form is exactly shift-invariant. centering is a pure reparameterization a
> bsorbed by
.   * the unit intercepts; measured movement on ordinary panels is machine prec
> ision.
.   * t is used as a continuous regressor NOWHERE else - every other formula us
> e is
.   * factor/absorb/grouping and must stay raw
.   if "`timetrends'" == "timetrends" {
443.     tempvar tcen
444.     qui gstats sum `t' if `ifstatement', meanonly
445.     qui gen double `tcen' = `t' - r(mean)
446.     local trendinjector i.`i'##c.`tcen'
447.   }
448.         *note that we dont absorb this - pooled continuous variabels is a 
> tricky matter sometimes
. 
. 
.   ************** CREATE CONTREAT CONTROLS ***********
.   * this covers how we control for continuous treatment/treatment intensity o
> utside of treated/pre-treatment observations
.   * we probably want to control for the continuous treatment variable in a fl
> exible way, possibly in a way that varies by period or by cohort or by period
>  separately in the treatment and control groups
.   * this section enables that by creating appropriate controls (using alterna
> te varnames or absorb, so as to remain invisible to margins)
.   * with interactions to allow the specified degree of flexibility - eg, have
>  controls vary by period vs by cohort vs etc.
. 
.   if "`contreatcontrols'" != ""   {
449.     * setup missing helper variables (only if not created earlier)
.     if strpos("`contreatcontrols'" , "byTreated" ) != 0 & strpos( "`latticety
> pe'" , "byTreated") == 0  {
450.       tempvar evertreated
451.       qui gen `evertreated' = `ttre' == .
452.     }
453.     if strpos("`contreatcontrols'" , "byTtre" ) != 0 & strpos("`latticetyp
> e'", "byTtre")==0{
454.       tempvar modified_ttre
455.       qui gen double `modified_ttre' = `ttre'
456.       qui replace `modified_ttre' = `minyearobserved' if `ttre' == .
457.       * minyearobserved is just any value not appearing in ttre; ttre is g
> uaranteed to not include that value
.     }
458. 
.     * initialize
.                 local contreatcontrolinserterFE
459.                 local contreatcontrolinserter
460. 
.     * handle basic, byTreated, byTtre, and byCohort in order since these are 
> successively more intensive and supersede each other
. 
.     * basic just partials out the baseline effect of your contreat control. i
> mplicitly, this effect is pooled in your control group and reference period
.     * this text initializes contreatcontrolinserterfe correctly if using basi
> c w/o a lattice
.     * and also initializes it this way if there is any chance that this FE ob
> ject might get kicked outside of an HDFE absorb, in which case this section b
> eing included
.     * is necessary in order to correctly manipulate the behavior of reg and p
> oisson's colinearity drop rules (nothing in an HDFE is dropped b/c of colinea
> rity with something not in the FE)
.                 * re: the nature of the manipulation, specifying null##ringer
>  and lattice##ringer (as opposed to ringer alone or lattice#ringer) -- and do
> ing so explicitly, rather than
.                 *     implicitly like in the other control types -- ensures t
> hat the base level of contreat gets partialled out. if not specified, it does
>  not always get partialled out, and
.                 *     instead one of the contreat control coefficients gets d
> ropped for colinearity instead
.     if (strpos("`contreatcontrols'",  "basic") != 0 & "`latticepart2hash'" ==
>  "" ) | "`unconditionalse'" == "unconditionalse" | "`customvce'" != "" | "`po
> isson'" == "poisson" {
461.       tempvar null
462.       qui gen `null' = 1
463.       local contreatcontrolinserterFE  i.`null'##`ringerpoly'
464.                         if "`latticepart2hash'" != ""  local contreatcontr
> olinserterFE `contreatcontrolinserterFE'  i.`latticevar'##`ringerpoly'
465.                         *using latticepart2hash as a check here is arbitra
> ry and a different lattice byproduct could be used
.     }
466. 
.     * built on top of the initialized contreatcontrolisnerterFE -- add lattic
> e components only if useful
.     if strpos("`contreatcontrols'",  "byTreated") != 0  local contreatcontrol
> inserterFE `contreatcontrolinserterFE' i.`evertreated'`ringerinj'
467.     if strpos("`contreatcontrols'",  "byTreated") != 0 & "`latticepart2has
> h'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`eve
> rtreated'`latticepart2hash'
468.     if strpos("`contreatcontrols'",  "byTtre") != 0  local contreatcontrol
> inserterFE `contreatcontrolinserterFE' i.`modified_ttre'`ringerinj'
469.     if strpos("`contreatcontrols'",  "byTtre") != 0  & "`latticepart2hash'
> " != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`modif
> ied_ttre'`latticepart2hash'
470.     if strpos("`contreatcontrols'",  "byCohort") != 0  local contreatcontr
> olinserterFE `contreatcontrolinserterFE'  i.`i'`ringerinj'
471.     if strpos("`contreatcontrols'",  "byCohort") != 0  & "`latticepart2has
> h'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'   i.`i'
> `latticepart2hash'
472. 
.     * handle by period - this is in addition to, not in lieu of the others
.     if strpos("`contreatcontrols'",  "byTime") != 0  local contreatcontrolins
> erterFE `contreatcontrolinserterFE' i.`t'`ringerinj'
473.     if strpos("`contreatcontrols'",  "byTime") != 0  & "`latticepart2hash'
> " != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'     i.`t'
> `latticepart2hash'
474. 
. 
.     * in terms of interpreting these control measures, note that allow each c
> ohort to have its own contreat control function can have some interesting con
> sequences
.     * more aggressive controlling can reduce the amount of cross-group compar
> isons that occur
.     * adding byTime implicitly says "compare the contreat effect in treated u
> nits in period 1 to controls in period 1"
.     * but allowing contreat effects to vary by cohort and period simultaneous
> ly would not have this effect
. 
. 
.     * if always zero when not treated, the only thing to do is not control fo
> r anything! this results in no contreat controls
.     * it is implemented via modifying the contreatinj statement and just not 
> having contreatcontrols of any kind
.     if "`contreatcontrols'" == "untreatedZero" {
475.       local contreatinj   `latticepart1hash'#`contreatpolypart' i.`_i'#i.`
> _t'#i.`targetflag'`latticepart1hash'
476.     }
477. 
.   }
478. 
.   if "`ccnoabsorb'" == "ccnoabsorb"   {
479.                 local contreatcontrolinserter `contreatcontrolinserterFE'
480.                 local contreatcontrolinserterFE
481.         }
482. 
. 
. 
. 
. 
. 
.   ***************************************************************************
> ************************
.   ********************************         ESTIMATE THE MODELS        *******
> ************************
.   ******************************* (And Extract Information From Them) *******
> ************************
.   ***************************************************************************
> ************************
. 
.   if "`verbose'" == "verbose" dis as text "Wooldid is now estimating its regr
> ession."
483. 
.   * handle SEs
.   local vcespecifier
484.   if "`robust'" == "robust" local vcespecifier vce(robust)
485.   if "`cluster'" != "" local vcespecifier cluster(`cluster')
486. 
.   * Regression!
.   * unconditionalse and customvce punts us to using reg or poisson; otherwise
> , use reghdfe or ppmlhdfe
.   * the transition is fairly easy in that you can get the same results by pla
> cing any absorbed FE before the treatment variable specification in the reg e
> quation
.   * since colinear terms get dropped in the order in which they appear (mostl
> y)
. 
.   *Re regtol - it is set to 9 by default, is is the reghdfe default.
.   if "`unconditionalse'" == "" & "`customvce'" == "" {
487.     * ppmlhdfe specification is different from reghdfe b/c it is more host
> ile to partialling out continuous variables
.     * ppmlhdfe requires d for predict, which margins requires
.     if "`poisson'" == "poisson" {
488.       if "`verbose'" != "" dis "ppmlhdfe `y' `contreatcontrolinserter' `tr
> endinjector'    i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `inte
> rinject'    `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , 
> absorb(i.`i' i.`t' `fe'   `contreatcontrolinserterFE'     `ccc_absorbinserter
> '  ) `vcespecifier' tol(1e-`regtol') d "
489.       qui cap ppmlhdfe `y' `contreatcontrolinserter' `trendinjector'    i.
> `_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'    `interinject'    `coar
> secontrolinserter'  `weightinserter'   if   `ifstatement' , absorb(i.`i' i.`t
> ' `fe'    `contreatcontrolinserterFE'  `ccc_absorbinserter' ) `vcespecifier' 
> tol(1e-`regtol') d
490.       if _rc == 3200 {
491.         dis as text "Caution: initial estimation of ppmlhdfe failed, possi
> bly due to inclusion of an absorbed categorical fixed effect with only 1 leve
> l."
492.         dis as text "Falling back to estimation with ppmlhdfe, but with an
> y included time-trend controls, ccc_absorb controls, and/or continuous treatm
> ent controls pulled out of the absorb() statement and placed in the main regr
> ession."
493.         dis as text "In principle, this fallback solution should usually y
> ield the same results, but will be computationally less efficient."
494.         dis as text "If estimation still fails, the issue could be either 
> with the fe() specified or a result of having few cohorts/time-periods."
495.         qui ppmlhdfe `y' `contreatcontrolinserter' `contreatcontrolinserte
> rFE'  `ccc_absorbinserter'  `trendinjector'  i.`_i'#i.`_t'#i.`targetflag'`con
> treatinj'  `controls'   `interinject'    `coarsecontrolinserter'  `weightinse
> rter'   if   `ifstatement' , absorb(i.`i' i.`t' `fe'   ) `vcespecifier' tol(1
> e-`regtol') d
496.       }
497.       else {
498.         if _rc != 0 error _rc
499.       }
500.     }
501.     else{
502.       if "`verbose'" != "" dis "reghdfe `y' `contreatcontrolinserter' `tre
> ndinjector' i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinj
> ect'   `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , absor
> b(i.`i' i.`t' `fe'     `contreatcontrolinserterFE'   `ccc_absorbinserter'  ) 
> `vcespecifier' tol(1e-`regtol')  "
503.       qui reghdfe `y' `contreatcontrolinserter' `trendinjector'  i.`_i'#i.
> `_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'     `coarsecontr
> olinserter'  `weightinserter'   if   `ifstatement' , absorb(i.`i' i.`t' `fe' 
>     `contreatcontrolinserterFE'   `ccc_absorbinserter'  ) `vcespecifier' tol(
> 1e-`regtol')
504.     }
505.   }
506.   else{
507.     * run the reg/poisson version, places all absorbed FE at the front of 
> the reg equation
.     if "`customvce'" != "" local vcespecifier vce(`customvce')
508.     local regtype reg
509.     if "`poisson'" == "poisson" local regtype poisson
510.     if "`verbose'" != "" dis "`regtype' `y' i.`i' i.`t' `fe'   `trendinjec
> tor' `contreatcontrolinserter' `contreatcontrolinserterFE'   `ccc_absorbinser
> ter'   i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject' 
>    `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' ,  `vcespec
> ifier'  "
511.     qui `regtype' `y' i.`i' i.`t' `fe'   `trendinjector' `contreatcontroli
> nserter' `contreatcontrolinserterFE'   `ccc_absorbinserter'   i.`_i'#i.`_t'#i
> .`targetflag'`contreatinj'  `controls'    `interinject'    `coarsecontrolinse
> rter'  `weightinserter'   if   `ifstatement' ,  `vcespecifier'
512.   }
513. 
.   * save the model; will be useful later
.   * register the data-variable obligation with the shell's error-path cleanup
>  epilogue
.   * BEFORE storing: _ppmlhdfe_d already exists in the data at this point, and
>  est sto
.   * itself can fail (a real trigger: the estimates directory at Stata's 300-s
> tore
.   * limit), which previously leaked the variable through the unregistered win
> dow
.   if "`poisson'" == "poisson" & "`unconditionalse'" == "" & "`customvce'" == 
> "" global WOOLDID_CLEANUP $WOOLDID_CLEANUP ppml
514.   qui est sto ___wooldidfullmodel
515.   global WOOLDID_CLEANUP $WOOLDID_CLEANUP fullmodel
516.   if "`verbose'" == "verbose" dis as text "Wooldid has finished regression
>  estimation and is preparing to begin margins calculations."
517. 
.         * check on dropped obs
.         qui count if `dropcount' & e(sample) == 0
518.         local droppedobs = r(N)
519. 
.   * grab some items from the model - sample indicator variable, residual degr
> ees of freedom, etc
.   tempvar esamp
520.   qui gen byte `esamp' = e(sample)
521.   local df_r = e(df_r)
522. 
.   ***************************************************************************
> **************************************
.   ******************************  PRODUCE THE WEIGHTS FOR CREATING VARIOUS OU
> TCOMES  ******************************
.   ***************************************************************************
> **************************************
.   * special weights are required to go beyond a simple ATT; this generates th
> em
.   * note: constructed after estimation, on the realized estimation sample (es
> amp), so that cell/cohort
.   * normalizations only count observations that actually entered the regressi
> on (estimators can drop
.   * observations - e.g. reghdfe singletons, ppmlhdfe separation - after the i
> nitial sample screens)
. 
.   * handle custom weight multipliers that the user specifies
.   local customweighttext
523.   if "`customweightmultiplier'" != "" local customweighttext * `customweig
> htmultiplier'
524. 
.   ***** begin manufacturing weights to produce averages of interest
.   * 4 weight concepts to target
.   * att is the "do nothing but use sample weights" weight
.   * att_i says give the average of cohort-specific effects, obtaining said ef
> fects using sample weights
.   * att_it says "calculate cohort-period specific effects using weights, then
>  average those"
.   * att_itime says "calculate cohort-period specific effects using weights, t
> hen average those by cohort, then average the cohort averages"
. 
.   foreach item in tag posttreatment   w_per_it w_per_i  t_per_i   w_att  w_at
> t_it w_att_i w_att_itime   {
525.     tempvar `item'
526.   }
527. 
.   * create necessary supporting object for computing att_i and att_itime weig
> hts
.   * this object is 1 if in the treated period for treated units,
.   * 2 if in the pre-treatment period for treated units and we are reporting e
> ffects for that time period
.   * 0 if in the pre-treatment period for treated units and we are not reporti
> ng effects for that period (i.e., the reference period)
.   * 3 if untreated and in sample
.   * 4 if out of sample
.   if "`att_i'" == "att_i" | "`att_itime'" == "att_itime" {
528.     qui gen `posttreatment' = `t' >= `ttre' if `esamp' == 1
529.     qui replace `posttreatment' = 2 if `t' < `ttre' & `ttre' != . & `_i' !
> = 0 & `_t' != 0 & `esamp' == 1
530.     qui replace `posttreatment' = 3 if `ttre' == .  & `esamp' == 1
531.     qui replace `posttreatment' = 4 if `posttreatment' == .
532.   }
533. 
.   * this variable helps count the number of i-t cells that exist in various s
> ubsets - useful for att_itime weights
.   if "`att_itime'" == "att_itime" {
534.     qui gegen `tag' = tag(`i' `t') if  `esamp' == 1
535.     qui replace `tag' = 0 if `tag' == .
536.   }
537. 
.   * generate some inputs for weights calculation
.   * w_per_it contains the amount of weight falling into each i-t cell
.   * w per i gives the total amount of sample weight associated for each i fal
> ling into the categories specified by posttreatment
.   * t per i is the total number of periods appearing for i in each posttreatm
> ent-defined period
.   * in each case, we only make the input if needed for a weight type the user
>  actually requested
.   * that said, we always produce w_att_it whenever a non att weight is reques
> ted, since they are needed for the event horizon estimates and sometimes for 
> histogram
.   if "`att_it'" == "att_it" | "`att_itime'" == "att_itime" | "`att_i'" == "at
> t_i" qui gegen `w_per_it' = total(`esamp' * `w')  , by(`i' `t')
538.   if "`att_i'" == "att_i"  qui gegen `w_per_i' = total(`w'*`esamp')      ,
>  by(`posttreatment' `i')
539.   if "`att_itime'" == "att_itime" qui gegen `t_per_i' = total(`tag')    , 
> by(`posttreatment' `i')
540. 
.   * att requires no special weights - it gets to stay as the given weight (w)
> , albeit with the customweight text multiplier coming through
.   * dividing w by w_per_it weights all i-t cells equally, but still lets w be
>  influential within i-t cells (att_it)
.   * dividing w by total w in i weights all i equally, but still lets w be inf
> luential within i-t cells and across i-t cells within i (att_i)
.   * dividing w by total w in i-t cells * number of t in the i, yields w_att_i
> time. this lets w be influential inside i-t cells, but then
.   *        weights every i-t cell equally when contributing to estimates of i
> -specific effects, which are themselves then averaged
. 
.   if "`att_i'" == "att_i" {
541.     qui gen double `w_att_i' = `w' `customweighttext'/`w_per_i'
542.     qui replace `w_att_i' = 0 if `w_att_i' == .
543.     qui drop `w_per_i'
544.     qui drop  `posttreatment'
545.   }
546. 
.   if "`att_itime'" == "att_itime" {
547.     qui gen double `w_att_itime' = `w' `customweighttext' /(`w_per_it'*`t_
> per_i')
548.     qui replace `w_att_itime' = 0 if `w_att_itime' == .
549.     qui drop `tag' `t_per_i'
550.     qui cap drop  `posttreatment'
551.   }
552. 
.   if "`att_it'" == "att_it" | "`att_itime'" == "att_itime"  | "`att_i'" == "a
> tt_i" {
553.     qui gen double `w_att_it' = `w' `customweighttext'/`w_per_it'
554.     qui replace `w_att_it' = 0 if `w_att_it' == .
555.     qui drop `w_per_it'
556.   }
557. 
.   * generate w_att whenever att is requested
.   if "`att'" == "att" qui gen double `w_att' = `w' `customweighttext'
558. 
.   * some comments on the weights:
.   * provided each i is always wholly contained in a given sg, we have no issu
> es using these weights for sg purposes
.   * since we don't allow fw type weights, weight scale here actually doesn't 
> matter - no need to multiply weights by scalar adjustment factors
.   * for event study estimates, note that att_i and att_itime are not conceptu
> ally all that sensible --
.   *       we substitute att_it for them since it retains a spirit of 'all sam
> e across i'
. 
.   * save the name of the current frame  - will be useful going forward
.   qui frame
559.   local defaultframe `r(currentframe)'
560. 
.   * create the matrix relyrcolumn containing all relative periods of interest
>  appearing in the regression - needed for constructing the results
.   * do this by processing the column names of e(b)
.   if `espre' + `espl' > 0 {
561.     local relyrlist
562.     tempname relyrcolumn
563.     local bvars: colnames e(b)
564.     local horizlist
565.     local horizonend = `horizonstarter' + `espre' + `espl' -1
566.     forval horiz = `horizonstarter'(1)`horizonend' {
567.       if regexm("`bvars'","[0-9].`_i'#`horiz'.`_t'#1.`targetflag'") {
568.         * the above regular expression resolves to 1 only if you see the f
> ollowing:
.         * (anynumber not followed by a o or a b)._it#(horiz)._t#1.targetflag 
>   <- so a valid, included in the model estimate at the given horizon
.         local relyr = `horiz'-`min_t'-1
569.         local horizlist `horizlist' `horiz'
570.         if "`relyrlist'" != "" local relyrlist `relyrlist' , `relyr'
571.         if "`relyrlist'" == "" local relyrlist `relyrlist' `relyr'
572.       }
573.     }
574.     matrix `relyrcolumn' = (`relyrlist')'
575.   }
576. 
. 
.   * here, we check and see if the main treatment effects have been dropped fr
> om the regression for multicollinearity - my tests for this are imperfect, bu
> t still useful
.   if "`safety'" != "off"  {
577.     local bvars: colnames e(b)
578.     local catastrophe 0
579.     local bigcatastrophe 0
580.     * "o." appears in e(b) colnames iff some term carries an omission flag
>  (a dot only ever
.     * follows a factor operator, and a token cannot straddle whitespace), so 
> when it is
.     * absent the loop below provably cannot fire -- skip the whole interprete
> d scan
.     if strpos("`bvars'", "o.") != 0 {
581.     tokenize `bvars'
582.     local maxwordcount = wordcount("`bvars'")
583.     forval testbvar = 1(1)`maxwordcount' {
584.       if strpos("``testbvar''", "o.") != 0   & strpos("``testbvar''", "0b.
> ") == 0 & strpos("``testbvar''", "`_i'") != 0 & strpos("``testbvar''", "`_t'"
> ) != 0  & ( strpos("``testbvar''", "1o.`targetflag'") != 0 | strpos("``testbv
> ar''", "1.`targetflag'") != 0)  {
585.         * the above triggers if and only if (a) the variable has an omissi
> on flag (and thus was dropped), and
.         * (b) it contains _i, _t, and targetflag (and thus is associated with
>  a main treatment effect), and
.         * (c) targetflag (omitted or not) has a value of 1 (meaning it is sup
> posed to correspond with a treatment effect), and
.         * (d) base values of 0 are not present anywhere (meaning it is suppos
> ed to correspond with a treatment effect)
.         * note that these conditions are required in combination since some n
> onsense cells can form with values like "treatflag = 1 for _i == 0 ", which c
> an't occur in the data
.         * note also that this doesn't always work very well for continuous tr
> eatments - it is really only high value for the regular non contreat items
. 
.         * below, we will test to confirm that there isnt just something weird
>  going on w/ duplicative entries --
.         * check that the variable minus the omitteds isn't present somewhere.
.         * note that the white space below actually matters!
.         local checkifpresent = subinstr("``testbvar''","o.",".",.)
586.         local checkifpresent = subinstr("`checkifpresent'"," ","",.)
587.         if strpos("`bvars'"," `checkifpresent' ") == 0 {
588.           * passing into this if means that the omitted object isn't just 
> a duplicate of any actually existing object (which shouldn't usually happen a
> nyway)
.           * next, figure out exactly where the problem occurred
.           * proceed only if there is serious reason to believe the coef shoul
> d've existed
. 
.           * strip out the _i _t targetflag etc from the word as well as the h
> ashes
.           * what's left behind should be the values of _i and _t associated w
> ith the missing object
.           foreach word in b. . `_i' `_t' `targetflag' {
589.             local checkifpresent = subinstr("`checkifpresent'","`word'",""
> ,.)
590.           }
591.           local checkifpresent = subinstr("`checkifpresent'","#"," ",.)
592.           local problem_i = word("`checkifpresent'",1)
593.           local problem_t = word("`checkifpresent'",2)
594.           * 2 remaining cases. wordcount = 3, in which case what we have i
> s probably a dropped i-t dummy
.           * or wordcount > 3, in which case we have something else, like a co
> ntreat interaction
.           local wordcountproblem = wordcount("`checkifpresent'")
595. 
.           * are there observations falling in the _i _t cell associated with 
> the missing coefficient? if not, this isn't a problem
.           * note: this regrettably is a bit computationally intensive -- and 
> its result is
.           * consumed only through the r(N) gate below, whose branches ALL req
> uire
.           * wordcount <= 3, no lattice, or verbose: when the flagged term is 
> an interaction
.           * (wordcount > 3) with a lattice active and verbose off, nothing ca
> n consume the
.           * count, so skip the full-data pass entirely (lattice drops there a
> re expected)
.           if `wordcountproblem' <= 3 | "`lattice'" == "" | "`verbose'" != "" 
> {
596.           qui count if `_i' == `problem_i' & `_t' == `problem_t' & `target
> flag' == 1 & `w' > 0 & `ifstatement'
597.           if r(N) > 0 {
598.             * if we proceeded to this point, then the omitted object has a
> ssociated observations, so this is an actual problem!
. 
.             if `wordcountproblem' <= 3 {
599.               local problem_t = `problem_t' - `min_t' - 1
600.               dis as error  "Error: a treated cohort-period dummy coeffici
> ent was dropped for multicollinearity."
601.               if "`verbose'" != "" dis as error  "The specific problematic
>  coefficient is: ``testbvar''"
602.               if "`verbose'" != "" dis as error  "For reference, _i is `_i
> ', _t is `_t', and targetflag is `targetflag'"
603.               dis as error  "The problem seems to be with the treatment du
> mmy for `i' == `problem_i', relative-`t' == `problem_t'"
604.               dis as error  "Specify contreatwithin if you have a continuo
> us treatment intensity variable and wish to partial out any effect of treatme
> nt when the treatment intensity is 0."
605.               dis as error  "You can ignore this check if you specify safe
> ty(off), but be careful."
606.               dis as error  " "
607.               * verbose not specified triggers error here (rather than lat
> er after looping through them all )
.               if "`verbose'" == "" error 322
608.               local bigcatastrophe 1
609.             }
610.             if `wordcountproblem' > 3  & ("`lattice'" == "" | "`verbose'" 
> == "verbose"){
611.               * > 3 implies we have more than _i, _t, and targetflag (the 
> variable that is 1 for obs contributed to an estimate and 0 otherwise) formin
> g the dropped variable
.               * this implies it is not a main effect treatment dummy
.               local problem_t = `problem_t' - `min_t' - 1
612.               if `catastrophe' == 0 dis as text  "Caution: a treatment per
> iod coefficient interacted with something (likely, a term implementing a cont
> inuous treatment variable or an interactive control variable) was dropped for
>  multicollinearity."
613.               if `catastrophe' == 0 & "`lattice'" != "" dis as text  "If u
> sing a lattice, this is likely innocuous."
614.               if `catastrophe' == 0 dis as text  "This could imply your re
> sults are not identified, depending on exactly what was dropped."
615.               if `catastrophe' == 0 dis as text  "Re-estimate with option 
> verbose for details on what was dropped."
616.               if "`verbose'" != "" dis as text " "
617.               if "`verbose'" != "" dis as text  "The specific problematic 
> coefficient is: ``testbvar''"
618.               if "`verbose'" != "" dis as text  "For reference, _i is `_i'
> , _t is `_t', and targetflag is `targetflag'"
619.               if "`verbose'" != "" dis as text  "Given we are looking at s
> omething with an _i _t (other items here) structure,"
620.               if "`verbose'" != "" dis as text  "the problem values of `i'
>  and relative-`t' are `problem_i', `problem_t'."
621.               local catastrophe = `catastrophe' + 1
622.             }
623.           }
624.           }
625.         }
626.       }
627.     }
628.     }
629.     if `catastrophe' > 0 dis as text "Note: the multicollinearity caution 
> above was triggered `catastrophe' times total."
630.     if `bigcatastrophe' == 1 error 322
631.   }
632. 
. 
. 
. 
.   **** extract important parameters from the model  - N, R2, etc
.   * first, extract general parameters of interest from the regression
.   local N = e(N)
633.   local Nclus = e(N_clust)
634.   local ll = e(ll)
635.   local ll_0 = e(ll_0)
636.   if "`regtype'" != "poisson" local rmse = e(rmse)
637.   if "`regtype'" != "poisson" local rss = e(rss)
638.   if "`poisson'" == "poisson" {
639.     local r2pseud = e(r2_p)
640.     local chi2 = e(chi2)
641.   }
642.   else {
643.     local r2 = e(r2)
644.     local r2adj = e(r2_a)
645.     local r2_within = e(r2_within)
646.     local r2_withinadj = e(r2_a_within)
647.     local F = e(F)
648.   }
649. 
. 
. 
. 
. 
. 
.   ***************************************************************************
> ************************
.   ***********************  F3: ATT(g,t) BUILDING BLOCKS (gteffects)  ********
> ************************
.   ***************************************************************************
> ************************
.   * runs inside the "clean e() window": the stage-1 model stored above is sti
> ll the ACTIVE e()
.   * here, so this reads e(b)/e(V)/e(sample) directly - no restore, no e-class
>  command, and no
.   * effect on anything downstream. binary designs only (wooldid_validate refu
> ses contreat):
.   * the <g>._i#<t>._t#1.targetflag coefficients ARE the cohort-by-relative-pe
> riod effects on
.   * the regression scale. the name parse and table assembly live in the woold
> id_gtx mata
.   * function at the bottom of this file to conserve worker compiled-size head
> room.
.   local gtn 0
650.   if "`gteffects'" != "" {
651.     tempvar gtin gttag gtnob gtw1 gtw2 gtw3 gtw4
652.     qui gen byte `gtin' = e(sample) & `targetflag' == 1
653.     qui gegen double `gtnob' = total(`gtin') if `gtin', by(`_i' `_t')
654.     local gtj 0
655.     foreach gtwv in `w_att' `w_att_it' `w_att_i' `w_att_itime' {
656.       local ++gtj
657.       cap confirm variable `gtwv'
658.       if _rc == 0 qui gegen double `gtw`gtj'' = total(`gtwv') if `gtin', b
> y(`_i' `_t')
659.       else qui gen double `gtw`gtj'' = .
660.     }
661.     qui gegen byte `gttag' = tag(`_i' `_t') if `gtin'
662.     tempname gtraw gtsed gtm
663.     cap mkmat `_i' `_t' `ttre' `t' `gtnob' `gtw1' `gtw2' `gtw3' `gtw4' if 
> `gttag' == 1, matrix(`gtraw')
664.     if _rc == 0 {
665.       cap matrix `gtsed' = vecdiag(e(V))
666.       if _rc != 0 matrix `gtsed' = J(1, colsof(e(b)), .)
667.       local gthstart = 1 + `min_t' - `espre'
668.       if "`esfixedbaseperiod'" == "" local gthstart 1
669.       local gthend = `gthstart' + `espre' + `espl' - 1
670.       mata: wooldid_gtx("`_i'", "`_t'", "`targetflag'", "`gtraw'", "`gtsed
> '", `min_t', `gthstart', `gthend', "`df_r'", "`gtm'")
671.     }
672.     qui drop `gtin' `gtnob' `gtw1' `gtw2' `gtw3' `gtw4' `gttag'
673.   }
674. 
.   ***************************************************************************
> ***********************
.   *****************************         PRODUCE SUMMARY STATS       *********
> ***********************
.   ***************************************************************************
> ***********************
.   if "`summarystats'" == "summarystats" {
675. 
.     * include among the summary stats information on size of reference period
>  where relevant
.     if "`esfixedbaseperiod'" == "" &  `espre' > 0  {
676.       qui count if e(sample) & `_t' == 0 & `ttre' < .
677.       local Npre_trebase = r(N)
678.       qui count if e(sample) & `_t' != 0 & `ttre' < . & `t' < `ttre'
679.       local Npre_treused = r(N)
680.       local Npre_rat = round(100*`Npre_trebase' / (`Npre_trebase' + `Npre_
> treused'),.01)
681.       tempvar overt
682.       qui gen `overt' = `_t' == 0
683.       qui total `w' if e(sample) & `ttre' < . & `t' < `ttre',over(`overt')
684.       drop `overt'
685.       local Wpre_trebase = e(b)[1,2]
686.       local Wpre_treused = e(b)[1,1]
687.       local Wpre_rat = round(100*`Wpre_trebase' / (`Wpre_trebase' + `Wpre_
> treused'),.01)
688.       qui est restore ___wooldidfullmodel
689.     }
690. 
. 
.     * get some summary statistics on the outcome variable and the continuous 
> treatment variable (if existent) in the estimation sample
.     * this code block is inefficient / a result of some legacy choices
.     local rownamessum
691.     if "`contreat'" == "" local sumvarlist y
692.     if "`contreat'" != "" local sumvarlist y contreat
693.     * gstats sum accepts pweights directly, so the regression weights pass
>  through to these descriptive computations unchanged
.     foreach sumvar in `sumvarlist' {
694.       local sumvar2 c
695.       if "`sumvar'" == "y" local sumvar2 y
696.       qui gstats sum ``sumvar'' `weightinserter' if e(sample), detail
697.       local `sumvar'_mean = r(mean)
698.       local `sumvar'_med = r(p50)
699.       local `sumvar'_sd = r(sd)
700.       local `sumvar'_p25 = r(p25)
701.       local `sumvar'_p75 = r(p75)
702.       local `sumvar'_iqr = ``sumvar'_p75' - ``sumvar'_p25'
703.       local `sumvar'_min = r(min)
704.       local `sumvar'_max = r(max)
705.       local rownamessum `rownamessum' `sumvar2'_insample
706. 
.       * do the same in the pre-treatment treated sample
.       if "`sumvar'" == "y" | ("`contreatcontrols'" != "untreatedZero" & "`sum
> var'" == "contreat") {
