> PERMTci PERMSTRata(varname numeric) PERMPRobs(string asis)]
  3. 
. * Verify that the packages wooldid requires (reghdfe, ftools, gtools) are ins
> talled before doing anything else
. * ppmlhdfe is deliberately not checked here: it is only required for poisson 
> estimation and remains optional
.   local missingpackages
  4.   foreach requiredpackage in reghdfe ftools gtools {
  5.     cap which `requiredpackage'
  6.     if _rc != 0 {
  7.       dis as error "Error: wooldid requires the package `requiredpackage',
>  which does not appear to be installed."
  8.       dis as text "To install it, run: ssc install `requiredpackage', repl
> ace"
  9.       local missingpackages `missingpackages' `requiredpackage'
 10.     }
 11.   }
 12.   if "`missingpackages'" != "" error 198
 13. 
.   if "`verbose'" == "verbose" dis as text "Wooldid is processing input in pre
> paration for regression estimation."
 14. 
.  * This controls the names we use for ES plots; the new syntax is more compat
> ible with the program event_plot
.  if "`oldsyntax'" == "oldsyntax" {
 15.     local oldsyntax 1
 16.  }
 17.  else {
 18.     local oldsyntax 0
 19.  }
 20. 
.   **** Begin a block of checks that command info is correctly specified; erro
> r out if not. handle all syntax errors here
. 
.   * check that sufficient input is given - note that the error will occur aut
> omatically if > 4 is given
.   if wordcount("`varlist'") < 4 {
 21.     dis as error "Error: command line input should feature all of y i t tt
> re; too few variables specified."
 22.     error 198
 23.   }
 24. 
.   if wordcount("`varlist'") > 4 {
 25.     dis as error "Error: command line input should feature only y i t ttre
> ; too many variables specified."
 26.     error 198
 27.   }
