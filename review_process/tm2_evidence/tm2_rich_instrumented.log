.   * the return statement also passes N and dof count and the function flaggin
> g the estimation sample
.   cap ereturn post `eb' `ev', esample(`esamp') depname(`y') obs(`N') dof(`df_
> r')
2140.   local evpostrc = _rc
2141.   if `evpostrc' != 0 {
2142.     * partial-identification rescue: ereturn post rejects a VCE carrying 
> ANY missing diagonal cell,
.     * so one estimand with an unidentified SE (an IM ttest with a single cont
> ributing cluster, or a
.     * row nulled by the IM degeneracy guard) would otherwise cost every OTHER
>  estimand its posted
.     * variance. When at least one estimand IS identified, replace the missing
>  diagonal cells with a
.     * negative sentinel: Stata accepts it and every display/inference surface
>  renders it as a
.     * missing standard error (ereturn display/esttab show ., test drops the c
> onstraint, lincom
.     * returns ., sqrt() of it is missing), so nothing is fabricated. Runs wit
> h no identified
.     * estimand at all keep the b-only fallback below.
.     local evpostgood 0
2143.     local evpostmiss 0
2144.     * capture the count now: a successful ereturn post consumes `eb'/`ev'
> , so their
.     * dimensions are no longer available when the caution below is displayed
.     local evposttotal = colsof(`ev')
2145.     forval evpostd = 1/`evposttotal' {
2146.       if missing(`ev'[`evpostd',`evpostd']) local ++evpostmiss
2147.       else if `ev'[`evpostd',`evpostd'] > 0 & `ev'[`evpostd',`evpostd'] <
>  . local ++evpostgood
2148.     }
2149.     if `evpostgood' > 0 & `evpostmiss' > 0 {
2150.       forval evpostd = 1/`=colsof(`ev')' {
2151.         if missing(`ev'[`evpostd',`evpostd']) matrix `ev'[`evpostd',`evpo
> std'] = -1e100
2152.       }
2153.       cap ereturn post `eb' `ev', esample(`esamp') depname(`y') obs(`N') 
> dof(`df_r')
2154.       local evpostrc = _rc
2155.       if `evpostrc' == 0 {
2156.         dis as text "Caution: standard errors were not identified for `ev
> postmiss' of `evposttotal' reported estimates. e(V) contains placeholder entr
> ies for the affected estimates that display as missing standard errors; all o
> ther estimates retain their variances in e(V). See e(wdidmainresults) and the
>  displayed tables for per-estimate detail."
2157.       }
2158.     }
2159.     if `evpostrc' != 0 {
2160.       cap ereturn post `eb' , esample(`esamp') depname(`y') obs(`N') dof(
> `df_r')
2161.       if _rc != 0 ereturn post   , esample(`esamp') depname(`y') obs(`N')
>  dof(`df_r')
