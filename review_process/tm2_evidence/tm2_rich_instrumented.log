.   * verify that if continuous treatment effects plots are requested, we have 
> a lattice over which to produce them
.   if "`makecfxplots'" != "" & "`cfxlattice'" == "" & ("`lattice'"=="" ) {
 90.     dis as error  "Error: You requested continuous treatment effects plots
> , but either didn't specify a cfxlattice variable or a lattice option for the
>  continuous treatment."
 91.     error 198
 92.   }
 93. 
.   * oostreatedcontrols determines whether or not units treated after the end 
> of the sample window are allowed to contribute to pre-treatment horizons;
.   * cancel estimation if you specify a negative value here (corresponding wit
> h a within window treatment)
.   if `oostreatedcontrols' < 0 {
 94.     dis as error  "Error: oostreatedcontrols specified as < 0, indicating 
> that treatments occurring within sample should be ignored."
 95.     dis as error  "This is not allowed; you must specially set up cases of
>  this sort by modifying the ttre variable and the if statement."
 96.     error 198
 97.   }
 98. 
.   * anticipation() shifts the effective onset EARLIER (ttre - #); a negative 
> value would
.   * pretend onset is later, pushing genuinely treated periods into the contro
> l/reference
.   * pool - a silent identification failure. delayed-onset designs need their 
> own setup
.   if `anticipation' < 0 {
 99.     dis as error  "Error: anticipation specified as < 0, indicating that t
> reatment onset should be treated as occurring later than recorded."
100.     dis as error  "This is not allowed; if you need a delayed-onset design
> , modify the ttre variable and the if statement directly."
101.     error 198
102.   }
103. 
. 
.   * check that controls are specified alright - error out if c. and i. are no
> t specified for each variable
.   if "`coarsecohortcontrols'" != "" {
104.     foreach case in `coarsecohortcontrols' {
105.       if strpos("`case'","c.") == 0 & strpos("`case'","i.") == 0 {
106.         dis as error  "Error: Your coarse cohort controls do not all speci
> fy whether they are continuous or categorical. You must do this using i. and 
> c. style notation."
107.         error 198
108.       }
109.     }
110.   }
111. 
.   * extract information about requested continuous treatment and error out if
>  the user misspecified the information
.   if "`lattice'" != "" & wordcount("`lattice'") != 1 {
112.     if wordcount("`lattice'") >= 3  {
113.       dis as error  "Error: lattice incorrectly specified; requires 2 argu
> ments or a pre-made lattice variable"
114.       error 198
115.     }
116. 
.     local latticenum = word("`lattice'",2)
117.     * validate by VALUE, not spelling: every downstream quantile engine ac
> cepts
.     * integer-valued spellings like 02, +2, 2.0, and 1e2, so a confirm-intege
> r-number
.     * spelling check would reject inputs that work; conversely gquantiles sil
> ently
.     * remaps nquantiles <= 0 to its default (and forval builds a degenerate n
> o-op
.     * lattice), so 0/negatives must be caught here by value. missing-evaluati
> ng
.     * tokens fail confirm number or the mod() test (mod(., 1) != 0 is true)
.     cap confirm number `latticenum'
118.     if _rc != 0 {
119.       dis as error "Error: lattice incorrectly specified; `latticenum' is 
> not a valid number of lattice quantiles. lattice() requires a valid lattice t
> ype and an integer number of quantiles, or a pre-made lattice variable."
120.       error 198
121.     }
122.     if mod(`latticenum',1) != 0 {
123.       dis as error "Error: lattice incorrectly specified; the number of la
> ttice quantiles (`latticenum') must be an integer."
124.       error 198
125.     }
126.     if `latticenum' <= 1 {
127.       dis as error "Error: lattice incorrectly specified; latticenum must 
> be > 1 or else the lattice does not permit additional variation relative to n
> ot specifying a lattice at all."
128.       error 198
129.     }
130. 
.     local latticetype = word("`lattice'",1)
131.     if inlist("`latticetype'","all","baseTreated","baseTreatedPost","baseT
> reatedPre", "baseTreatedRef") == 0 & inlist("`latticetype'","byCohort","byTim
> e","byCohortByTime","byTreated","byTreatedByTime","byTtre","byTtreByTime") ==
>  0{
132.       dis as error  "Error: lattice type is misspecified; `latticetype' is
>  not a valid lattice type."
133.       error 198
134.     }
135.   }
136. 
.   * extract contreatcontrol type and error out if misspecified
.   if "`contreatcontrols'" != "" {
137.     foreach word in `contreatcontrols' {
138.       if inlist("`word'",  "byTreated", "byTtre", "byCohort", "byTime") ==
>  0 & inlist("`word'","basic","untreatedZero") == 0 {
139.         dis as error  "Error: continuous treatment control type misspecifi
> ed; `word' is not a valid continuous treatment control type."
140.         error 198
141.       }
142.     }
143.     if strpos("`contreatcontrols'","untreatedZero") != 0 & wordcount("`con
> treatcontrols'") > 1 {
144.       dis as error "Error: untreatedZero cannot be paired with other contr
> ol types"
145.       error 198
146.     }
147.   }
148. 
.   * error out if no contreatcontrol type is specified in a continuous treatme
> nt scenario
.   if "`contreatcontrols'" == "" & "`contreat'" != "" {
149.     dis as error "Error: contreatcontrols type not specified; you must spe
> cify this - substantive judgement is required."
150.     error 198
151.   }
152. 
.   * error out if you request continuous treatment controls w/o a continuous t
> reatment variable
.   if "`contreatcontrols'" != "" & "`contreat'" == "" {
153.     dis as error "Error: you cannot request continuous treatment controls 
> without specifying a continuous treatment variable."
154.     error 198
155.   }
156. 
.   * error out if a lattice is requested without a continuous treatment - the 
> lattice-construction
.   * code all sits inside the contreat block, so the option would otherwise be
>  silently ignored
.   if "`lattice'" != "" & "`contreat'" == "" {
157.     dis as error "Error: lattice() has no effect without contreat(); speci
> fy a continuous treatment variable or remove the lattice() option."
158.     error 198
159.   }
160. 
.  * issue warnings pertaining to cfxplot types
.   if "`makecfxplots'" != "" & ("`att_it'" == "att_it" | "`att_itime'" == "att
> _itime" | "`att_i'" == "att_i" )   {
161.     if "`safety'" == "off" {
162.       dis as text "Caution: interpretation of continuous treatment effects
>  plots for estimands other than the ATT is difficult unless i-t cells (and so
> metimes cohorts i) are wholly contained within lattice bins."
163.     }
164.     else{
165.       dis as text "Caution: interpretation of continuous treatment effects
>  plots for estimands other than the ATT is difficult unless i-t cells (and so
> metimes cohorts i) are wholly contained within lattice bins."
166.       dis as text "As such, wooldid will not produce these plots unless yo
> u specify safety(off)."
167.     }
168.   }
169. 
.   if `esprelength' < 0 {
170.     dis as error "Error: cannot accept negative values of esprelength."
171.     error 198
172.   }
173. 
.   * this implements a hack for estimability check failures in certain special
>  cases
.   if `espostlength' < 0  {
174.     if `espostlength' != -999  {
175.       dis as error "Error: cannot accept negative values of espostlength."
176.       error 198
177.     }
178.     local espostlength 0
179.     local esposttrip no
180.   }
181. 
.   if "`subgroups'" != "" &   `esprelength' > 0  & `espostlength' == 0 & "`esp
> osttrip'" == "" {
182.     local espostlength 1
183.     if "`safety'" != "off" dis as text "Caution: espostlength set to 1 due
>  to use of subgroups in conjunction with esprelength > 0."
184.     if "`safety'" != "off" dis as text "Without this modification, subgrou
> ps may crash if pre-treatment effects are not estimable for them."
185.     if "`safety'" != "off" dis as text "Specify espostlength(-999) to over
> ride this issue. Specify safety(off) to avoid seeing this message."
186.   }
187. 
. 
. 
.   ******** parsing for specification errors complete, begin processing input 
> on other dimensions, setting defaults, etc. handle errors that aren't purely 
> syntax here
. 
.   ******* process the raw inputs
. 
.   * extract y, i, t, and ttre from the main variable list
.   local y = word("`varlist'",1)
188.   local i = word("`varlist'",2)
189.   local t = word("`varlist'",3)
190.   local ttre_asgiven = word("`varlist'",4)
191. 
.   * F6: permutation-inference screens. deep checks live in the subprogram
.   * (wooldid_permctl) to conserve this program's compiled-size headroom
.   if "`permute'" == "" {
192.     local permstray
193.     if `permreps' != 0 local permstray permreps()
194.     if "`permexact'" != "" local permstray `permstray' permexact
195.     if "`permtstat'" != "" local permstray `permstray' permtstat
196.     if "`permtci'" != "" local permstray `permstray' permtci
197.     if "`permstrata'" != "" local permstray `permstray' permstrata()
198.     if `"`permprobs'"' != "" local permstray `permstray' permprobs()
199.     if "`permstray'" != "" {
200.       dis as error "Error: `permstray' require(s) the permute() option."
201.       error 198
202.     }
203.   }
204.   if "`permute'" != "" {
205.     cap noi wooldid_permctl , permute(`permute') permreps(`permreps') `per
> mexact' clus(`cluster') ttrevar(`ttre_asgiven') permstrata(`permstrata') perm
> probs(`permprobs') impv(`impvalues') uncond(`unconditionalse') cw(`contreatwi
> thin') os(`oldsyntax') ts(`permtstat') tc(`permtci') fn(`fastnose') cc(`contr
> eatcontrols') ifr(`if')
206.     if _rc != 0 error _rc
207.   }
208. 
.   * capture the user's own safety() input before any internal relaxation (con
> treatwithin sets
.   * the working copy to off further down); the identifying-assumption checks 
> gate on this copy
.   * so an internal relaxation does not silently disable them
.   local safetyinput `safety'
209. 
.   * register verbose retention with the shell's error-path cleanup epilogue (
> top of this
.   * file): under verbose, ___wooldidfullmodel (and _ppmlhdfe_d under poisson)
>  are
.   * documented as retained for inspection - on failed runs as well
.   if "`verbose'" == "verbose" global WOOLDID_CLEANUP $WOOLDID_CLEANUP keep
210. 
.   * the input-validity asserts below respect the user's if() restriction, mir
> roring the
.   * estimation sample construction exactly: the sample keeps rows where the i
> f expression
.   * evaluates to 1 (gen ifvar = `if' further down), so the asserts test (`if'
> ) == 1 --
.   * identical row selection for any expression shape, including bare flag var
> iables with
.   * nonzero or missing values, which a plain if-qualifier would wrongly inclu
> de. empty when
.   * no if() is given, leaving the asserts running over the full dataset exact
> ly as before
.   local ifassert
211.   if `"`if'"' != "" local ifassert if (`if') == 1
212. 
.   * check that i is specified acceptably
.   if "`safety'" != "off" {
213.     cap assert `i' > 0  & int(`i') == `i' `ifassert'
214.     if _rc != 0 {
215.       dis as error  "Error: `i' must consist of positive, non-zero integer
> s, but does not"
216.       error 411
217.     }
218.   }
219. 
.   * if poisson, check that y is not negative
.   if "`poisson'" != "" {
220.     cap assert `y' >= 0 `ifassert'
221.     if _rc != 0 {
222.       dis as error "Error: the outcome variable contains negative values; 
> this is not allowed with poisson."
223.       error 411
224.     }
225.   }
226. 
. 
.   ****** process other aspects of the command syntax
. 
.   * if no elasticity type specified, assume regular non-elasticity estimates;
>  a supplied
.   * but unrecognized value is rejected by the domain screen at the end of thi
> s program
.   * (formerly any unrecognized value collapsed silently to dydx)
.   if "`contreatelasticitytype'" == "" local contreatelasticitytype dydx
227.   if "`semielasticity'" == "" {
228.     local semielasticity dydx
229.   }
230.   else {
231.     local semielasticity eydx
232.   }
233. 
.   * do some light processing of the "number of pre-treatment coefs" input - i
> t needs some adjustment when esfixedbaseperiod is used since the period norma
> lized to 0 could fall within your range of requested coefs
.   if "`esfixedbaseperiod'" == "esfixedbaseperiod" &   `esprelength' > 0  {
234.     if abs(`esrelativeto') <= `esprelength' local ++esprelength
235.     * this is needed b/c we arent counting the reference period coef as a 
> coef
.   }
236. 
.   * process the joint tests suppression flag  - it is on by default unless jo
> inttests is specified
.   local suppressjointtests suppressjointtests
237.   if "jointtests" == "`jointtests'" local suppressjointtests
238. 
.   * what type of results do we want estimated  - if nothing specified, defaul
> t estimand to att
.   if "`att'" == "" & "" == "`att_it'" & "" == "`att_itime'" & "" == "`att_i'"
>  {
239.     local att att
240.   }
241. 
.   * handle contreatwithin - indicator to use only within variation
.   * crash if probably illegitimate contreatcontrols are specified
.   * also, set safety to off
.   if "`contreatwithin'" == "contreatwithin" & "`contreat'" != "" {
242.     if strpos("`contreatcontrols'","byTime") != 0  {
243.       if "`safety'" == "off" dis as text "Caution: contreatwithin is speci
> fied in conjunction with the byTime contreatcontrol type."
244.       if "`safety'" != "off" dis as error "Error: contreatwithin is specif
> ied in conjunction with the byTime contreatcontrol type."
245.       if "`verbose'" == "verbose" dis as text "Typically, this partials ou
> t some treatment effects and yields unidentified estimates."
246.       if "`safety'" != "off" {
247.         dis as error "To proceed anyway in a new estimation run, manually 
> set safety(off) before proceeding."
248.         error 198
249.       }
250.     }
251.     local safety off
252.     * the above is required since we are intentionally making the base eff
> ects irrelevant
.   }
253. 
. 
.   * process cfxplottypes
.   * note that the tests here on what cfxplottypes are allowed are kinda weak 
> in that you can request impractical relative periods (relyrs) and such, but b
> etter than no checks
.   if "`makecfxplots'" != "" {
254.     local cfxpost 0
255.     local cfxpre 0
256.     local cfxrelyrlist
257.     if "`cfxplottypes'" == "" local cfxplottypes post
258.     * VAL-G13A: exact-token parse. the old substring matching accepted gar
> bage tokens
.     * (postpost counted as post, 2post2 became 2 2), and fractional numeric e
> ntries fell
.     * through both cap'd window filters silently (rc 0, no plot, no message).
>  keywords are
.     * matched exactly per token; numeric tokens must be non-missing integers,
>  loudly.
.     foreach item in `cfxplottypes' {
259.       if "`item'" == "post" {
260.         local cfxpost 1
261.         continue
262.       }
263.       if "`item'" == "pre" {
264.         * without esf or pre-periods, pre is dropped (documented precondit
> ion in the sthlp)
.         if "`esfixedbaseperiod'" == "esfixedbaseperiod" | `esprelength' > 0 l
> ocal cfxpre 1
265.         continue
266.       }
267.       * remaining entries must be numeric: a stray token would otherwise b
> e evaluated as a
.       * variable reference below -- crashing with an unexplained r(111) if no
>  such variable
.       * exists, or silently injecting the variable into the plot list if one 
> does (stata
.       * does not short-circuit |, so the reference-period comparison always r
> uns)
.       cap confirm number `item'
268.       if _rc != 0 {
269.         dis as error "Error: cfxplottypes() contains an unrecognized entry
> : `item'"
270.         dis as error "Valid cfxplottypes() entries are post, pre, and/or i
> ntegers specifying relative time periods."
271.         error 198
272.       }
273.       * a leading + is a natural way to write positive relative years (+2,
>  matching -2), but
.       * the raw token is later embedded in matrix names, where + is an invali
> d character;
.       * strip it so +2 means 2 (and the post-loop dedup then also collapses +
> 2 with 2)
.       if substr("`item'",1,1) == "+" local item = substr("`item'",2,.)
