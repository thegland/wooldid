 27.     frame create `__wooldidframe'
 28.     frame change `__wooldidframe'
 29.     qui svmat double `wdidpooled', names(col)
 30.     qui gen rownamesvar = ""
 31.     local names : roweq `wdidpooled'
 32.     forvalues i=1/`: word count `names'' {
 33.       qui replace rownamesvar=`"`: word `i' of `names''"' in `i'
 34.     }
 35.     qui drop if relyr == .
 36.     qui glevelsof(rownamesvar), clean local(graphtypes)
 37.     qui gen postperiod =  relyr >= 0
 38.     keep   postperiod relyr  estimate lb_95ci ub_95ci rownamesvar
 39. 
.     * add the pre treatment observation / reference period
.     if "`esfixedbaseperiod'" == "" {
 40.       local newN = _N + 1
 41.       qui gstats sum relyr, meanonly
 42.       local max = r(max)
 43.       local min = r(min)
 44.       local initialflagt = r(min) - 1
 45.       qui set obs `newN'
 46.       qui replace relyr = `initialflagt' if _n == _N
 47.       qui replace lb_95ci = 0 if _n == _N
 48.       qui replace ub_95ci = 0 if _n == _N
 49.       qui replace estimate = 0 if _n == _N
