. do probeB1.do 

. * theoryB verification probe (single dataset, NOT a Monte Carlo)
. * Purpose: verify three deterministic/algebraic structural predictions on one
>  d1-style draw:
. *   (P1) byCohort + cluster(i): visible-slope CRVE block annihilated -> ame S
> Es ~ machine zero
. *   (P2) byTime  + cluster(i): V_es_ame full rank, horizon-varying SEs, adver
> sarial POSTS
. *   (P3) within-arm (basic+contreatwithin+safety(off)) numerically identical 
> to basic
. * plus re-confirm (P0) basic + cluster(i) rank-1 collapse with all SEs = SE(p
> hihat).
. clear all

. set more off

. set maxvar 20000


. * IMPORTANT: a stale wooldid.ado (2024-07-31) lives in the PLUS adopath and w
> ins over
. * `adopath +` (which appends). Load the repo build directly so in-memory prog
> rams win.
. qui do "/Users/hegland/Documents/Research/wooldid_dev/wooldidinstall/wooldid.
> ado"

. set seed 987654321

. set sortseed 987654321

. 
. * ---- d1-style DGP: 30 cohorts, 6 units/cohort, t=1..12, even i treated at t
> =6
. set obs 180
Number of observations (_N) was 0, now 180.

. gen i = ceil(_n/6)

. gen unitid = 1000 + _n

. gen dose = rnormal(1,1)          // unit-level dose, constant within unit ove
> r time (d1)

. gen cohfe = rnormal(0,1)

. bysort i (unitid): replace cohfe = cohfe[1]
(150 real changes made)

. expand 12
(1,980 observations created)

. bysort unitid: gen t = _n

. gen ttre = 6 if mod(i,2)==0
(1,080 missing values generated)

. gen y = cohfe + .05*t + rnormal(0,1)   // dose NEVER enters y

. tempfile d1

. save `d1'
file /var/folders/ls/yldcbdg94wq_f401f_nynbsc0000gn/T//St26639.000002 saved
    as .dta format

. 
. capture program drop vsummary

. program define vsummary
  1.   * summarize e(V_es_ame): diag range, eigenvalues, min offdiag corr
.   cap matrix VV = e(V_es_ame)
  2.   if _rc != 0 {
  3.     dis as result "V_es_ame: NOT POSTED"
  4.     exit
  5.   }
  6.   matrix bb = e(b_es_ame)
  7.   local k = colsof(VV)
  8.   dis as result "V dims: " rowsof(VV) " x " `k'
  9.   * count missing entries; build a missing-patched copy for eigen
.   local nmiss 0
 10.   matrix VP = VV
 11.   forval a = 1/`k' {
 12.     forval bq = 1/`k' {
 13.       if VV[`a',`bq'] >= . {
 14.         local ++nmiss
 15.         matrix VP[`a',`bq'] = 0
 16.       }
 17.     }
 18.   }
 19.   dis as result "n missing entries: " `nmiss'
 20.   local dmin = .
 21.   local dmax = .
 22.   forval a = 1/`k' {
 23.     if VV[`a',`a'] < `dmin' local dmin = VV[`a',`a']
 24.     if (VV[`a',`a'] > `dmax' & VV[`a',`a'] < .) | `dmax' == . local dmax =
>  VV[`a',`a']
 25.   }
 26.   local cmin = .
 27.   local cmax = .
 28.   forval a = 1/`k' {
 29.     forval bq = 1/`k' {
 30.       if `a' < `bq' & VV[`a',`bq'] < . & VV[`a',`a'] > 0 & VV[`bq',`bq'] >
>  0 {
 31.         local cc = VV[`a',`bq']/sqrt(VV[`a',`a']*VV[`bq',`bq'])
 32.         if `cc' < `cmin' | `cmin' == . local cmin = `cc'
 33.         if (`cc' > `cmax' & `cc' < .) | `cmax' == . local cmax = `cc'
 34.       }
 35.     }
 36.   }
 37.   dis as result "V diag min/max: " `dmin' " / " `dmax'
 38.   dis as result "offdiag corr min/max: " `cmin' " / " `cmax'
 39.   cap matrix symeigen X L = VP
 40.   if _rc == 0 {
 41.     dis as result "eigenvalues (missing-patched V):"
 42.     matrix list L, format(%14.0g)
 43.   }
 44.   else dis as result "symeigen failed rc " _rc
 45.   dis as result "raw V_es_ame:"
 46.   matrix list VV, format(%12.0g)
 47.   dis as result "b_es_ame:"
 48.   matrix list bb, format(%12.0g)
 49.   dis as result "adversarial_pval_ame = " e(adversarial_pval_ame)
 50.   dis as result "es_ndegen_ame = " e(es_ndegen_ame)
 51. end

. 
