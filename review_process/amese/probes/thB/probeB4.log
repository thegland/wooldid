. do probeB4.do 

. * theoryB probe 4: d3 deterministic behavior (cell-constant dose) + d1 robust
> /unit-cluster sanity
. clear all

. set more off

. set maxvar 20000


. qui do "/Users/hegland/Documents/Research/wooldid_dev/wooldidinstall/wooldid.
> ado"

. set seed 24681357

. set sortseed 24681357

. 
. * base panel
. set obs 180
Number of observations (_N) was 0, now 180.

. gen i = ceil(_n/6)

. gen unitid = 1000 + _n

. gen udose = rnormal(1,1)          // unit-level dose for d1

. gen cohfe = rnormal(0,1)

. bysort i (unitid): replace cohfe = cohfe[1]
(150 real changes made)

. expand 12
(1,980 observations created)

. bysort unitid: gen t = _n

. gen ttre = 6 if mod(i,2)==0
(1,080 missing values generated)

. gen y = cohfe + .05*t + rnormal(0,1)

. * d3a: cohort-level dose, time-invariant
. gen d3adose = mod(i,7) + 0.5

. * d3b: cohort-by-period dose (cell-constant, time-varying)
. gen d3bdose = mod(i,7) + 0.3*mod(t,4) + 0.5

. tempfile base

. save `base'
file /var/folders/ls/yldcbdg94wq_f401f_nynbsc0000gn/T//St27259.000002 saved
    as .dta format

. 
. capture program drop f2check

. program define f2check
  1.   foreach mm in b_es_ame V_es_ame {
  2.     cap matrix chk = e(`mm')
  3.     if _rc == 0 & rowsof(chk) + colsof(chk) > 2 dis as result "  e(`mm'): 
> " rowsof(chk) " x " colsof(chk)
  4.     else dis as result "  e(`mm'): ABSENT"
  5.     cap matrix drop chk
  6.   }
  7.   cap matrix chk2 = e(V_es_ame)
  8.   if colsof(chk2) > 1 {
  9.     mata: V = st_matrix("chk2"); printf("  diag min %10.6g max %10.6g\n", 
> min(diagonal(V)), max(diagonal(V)))
 10.     mata: ev = symeigenvalues(st_matrix("chk2")); printf("  eig max %10.6g
>  min %10.3g\n", max(ev), min(ev))
 11.   }
 12.   cap matrix drop chk2
 13.   dis as result "  adversarial_pval_ame = " e(adversarial_pval_ame)
 14. end

. 
. use `base', clear

. dis as result "===== D3A basic cluster(i)  [cohort-constant dose] ====="
