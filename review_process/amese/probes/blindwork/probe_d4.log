126. 
.   if "`part'" == "roth" {
127.   * replay-only: redisplay the Roth (2022) pre-trend power block from e(roth_*) without
.   * re-running the quadrature (the NIS computation can cost minutes). cautions that are
.   * reconstructible from posted e() ARE replayed (rank-deficiency from roth_keff vs
.   * roth_npre; interrupted-pass and completed-but-unavailable states from roth_ok);
.   * per-type estimation-time skip cautions remain live-only. on the live path the worker
.   * calls wooldid_ptp itself between part(1) and part(2), so this part is never run live.
.   * NOTE (deliberate replay-contract exception): the roth_ok reads below consult an e()
.   * member without a wdid_replayv bump - the only affected window is same-day pre-marker
.   * dev stores, and the degradation is a conservative caution + skip, versus a bump
.   * refusing every older store
.   * NFPTP-07: e(roth_ok) is written after a completed diagnostics pass; the worker runs
.   * wooldid_ptp under cap noi with individually-cap'd ereturns, so an abort partway
.   * through the type loop leaves earlier types' roth_* in e() with no marker. formerly
.   * nothing read the marker, so replay presented an interrupted pass as complete
.   local rothany 0
128.   foreach ptpty in att att_it ame ame_it {
129.     cap confirm matrix e(roth_power_`ptpty')
130.     if _rc == 0 local rothany 1
131.   }
132.   if `rothany' & e(roth_ok) != 1 {
133.     dis as text "Caution: the stored pretrendpower() diagnostics are incomplete (the diagnostics pass was interrupted); partial results are not replayed. Refit wooldid to recompute them."
134.   }
135.   else if `rothany' == 0 & e(roth_ok) == 1 {
136.     dis as text "Caution: pretrendpower() was requested, but no event-study coefficient vector with a valid variance-covariance matrix was available (e.g. under timetrends); no diagnostics were computed."
137.   }
138.   else if `rothany' & e(roth_ok) == 1 {
139.   local dfr = e(df_r)
140.   local ptpdfok 0
141.   if "`dfr'" != "" & "`dfr'" != "." {
142.     if real("`dfr'") > 0 & real("`dfr'") < . local ptpdfok 1
143.   }
144.   local ptpref `e(wdid_esrel)'
145.   local ptpheader 0
146.   foreach ptpty in att att_it ame ame_it {
147.     cap confirm matrix e(roth_power_`ptpty')
148.     if _rc != 0 continue
149.     local ptpk = e(roth_npre_`ptpty')
150.     local ptpkeff = e(roth_keff_`ptpty')
151.     local ptpslope = e(roth_slope_`ptpty')
152.     local ptpse = e(roth_slope_se_`ptpty')
153.     local ptpll = e(roth_slope_ll_`ptpty')
154.     local ptpul = e(roth_slope_ul_`ptpty')
155.     local ptpprep = e(roth_prep_`ptpty')
156.     local ptphbar = e(roth_hbar_`ptpty')
157.     local ptpW = e(roth_W_`ptpty')
158.     local ptpnisok = ("`e(roth_nissize_`ptpty')'" != "")
159.     local ptpnissize = e(roth_nissize_`ptpty')
160.     * NFPTP-02/07: the rank-deficiency disclosure is reconstructible from e() and is
.     * now replayed (byte-identical text and position: live prints it pre-header)
.     if `ptpkeff' < `ptpk' dis as text "Caution: the `ptpty' pre-period variance-covariance block is rank-deficient (rank `ptpkeff' of `ptpk'). The slope, its CI, the joint test (now `ptpkeff' degrees of freedom), and the detectable-trend 
> columns then reflect only the linearly independent subset of pre-period coefficients a generalized inverse retains - NOT a summary of all pre-period evidence - and can differ arbitrarily from statistics built on the discarded coefficients
> ; interpret with care."
161.     if `ptpheader' == 0 {
162.       dis as result " "
163.       dis as result "Pre-Trend Power Diagnostics (Roth 2022):"
164.       local ptpheader 1
165.     }
166.     dis as result "  `ptpty': GLS linear pre-trend fit on `ptpk' pre-treatment coefficient(s); reference relative period = `ptpref'"
167.     dis as result "    slope = " %-9.0g `ptpslope' " (se " %-9.0g `ptpse' "; 95% CI " %-9.0g `ptpll' " to " %-9.0g `ptpul' ")"
168.     if `ptpdfok' dis as result "    joint pre-trend test: F(`ptpkeff', `dfr') = " %-8.0g `=`ptpW'/`ptpkeff'' ", p = " %-6.4f `ptpprep'
169.     else dis as result "    joint pre-trend test: chi2(`ptpkeff') = " %-8.0g `ptpW' ", p = " %-6.4f `ptpprep'
170.     if `ptpnisok' dis as result "    size of the any-pre-period-individually-significant pre-test: " %-6.4f real("`ptpnissize'")
171.     if !`ptpnisok' & `ptpk' > 4 dis as text "    note: mdt_nis and the NIS-test size are omitted (`ptpk' pre-periods exceed the exact-quadrature budget of 4); mdt_wald is unaffected. For the NIS convention at larger k, feed e(b_es_`ptp
> ty')/e(V_es_`ptpty')/e(numpre_`ptpty') to Roth's pretrends package."
172.     dis as result "    weighted mean post-treatment relative period (hbar) = " %-9.0g `ptphbar'
173.     dis as result "    minimum detectable linear trend, and the bias such a trend would imply for the"
174.     dis as result "    `ptpty' pooled estimand if it continued into the post-treatment period:"
175.     * NFPTP-03: the att_it/ame_it block is the shared event-study curve; when the user
.     * requested att_i/att_itime the block stands in for them but its hbar/bias columns
.     * use att_it-family post-period weights - say so rather than implying the requested
.     * pooled estimand's own weighting. exact-token match (att_i is a prefix of att_it
.     * and att_itime; cf. the cfxplottypes exact-token precedent)
.     if inlist("`ptpty'", "att_it", "ame_it") {
176.       local ptpsurr
177.       local ptpests `e(wdid_estimands)'
178.       if `: list posof "att_i" in ptpests' > 0 local ptpsurr att_i
179.       if `: list posof "att_itime" in ptpests' > 0 local ptpsurr `ptpsurr' att_itime
180.       if "`ptpsurr'" != "" {
181.         if "`ptpty'" == "ame_it" local ptpsurr = subinstr("`ptpsurr'", "att", "ame", .)
182.         dis as text "    note: this `ptpty'-weighted diagnostic stands in for the requested `ptpsurr' estimand(s); its hbar and bias columns use `ptpty' post-period weights."
183.       }
184.     }
185.     matlist e(roth_power_`ptpty'), format(%12.4g)
186.     dis as text "    note: mdt_wald powers the joint pre-trend test above; mdt_nis powers the test that any"
187.     dis as text "    pre-period coefficient is individually significant (the convention of Roth's pretrends package)."
188.     if "`poisson'" == "poisson" & "`e(wdid_poisexp)'" == "" dis as text "    note: poisson event-study coefficients are on the linear-index (xb) scale, and so are these diagnostics."
189.   }
190.   }
191.   }
192. 
.   if "`part'" == "2" {
193.   dis as result  " "
