324.     qui gegen double `f13sgimin' = min(cond(`subgroups' >= ., ., `subgroups')) if `ifstatement' & `ttre' != ., by(`i')
325.     qui gegen double `f13sgimax' = max(cond(`subgroups' >= ., ., `subgroups')) if `ifstatement' & `ttre' != ., by(`i')
326.     cap assert `f13sgimin' == `f13sgimax' if `ifstatement' & `ttre' != .
327.     if _rc != 0 {
328.       if "`safetyinput'" != "off" {
329.         dis as error "Error: the subgroup variable `subgroups' splits some units of `i' across multiple subgroups over time. A unit cannot belong to more than one subgroup."
330.         dis as error "To proceed anyway, specify safety(off): by-subgroup att and att_it then weight each observation to its own subgroup as usual, while att_i and att_itime enter a split unit into each subgroup weighted by its share o
> f sample weight there, rather than with the equal unit weighting those estimands normally imply."
331.         error 459
332.       }
333.       else dis as text "Caution: the subgroup variable `subgroups' splits some units of `i' across multiple subgroups over time; proceeding under safety(off) using share weighting. att_i and att_itime enter a split unit into each subgr
> oup weighted by its share of sample weight there, rather than with the equal unit weighting those estimands normally imply; by-subgroup att and att_it results are unaffected."
334.     }
335.     qui drop `f13sgimin' `f13sgimax'
336.     * long subgroup values overflow stata's 31/32-character name limits when embedded in
