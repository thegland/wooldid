1448.                 }
1449.                 if "`relyrbysg'" == "" {
1450.                   local relyrbysg  `relyrinj'
1451.                 }
1452.                 else{
1453.                   local relyrbysg `relyrbysg' ,  `relyrinj'
1454.                 }
1455.               }
1456.               tempname relyrcolumn_s`sgcase'
