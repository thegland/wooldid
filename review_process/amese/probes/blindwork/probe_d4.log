 30.   local Wpre_rat `e(wdid_wprat)'
 31.   local esfixedbaseperiod
 32.   if "`e(estimate_type)'" == "fixed_reference_period" local esfixedbaseperiod esfixedbaseperiod
 33.   local N = e(N)
 34.   local Nclus = e(Nclus)
