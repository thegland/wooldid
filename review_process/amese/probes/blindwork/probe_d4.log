1949.       if "`poisson'" == "" matrix colnames `pwsgs' =  estimate se t p lb_95ci ub_95ci
1950.       if "`poisson'" == "poisson" matrix colnames `pwsgs' =  estimate se z p lb_95ci ub_95ci
1951. 
.     }
1952.   }
1953. 
