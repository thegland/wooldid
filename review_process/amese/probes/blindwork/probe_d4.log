1193. 
.           * proceed for continuous treatment
.           local itemtext = subinstr("`item'","att","ame",.)
1194.           qui margins [`weight'=`w_`item''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1  `cfxif') noestimcheck over(`cfxlatticeplot') `cfxseopt' `poismarginstext'
1195.           tempname cfx`itemtext'_`nametext'
1196.           matrix `f9tab' = r(table)
1197.           if rowsof(`f9tab') < 6 {
1198.             matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1199.             matrix rownames `f9tab' = b se t pvalue ll ul
1200.           }
