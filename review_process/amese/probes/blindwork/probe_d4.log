1074.         local im_ul = `b' - invt(r(df_t),.025)*`se'
1075.         if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
1076.           local se .
1077.           local imt .
1078.           local imp .
1079.           local im_ll .
1080.           local im_ul .
