1473.                     matrix `adversarialB_`horizitem'_s`sgcase'' = r(line)
1474.                   }
1475.                 }
1476.                 else dis as text "Caution: the adversarial pre-trend test was skipped for subgroup `sgcase': too few event-study coefficients."
1477.               }
1478.             }
1479.           }
1480.         }
