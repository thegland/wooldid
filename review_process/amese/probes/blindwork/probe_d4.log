.       ********** average marginal effects by horizon  horizons
.       if `espre' + `espl' > 0  {
1271.         local horizitem att
1272.         if "`item'" != "att" local horizitem att_it
1273.         cap confirm  matrix `___C`horizitem'_horiz'
1274.         * this prevents estimating horizons if done already for a non att
.         if _rc != 0 {
1275.           tempname ___C`horizitem'_horiz
1276. 
.           if "`impvalues'" == "" {
1277.             qui  margins [`weight'=`w_`horizitem''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1  & `_t' >= `horizonstarter' & `_t' <= `horizonend' ) noestimcheck   over(`_t') `poismarginstext' `mar
> ginsdof'
1278.             matrix `f9tab' = r(table)
1279.             if rowsof(`f9tab') < 6 {
1280.               matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1281.               matrix rownames `f9tab' = b se t pvalue ll ul
1282.             }
1283.             matrix `___C`horizitem'_horiz' = (`f9tab'[1..6, 1..`=colsof(r(b))']',`relyrcolumn')
1284.             * F2: capture event-study b/V (relyr-labeled) for honestdid/lincom/test [pure-add]
.             if "`marginsdof'" != "nose" {
1285.               tempname f2bmat f2vmat
1286.               matrix `f2bmat' = r(b)[1, 1..`=colsof(r(b))']
1287.               matrix `f2vmat' = r(V)[1..`=colsof(r(b))', 1..`=colsof(r(b))']
1288.               local f2k = cond("`horizitem'"=="att","ame","ame_it")
1289.               local f2b_`f2k' `f2bmat'
1290.               local f2v_`f2k' `f2vmat'
1291.               local f2keys `f2keys' `f2k'
1292.               local f2rl_`f2k'
1293.               forval f2ri = 1/`=rowsof(`relyrcolumn')' {
1294.                 local f2rv = `relyrcolumn'[`f2ri',1]
1295.                 if `f2rv' < 0  local f2rl_`f2k' `f2rl_`f2k'' pre`=abs(`f2rv')'
1296.                 else          local f2rl_`f2k' `f2rl_`f2k'' post`f2rv'
1297.               }
1298.             }
1299.             * NFADV-01/02/05: adversarial statistics + display line via wooldid_advstat
.             * (see the binary twin above; only the estimability guard stays in-worker)
.             local finaladvtest
1300.             cap confirm matrix r(b)
1301.             if _rc == 0 {
1302.               local finaladvtest  `=colsof(r(b))'
1303.             }
1304.             if "`finaladvtest'" == ""  | "`finaladvtest'" == "." local finaladvtest 0
1305.             if `finaladvtest' <= 1 {
1306.               * see the binary twin above: Caution only when a pending test is called off
.               if "`adversarial'" == "adversarial" dis as text "Caution: adversarial pre-trend testing was cancelled: too few event-study coefficients were estimated to fit the reference line."
1307.               local adversarial
1308.             }
1309.             if "`adversarial'" == "adversarial"    {
1310.               wooldid_advstat , b(`f2bmat') v(`f2vmat') relyr(`relyrcolumn') mint(`min_t') esrel(`esrelativeto') dfr(`df_r') esf(`esfixedbaseperiod') tt(`timetrends') alt(`altmethod_adversarial')
1311.               local advstatus `r(status)'
1312.               if "`advstatus'" == "gapskip" local adversarial
1313.               else {
1314.                 if "`advstatus'" == "ok" local adversarialP_C`horizitem' = r(p)
1315.                 tempname adversarialB_C`horizitem'
1316.                 matrix `adversarialB_C`horizitem'' = r(line)
1317.               }
1318.             }
1319.             * end adversarial pre-trend handling
.           }
1320. 
.           *constraints on margins setup requires looping through horizons
.           if "`impvalues'" == "impvalues" {
1321.             local currenthoriz 1
1322.             tempname horizhold
1323.             foreach horizon in `horizlist' {
1324.               qui margins [`weight'=`w_`horizitem''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `_t' == `horizon' & `targetflag'==1  ) noestimcheck   over(`cluster') `poismarginstext' nose
1325.               tempname ibmucoefs
1326.               tempname ibmuframe
1327.               matrix `ibmucoefs' =  r(b)[1, 1..`=colsof(r(b))']'
1328.               frame create `ibmuframe'
1329.               frame change `ibmuframe'
1330.               qui svmat double `ibmucoefs'
1331.               qui gstats sum `ibmucoefs'1, meanonly
1332.               local b = r(mean)
1333.               qui ttest `ibmucoefs'1 == 0
1334.               local se = r(se)
1335.               local imt = r(t)
1336.               local imp = r(p)
1337.               local im_ll = `b' + invt(r(df_t),.025)*`se'
1338.               local im_ul = `b' - invt(r(df_t),.025)*`se'
1339.               if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
1340.                 local se .
1341.                 local imt .
1342.                 local imp .
1343.                 local im_ll .
1344.                 local im_ul .
1345.                 if "`imdegwarned'" == "" {
1346.                   dis as text "`imdegmsg'"
1347.                   local imdegwarned 1
1348.                 }
1349.               }
1350.               if `currenthoriz' == 1 matrix `horizhold' = (`b',`se', `imt', `imp', `im_ll', `im_ul')
1351.               if `currenthoriz' >1  matrix `horizhold' = `horizhold' \ (`b',`se', `imt', `imp', `im_ll', `im_ul')
1352.               frame change `defaultframe'
1353.               frame drop `ibmuframe'
1354.               local ++currenthoriz
1355.               matrix drop `ibmucoefs'
1356.             }
1357.             matrix `___C`horizitem'_horiz' = ( `horizhold',`relyrcolumn')
1358.           }
1359.         }
1360.       }
