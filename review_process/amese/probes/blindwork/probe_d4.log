.   ***************************************************************************************************************************
.   ****************************         EVENT-STUDY COMPOSITION DIAGNOSTICS (F8)       **************************************
.   ***************************************************************************************************************************
.   * per reported horizon: distinct treatment-onset cohorts, distinct units of i (= the number of
.   * unit-by-period coefficients averaged at that horizon), distinct clusters, estimation-sample
.   * observations, and the horizon's share of the reported-window treated weight under both weight
.   * concepts the event studies use (w_att = w x customweightmultiplier; w_att_it = that divided by
.   * the i-by-t cell weight total, replicating the weight construction above - the tempvars
.   * themselves are estimand-gated and w_per_it is already dropped, so the shares are recomputed
.   * here so the matrix has fixed width regardless of which estimands were requested). rows come
.   * from the SAME relyrcolumn / relyrcolumn_s<sg> sources as the reported ES matrices, so they
.   * align one-for-one with the ES_* blocks (horizons without a surviving coefficient get no row).
.   * composition is a descriptive counts-and-totals screen, not a test: flat columns rule out
.   * changes in these REPORTED summaries (a cohort entering/leaving, a unit-count or weight-mass
.   * shift); they do not rule out turnover of WHICH units contribute at unchanged counts, since
.   * identities are not stored. moving columns do not by themselves establish composition bias.
.   * this block runs NO margins call and NO e-class command, so the active e() is untouched and no
.   * est restore is needed. it DOES clear r(); nothing between here and the ereturn post consumes
.   * r(). gtools by() is hash-based: the user's sort order is not disturbed.
.   local f8keys
1954.   if `espre' + `espl' > 0 {
1955.     tempvar f8wa f8wpit f8wit
1956.     qui gen double `f8wa' = `w' `customweighttext'
1957.     qui gegen double `f8wpit' = total(`esamp' * `w'), by(`i' `t')
1958.     qui gen double `f8wit' = `f8wa'/`f8wpit'
1959.     qui replace `f8wit' = 0 if `f8wit' == .
1960.     local f8cluster
1961.     if "`cluster'" != "" & wordcount("`cluster'") == 1 local f8cluster `cluster'
1962.     tempvar f8in f8tagc f8tagi f8tagcl f8tagt f8nc f8nu f8ncl f8n f8w f8wi
1963.     qui gen byte `f8in' = (`esamp' == 1 & `targetflag' == 1 & `_t' >= `horizonstarter' & `_t' <= `horizonend')
1964.     qui gegen byte   `f8tagc'  = tag(`_t' `ttre') if `f8in'
1965.     qui gegen byte   `f8tagi'  = tag(`_t' `_i')   if `f8in'
1966.     qui gegen byte   `f8tagt'  = tag(`_t')        if `f8in'
1967.     qui gegen long   `f8nc'    = total(`f8tagc') if `f8in', by(`_t')
1968.     qui gegen long   `f8nu'    = total(`f8tagi') if `f8in', by(`_t')
1969.     if "`f8cluster'" != "" {
1970.       qui gegen byte `f8tagcl' = tag(`_t' `f8cluster') if `f8in'
1971.       qui gegen long `f8ncl'   = total(`f8tagcl') if `f8in', by(`_t')
1972.     }
1973.     else {
1974.       qui gen byte `f8tagcl' = .
1975.       qui gen double `f8ncl' = .
1976.     }
1977.     qui gegen long   `f8n'     = count(1)       if `f8in', by(`_t')
1978.     qui gegen double `f8w'     = total(`f8wa')  if `f8in', by(`_t')
1979.     qui gegen double `f8wi'    = total(`f8wit') if `f8in', by(`_t')
1980.     tempname f8raw
1981.     cap mkmat `_t' `f8nc' `f8nu' `f8ncl' `f8n' `f8w' `f8wi' if `f8tagt' == 1, matrix(`f8raw')
1982.     local f8rawrc = _rc
1983.     cap drop `f8in' `f8tagc' `f8tagi' `f8tagcl' `f8tagt' `f8nc' `f8nu' `f8ncl' `f8n' `f8w' `f8wi'
1984.     if `f8rawrc' == 0 {
1985.       tempname f8m
1986.       local f8nr = rowsof(`relyrcolumn')
1987.       matrix `f8m' = J(`f8nr', 8, 0)
1988.       local f8wtot = 0
1989.       local f8witot = 0
1990.       local f8rn
1991.       forval f8i = 1/`f8nr' {
1992.         local f8rv = `relyrcolumn'[`f8i',1]
1993.         local f8h  = `f8rv' + `min_t' + 1
1994.         if `f8rv' < 0 local f8rn `f8rn' pre`=abs(`f8rv')'
1995.         else if `f8rv' == 0 & `oldsyntax' == 1 local f8rn `f8rn' contemp
1996.         else local f8rn `f8rn' post`f8rv'
1997.         matrix `f8m'[`f8i',8] = `f8rv'
1998.         forval f8r = 1/`=rowsof(`f8raw')' {
1999.           if `f8raw'[`f8r',1] == `f8h' {
2000.             matrix `f8m'[`f8i',1] = `f8raw'[`f8r',2]
2001.             matrix `f8m'[`f8i',2] = `f8raw'[`f8r',3]
2002.             matrix `f8m'[`f8i',3] = `f8raw'[`f8r',4]
2003.             matrix `f8m'[`f8i',4] = `f8raw'[`f8r',5]
2004.             matrix `f8m'[`f8i',5] = `f8raw'[`f8r',6]
2005.             matrix `f8m'[`f8i',6] = `f8raw'[`f8r',6]
2006.             matrix `f8m'[`f8i',7] = `f8raw'[`f8r',7]
2007.             local f8wtot = `f8wtot' + `f8raw'[`f8r',6]
2008.             local f8witot = `f8witot' + `f8raw'[`f8r',7]
2009.           }
2010.         }
2011.       }
2012.       * share denominators accumulate over the matched (reported) horizons only, so each
.       * share column sums to 1 by construction
.       forval f8i = 1/`f8nr' {
2013.         if `f8wtot' > 0 & `f8wtot' < .   matrix `f8m'[`f8i',6] = `f8m'[`f8i',6]/`f8wtot'
2014.         if `f8witot' > 0 & `f8witot' < . matrix `f8m'[`f8i',7] = `f8m'[`f8i',7]/`f8witot'
2015.       }
2016.       matrix rownames `f8m' = `f8rn'
2017.       matrix colnames `f8m' = ncohorts nunits nclusters nobs sumw_att wshare_att wshare_att_it relyr
2018.       local f8mat_main `f8m'
2019.       local f8keys `f8keys' main
2020.       * reference-pool and whole-treated-sample coverage scalars (the reported window need not
.       * exhaust the treated sample; under esfixedbaseperiod no reference stats exist elsewhere)
.       tempvar f8refc f8refu
2021.       qui count if `esamp' == 1 & `_t' == 0 & `ttre' != .
2022.       local f8refN = r(N)
2023.       qui gegen byte `f8refc' = tag(`ttre') if `esamp' == 1 & `_t' == 0 & `ttre' != .
2024.       qui gegen byte `f8refu' = tag(`i')    if `esamp' == 1 & `_t' == 0 & `ttre' != .
2025.       qui count if `f8refc' == 1
2026.       local f8refncoh = r(N)
2027.       qui count if `f8refu' == 1
2028.       local f8refnunits = r(N)
2029.       qui drop `f8refc' `f8refu'
2030.       qui sum `f8wa' if `esamp' == 1 & `_t' == 0 & `ttre' != ., meanonly
2031.       local f8refW = cond(r(N) > 0, r(sum), 0)
2032.       qui count if `esamp' == 1 & `ttre' != .
2033.       local f8trtN = r(N)
2034.       qui sum `f8wa' if `esamp' == 1 & `ttre' != ., meanonly
2035.       local f8trtW = cond(r(N) > 0, r(sum), 0)
2036.     }
2037.     cap matrix drop `f8raw'
2038. 
.     * ---- subgroup scopes: one extra pass keyed on (_t, sg) covers every subgroup at once ----
.     if "`subgroups'" != "" & "`suppresssgprimaryeffects'" == "" {
2039.       tempvar f8sin f8stagc f8stagi f8stagcl f8stagt f8snc f8snu f8sncl f8sn f8sw f8swi
2040.       qui gen byte `f8sin' = (`esamp' == 1 & `targetflag' == 1 & `_t' >= `horizonstarter' & `_t' <= `horizonend' & `subgroups' < .)
2041.       qui gegen byte   `f8stagc'  = tag(`_t' `subgroups' `ttre') if `f8sin'
2042.       qui gegen byte   `f8stagi'  = tag(`_t' `subgroups' `_i')   if `f8sin'
2043.       qui gegen byte   `f8stagt'  = tag(`_t' `subgroups')        if `f8sin'
2044.       qui gegen long   `f8snc'    = total(`f8stagc') if `f8sin', by(`_t' `subgroups')
2045.       qui gegen long   `f8snu'    = total(`f8stagi') if `f8sin', by(`_t' `subgroups')
2046.       if "`f8cluster'" != "" {
2047.         qui gegen byte `f8stagcl' = tag(`_t' `subgroups' `f8cluster') if `f8sin'
2048.         qui gegen long `f8sncl'   = total(`f8stagcl') if `f8sin', by(`_t' `subgroups')
2049.       }
2050.       else {
2051.         qui gen byte `f8stagcl' = .
2052.         qui gen double `f8sncl' = .
2053.       }
2054.       qui gegen long   `f8sn'     = count(1)        if `f8sin', by(`_t' `subgroups')
2055.       qui gegen double `f8sw'     = total(`f8wa')   if `f8sin', by(`_t' `subgroups')
2056.       qui gegen double `f8swi'    = total(`f8wit')  if `f8sin', by(`_t' `subgroups')
2057.       tempname f8sraw
2058.       cap mkmat `_t' `subgroups' `f8snc' `f8snu' `f8sncl' `f8sn' `f8sw' `f8swi' if `f8stagt' == 1, matrix(`f8sraw')
2059.       local f8srawrc = _rc
2060.       cap drop `f8sin' `f8stagc' `f8stagi' `f8stagcl' `f8stagt' `f8snc' `f8snu' `f8sncl' `f8sn' `f8sw' `f8swi'
2061.       if `f8srawrc' == 0 {
2062.         foreach sgcase in `sglist' {
2063.           cap confirm matrix `relyrcolumn_s`sgcase''
2064.           if _rc == 0 {
2065.             tempname f8sm
2066.             local f8snr = rowsof(`relyrcolumn_s`sgcase'')
2067.             matrix `f8sm' = J(`f8snr', 8, 0)
2068.             local f8swtot = 0
2069.             local f8switot = 0
2070.             local f8srn
2071.             forval f8i = 1/`f8snr' {
2072.               local f8rv = `relyrcolumn_s`sgcase''[`f8i',1]
2073.               local f8h  = `f8rv' + `min_t' + 1
2074.               if `f8rv' < 0 local f8srn `f8srn' pre`=abs(`f8rv')'
2075.               else if `f8rv' == 0 & `oldsyntax' == 1 local f8srn `f8srn' contemp
2076.               else local f8srn `f8srn' post`f8rv'
2077.               matrix `f8sm'[`f8i',8] = `f8rv'
2078.               forval f8r = 1/`=rowsof(`f8sraw')' {
2079.                 if `f8sraw'[`f8r',1] == `f8h' & `f8sraw'[`f8r',2] == `sgcase' {
2080.                   matrix `f8sm'[`f8i',1] = `f8sraw'[`f8r',3]
2081.                   matrix `f8sm'[`f8i',2] = `f8sraw'[`f8r',4]
2082.                   matrix `f8sm'[`f8i',3] = `f8sraw'[`f8r',5]
2083.                   matrix `f8sm'[`f8i',4] = `f8sraw'[`f8r',6]
2084.                   matrix `f8sm'[`f8i',5] = `f8sraw'[`f8r',7]
2085.                   matrix `f8sm'[`f8i',6] = `f8sraw'[`f8r',7]
2086.                   matrix `f8sm'[`f8i',7] = `f8sraw'[`f8r',8]
2087.                   local f8swtot = `f8swtot' + `f8sraw'[`f8r',7]
2088.                   local f8switot = `f8switot' + `f8sraw'[`f8r',8]
2089.                 }
2090.               }
2091.             }
2092.             forval f8i = 1/`f8snr' {
2093.               if `f8swtot' > 0 & `f8swtot' < .   matrix `f8sm'[`f8i',6] = `f8sm'[`f8i',6]/`f8swtot'
2094.               if `f8switot' > 0 & `f8switot' < . matrix `f8sm'[`f8i',7] = `f8sm'[`f8i',7]/`f8switot'
2095.             }
2096.             matrix rownames `f8sm' = `f8srn'
2097.             matrix colnames `f8sm' = ncohorts nunits nclusters nobs sumw_att wshare_att wshare_att_it relyr
2098.             local f8mat_s`sgcase' `f8sm'
2099.             local f8keys `f8keys' s`sgcase'
2100.           }
2101.         }
2102.       }
2103.       cap matrix drop `f8sraw'
2104.     }
2105.     cap drop `f8wa' `f8wpit' `f8wit'
2106.   }
2107. 
.   ***************************************************************************************************************************
.   ***************************************         PRESENT AND RETURN THE RESULTS       **************************************
.   ***************************************************************************************************************************
. 
.   ******************* In the first block, we signal that results are coming,
.   * list the sample N and number of clusters
.   * present diagnostics on sample size in the pre-treatment group if not using esfixed base
.   * present some R^2 measures
.   * and then present some basic summary statistics
. 
.   * result presentation must start with posting items to e - allows saving as .ster and using esttab
.   * this also clears e
.   tempname eb
2108.   tempname ev
2109.   tempname ebformer
2110.   matrix `ebformer' = `wdidpooled'
2111.   local rownamespool = subinstr("`rownamespool'",":","_",.)
2112. 
.   * the plan is just to push through result estimates and SEs to e(b) and e(V)
.   * without giving any information about covariance (which we did not estimate anyway)
.   * this means we will get the correct coef and SE when using esttab... but you won't be able to test estimates against each other, use lincom to combine estimates, etc.
.   if "`subgroups'" != "" {
2113.     if "`suppresssgprimaryeffects'" == "" {
2114.       foreach sgcase in `sglist' {
2115.         matrix `ebformer' = `ebformer' \ `wdid_sg`sgcase''
2116.         local rownamespool_sginj = subinstr("`rownamessg`sgcase''",":","_SG`sgcase'_",.)
2117.         local rownamespool `rownamespool' `rownamespool_sginj'
2118.       }
2119.     }
2120.   }
2121. 
.   matrix `eb' = `ebformer'[1..`=rowsof(`ebformer')',1]'
2122.   matrix `ev' = diag(hadamard(`ebformer'[1..`=rowsof(`ebformer')',2],`ebformer'[1..`=rowsof(`ebformer')',2]))
2123.   matrix rownames `ev' = :
2124.   matrix rownames `eb' = :
2125.   matrix colnames `ev' = :
2126.   matrix colnames `eb' = :
2127.   matrix rownames `ev' = `rownamespool'
2128.   matrix colnames `ev' = `rownamespool'
2129.   matrix colnames `eb' = `rownamespool'
2130.   matrix rownames `eb' = `y'
2131. 
.   * the return statement also passes N and dof count and the function flagging the estimation sample
.   cap ereturn post `eb' `ev', esample(`esamp') depname(`y') obs(`N') dof(`df_r')
2132.   local evpostrc = _rc
2133.   if `evpostrc' != 0 {
2134.     * partial-identification rescue: ereturn post rejects a VCE carrying ANY missing diagonal cell,
.     * so one estimand with an unidentified SE (an IM ttest with a single contributing cluster, or a
.     * row nulled by the IM degeneracy guard) would otherwise cost every OTHER estimand its posted
.     * variance. When at least one estimand IS identified, replace the missing diagonal cells with a
.     * negative sentinel: Stata accepts it and every display/inference surface renders it as a
.     * missing standard error (ereturn display/esttab show ., test drops the constraint, lincom
.     * returns ., sqrt() of it is missing), so nothing is fabricated. Runs with no identified
.     * estimand at all keep the b-only fallback below.
.     local evpostgood 0
2135.     local evpostmiss 0
2136.     * capture the count now: a successful ereturn post consumes `eb'/`ev', so their
.     * dimensions are no longer available when the caution below is displayed
.     local evposttotal = colsof(`ev')
2137.     forval evpostd = 1/`evposttotal' {
2138.       if missing(`ev'[`evpostd',`evpostd']) local ++evpostmiss
2139.       else if `ev'[`evpostd',`evpostd'] > 0 & `ev'[`evpostd',`evpostd'] < . local ++evpostgood
2140.     }
2141.     if `evpostgood' > 0 & `evpostmiss' > 0 {
2142.       forval evpostd = 1/`=colsof(`ev')' {
2143.         if missing(`ev'[`evpostd',`evpostd']) matrix `ev'[`evpostd',`evpostd'] = -1e100
2144.       }
2145.       cap ereturn post `eb' `ev', esample(`esamp') depname(`y') obs(`N') dof(`df_r')
2146.       local evpostrc = _rc
2147.       if `evpostrc' == 0 {
2148.         dis as text "Caution: standard errors were not identified for `evpostmiss' of `evposttotal' reported estimates. e(V) contains placeholder entries for the affected estimates that display as missing standard errors; all other es
> timates retain their variances in e(V). See e(wdidmainresults) and the displayed tables for per-estimate detail."
2149.       }
2150.     }
2151.     if `evpostrc' != 0 {
2152.       cap ereturn post `eb' , esample(`esamp') depname(`y') obs(`N') dof(`df_r')
2153.       if _rc != 0 ereturn post   , esample(`esamp') depname(`y') obs(`N') dof(`df_r')
2154.       if `evpostmiss' > 0 & "`fastnose'" == "" dis as text "Caution: standard errors were not identified for `evpostmiss' of `evposttotal' reported estimates, so no variance-covariance matrix e(V) was posted. Point estimates remain in
>  e(b); per-estimate results remain in e(wdidmainresults) and the displayed tables."
2155.       if `evpostmiss' == 0 dis as text "Caution: wooldid could not post a variance-covariance matrix e(V) for this run. Per-estimate results remain in e(wdidmainresults) and the displayed tables."
2156.     }
2157.   }
2158. 
. 
.   * return the command line input and estimate_type
.   * F2: expose captured event-study b/V (honestdid/lincom/test compatible) [pure-add, after post]
.   foreach f2ky of local f2keys {
2159.     local f2bm `f2b_`f2ky''
2160.     local f2vm `f2v_`f2ky''
2161.     local f2rl `f2rl_`f2ky''
2162.     if "`f2bm'" != "" & "`f2rl'" != "" {
2163.       if `=colsof(`f2bm')' == `:list sizeof f2rl' & `=colsof(`f2bm')' > 0 {
2164.         cap mata: st_matrix("`f2bm'", st_matrix("`f2bm'"))
2165.         cap mata: st_matrix("`f2vm'", st_matrix("`f2vm'"))
2166.         matrix colnames `f2bm' = `f2rl'
2167.         matrix colnames `f2vm' = `f2rl'
2168.         matrix rownames `f2vm' = `f2rl'
2169.         local f2np 0
2170.         foreach f2t of local f2rl {
2171.           if substr("`f2t'",1,3) == "pre" local ++f2np
2172.         }
2173.         * skip a fully non-identified VCV (e.g. timetrends): no positive-finite diagonal.
.         * NFES-02: also count the degenerate rows (zero/missing/negative diagonals) -
.         * partially degenerate families still POST (adjudicated: structural zeros are
.         * genuine margins output), but silently shipping them under a joint-inference-
.         * advertised name was the gap: caution + machine-readable marker below
.         local f2ok 0
2174.         local f2nbad 0
2175.         local f2k = colsof(`f2vm')
2176.         forval f2d = 1/`f2k' {
2177.           if `f2vm'[`f2d',`f2d'] > 0 & `f2vm'[`f2d',`f2d'] < . local f2ok 1
2178.           else local ++f2nbad
2179.         }
2180.         if `f2ok' {
2181.           cap ereturn matrix b_es_`f2ky' = `f2bm'
2182.           cap ereturn matrix V_es_`f2ky' = `f2vm'
2183.           local f2vrc = _rc
2184.           cap ereturn scalar numpre_`f2ky' = `f2np'
2185.           if `f2vrc' == 0 & `f2nbad' > 0 {
2186.             dis as text "Caution: e(V_es_`f2ky') contains `f2nbad' of `f2k' horizons with zero or missing variance (structurally degenerate rows); inspect the diagonal before joint inference - honestdid/lincom on those rows is not mea
> ningful."
2187.             cap ereturn scalar es_ndegen_`f2ky' = `f2nbad'
2188.           }
2189.         }
2190.       }
2191.     }
2192.   }
2193.   * F3: expose the ATT(g,t) building blocks [pure-add, after post]
.   if "`gteffects'" != "" {
2194.     if `gtn' > 0 {
2195.       cap ereturn matrix gteffects = `gtm'
2196.       if _rc != 0 dis as text "Caution: e(gteffects) could not be posted (rc `=_rc')."
2197.     }
2198.     else dis as text "Caution: gteffects found no cohort-by-relative-period main-effect coefficients to report."
2199.   }
2200.   * F8: expose event-study composition diagnostics [pure-add, after post]
.   foreach f8ky of local f8keys {
2201.     local f8mm `f8mat_`f8ky''
2202.     if "`f8mm'" != "" {
2203.       if "`f8ky'" == "main" cap ereturn matrix escomp = `f8mm', copy
2204.       else cap ereturn matrix escomp_`f8ky' = `f8mm', copy
2205.     }
2206.   }
2207.   if strpos("`f8keys'", "main") != 0 {
2208.     cap ereturn scalar escomp_refN = `f8refN'
2209.     cap ereturn scalar escomp_refnunits = `f8refnunits'
2210.     cap ereturn scalar escomp_refncoh = `f8refncoh'
2211.     cap ereturn scalar escomp_refW = `f8refW'
2212.     cap ereturn scalar escomp_trtN = `f8trtN'
2213.     cap ereturn scalar escomp_trtW = `f8trtW'
2214.   }
2215.   * CORE-10: prefix the command name so e(cmdline) matches the Stata convention (the
.   * worker's `0' is never rewritten, so this single posting site is authoritative)
.   ereturn local cmdline `"wooldid `0'"'
2216.   local estimate_type "pooled_reference_period"
2217.   if "`esfixedbaseperiod'" != "" local estimate_type "fixed_reference_period"
2218.   ereturn local estimate_type "`estimate_type'"
2219.   if `anticipation' > 0 ereturn scalar anticipation = `anticipation'
2220. 
. 
. 
. 
. 
.   * F11: ship every remaining result and the display-state macros to e() BEFORE any
.   * display runs. the presentation itself now lives in wooldid_display / wooldid_esplots
.   * (the worker is near stata's per-program compiled-size ceiling), and those
.   * subprograms read e() only - which is also what makes replay (typing wooldid alone
.   * after estimation) possible. the posting order below preserves the pre-F11 posting
.   * order exactly; the hidden wdid_* display-state macros are appended at the end.
.   if "`summarystats'" != "" {
2221.     ereturn matrix summarystats = `summarystats'
2222. 
.     * most summary stats will live in the summary stats matrix, but these may be worth returning on their own
.     ereturn scalar ypre_mean = `ypre_mean'
2223.     ereturn scalar ypre_med =  `ypre_med'
2224.     ereturn scalar ypre_sd =  `ypre_sd'
2225.     ereturn scalar ypre_iqr =  `ypre_iqr'
2226. 
.     if "`contreat'" != "" {
2227.       * under untreatedZero, pre-treatment contreat stats are never computed (see the matching guard in the summarystats block), so do not ereturn them
.       if "`contreatcontrols'" != "untreatedZero" {
2228.         ereturn scalar contreatpre_mean = `contreatpre_mean'
2229.         ereturn scalar contreatpre_med =  `contreatpre_med'
2230.         ereturn scalar contreatpre_sd =  `contreatpre_sd'
2231.       }
2232.       ereturn scalar contreatpost_mean = `contreatpost_mean'
2233.       ereturn scalar contreatpost_med =  `contreatpost_med'
2234.       ereturn scalar contreatpost_sd =  `contreatpost_sd'
2235.       ereturn scalar contreat_mean = `contreat_mean'
2236.       ereturn scalar contreat_med =  `contreat_med'
2237.       ereturn scalar contreat_sd =  `contreat_sd'
2238.     }
2239.   }
2240. 
.   * return various scalars and summary stats
.   local r2list r2 r2adj r2_within r2_withinadj F
2241.   if "`poisson'" == "poisson" local r2list r2pseud chi2
2242.   if "`regtype'" != "poisson" local r2list `r2list' rmse rss
2243.   foreach scalar in N Nclus ll ll_0 `r2list'   {
2244.     if "``scalar''" != "." ereturn scalar `scalar' = ``scalar''
2245.   }
2246.   ereturn scalar N_dropped = `droppedobs'
2247. 
.   * return the joint  tests
.   if "`suppressjointtests'" == "" {
2248.     if "`joint_horiz'" != "" ereturn scalar joint_horiz = `joint_horiz'
2249.     if "`joint_horiz_i'" != "" ereturn scalar joint_horiz_i = `joint_horiz_i'
2250.     if "`joint_Choriz'" != "" ereturn scalar joint_Choriz = `joint_Choriz'
2251.     if "`joint_Choriz_i'" != "" ereturn scalar joint_Choriz_i = `joint_Choriz_i'
2252.   }
2253. 
.  if "`adversarial'" != "" {
2254.    foreach scenario in _ _C {
2255.      foreach type in att att_it {
2256.        * NFADV-01/02: independent gates - the display line survives when inference is
.        * unavailable (pooled reference regime, degenerate covariance)
.        cap confirm matrix `adversarialB`scenario'`type''
2257.        if _rc == 0 {
2258.          local typetext `type'
2259.          if "`scenario'" == "_C" local typetext = subinstr("`typetext'","att","ame",.)
2260.          if "`adversarialP`scenario'`type''" != "" ereturn scalar adversarial_pval_`typetext' = `adversarialP`scenario'`type''
2261.          ereturn matrix adversarial_line_`typetext' =   `adversarialB`scenario'`type''
2262.        }
2263.      }
2264.    }
2265.  }
2266. 
.   if "`subgroups'" != "" {
2267.     if "`suppresssgprimaryeffects'" == "" {
2268.       foreach sgcase in `sglist' {
2269.         if "`suppressjointtests'" == "" {
2270.           if "`joint_horiz_s`sgcase''" != "" ereturn local joint_horiz_s`sgcase' = `joint_horiz_s`sgcase''
2271.           if "`joint_horiz_i_s`sgcase''" != "" ereturn local joint_horiz_i_s`sgcase' = `joint_horiz_i_s`sgcase''
2272.           if "`joint_Choriz_s`sgcase''" != "" ereturn local  joint_Choriz_s`sgcase' = `joint_Choriz_s`sgcase''
2273.           if "`joint_Choriz_i_s`sgcase''" != "" ereturn local  joint_Choriz_i_s`sgcase' =  `joint_Choriz_i_s`sgcase''
2274.         }
2275.         if "`adversarial'" != "" {
2276.           foreach scenario in _ _C {
2277.             foreach type in att att_it {
2278.               * NFADV-01/02: independent gates (see the overall twin above)
.               cap confirm matrix `adversarialB`scenario'`type'_s`sgcase''
2279.               if _rc == 0 {
2280.                 local typetext `type'
2281.                 if "`scenario'" == "_C" local typetext = subinstr("`typetext'","att","ame",.)
2282.                 if "`adversarialP`scenario'`type'_s`sgcase''" != "" ereturn scalar adversarial_pval_`typetext'_s`sgcase' = `adversarialP`scenario'`type'_s`sgcase''
2283.                 ereturn matrix adversarial_line_`typetext'_s`sgcase' =   `adversarialB`scenario'`type'_s`sgcase''
2284.               }
2285.             }
2286.           }
2287.         }
2288.       }
2289.     }
2290.     if wordcount("`sglist'") > 1 {
2291.       ereturn matrix pwsgs = `pwsgs'
2292.       foreach item in `att'  `att_it' `att_i' `att_itime' {
2293.         if "`joint_`item'_sdiff'" != "" ereturn scalar joint_`item'_allsgssame =   `joint_`item'_sdiff'
2294.         if "`prejoint_`item'_sdiff'" != "" ereturn scalar joint_pre_`item'_allsgssame =   `prejoint_`item'_sdiff'
2295.       }
2296.       if "`contreat'" != "" {
2297.         foreach item in `att'  `att_it' `att_i' `att_itime' {
2298.           local itemtext = subinstr("`item'","att","ame",.)
2299.           if "`joint_C`item'_sdiff'" != "" ereturn scalar joint_`itemtext'_allsgssame =   `joint_C`item'_sdiff'
2300.           if "`prejoint_C`item'_sdiff'" != "" ereturn scalar joint_pre_`itemtext'_allsgssame =   `prejoint_C`item'_sdiff'
2301.         }
2302.       }
2303.     }
2304.   }
2305. 
.   *return the histogram matrix
.   if "`histogramcohorteffects'" != "" ereturn matrix histogramestimates = `___hist'
2306. 
.   * ship remaining matrices into ereturn
.   if "`subgroups'" != "" & "`suppresssgprimaryeffects'" == "" {
2307.     foreach sgcase in `sglist' {
2308.       ereturn matrix wdidsgresults_`sgcase'  = `wdid_sg`sgcase''
2309.     }
2310.   }
2311. 
.   ereturn matrix wdidmainresults = `wdidpooled'
2312. 
.   *** finally, return the CFX plots
.   * NFFAST-02: the margins-inherited row stripes embed wooldid tempvar names (volatile
.   * across runs - two identical calls returned identical numbers under different row
.   * identifiers, breaking documented downstream row-name joins); rename to stable
.   * lattice_# keys before posting
.   foreach matrix in `cfxmatricestoreturn' {
2313.     wooldid_cfxstripe ``matrix''
2314.     ereturn matrix `matrix' = ``matrix''
2315.   }
2316. 
.   * display-state macros consumed by wooldid_display / wooldid_esplots (and by replay).
.   * hidden: internal plumbing, not part of the documented e() surface (they still appear
.   * to "local m : e(macros)" and so to the test battery). an ereturn local with an empty
.   * value creates no macro, so the unconditional lines below are self-gating.
.   ereturn hidden local wdid_vcespec `"`vcespecifier'"'
2317.   ereturn hidden local wdid_poisson "`poisson'"
2318.   ereturn hidden local wdid_poisexp "`poisexpresults'"
2319.   ereturn hidden local wdid_contreat "`contreat'"
2320.   ereturn hidden local wdid_sgvar "`subgroups'"
2321.   ereturn hidden local wdid_sglist "`sglist'"
2322.   ereturn hidden local wdid_estimands "`att' `att_it' `att_i' `att_itime'"
2323.   ereturn hidden local wdid_cwm "`customweightmultiplier'"
2324.   ereturn hidden local wdid_semielas "`semielasticity'"
2325.   ereturn hidden local wdid_cetype "`contreatelasticitytype'"
2326.   ereturn hidden local wdid_suppressjt "`suppressjointtests'"
2327.   ereturn hidden local wdid_suppresssgpe "`suppresssgprimaryeffects'"
2328.   ereturn hidden local wdid_adversarial "`adversarial'"
2329.   if "`summarystats'" != "" ereturn hidden local wdid_sumstats "summarystats"
2330.   ereturn hidden local wdid_espre "`espre'"
2331.   ereturn hidden local wdid_nptb "`Npre_trebase'"
2332.   ereturn hidden local wdid_nprat "`Npre_rat'"
2333.   ereturn hidden local wdid_wprat "`Wpre_rat'"
2334.   ereturn hidden local wdid_esrel "`esrelativeto'"
2335.   ereturn hidden local wdid_timetrends "`timetrends'"
2336.   ereturn hidden local wdid_fastnose "`fastnose'"
2337.   * replay contract version: bump this when the display contract changes (anything
.   * wooldid_display / wooldid_esplots read from e(), or how they interpret it);
.   * their gates exact-match this value, so a bump refuses cross-version replays
.   ereturn hidden local wdid_replayv "1"
2338. 
. 
.   ********* begin actual result presentation *************
.   * F11: the presentation code lives in wooldid_display (non-eclass, reads e() only).
.   * it is split in two parts so the eclass wooldid_ptp call below stays at worker level
.   * (its ereturns would be discarded inside a non-eclass subprogram)
.   wooldid_display , part(1)
2339.   * F7: Roth (2022) pre-trend power diagnostics (compute + display + ereturns live in a
.   * subprogram; cap noi so a failure here cannot abort an otherwise-complete run)
.   if "`pretrendpower'" != "" cap noi wooldid_ptp , levels(`pretrendpower') esrel(`esrelativeto') dfr(`df_r') pois(`poisson') poisexp(`poisexpresults') tvar(`t') ttrevar(`ttre') ivar(`i') wvar(`w') cwm(`customweightmultiplier')
2340.   wooldid_display , part(2)
2341. 
. 
. 
. 
.   ***************************************************************************************************************************
.   ********************************************         PRODUCE EVENT STUDY PLOTS       **************************************
.   ***************************************************************************************************************************
.   * present event study plots if requested; a little complicated because of naming practices in wdidpooled
.   * this is also somewhat awkward placement b/c I have this coded to use the wdidpooled matrix
.   * this choice is vestigial to a prior program design and is kept here on the principle of not redoing what already works
.   * though I should probably redo this someday
. 
.   if `espre' +`espl' > 0 & "`makeplots'" == "makeplots" {
2342.     local wdesopts
2343.     if "`saveplots'" != "" local wdesopts saveplots(`saveplots')
2344.     wooldid_esplots , `wdesopts' `replace'
2345.   }
2346. 
. 
. 
.   ***************************************************************************************************************************
.   ***************************************         CLEAN UP AND EXIT       **************************************
.   ***************************************************************************************************************************
.   * (F11) all result matrices and scalars were shipped to e() above, BEFORE the display
.   * and plot calls; only cleanup remains here
. 
.   if "`cleanmatrices'" != "" {
2347.     clear mata
2348.     matrix drop _all
2349.   }
2350. 
.   if "`verbose'" != "verbose" qui est drop ___wooldidfullmodel
2351.   * clean up after ppmlhdfe. under verbose, retain _ppmlhdfe_d alongside the retained
.   * ___wooldidfullmodel (author directive, 2026-07). note this alone does not make
.   * predict/margins replay work after est restore: the model's regressors (_i, _t,
.   * targetflag, and the internal weight) are tempvars that no longer exist at that
.   * point - retention just stops closing that door for a future replay feature
.   if "`poisson'" == "poisson" & "`unconditionalse'" == "" & "`customvce'" == "" & "`verbose'" != "verbose" qui cap drop _ppmlhdfe_d
2352. 
. 
.   * program ends!
.   dis as result  " "
2353.   ereturn local cmd "wooldid"
2354. 
. 
. 
. 
.   end

. 
. 
. * ============================================================================
. * S5: the complete early input gate - every parse-time check and option
. * normalization wooldid performs before touching the dataset structure. moved out
. * of wooldid_worker (per-program compiled-size ceiling) verbatim and in the original
. * order, so multi-error calls report the same first error as before. re-parses `0'
. * with a byte-identical copy of the worker's syntax line (test/check_validate_sync.py
. * guards the duplication) and returns everything it parses or mutates via c_local.
. * NOT in here (hard constraints, all measured): set emptycells (program-scoped, would
. * be restored the instant this returns), tempvar creation (dies on return), and the
. * update branch (its exit would only leave this subprogram).
. cap prog drop wooldid_validate

. prog def wooldid_validate
  1. version 16.0
  2. 
. * S5: this line must remain BYTE-IDENTICAL to the worker's syntax line
. syntax [varlist(numeric default=none)] [if/]  [aw pw / ]  ,  [att att_it att_itime att_i CLUSter(varlist numeric) customvce(string) UNCONDitionalse  ROBust IMPvalues fe(varlist fv) COARSEcohortcontrols(string) ccc_absorb(varlist numeric) 
>   CONTROLs(varlist fv) INTERactivecontrols(varlist numeric)  TIMETRENDs SUBgroups(varname numeric) CUSTOMWeightmultiplier(varname numeric)  ESPRElength(integer 0) ESPOSTlength(integer 0) SAVEplots(name)  POISson POISEXPresults   OOStreate
> dcontrols(integer 0) ANTICipation(integer 0) ESFixedbaseperiod ESRelativeto(integer -1) safety(string)   MAKEPlots MAKECfxplots SUMmarystats HISTogramcohorteffects   regtol(integer 9)  JOINTtests SUPPRESSsgprimaryeffects contreat(varname 
> numeric) CONTREATPoly(int 1) lattice(string) LATTICEIGnoreweights  CCNOabsorb CONTREATControls(string) VERbose   CFXPLOTTypes(string) cfxlattice(varname) makecfxplotsbysg cfxplotnose SEMIelasticity CONTREATELASticitytype(string)    CONTRE
> ATWithin CLEANmatrices   emptycellsoverride  replace  altmethod_adversarial ADVersarial update oldsyntax PRETRENDPOWer(numlist) FASTnose GTEffects PERMute(string) PERMREPS(integer 0) PERMEXact PERMTStat PERMTci PERMSTRata(varname numeric)
>  PERMPRobs(string asis)]
  3. 
. * Verify that the packages wooldid requires (reghdfe, ftools, gtools) are installed before doing anything else
. * ppmlhdfe is deliberately not checked here: it is only required for poisson estimation and remains optional
.   local missingpackages
  4.   foreach requiredpackage in reghdfe ftools gtools {
  5.     cap which `requiredpackage'
  6.     if _rc != 0 {
  7.       dis as error "Error: wooldid requires the package `requiredpackage', which does not appear to be installed."
  8.       dis as text "To install it, run: ssc install `requiredpackage', replace"
  9.       local missingpackages `missingpackages' `requiredpackage'
 10.     }
 11.   }
 12.   if "`missingpackages'" != "" error 198
 13. 
.   if "`verbose'" == "verbose" dis as text "Wooldid is processing input in preparation for regression estimation."
 14. 
.  * This controls the names we use for ES plots; the new syntax is more compatible with the program event_plot
.  if "`oldsyntax'" == "oldsyntax" {
 15.     local oldsyntax 1
 16.  }
 17.  else {
 18.     local oldsyntax 0
 19.  }
 20. 
.   **** Begin a block of checks that command info is correctly specified; error out if not. handle all syntax errors here
. 
.   * check that sufficient input is given - note that the error will occur automatically if > 4 is given
.   if wordcount("`varlist'") < 4 {
 21.     dis as error "Error: command line input should feature all of y i t ttre; too few variables specified."
 22.     error 198
 23.   }
 24. 
.   if wordcount("`varlist'") > 4 {
 25.     dis as error "Error: command line input should feature only y i t ttre; too many variables specified."
 26.     error 198
 27.   }
 28. 
.   *Confirm correct weight usage if using poisson
.   if "`weight'" == "aweight" & "`poisson'" == "poisson" {
 29.     dis as error "Error: poisson only accepts pweights, not aweights."
 30.     error 198
 31.   }
 32. 
.   *Issue warnings related to unconditional se reliability
.   if "`safety'" != "off" & "`unconditionalse'" == "unconditionalse" & ("att_i" == "`att_i'" | "att_it" == "`att_it'" | "att_itime" == "`att_itime'" ) {
 33.     dis as error "Error: unconditional standard errors may be unreliable with non-att estimand types."
 34.     dis as text "Set option safety(off) to disregard this error."
 35.     error 198
 36.   }
 37. 
.   if "`safety'" != "off" & "`unconditionalse'" == "unconditionalse" & ("`weight'" == "aweight" ) {
 38.     dis " "
 39.     dis as text "Caution: unconditional standard errors may be unreliable with aweights."
 40.     dis as text "Set option safety(off) to suppress this caution."
 41.     dis " "
 42.   }
 43. 
.   if "`adversarial'" == "adversarial" & "`impvalues'" == "impvalues" {
 44.     dis as error "Error: Adversarial Pre-Trends Testing not allowed with Ibragimov and Muller p-values."
 45.     error 198
 46.   }
 47. 
.   * object to certain specification types when forced to switch to reg or poisson over an hdfe estimator
.   if ("`customvce'" != "" | "`unconditionalse'" != "") & ( "`fe'" != "" | "`ccc_absorb'" != "")  {
 48.     dis as text "Caution: unconditional SEs and custom VCE specifications rely on the plain regress command and so are not compatible with absorbed fixed effects."
 49.     dis as text "You must specify anything in fe as controls, manually specifying any needed i. prefixes."
 50.   }
 51. 
.   * check conditions for using im p-values
.   if "`impvalues'" != "" & "`cluster'" == "" {
 52.     dis as error "Error: Ibragimov and Muller p-values only allowed when clustering; please specify a clustering variable."
 53.     error 198
 54.   }
 55. 
.   if "`impvalues'" != "" & wordcount("`cluster'") > 1 {
 56.     dis as error "Error: Ibragimov and Muller p-values only allowed with a single cluster variable."
 57.     error 198
 58.   }
 59. 
.   * check conditions for using im p-values
.   if "`impvalues'" != "" & ( "`customvce'" != "" | "`unconditionalse'" != "") {
 60.     dis as error "Error: Ibragimov and Muller p-values are not compatible with unconditional SE computation and custom VCE specifications."
 61.     error 198
 62.   }
 63. 
.   * complain if you specify customvce and something else with it
.   if "`customvce'" != "" & ("`robust'" != "" | "`cluster'" != "") {
 64.     dis as error "Error: customvce() is not compatible with robust and cluster(). You must manually specify the contents of reg's vce() statement in this case."
 65.     error 198
 66.   }
 67. 
.   * unconditional SEs are computed by margins via vce(unconditional), which requires the underlying
.   * regression to have been fit with robust or clustered standard errors; catch this early rather than
.   * failing with a bare r(322) at the first margins call after estimation has completed.
.   * pweights are exempt: they force a robust vce in reg/poisson, satisfying the requirement on their own
.   if "`unconditionalse'" == "unconditionalse" & "`robust'" == "" & "`cluster'" == "" & "`customvce'" == "" & "`weight'" != "pweight" {
 68.     dis as error "Error: the option unconditionalse requires specifying either robust or clustered standard errors."
 69.     dis as text "Specify robust or cluster(), or provide a robust/clustered vce via customvce()."
 70.     error 198
 71.   }
 72. 
. 
.   *check conditions for using im p-values - in principle, SG estimates could be computed provided SGs never cross cut clusters, but I have not implemented this
.   * NOTE (t10_v3): this gate is LOAD-BEARING for the E1 subgroup restructure - under
.   * impvalues, marginsdof is nose, and a chain `test' after a nose `post' is r(321);
.   * do not relax this pairing without also emptying `sgpost' in the SG-comparison blocks
.   if "`impvalues'" != "" & "`subgroups'" != "" {
 73.     dis as error "Error: Ibragimov and Muller p-values not compatible with subgroups."
 74.     error 198
 75.   }
 76. 
.   * F3: under a continuous treatment the cohort-by-period interaction coefficients are
.   * intercepts at dose zero, not treatment effects, so the building-block table would be
.   * silently meaningless there
.   if "`gteffects'" != "" & "`contreat'" != "" {
 77.     dis as error "Error: gteffects is not available with contreat(): the cohort-by-period interaction coefficients are dose-zero intercepts under a continuous treatment, not treatment effects. Aggregate e(b_es_ame) or the cfx materials
>  instead."
 78.     error 198
 79.   }
 80. 
. 
.   *check conditions for using im p-values - for CFX plots, we have problems similar to with SGs, but even worse
.   if "`impvalues'" != "" & "`makecfxplots'" != "" {
 81.     dis as error "Error: Ibragimov and Muller p-values not compatible with continuous treatment effects plots."
 82.     error 198
 83.   }
 84. 
.   * F7 pre-trend power diagnostics: validate the request early (checks live in a
.   * subprogram - the worker is close to Stata's per-program size ceiling)
.   if "`pretrendpower'" != "" wooldid_ptpcheck , levels(`pretrendpower') esf(`esfixedbaseperiod') impv(`impvalues') espre(`esprelength')
 85. 
.   * check conditions for using im p-values --
.   * for the joint tests, I have not seen IM characterize multi-way tests. implementing a test here of some sort would be easy,
.   * but I am not sure if it would technically be valid.
.   if "`impvalues'" != "" & ( "`jointtests'" != "" ){
 86.     dis as error "Error: Ibragimov and Muller p-values are not compatible with the jointtests option."
 87.     error 198
 88.   }
 89. 
.   * verify that if continuous treatment effects plots are requested, we have a lattice over which to produce them
.   if "`makecfxplots'" != "" & "`cfxlattice'" == "" & ("`lattice'"=="" ) {
 90.     dis as error  "Error: You requested continuous treatment effects plots, but either didn't specify a cfxlattice variable or a lattice option for the continuous treatment."
 91.     error 198
 92.   }
 93. 
.   * oostreatedcontrols determines whether or not units treated after the end of the sample window are allowed to contribute to pre-treatment horizons;
.   * cancel estimation if you specify a negative value here (corresponding with a within window treatment)
.   if `oostreatedcontrols' < 0 {
 94.     dis as error  "Error: oostreatedcontrols specified as < 0, indicating that treatments occurring within sample should be ignored."
 95.     dis as error  "This is not allowed; you must specially set up cases of this sort by modifying the ttre variable and the if statement."
 96.     error 198
 97.   }
 98. 
.   * anticipation() shifts the effective onset EARLIER (ttre - #); a negative value would
.   * pretend onset is later, pushing genuinely treated periods into the control/reference
.   * pool - a silent identification failure. delayed-onset designs need their own setup
.   if `anticipation' < 0 {
 99.     dis as error  "Error: anticipation specified as < 0, indicating that treatment onset should be treated as occurring later than recorded."
100.     dis as error  "This is not allowed; if you need a delayed-onset design, modify the ttre variable and the if statement directly."
101.     error 198
102.   }
103. 
. 
.   * check that controls are specified alright - error out if c. and i. are not specified for each variable
.   if "`coarsecohortcontrols'" != "" {
104.     foreach case in `coarsecohortcontrols' {
105.       if strpos("`case'","c.") == 0 & strpos("`case'","i.") == 0 {
106.         dis as error  "Error: Your coarse cohort controls do not all specify whether they are continuous or categorical. You must do this using i. and c. style notation."
107.         error 198
108.       }
109.     }
110.   }
111. 
.   * extract information about requested continuous treatment and error out if the user misspecified the information
.   if "`lattice'" != "" & wordcount("`lattice'") != 1 {
112.     if wordcount("`lattice'") >= 3  {
113.       dis as error  "Error: lattice incorrectly specified; requires 2 arguments or a pre-made lattice variable"
114.       error 198
115.     }
116. 
.     local latticenum = word("`lattice'",2)
117.     * validate by VALUE, not spelling: every downstream quantile engine accepts
.     * integer-valued spellings like 02, +2, 2.0, and 1e2, so a confirm-integer-number
.     * spelling check would reject inputs that work; conversely gquantiles silently
.     * remaps nquantiles <= 0 to its default (and forval builds a degenerate no-op
.     * lattice), so 0/negatives must be caught here by value. missing-evaluating
.     * tokens fail confirm number or the mod() test (mod(., 1) != 0 is true)
.     cap confirm number `latticenum'
118.     if _rc != 0 {
119.       dis as error "Error: lattice incorrectly specified; `latticenum' is not a valid number of lattice quantiles. lattice() requires a valid lattice type and an integer number of quantiles, or a pre-made lattice variable."
120.       error 198
121.     }
122.     if mod(`latticenum',1) != 0 {
123.       dis as error "Error: lattice incorrectly specified; the number of lattice quantiles (`latticenum') must be an integer."
124.       error 198
125.     }
126.     if `latticenum' <= 1 {
127.       dis as error "Error: lattice incorrectly specified; latticenum must be > 1 or else the lattice does not permit additional variation relative to not specifying a lattice at all."
128.       error 198
129.     }
130. 
.     local latticetype = word("`lattice'",1)
131.     if inlist("`latticetype'","all","baseTreated","baseTreatedPost","baseTreatedPre", "baseTreatedRef") == 0 & inlist("`latticetype'","byCohort","byTime","byCohortByTime","byTreated","byTreatedByTime","byTtre","byTtreByTime") == 0{
132.       dis as error  "Error: lattice type is misspecified; `latticetype' is not a valid lattice type."
133.       error 198
134.     }
135.   }
136. 
.   * extract contreatcontrol type and error out if misspecified
.   if "`contreatcontrols'" != "" {
137.     foreach word in `contreatcontrols' {
138.       if inlist("`word'",  "byTreated", "byTtre", "byCohort", "byTime") == 0 & inlist("`word'","basic","untreatedZero") == 0 {
139.         dis as error  "Error: continuous treatment control type misspecified; `word' is not a valid continuous treatment control type."
140.         error 198
141.       }
142.     }
143.     if strpos("`contreatcontrols'","untreatedZero") != 0 & wordcount("`contreatcontrols'") > 1 {
144.       dis as error "Error: untreatedZero cannot be paired with other control types"
145.       error 198
146.     }
147.   }
148. 
.   * error out if no contreatcontrol type is specified in a continuous treatment scenario
.   if "`contreatcontrols'" == "" & "`contreat'" != "" {
149.     dis as error "Error: contreatcontrols type not specified; you must specify this - substantive judgement is required."
150.     error 198
151.   }
152. 
.   * error out if you request continuous treatment controls w/o a continuous treatment variable
.   if "`contreatcontrols'" != "" & "`contreat'" == "" {
153.     dis as error "Error: you cannot request continuous treatment controls without specifying a continuous treatment variable."
154.     error 198
155.   }
156. 
.   * error out if a lattice is requested without a continuous treatment - the lattice-construction
.   * code all sits inside the contreat block, so the option would otherwise be silently ignored
.   if "`lattice'" != "" & "`contreat'" == "" {
157.     dis as error "Error: lattice() has no effect without contreat(); specify a continuous treatment variable or remove the lattice() option."
158.     error 198
159.   }
160. 
.  * issue warnings pertaining to cfxplot types
.   if "`makecfxplots'" != "" & ("`att_it'" == "att_it" | "`att_itime'" == "att_itime" | "`att_i'" == "att_i" )   {
161.     if "`safety'" == "off" {
162.       dis as text "Caution: interpretation of continuous treatment effects plots for estimands other than the ATT is difficult unless i-t cells (and sometimes cohorts i) are wholly contained within lattice bins."
163.     }
164.     else{
165.       dis as text "Caution: interpretation of continuous treatment effects plots for estimands other than the ATT is difficult unless i-t cells (and sometimes cohorts i) are wholly contained within lattice bins."
166.       dis as text "As such, wooldid will not produce these plots unless you specify safety(off)."
167.     }
168.   }
169. 
.   if `esprelength' < 0 {
170.     dis as error "Error: cannot accept negative values of esprelength."
171.     error 198
172.   }
173. 
.   * this implements a hack for estimability check failures in certain special cases
.   if `espostlength' < 0  {
174.     if `espostlength' != -999  {
175.       dis as error "Error: cannot accept negative values of espostlength."
176.       error 198
177.     }
178.     local espostlength 0
179.     local esposttrip no
180.   }
181. 
.   if "`subgroups'" != "" &   `esprelength' > 0  & `espostlength' == 0 & "`esposttrip'" == "" {
182.     local espostlength 1
183.     if "`safety'" != "off" dis as text "Caution: espostlength set to 1 due to use of subgroups in conjunction with esprelength > 0."
184.     if "`safety'" != "off" dis as text "Without this modification, subgroups may crash if pre-treatment effects are not estimable for them."
185.     if "`safety'" != "off" dis as text "Specify espostlength(-999) to override this issue. Specify safety(off) to avoid seeing this message."
186.   }
187. 
. 
. 
.   ******** parsing for specification errors complete, begin processing input on other dimensions, setting defaults, etc. handle errors that aren't purely syntax here
. 
.   ******* process the raw inputs
. 
.   * extract y, i, t, and ttre from the main variable list
.   local y = word("`varlist'",1)
188.   local i = word("`varlist'",2)
189.   local t = word("`varlist'",3)
190.   local ttre_asgiven = word("`varlist'",4)
191. 
.   * F6: permutation-inference screens. deep checks live in the subprogram
.   * (wooldid_permctl) to conserve this program's compiled-size headroom
.   if "`permute'" == "" {
192.     local permstray
193.     if `permreps' != 0 local permstray permreps()
194.     if "`permexact'" != "" local permstray `permstray' permexact
195.     if "`permtstat'" != "" local permstray `permstray' permtstat
196.     if "`permtci'" != "" local permstray `permstray' permtci
197.     if "`permstrata'" != "" local permstray `permstray' permstrata()
198.     if `"`permprobs'"' != "" local permstray `permstray' permprobs()
199.     if "`permstray'" != "" {
200.       dis as error "Error: `permstray' require(s) the permute() option."
201.       error 198
202.     }
203.   }
204.   if "`permute'" != "" {
205.     cap noi wooldid_permctl , permute(`permute') permreps(`permreps') `permexact' clus(`cluster') ttrevar(`ttre_asgiven') permstrata(`permstrata') permprobs(`permprobs') impv(`impvalues') uncond(`unconditionalse') cw(`contreatwithin') 
> os(`oldsyntax') ts(`permtstat') tc(`permtci') fn(`fastnose') cc(`contreatcontrols') ifr(`if')
206.     if _rc != 0 error _rc
207.   }
208. 
.   * capture the user's own safety() input before any internal relaxation (contreatwithin sets
.   * the working copy to off further down); the identifying-assumption checks gate on this copy
.   * so an internal relaxation does not silently disable them
.   local safetyinput `safety'
209. 
.   * register verbose retention with the shell's error-path cleanup epilogue (top of this
.   * file): under verbose, ___wooldidfullmodel (and _ppmlhdfe_d under poisson) are
.   * documented as retained for inspection - on failed runs as well
.   if "`verbose'" == "verbose" global WOOLDID_CLEANUP $WOOLDID_CLEANUP keep
210. 
.   * the input-validity asserts below respect the user's if() restriction, mirroring the
.   * estimation sample construction exactly: the sample keeps rows where the if expression
.   * evaluates to 1 (gen ifvar = `if' further down), so the asserts test (`if') == 1 --
.   * identical row selection for any expression shape, including bare flag variables with
.   * nonzero or missing values, which a plain if-qualifier would wrongly include. empty when
.   * no if() is given, leaving the asserts running over the full dataset exactly as before
.   local ifassert
211.   if `"`if'"' != "" local ifassert if (`if') == 1
212. 
.   * check that i is specified acceptably
.   if "`safety'" != "off" {
213.     cap assert `i' > 0  & int(`i') == `i' `ifassert'
214.     if _rc != 0 {
215.       dis as error  "Error: `i' must consist of positive, non-zero integers, but does not"
216.       error 411
217.     }
218.   }
219. 
.   * if poisson, check that y is not negative
.   if "`poisson'" != "" {
220.     cap assert `y' >= 0 `ifassert'
221.     if _rc != 0 {
222.       dis as error "Error: the outcome variable contains negative values; this is not allowed with poisson."
223.       error 411
224.     }
225.   }
226. 
. 
.   ****** process other aspects of the command syntax
. 
.   * if no elasticity type specified, assume regular non-elasticity estimates; a supplied
.   * but unrecognized value is rejected by the domain screen at the end of this program
.   * (formerly any unrecognized value collapsed silently to dydx)
.   if "`contreatelasticitytype'" == "" local contreatelasticitytype dydx
227.   if "`semielasticity'" == "" {
228.     local semielasticity dydx
229.   }
230.   else {
231.     local semielasticity eydx
232.   }
233. 
.   * do some light processing of the "number of pre-treatment coefs" input - it needs some adjustment when esfixedbaseperiod is used since the period normalized to 0 could fall within your range of requested coefs
.   if "`esfixedbaseperiod'" == "esfixedbaseperiod" &   `esprelength' > 0  {
234.     if abs(`esrelativeto') <= `esprelength' local ++esprelength
235.     * this is needed b/c we arent counting the reference period coef as a coef
.   }
236. 
.   * process the joint tests suppression flag  - it is on by default unless jointtests is specified
.   local suppressjointtests suppressjointtests
237.   if "jointtests" == "`jointtests'" local suppressjointtests
238. 
.   * what type of results do we want estimated  - if nothing specified, default estimand to att
.   if "`att'" == "" & "" == "`att_it'" & "" == "`att_itime'" & "" == "`att_i'" {
239.     local att att
240.   }
241. 
.   * handle contreatwithin - indicator to use only within variation
.   * crash if probably illegitimate contreatcontrols are specified
.   * also, set safety to off
.   if "`contreatwithin'" == "contreatwithin" & "`contreat'" != "" {
242.     if strpos("`contreatcontrols'","byTime") != 0  {
243.       if "`safety'" == "off" dis as text "Caution: contreatwithin is specified in conjunction with the byTime contreatcontrol type."
244.       if "`safety'" != "off" dis as error "Error: contreatwithin is specified in conjunction with the byTime contreatcontrol type."
245.       if "`verbose'" == "verbose" dis as text "Typically, this partials out some treatment effects and yields unidentified estimates."
246.       if "`safety'" != "off" {
247.         dis as error "To proceed anyway in a new estimation run, manually set safety(off) before proceeding."
248.         error 198
249.       }
250.     }
251.     local safety off
252.     * the above is required since we are intentionally making the base effects irrelevant
.   }
253. 
. 
.   * process cfxplottypes
.   * note that the tests here on what cfxplottypes are allowed are kinda weak in that you can request impractical relative periods (relyrs) and such, but better than no checks
.   if "`makecfxplots'" != "" {
254.     local cfxpost 0
255.     local cfxpre 0
256.     local cfxrelyrlist
257.     if "`cfxplottypes'" == "" local cfxplottypes post
258.     * VAL-G13A: exact-token parse. the old substring matching accepted garbage tokens
.     * (postpost counted as post, 2post2 became 2 2), and fractional numeric entries fell
.     * through both cap'd window filters silently (rc 0, no plot, no message). keywords are
.     * matched exactly per token; numeric tokens must be non-missing integers, loudly.
.     foreach item in `cfxplottypes' {
259.       if "`item'" == "post" {
260.         local cfxpost 1
261.         continue
262.       }
263.       if "`item'" == "pre" {
264.         * without esf or pre-periods, pre is dropped (documented precondition in the sthlp)
.         if "`esfixedbaseperiod'" == "esfixedbaseperiod" | `esprelength' > 0 local cfxpre 1
265.         continue
266.       }
267.       * remaining entries must be numeric: a stray token would otherwise be evaluated as a
.       * variable reference below -- crashing with an unexplained r(111) if no such variable
.       * exists, or silently injecting the variable into the plot list if one does (stata
.       * does not short-circuit |, so the reference-period comparison always runs)
.       cap confirm number `item'
268.       if _rc != 0 {
269.         dis as error "Error: cfxplottypes() contains an unrecognized entry: `item'"
270.         dis as error "Valid cfxplottypes() entries are post, pre, and/or integers specifying relative time periods."
271.         error 198
272.       }
273.       * a leading + is a natural way to write positive relative years (+2, matching -2), but
.       * the raw token is later embedded in matrix names, where + is an invalid character;
.       * strip it so +2 means 2 (and the post-loop dedup then also collapses +2 with 2)
.       if substr("`item'",1,1) == "+" local item = substr("`item'",2,.)
274.       if `item' >= . | int(`item') != `item' {
275.         dis as error "Error: cfxplottypes() contains a missing or non-integer entry: `item'"
276.         dis as error "Valid cfxplottypes() entries are post, pre, and/or integers specifying relative time periods."
277.         error 198
278.       }
279.       if "`esfixedbaseperiod'" == "" | `item' != `esrelativeto' {
280.         if `item' >= 0 & (`item' <= `espostlength' | "`esfixedbaseperiod'" == "esfixedbaseperiod") local cfxrelyrlist `cfxrelyrlist' `item'
281.         if `item' < 0 & (abs(`item') <= `esprelength' | "`esfixedbaseperiod'" == "esfixedbaseperiod") local cfxrelyrlist `cfxrelyrlist' `item'
282.       }
283.     }
284.     * a repeated relyr entry would build the same result matrix twice; the final ereturn loop
.     * moves (not copies) each matrix, so the duplicate's second pass dies r(111). list uniq
.     * preserves first-occurrence order, so duplicate-free input is untouched
.     local cfxrelyrlist : list uniq cfxrelyrlist
285.   }
286. 
. 
.   * weight-sign screen: the worker's `w' is its own tempvar when no weights are
.   * given (identically 1, making the assert vacuous there), so screen the user's
.   * weight expression directly instead
.   local w `exp'
287.   * gate on safetyinput, not safety: contreatwithin's internal safety-off overwrite sits
.   * upstream and previously skipped this screen entirely - contreatwithin + a negative
.   * weight ran rc 0 with no message (verifier s5_v2, 2026-07-26). an explicit user
.   * safety(off) still bypasses
.   if  "`safetyinput'" != "off" & "`w'" != "" {
288.     cap assert `w' >= 0 `ifassert'
289.     if _rc != 0 {
290.       dis as error  "Error: weights must not be negative."
291.       error 411
292.     }
293.   }
294. 
.   * VAL-G15A: the negative-subgroup screen moved into the worker (beside the integer
.   * screen) so it runs on the estimation-aware domain (ifstatement folds markout;
.   * internal ttre < . spans exactly the rows any over(subgroups) subpop can consume).
.   * the raw-if-domain check that lived here falsely rejected runs whose only negative
.   * values sat on deterministically-discarded rows (e.g. missing outcomes).
. 
.   * ---- S5: additional early screens for inputs that previously failed late with ----
.   * ---- opaque messages or were silently mis-handled. placed AFTER all pre-existing ----
.   * ---- checks so no existing multi-error precedence changes. ----
. 
.   * makecfxplots without a continuous treatment was a silent no-op: the whole cfx
.   * production block is gated on contreat(), so makecfxplots + cfxlattice() alone
.   * returned rc 0 with no plots and no message
.   if "`makecfxplots'" != "" & "`contreat'" == "" {
295.     dis as error "Error: makecfxplots requires a continuous treatment; specify contreat()."
296.     error 198
297.   }
298. 
.   * one-token lattice() was previously unvalidated: a forgotten quantile count surfaced
.   * as a bare "variable all not found" r(111), and bad variable contents survived to the
.   * regression stage. variable lookup runs first, so a genuine variable that happens to
.   * share a lattice-type name still wins, exactly as before
.   if "`lattice'" != "" & wordcount("`lattice'") == 1 {
299.     cap confirm numeric variable `lattice'
300.     if _rc != 0 {
301.       local wdvlatone = strlower("`lattice'")
302.       if inlist("`wdvlatone'","all","basetreated","basetreatedpost","basetreatedpre","basetreatedref") | inlist("`wdvlatone'","bycohort","bytime","bycohortbytime","bytreated","bytreatedbytime","byttre","byttrebytime") {
303.         dis as error "Error: lattice(`lattice') specifies a lattice type without a quantile count; use, for example, lattice(`lattice' 4)."
304.         error 198
305.       }
306.       dis as error "Error: lattice() must contain either an existing numeric variable or a lattice type followed by a quantile count."
307.       error 198
308.     }
309.     * gate on safetyinput (the user's own safety() setting, captured before the
.     * contreatwithin block relaxes `safety'), matching the F13 checks: an internal
.     * relaxation must not silently disable a data-integrity screen
.     if "`safetyinput'" != "off" {
310.       cap assert (`lattice' >= 0 & int(`lattice') == `lattice') | `lattice' >= . `ifassert'
311.       if _rc != 0 {
312.         dis as error "Error: the lattice() variable must contain only non-negative integers (it is used as a factor variable)."
313.         error 411
314.       }
315.     }
316.   }
317. 
.   * cfxlattice() content screens: margins over() accepts only non-negative integers, and
.   * previously bad contents died late at the margins/regression stage with generic
.   * messages. worse, margins silently DROPS missing-cfxlattice rows and wooldid calls
.   * margins quietly, so the omitted-observations note never reached the user (measured:
.   * rc 0 with materially different cfx results) - hence the missing-values Caution
.   if "`cfxlattice'" != "" & "`makecfxplots'" == "" {
318.     * inert option: without makecfxplots the variable is never passed to margins, and
.     * such calls ran fine before these screens existed - caution, do not error
.     dis as text "Caution: cfxlattice() has no effect without makecfxplots and is being ignored."
319.   }
320.   if "`cfxlattice'" != "" & "`makecfxplots'" != "" {
321.     cap confirm numeric variable `cfxlattice'
322.     if _rc != 0 {
323.       dis as error "Error: cfxlattice() must specify a numeric variable."
324.       error 198
325.     }
326.     if "`safetyinput'" != "off" {
327.       * VAL-G12A/G12B: both screens tolerate rows with a missing recorded onset - every
.       * executed CFX subpop requires internal ttre != . (never-treated rows feed no plot),
.       * so values there can neither crash margins nor silently shift a plotted average.
.       * mirrors the ttre_asgiven >= . tolerance of the commensurability screen below
.       cap assert (`cfxlattice' >= 0 & int(`cfxlattice') == `cfxlattice') | `cfxlattice' >= . | `ttre_asgiven' >= . `ifassert'
328.       if _rc != 0 {
329.         dis as error "Error: the cfxlattice() variable must contain only non-negative integers on observations with a nonmissing treatment onset (margins allows only non-negative integers in over())."
330.         error 411
331.       }
332.       local wdvcfxmiss `cfxlattice' >= . & `ttre_asgiven' < .
333.       if `"`if'"' != "" local wdvcfxmiss (`wdvcfxmiss') & ((`if') == 1)
334.       qui count if `wdvcfxmiss'
335.       if r(N) > 0 dis as text "Caution: the cfxlattice() variable is missing on `r(N)' observation(s) with a nonmissing treatment onset; margins omits those observations when computing the continuous treatment effect plot points, so th
> e plotted averages reflect only the nonmissing-cfxlattice subsample."
336.     }
337.   }
338. 
.   * non-commensurate ttre: fractional t - ttre previously either died late at the
.   * regression stage with opaque errors (a bare "invalid syntax", a tempvar-named
.   * factor-variable error, or a misleading insufficient-pre-periods r(459)) or - worse -
.   * ran to completion with the onset period silently mislabeled as pre-treatment.
.   * integer SPACING is not required - biennial or 5-year panels pass - only that onsets
.   * sit on the same grid as t. tiered like the F13 checks: offending onsets that fall
.   * wholly outside the usable window (dropped as pre-sample or treated as never-treated
.   * downstream) downgrade to a caution rather than an error
.   if "`safetyinput'" != "off" {
339.     cap assert (`t' - `ttre_asgiven') == int(`t' - `ttre_asgiven') | `ttre_asgiven' >= . `ifassert'
340.     if _rc != 0 {
341.       local wdvtrng `t' < .
342.       if `"`if'"' != "" local wdvtrng (`wdvtrng') & ((`if') == 1)
343.       qui gstats sum `t' if `wdvtrng', meanonly
344.       local wdvtmin = r(min)
345.       local wdvtlo = `wdvtmin' + `anticipation'
346.       local wdvthi = r(max) + `oostreatedcontrols' + `anticipation'
347.       * under timetrends the worker needs a two-period reference block, so it drops treated
.       * units with onsets at or below the SECOND observed period (mintp1, per-unit); lift the
.       * tier's lower bound to the second-smallest distinct t so fractional onsets in that
.       * band are screened by the worker's own drop rule rather than erroring here. exact for
.       * any period spacing (mintp1_i >= min{t : t > min(t)}); falls back to the first-period
.       * bound if the panel has a single distinct period
.       if "`timetrends'" != "" {
348.         qui gstats sum `t' if (`wdvtrng') & `t' > `wdvtmin', meanonly
349.         if r(N) > 0 local wdvtlo = r(min) + `anticipation'
350.       }
351.       cap assert (`t' - `ttre_asgiven') == int(`t' - `ttre_asgiven') | `ttre_asgiven' >= . | `ttre_asgiven' <= `wdvtlo' | `ttre_asgiven' > `wdvthi' `ifassert'
352.       if _rc != 0 {
353.         dis as error "Error: t minus ttre takes non-integer values, so relative-period horizons cannot be constructed. Treatment onset times must sit on the same grid as the time variable; if the time variable itself is on a fractional
>  grid (e.g. year + quarter/4), recode both to consecutive integers."
354.         error 459
355.       }
356.       dis as text "Caution: some treatment onset times are not on the same grid as t (t minus ttre is non-integer), but all such onsets fall outside the usable estimation window and will be dropped or treated as never-treated downstrea
> m."
357.     }
358.   }
359. 
.   * esrelativeto() without esfixedbaseperiod was silently ignored (output is identical
.   * with and without it)
.   if `esrelativeto' != -1 & "`esfixedbaseperiod'" == "" {
360.     dis as text "Caution: esrelativeto() has no effect without esfixedbaseperiod and is being ignored."
361.   }
362. 
.   * ---- F9: fast (no-SE) mode gates ----
.   * placed last so no pre-existing check's position (and so no multi-error call's first
.   * message) moves. fastnose runs every margins call with nose: point estimates only.
.   * everything downstream that needs a variance is therefore unavailable and is refused
.   * here rather than silently degraded - margins itself rejects nose+vce(unconditional)
.   * (r198), test after a nose post is r321, and contrast(overjoint) under nose returns a
.   * MISSING p rather than erroring, which would otherwise be displayed and ereturn'd.
.   if "`fastnose'" != "" {
363.     if "`unconditionalse'" != "" {
364.       dis as error "Error: fastnose is not compatible with unconditionalse; unconditional standard errors are produced by margins, which fast mode does not ask for."
365.       error 198
366.     }
367.     if "`impvalues'" != "" {
368.       dis as error "Error: fastnose is not compatible with impvalues; Ibragimov-Muller inference reports standard errors and p-values, which fast mode does not estimate."
369.       error 198
370.     }
371.     if "`adversarial'" != "" {
372.       dis as error "Error: fastnose is not compatible with adversarial; the adversarial pre-trends test needs a variance-covariance matrix, which fast mode does not estimate."
373.       error 198
374.     }
375.     if "`jointtests'" != "" {
376.       dis as error "Error: fastnose is not compatible with jointtests; fast mode reports point estimates only."
377.       error 198
378.     }
379.     if "`pretrendpower'" != "" {
380.       dis as error "Error: fastnose is not compatible with pretrendpower(); the Roth (2022) diagnostics need the event-study variance-covariance matrix, which fast mode does not estimate."
381.       error 198
382.     }
383.     * belt-and-braces: joint tests are already off whenever jointtests is absent, and the
.     * gate above rejects jointtests, so this is redundant today - it is kept explicit so a
.     * future relaxation of that gate cannot silently re-enable a joint test under nose
.     local suppressjointtests suppressjointtests
384.   }
385. 
.   * ---- option-domain screens (issue-file batch VAL-G19/G21A/G21B/G21C/G21E) ----
.   * appended after all pre-existing checks so no existing multi-error call's first message
.   * moves. each closes a silent-accept path: these inputs previously ran rc 0 with
.   * silently different semantics than requested.
.   * contreatwithin without contreat() was silently ignored AND disabled the worker's
.   * binary-design estimability checks (which gate on the bare flag)
.   if "`contreatwithin'" != "" & "`contreat'" == "" {
386.     dis as error "Error: you cannot request contreatwithin without specifying a continuous treatment variable via contreat()."
387.     error 198
388.   }
389.   * a supplied but unrecognized elasticity type formerly collapsed silently to dydx
.   if !inlist("`contreatelasticitytype'", "dydx", "eyex", "eydx", "dyex") {
390.     dis as error "Error: contreatelasticitytype() must be dydx, eyex, eydx, or dyex."
391.     error 198
392.   }
393.   * syntax's int type rejects fractions/missing but admits 0 and negatives, which
.   * formerly ran identically to order 1
.   if `contreatpoly' < 1 {
394.     dis as error "Error: contreatpoly() must be a positive integer."
395.     error 198
396.   }
397.   * tested on the raw user value (safetyinput): contreat+contreatwithin rewrites the
.   * working copy to off above, which would mask an invalid user token here
.   if "`safetyinput'" != "" & !inlist("`safetyinput'", "on", "off") {
398.     dis as error "Error: safety() must be on or off."
399.     error 198
400.   }
401.   * under esfixedbaseperiod the worker formerly clamped esrelativeto() values above -1
.   * to -1 silently; the reference period must lie strictly before onset
.   if "`esfixedbaseperiod'" != "" & `esrelativeto' > -1 {
402.     dis as error "Error: esrelativeto() must be a negative integer (a pre-onset reference period) when esfixedbaseperiod is specified."
403.     error 198
404.   }
405.   * NFADV-07: altmethod_adversarial is a modifier of adversarial; every gate and work
.   * branch keys on the adversarial flag, so the standalone spelling ran rc 0 as a silent
.   * no-op. error rather than imply, matching the modifier-without-parent convention
.   * (lattice()-without-contreat, contreatwithin-without-contreat)
.   if "`altmethod_adversarial'" != "" & "`adversarial'" == "" {
406.     dis as error "Error: altmethod_adversarial modifies the adversarial pre-trends test; specify the adversarial option as well (or remove altmethod_adversarial)."
407.     error 198
408.   }
409. 
.   * ---- return the parsed options and every derived/normalized local to the worker ----
.   * blanket-by-construction: every option the syntax line defines is listed (plus the
.   * derived locals below), so a future edit that mutates one more local here cannot
.   * silently strand the worker on the stale syntax-parsed value. varlist/if/weight/exp
.   * are excluded: the worker's own syntax call already parsed them identically and this
.   * subprogram never alters them.
.   foreach wdv_ret in att att_it att_itime att_i cluster customvce unconditionalse robust impvalues fe coarsecohortcontrols ccc_absorb controls interactivecontrols timetrends subgroups customweightmultiplier esprelength espostlength savepl
> ots poisson poisexpresults oostreatedcontrols anticipation esfixedbaseperiod esrelativeto safety makeplots makecfxplots summarystats histogramcohorteffects regtol jointtests suppresssgprimaryeffects contreat contreatpoly lattice latticeig
> noreweights ccnoabsorb contreatcontrols verbose cfxplottypes cfxlattice makecfxplotsbysg cfxplotnose semielasticity contreatelasticitytype contreatwithin cleanmatrices emptycellsoverride replace altmethod_adversarial adversarial update ol
> dsyntax pretrendpower fastnose gteffects permute permreps permexact permtstat permtci permstrata permprobs y i t ttre_asgiven safetyinput suppressjointtests latticenum latticetype esposttrip cfxpost cfxpre cfxrelyrlist {
410.     c_local `wdv_ret' `"``wdv_ret''"'
411.   }
412. 
. end

. 
. * ============================================================================
. * F4 helper subprograms (kept out of the worker to conserve its size headroom)
. * ============================================================================
. 
. * warn when an effective onset lands on a period not observed in the data - on panels
. * whose t is not unit-spaced (e.g. biennial), an off-grid anticipation shift can merely
. * relabel horizons (pooled reference), move the fixed reference period in unintended
. * ways (esfixedbaseperiod), or make estimation fail
. cap prog drop wooldid_anticgrid

. prog def wooldid_anticgrid
  1. version 16.0
  2.   syntax , tvar(string) ttrevar(string) ifv(string)
  3.   qui glevelsof `ttrevar' if `ifv' == 1 & `ttrevar' != ., local(anticonsets)
  4.   local anticoffgrid
  5.   foreach anticv of local anticonsets {
  6.     qui count if `tvar' == `anticv' & `ifv' == 1
  7.     if r(N) == 0 local anticoffgrid `anticoffgrid' `anticv'
  8.   }
  9.   if "`anticoffgrid'" != "" {
 10.     dis as text "Caution: anticipation() is expressed in the units of `tvar', and the effective onset value(s) `anticoffgrid' fall on period(s) not observed in the data. Depending on the specification, this can merely relabel horizons,
>  move the reference period in unintended ways, or cause estimation to fail. Verify that the anticipation length matches the spacing of `tvar'."
 11.   }
 12. end

. 
. * under esfixedbaseperiod, report units dropped only BECAUSE the anticipation shift
. * moved their reference period onto a period they are not observed in (called after the
. * reference-period screen zeroes ifvar, before ttre is nulled for the dropped units)
. cap prog drop wooldid_anticesf

. prog def wooldid_anticesf
  1. version 16.0
  2.   syntax , ivar(string) tvar(string) rawttre(string) refobs(string) esrel(string) antic(string) ttrevar(string) ifv(string)
  3.   * the raw-reference check must use the SAME domain the reference screen itself used:
.   * rows in-sample before this screen ran. the screen has already zeroed ifv for its own
.   * victims, so that domain = still-in-sample rows plus the just-zeroed victims. without
.   * this restriction, a raw reference observed only on rows an EARLIER screen (e.g. a
.   * user if()) had excluded would mis-attribute an unrelated drop to the shift
.   tempvar rawref rawrefobs
  4.   qui gen byte `rawref' = `tvar' == `rawttre' + `esrel' if `ifv' == 1 | (`refobs' == 0 & `ttrevar' != .)
  5.   qui gegen `rawrefobs' = max(`rawref'), by(`ivar')
  6.   qui count if `refobs' == 0 & `ttrevar' != . & `rawrefobs' == 1
  7.   if r(N) > 0 {
  8.     local anticdropobs = r(N)
  9.     tempvar antictag
 10.     qui gegen `antictag' = tag(`ivar') if `refobs' == 0 & `ttrevar' != . & `rawrefobs' == 1
 11.     qui count if `antictag' == 1
 12.     dis as text "Caution: anticipation(`antic') places the effective reference period of `r(N)' unit(s) on a period unusable for them (not observed, or dropped for lack of a comparison unit); those unit(s) and their `anticdropobs' obse
> rvations are dropped (their reference period would have been usable without the anticipation shift)."
 13.     qui drop `antictag'
 14.   }
 15.   qui drop `rawref' `rawrefobs'
 16. end

. 
. * ============================================================================
. * E1 subprogram: build the "every subgroup margin is equal" constraint chain for
. * -test- out of the coefficient names Stata itself posted in e(b) after
. *   margins ..., over(<sg>) pwcompare(effects) <marginsdof> post
. * The names are READ BACK (colnames/coleq), never constructed from subgroup
. * values, so they are valid by construction whatever the level values, level
. * labels or variable name length; omitted (o.) columns are skipped. -half-
. * selects the binary layout, where the posted e(b) carries the base-outcome half
. * followed by the 1.<targetflag> half and only the second half is wanted;
. * without -half- (continuous treatment) every column is used.
. * Returns: sgchain (the chain, empty if fewer than 2 usable columns)
. *          sgchainn (number of usable columns; the caller must require > 1,
. *          since a one-term chain would test that margin against 0 instead)
. * A subprogram because wooldid_worker sits near Stata's per-program compiled-size
. * ceiling and this is used at four call sites.
. * ============================================================================
. cap prog drop wooldid_sgchain

. prog def wooldid_sgchain
  1. version 16.0
  2.   syntax [, HALF]
  3.   tempname sgcb
  4.   matrix `sgcb' = e(b)
  5.   local sgck = colsof(`sgcb')
  6.   local sgccn : colnames `sgcb'
  7.   local sgcce : coleq `sgcb'
  8.   local sgcj0 = 1
  9.   if "`half'" == "half" local sgcj0 = floor(`sgck'/2) + 1
 10.   local sgcchain
 11.   local sgcn 0
 12.   forval sgcj = `sgcj0'/`sgck' {
 13.     local sgcnm : word `sgcj' of `sgccn'
 14.     local sgceq : word `sgcj' of `sgcce'
 15.     if strmatch("`sgcnm'","*o.*") continue
 16.     local sgcn = `sgcn' + 1
 17.     if `sgcn' == 1 local sgcchain [`sgceq']`sgcnm'
 18.     else local sgcchain `sgcchain' = [`sgceq']`sgcnm'
 19.   }
 20.   if `sgcn' < 2 local sgcchain
 21.   c_local sgchain `"`sgcchain'"'
 22.   c_local sgchainn `sgcn'
 23. end

. 
. 
. 
. *** F6: parse-time screens for permutation inference (author's brief: cluster nesting
. *** in treatment-onset levels; refuse impvalues/unconditionalse/contreatwithin; reps
. *** xor exact; strata subset checks). kept out of wooldid_validate for size headroom.
. cap prog drop wooldid_permctl

. prog def wooldid_permctl
  1. version 16.0
  2.   syntax , [permute(string) permreps(integer 0) PERMEXact clus(varlist) ttrevar(varname) permstrata(varname numeric) permprobs(string asis) impv(string) uncond(string) cw(string) os(string) ts(string) tc(string) fn(string) cc(string as
> is) ifr(string asis)]
  3. 
.   local permmethod `permute'
  4.   if "`permmethod'" != "shuffle" & "`permmethod'" != "probabilities" {
  5.     dis as error "Error: permute() must be permute(shuffle) or permute(probabilities). Strata and assignment probabilities have their own options: permstrata() and permprobs()."
  6.     error 198
  7.   }
  8.   if "`impv'" != "" {
  9.     dis as error "Error: permute() is not compatible with impvalues."
 10.     error 198
 11.   }
 12.   if "`uncond'" != "" {
 13.     dis as error "Error: permute() is not compatible with unconditionalse."
 14.     error 198
 15.   }
 16.   if "`cw'" != "" {
 17.     dis as error "Error: permute() is not compatible with contreatwithin: randomization inference reassigns onset timing across clusters, which requires a comparison group."
 18.     error 198
 19.   }
 20.   * NFPERM-15: untreatedZero's model formulation requires the dose to be zero outside
.   * treated cohort-periods; replications reassign onset while the dose path stays frozen,
.   * so every rep would violate that structural premise and silently contaminate the null
.   * distribution. plain equality suffices: validate already forces untreatedZero to be
.   * the sole contreatcontrols token. contreat in general stays ALLOWED (adjudicated:
.   * the null is timing-as-if-random given dose)
.   if `"`cc'"' == "untreatedZero" {
 21.     dis as error "Error: permute() is not compatible with contreatcontrols(untreatedZero): replications reassign treatment onset while the dose path stays fixed, violating untreatedZero's requirement that the dose be zero outside treat
> ed cohort-periods."
 22.     error 198
 23.   }
 24.   if "`os'" == "1" {
 25.     dis as error "Error: permute() is not compatible with oldsyntax."
 26.     error 198
 27.   }
 28.   if ("`ts'" != "" | "`tc'" != "") & "`fn'" != "" {
 29.     dis as error "Error: permtstat/permtci randomize on t-statistics, which fastnose does not compute."
 30.     error 198
 31.   }
 32.   if `permreps' < 0 {
 33.     dis as error "Error: permreps() must be a positive integer."
 34.     error 198
 35.   }
 36.   if `permreps' > 0 & `permreps' < 20 {
 37.     dis as error "Error: permreps() must be at least 20: the engine refuses inference on fewer than 20 completed replications, so a smaller request can only ever burn the run."
 38.     error 198
 39.   }
 40.   if "`permmethod'" == "probabilities" {
 41.     cap confirm numeric variable `clus'
 42.     if _rc != 0 {
 43.       dis as error "Error: permute(probabilities) requires a numeric cluster variable (the permprobs() grammar lists clusters by numeric value)."
 44.       error 198
 45.     }
 46.     if `"`permprobs'"' == "" {
 47.       dis as error "Error: permute(probabilities) requires permprobs()."
 48.       error 198
 49.     }
 50.     if "`permexact'" != "" {
 51.       dis as error "Error: permute(probabilities) supports permreps() only, not permexact."
 52.       error 198
 53.     }
 54.     if `permreps' <= 0 {
 55.       dis as error "Error: permute(probabilities) requires permreps()."
 56.       error 198
 57.     }
 58.   }
 59.   if "`permmethod'" == "shuffle" {
 60.     if `"`permprobs'"' != "" {
 61.       dis as error "Error: permprobs() is only for permute(probabilities)."
 62.       error 198
 63.     }
 64.     if "`permexact'" != "" & `permreps' > 0 {
 65.       dis as error "Error: specify permreps() or permexact, not both."
 66.       error 198
 67.     }
 68.     if "`permexact'" == "" & `permreps' <= 0 {
 69.       dis as error "Error: permute(shuffle) requires permreps() or permexact."
 70.       error 198
 71.     }
 72.   }
 73.   if wordcount("`clus'") != 1 {
 74.     dis as error "Error: permute() requires cluster() with a single variable - the unit whose treatment-onset assignment is randomized."
 75.     error 198
 76.   }
 77. 
.   * sample for the data checks: the user's if-restriction, rows with a cluster value
.   tempvar insmp
 78.   * NFPERM-03: exact-one rule ((exp)==1), matching estimation's if-semantics (8d7bd01):
.   * native truth admitted rows with if-values like 2 or missing into the randomization
.   * design that never enter estimation (false r459 nesting errors on bare-flag ifs;
.   * design-population drift). byte-parallel with permrun's smp below
.   if `"`ifr'"' != "" qui gen byte `insmp' = ((`ifr') == 1) & !missing(`clus')
 79.   else qui gen byte `insmp' = !missing(`clus')
 80.   qui replace `insmp' = 0 if `insmp' >= .
 81. 
.   * the level accounting treats all missing codes as the single never-treated group,
.   * but enumeration/probability matching distinguishes extended missings; require the
.   * plain-missing convention outright
.   qui count if `insmp' & `ttrevar' > .
 82.   if r(N) > 0 {
 83.     dis as error "Error: permute() requires never-treated observations coded as plain missing (.) in the timing variable; `r(N)' in-sample observation(s) carry extended missing codes (.a, .b, ...)."
 84.     error 459
 85.   }
 86. 
.   * nesting (author's brief): each cluster must sit inside exactly one treatment-onset
.   * level - onset constant within cluster, and treated/never-treated rows never mixed
.   tempvar tmin tmax ntr nnv
 87.   qui gegen double `tmin' = min(`ttrevar') if `insmp', by(`clus')
 88.   qui gegen double `tmax' = max(`ttrevar') if `insmp', by(`clus')
 89.   qui gegen double `ntr' = total(!missing(`ttrevar')) if `insmp', by(`clus')
 90.   qui gegen double `nnv' = total(missing(`ttrevar')) if `insmp', by(`clus')
 91.   qui count if `insmp' & ((`ntr' > 0 & `nnv' > 0) | (`ntr' > 0 & `tmin' != `tmax'))
 92.   if r(N) > 0 {
 93.     dis as error "Error: permute() requires clusters to be subsets of treatment-onset groups (levels of the timing variable, with never-treated its own group), but `r(N)' in-sample observation(s) sit in clusters that mix onset values o
> r mix treated and never-treated rows."
 94.     error 459
 95.   }
 96. 
.   * strata: clusters must be strict subsets of strata
.   if "`permstrata'" != "" {
 97.     if "`permmethod'" != "shuffle" {
 98.       dis as error "Error: permstrata() is only for permute(shuffle)."
 99.       error 198
100.     }
101.     tempvar smin smax
102.     qui gegen double `smin' = min(`permstrata') if `insmp', by(`clus')
103.     qui gegen double `smax' = max(`permstrata') if `insmp', by(`clus')
104.     qui count if `insmp' & (`smin' != `smax' | missing(`permstrata'))
105.     if r(N) > 0 {
106.       dis as error "Error: permstrata() requires every cluster to sit inside a single stratum with no missing stratum values (`r(N)' in-sample observation(s) violate this)."
107.       error 459
108.     }
109.   }
110. 
.   * enough freedom to randomize: at least 2 clusters and 2 distinct onset groups
.   tempvar ctag consv
111.   qui gegen byte `ctag' = tag(`clus') if `insmp'
112.   qui count if `ctag' == 1
113.   local permnclus = r(N)
114.   qui gen double `consv' = cond(`ntr' > 0, `tmin', .) if `ctag' == 1
115.   qui glevelsof `consv' if `ctag' == 1, missing local(permlvls)
116.   local permnlvl : word count `permlvls'
117.   if `permnclus' < 2 | `permnlvl' < 2 {
118.     dis as error "Error: permute() found `permnclus' cluster(s) across `permnlvl' treatment-onset group(s); there is nothing to randomize."
119.     error 459
120.   }
121. 
.   * permute(probabilities): validate the permprobs() grammar against the data's actual
.   * onset levels and cluster values (the same mata parser the engine uses, run in
.   * check-only mode, so the two can never drift)
.   if "`permmethod'" == "probabilities" {
122.     qui glevelsof `ttrevar' if `insmp', missing local(permonslvls)
123.     qui glevelsof `clus' if `insmp', local(permclusvals)
124.     local permperr
125.     mata: wooldid_permp(st_local("permprobs"), "`ttrevar'", "`permonslvls'", "`permclusvals'", "", "")
126.     if "`permperr'" != "" {
127.       dis as error "`permperr'"
128.       error 198
129.     }
130.   }
131. end

. 
. 
. *** F6: the permutation engine. builds the cluster->onset map, generates assignments
. *** (mata: wooldid_permx), runs the rep loop as nested quiet wooldid calls on a
. *** permuted onset column, and hands the summary statistics back to the shell via
. *** c_local (the shell restores the observed results and posts them to e())
. cap prog drop wooldid_permrun

. prog def wooldid_permrun
  1. version 16.0
  2.   syntax , y(varname) i(varname) t(varname) ttrevar(varname) clus(varlist) permute(string) estimands(string) distname(string) [permreps(integer 0) PERMEXact permstrata(varname numeric) permprobs(string asis) PERMTStat repopts(string as
> is) wtype(string) wexp(string) ifr(string asis) compname(string)]
  3. 
.   * comparison-statistic scalars, filled by the mandatory rep-0 run below (NFPERM-10)
.   tempname wdpo1 wdpo2 wdpo3 wdpo4
  4. 
.   * one row per cluster: its onset level and (optional) stratum
.   tempvar smp
  5.   if `"`ifr'"' != "" {
  6.     * NFPERM-03: exact-one rule, byte-parallel with permctl's insmp
.     qui gen byte `smp' = ((`ifr') == 1)
  7.     qui replace `smp' = 0 if `smp' >= .
  8.   }
  9.   else qui gen byte `smp' = 1
 10.   qui replace `smp' = 0 if missing(`clus')
 11.   tempname mpfr
 12.   frame put `clus' `ttrevar' `permstrata' if `smp', into(`mpfr')
 13.   frame `mpfr' {
 14.     qui bysort `clus': keep if _n == 1
 15.     if "`permstrata'" == "" {
 16.       tempvar onestr
 17.       qui gen byte `onestr' = 1
 18.       local permstrata `onestr'
 19.     }
 20.     qui sort `permstrata' `clus'
 21.     qui gen double __wdpassign = .
 22.     * NFPERM-02: freeze the generation-time row identity. the assignment matrix is
.     * generated in the (strata, cluster) sort order above, but frlink below RE-SORTS
.     * this frame by the cluster key (frlink is sortpreserve for the master frame only),
.     * so a positional _n read at application time attaches assignments to the WRONG
.     * clusters whenever ascending cluster order crosses stratum order - silently wrong
.     * stratified inference (probed: crossing-strata exact designs reported p=0 with the
.     * observed assignment absent from their own enumeration). __wdprow keys each row to
.     * its generation-time matrix row, making any later reorder harmless
.     qui gen long __wdprow = _n
 23.   }
 24. 
.   * assignments + counts (mata): fills the C x R matrix, sets wdp_R, the possible-
.   * assignment count (double + string), and caution flags
.   tempname wdpassign wdpP wdpL
 25.   if "`permute'" == "probabilities" {
 26.     * re-run the shared parser in engine mode: fills the probability matrix (rows in
.     * ascending cluster order = the map frame's order) and the level vector
.     frame `mpfr' {
 27.       qui glevelsof `ttrevar', missing local(permonslvls)
 28.       qui glevelsof `clus', local(permclusvals)
 29.     }
 30.     local permperr
 31.     mata: wooldid_permp(st_local("permprobs"), "`ttrevar'", "`permonslvls'", "`permclusvals'", "`wdpP'", "`wdpL'")
 32.     if "`permperr'" != "" {
 33.       dis as error "`permperr'"
 34.       error 198
 35.     }
 36.   }
 37.   mata: wooldid_permx("`mpfr'", "`ttrevar'", "`permstrata'", `permreps', ("`permexact'" != ""), "`wdpassign'", "`wdpP'", "`wdpL'")
 38.   if "`wdp_caut0'" != "" dis as text "Caution: `wdp_caut0'"
 39.   if "`wdp_err'" != "" {
 40.     dis as error "`wdp_err'"
 41.     error 198
 42.   }
 43.   * NFPERM-09: conditionally degenerate designs (every stratum onset-homogeneous, or every
.   * permprobs() row deterministic) pass the global freedom precheck but admit exactly one
.   * possible assignment; they formerly ran to completion reporting a useless p (p=1, or
.   * p=1/(R+1) when a deterministic table targets a non-observed assignment). both
.   * generators report the support count in wdp_npd, and M==1 iff lnM==0 exactly (the
.   * per-stratum lnfactorial terms cancel exactly; smallest nondegenerate M is 2), so the
.   * numeric compare cannot false-fire. placed BEFORE the reps-vs-support cautions so a
.   * degenerate run is refused rather than first advised to consider permexact
.   if real("`wdp_npd'") == 1 {
 44.     dis as error "Error: the requested randomization design admits only one possible assignment (every stratum is onset-homogeneous, or every permprobs() row is deterministic); there is nothing to randomize."
 45.     error 459
 46.   }
 47.   if "`wdp_caut1'" != "" dis as text "Caution: `wdp_caut1'"
 48.   if "`wdp_caut2'" != "" dis as text "Caution: `wdp_caut2'"
 49. 
.   * link the map into the data once; each rep refreshes the onset column from it
.   tempvar lnk repons
 50.   qui frlink m:1 `clus', frame(`mpfr') generate(`lnk')
 51.   local ndone 0
 52.   local nfail 0
 53.   tempname res
 54.   matrix `res' = J(`wdp_R', `: word count `estimands'', .)
 55.   local wtif
 56.   if "`wtype'" != "" local wtif [`wtype'=`wexp']
 57.   if `"`ifr'"' != "" local wtif `wtif' if (`ifr')
 58.   local repcall `y' `i' `t'
 59.   * statistic-path consistency: draws are estimated under fastnose, whose point
.   * estimates differ from the full run's in the last digits (the F9 contract), so the
.   * comparison statistic comes from a rep-0 fastnose run of the TRUE assignment - this
.   * keeps the exact test's observed-is-a-member property bitwise. the display still
.   * shows the full run's estimate. the statistics are held in tempname SCALARS: a
.   * local's decimal round-trip re-parses one ulp off, which breaks the
.   * observed-is-a-member property (measured: b >= local-copy-of-b evaluates FALSE)
.   cap qui wooldid `repcall' `ttrevar' `wtif' , `repopts'
 60.   * NFPERM-10: the comparator fit and its scalars must be valid. formerly a rep-0
.   * failure fell through silently (retaining full-run-provenance scalars, breaking the
.   * exact test's bitwise observed-is-a-member property), and a missing comparison
.   * statistic (e.g. a degenerate observed SE under permtstat) silently zeroed every
.   * tail count - exact p = 0 with no message. the shell restores the observed
.   * estimation results bit-intact on these error paths
.   if _rc == 1 error 1
 61.   if _rc != 0 {
 62.     dis as error "Error: the rep-0 comparison run of the observed assignment failed (rc `=_rc'); permutation inference is impossible. The observed estimation results are unaffected."
 63.     error 459
 64.   }
 65.   local ec 0
 66.   foreach ee in `estimands' {
 67.     local ++ec
 68.     if "`permtstat'" == "" cap scalar `wdpo`ec'' = _b[main_`ee']
 69.     else cap scalar `wdpo`ec'' = _b[main_`ee']/_se[main_`ee']
 70.     if _rc != 0 {
 71.       dis as error "Error: the observed comparison statistic for `ee' could not be read from the rep-0 run; permutation inference is impossible."
 72.       error 459
 73.     }
 74.     if missing(`wdpo`ec'') {
 75.       dis as error "Error: the observed comparison statistic for `ee' is missing (unidentified observed estimate or standard error); permutation inference is impossible."
 76.       error 459
 77.     }
 78.   }
 79.   * NFPERM-12 (lean kernel): export the comparison statistics actually used for the
.   * tail counts, guarded valid above; the caller posts them as e(perm_comparator)
.   if "`compname'" != "" {
 80.     matrix `compname' = J(1, `: word count `estimands'', .)
 81.     local ec 0
 82.     foreach ee in `estimands' {
 83.       local ++ec
 84.       matrix `compname'[1, `ec'] = `wdpo`ec''
 85.     }
 86.     matrix colnames `compname' = `estimands'
 87.   }
 88.   forval r = 1/`wdp_R' {
 89.     frame `mpfr': qui replace __wdpassign = el("`wdpassign'", __wdprow, `r')
 90.     cap drop `repons'
 91.     qui frget `repons' = __wdpassign, from(`lnk')
 92.     cap qui wooldid `repcall' `repons' `wtif' , `repopts'
 93.     local badrep 0
 94.     if _rc != 0 local badrep 1
 95.     if `badrep' == 0 {
 96.       local ec 0
 97.       foreach ee in `estimands' {
 98.         local ++ec
 99.         if "`permtstat'" == "" {
100.           cap matrix `res'[`r', `ec'] = _b[main_`ee']
101.           * NFPERM-10: mirror the t-branch missing check so whole-row blanking keeps a
.           * single completed-row set (nuse == ndone for every column)
.           if _rc == 0 {
102.             if missing(`res'[`r', `ec']) local badrep 1
103.           }
104.         }
105.         else {
106.           cap matrix `res'[`r', `ec'] = _b[main_`ee']/_se[main_`ee']
107.           if _rc == 0 {
108.             if missing(`res'[`r', `ec']) local badrep 1
109.           }
110.         }
111.         if _rc != 0 local badrep 1
112.       }
113.     }
114.     if `badrep' == 0 local ++ndone
115.     else {
116.       local ++nfail
117.       * blank the whole row: a partially-failed rep (reachable under permtstat with a
.       * degenerate SE on one of several estimands) must not leak its good columns into
.       * the per-estimand summaries, and the permdist packing keys on column 1
.       local ec 0
118.       foreach ee in `estimands' {
119.         local ++ec
120.         cap matrix `res'[`r', `ec'] = .
121.       }
122.     }
123.   }
124.   cap drop `lnk'
125.   cap drop `repons'
126.   frame drop `mpfr'
127. 
.   if `ndone' < max(20, `wdp_R'/2) & "`permexact'" == "" {
128.     dis as error "Error: only `ndone' of `wdp_R' permutation replications estimated successfully; too few for inference. Check whether reassigned onset configurations are frequently inestimable on these data."
129.     error 459
130.   }
131.   * NFPERM-01 (lean residue): under permexact ANY failure means the enumeration is
.   * incomplete, so the caution fires at nfail > 0 with wording that states the
.   * substance; sampled mode keeps the 10% threshold (adjudicated accounting design)
.   if `nfail' > 0 & "`permexact'" != "" dis as text "Caution: `nfail' of `wdp_R' enumerated assignments failed to estimate, so the exact enumeration is incomplete; the reported exact p-value is a share over completed assignments only (the 
> observed-is-a-member and 2/M-floor readings no longer apply)."
132.   else if `nfail' > 0 & `nfail' > 0.1*`wdp_R' dis as text "Caution: `nfail' of `wdp_R' permutation replications failed to estimate and were excluded."
133. 
.   * summaries per estimand: add-one two-sided p (exact: plain share - the observed
.   * assignment is a member of the enumeration), 5th/95th percentile band, SD
.   tempname rsfr
134.   matrix `distname' = J(`ndone', `: word count `estimands'', .)
135.   local ec 0
136.   foreach ee in `estimands' {
137.     local ++ec
138.     frame create `rsfr' double s
139.     frame `rsfr' {
140.       qui set obs `wdp_R'
141.       qui replace s = el("`res'", _n, `ec')
142.       qui drop if missing(s)
143.       qui count if abs(s) >= abs(`wdpo`ec'')
144.       local nex = r(N)
145.       qui count
146.       local nuse = r(N)
147.       _pctile s, p(5 95)
148.       local lb = r(r1)
149.       local ub = r(r2)
150.       qui sum s
151.       * NFPERM-11: an exact enumeration IS the complete population of assignments, so
.       * report the population SD (denominator M); sampled draws keep the n-1 sample SD.
.       * r(Var) is full double precision - no display-rounding hazard
.       if "`permexact'" != "" local sdv = sqrt(r(Var)*(r(N)-1)/r(N))
152.       else local sdv = r(sd)
153.       if `sdv' == 0 dis as text "Caution: the permuted `ee' distribution is degenerate (every completed draw equals every other); the permutation p-value is uninformative."
154.       local q95 .
155.       if "`permtstat'" != "" {
156.         qui gen double abss = abs(s)
157.         _pctile abss, p(95)
158.         local q95 = r(r1)
159.         qui drop abss
160.       }
161.     }
162.     frame drop `rsfr'
163.     if "`permexact'" != "" local p_`ee' = `nex'/`nuse'
164.     else local p_`ee' = (1 + `nex')/(`nuse' + 1)
165.     c_local wdp_r_p_`ee' `p_`ee''
166.     c_local wdp_r_lb_`ee' `lb'
167.     c_local wdp_r_ub_`ee' `ub'
168.     c_local wdp_r_sd_`ee' `sdv'
169.     c_local wdp_r_q_`ee' `q95'
170.   }
171.   * dense permdist matrix (completed rows only), built once from res
.   local rr 0
172.   forval r = 1/`wdp_R' {
173.     if !missing(el("`res'", `r', 1)) {
174.       local ++rr
175.       local ec 0
176.       foreach ee in `estimands' {
177.         local ++ec
178.         matrix `distname'[`rr', `ec'] = el("`res'", `r', `ec')
179.       }
180.     }
181.   }
182.   matrix colnames `distname' = `estimands'
183. 
.   c_local wdp_r_reps `wdp_R'
184.   c_local wdp_r_done `ndone'
185.   c_local wdp_r_fail `nfail'
186.   c_local wdp_r_npd `wdp_npd'
187.   c_local wdp_r_nps `wdp_nps'
188. end

. 
. 
. * ============================================================================
. * F7 subprograms: Roth (2022) pre-trend power diagnostics.
. * Implemented as subprograms because wooldid_worker sits close to Stata's
. * per-program compiled-size ceiling (verified: sizable inline additions make
. * the ado fail to load with r(1000)).
. * ============================================================================
. 
. * parse-time validation for pretrendpower()
. cap prog drop wooldid_ptpcheck

. prog def wooldid_ptpcheck
  1. version 16.0
  2.   syntax , [levels(numlist) esf(string) impv(string) espre(string)]
  3.   if "`impv'" != "" {
  4.     dis as error "Error: pretrendpower() is not compatible with impvalues (no event-study variance-covariance matrix exists under Ibragimov-Muller inference)."
  5.     error 198
  6.   }
  7.   if "`esf'" == "" {
  8.     dis as error "Error: pretrendpower() requires esfixedbaseperiod. Under the pooled reference the comparison period is a cohort-specific pool of pre-periods, so the single omitted reference period that the Roth (2022) linear-trend no
> rmalization requires is not defined."
  9.     dis as error "Specify esfixedbaseperiod (with esrelativeto() if you want a reference other than -1)."
 10.     error 198
 11.   }
 12.   if `espre' <= 0 {
 13.     dis as error "Error: pretrendpower() requires esprelength() of at least 1; without pre-treatment event-study coefficients there is nothing to diagnose."
 14.     error 198
 15.   }
 16.   foreach ptpl of local levels {
 17.     if `ptpl' > 0 & `ptpl' < 1 {
 18.       dis as error "Error: pretrendpower() takes power levels in percent (for example 80, not .8)."
 19.       error 198
 20.     }
 21.     if `ptpl' != int(`ptpl') | `ptpl' <= 5 | `ptpl' >= 100 {
 22.       dis as error "Error: pretrendpower() power levels must be integers strictly between 5 and 100 (for example 50, 80, 90, 95)."
 23.       error 198
 24.     }
 25.   }
 26. end

. 
. * compute + display + ereturn the diagnostics. Runs AFTER the ereturn post, so it may
. * only use r-class data commands and matrix algebra (an estimation command here would
. * wipe the posted e()). All inputs arrive as passed tempvar names or e() objects.
. cap prog drop wooldid_ptp

. prog def wooldid_ptp, eclass
  1. version 16.0
  2.   syntax , levels(numlist) [esrel(string) dfr(string) pois(string) poisexp(string) tvar(string) ttrevar(string) ivar(string) wvar(string) cwm(string)]
  3. 
.   * duplicate power levels (e.g. pretrendpower(80 80)) would otherwise be processed
.   * twice, yielding a duplicated row in e(roth_power_*) and in the displayed table;
.   * keep the first occurrence of each level, preserving the order given
.   local levels : list uniq levels
  4. 
.   local ptpref = `esrel'
  5.   * degrees of freedom: use the regression's residual df when available (t and F
.   * distributions, matching the critical values wooldid's own tables and joint tests
.   * use); fall back to normal / chi-squared otherwise (e.g. some poisson paths)
.   local ptpdfok 0
  6.   if "`dfr'" != "" & "`dfr'" != "." {
  7.     if real("`dfr'") > 0 & real("`dfr'") < . local ptpdfok 1
  8.   }
  9.   if `ptpdfok' local ptpcrit = invttail(`dfr', .025)
 10.   else local ptpcrit = invnormal(.975)
 11. 
.   * hbar: estimand-weighted mean post-treatment relative period over the FULL post
.   * support of the estimation sample - the pooled estimands aggregate over all post
.   * cells (subpop t >= onset), not only the reported event-study window, and using the
.   * reported window instead understates the implied bias whenever espostlength is
.   * smaller than the largest post relative period
.   tempvar ptprely ptpwa ptppost ptpnum
 12.   qui gen double `ptprely' = `tvar' - `ttrevar'
 13.   qui gen double `ptpwa' = `wvar'
 14.   if "`cwm'" != "" qui replace `ptpwa' = `ptpwa' * `cwm'
 15.   qui gen byte `ptppost' = e(sample) & `ttrevar' != . & `ptprely' >= 0 & `ptprely' < .
 16.   qui gen double `ptpnum' = `ptpwa' * `ptprely' if `ptppost'
 17.   qui sum `ptpnum' if `ptppost', meanonly
 18.   local ptphnum = r(sum)
 19.   qui sum `ptpwa' if `ptppost', meanonly
 20.   local ptphbar_att = cond(r(sum) > 0 & r(sum) < ., `ptphnum'/r(sum), .)
 21.   * att_it-family hbar: weight divided by the (i,t) cell weight total, replicating the
.   * weight-construction block (cell totals use the raw weight, without any custom
.   * weight multiplier - the documented asymmetry)
.   tempvar ptpwpit ptpwit ptpnum2
 22.   qui gegen double `ptpwpit' = total(cond(e(sample), `wvar', 0)), by(`ivar' `tvar')
 23.   qui gen double `ptpwit' = `ptpwa'/`ptpwpit'
 24.   qui replace `ptpwit' = 0 if `ptpwit' == .
 25.   qui gen double `ptpnum2' = `ptpwit' * `ptprely' if `ptppost'
 26.   qui sum `ptpnum2' if `ptppost', meanonly
 27.   local ptphnum2 = r(sum)
 28.   qui sum `ptpwit' if `ptppost', meanonly
 29.   local ptphbar_it = cond(r(sum) > 0 & r(sum) < ., `ptphnum2'/r(sum), .)
 30.   cap drop `ptprely' `ptpwa' `ptppost' `ptpnum' `ptpwpit' `ptpwit' `ptpnum2'
 31. 
.   local ptpheader 0
 32.   foreach ptpty in att att_it ame ame_it {
 33.     cap confirm matrix e(b_es_`ptpty')
 34.     if _rc != 0 continue
 35.     cap confirm matrix e(V_es_`ptpty')
 36.     if _rc != 0 continue
 37.     tempname ptpb ptpV
 38.     matrix `ptpb' = e(b_es_`ptpty')
 39.     matrix `ptpV' = e(V_es_`ptpty')
 40.     local ptplbl : colnames `ptpb'
 41.     * pre-period indices and the trend vector m = relyr - reference. m is built from
.     * the actual labels: under esrelativeto(< -1) the pre relyrs straddle the
.     * reference, so m carries BOTH signs - no ordering or sign assumption is safe
.     local ptpk 0
 42.     local ptppreidx
 43.     local ptpmvals
 44.     local ptpj 0
 45.     foreach ptpl of local ptplbl {
 46.       local ++ptpj
 47.       if substr("`ptpl'", 1, 3) == "pre" {
 48.         local ++ptpk
 49.         local ptppreidx `ptppreidx' `ptpj'
 50.         local ptpmvals `ptpmvals' `=-real(substr("`ptpl'", 4, .)) - `ptpref''
 51.       }
 52.     }
 53.     if `ptpk' == 0 {
 54.       dis as text "Caution: pretrendpower() requested, but the `ptpty' event study has no pre-treatment coefficients; diagnostics skipped for `ptpty'."
 55.       continue
 56.     }
 57.     tempname ptpS ptpbp ptpm
 58.     matrix `ptpS' = J(`ptpk', `ptpk', 0)
 59.     matrix `ptpbp' = J(`ptpk', 1, 0)
 60.     matrix `ptpm' = J(`ptpk', 1, 0)
 61.     local ptpr 0
 62.     foreach ptpi of local ptppreidx {
 63.       local ++ptpr
 64.       matrix `ptpbp'[`ptpr', 1] = `ptpb'[1, `ptpi']
 65.       local ptpmv : word `ptpr' of `ptpmvals'
 66.       matrix `ptpm'[`ptpr', 1] = `ptpmv'
 67.       local ptpc 0
 68.       foreach ptpi2 of local ptppreidx {
 69.         local ++ptpc
 70.         matrix `ptpS'[`ptpr', `ptpc'] = `ptpV'[`ptpi', `ptpi2']
 71.       }
 72.     }
 73.     * screens, in hazard order: a missing element would make invsym abort the run; a
.     * non-positive diagonal (degeneracy sentinel, zero-variance row) would otherwise be
.     * silently g-inversed into a plausible-looking wrong number
.     local ptpbad 0
 74.     forval ptpr = 1/`ptpk' {
 75.       if missing(`ptpbp'[`ptpr', 1]) local ptpbad 1
 76.       if missing(`ptpS'[`ptpr', `ptpr']) | `ptpS'[`ptpr', `ptpr'] <= 0 local ptpbad 1
 77.       forval ptpc = 1/`ptpk' {
 78.         if missing(`ptpS'[`ptpr', `ptpc']) local ptpbad 1
 79.       }
 80.     }
 81.     if `ptpbad' {
 82.       dis as text "Caution: the `ptpty' pre-period variance-covariance block contains missing or non-positive variance entries; pretrendpower() diagnostics skipped for `ptpty'."
 83.       continue
 84.     }
 85.     matrix `ptpS' = (`ptpS' + `ptpS'')/2
 86.     tempname ptpSi ptpwork
 87.     matrix `ptpSi' = invsym(`ptpS')
 88.     local ptpkeff = `ptpk' - diag0cnt(`ptpSi')
 89.     if `ptpkeff' <= 0 {
 90.       dis as text "Caution: the `ptpty' pre-period variance-covariance block is not invertible; pretrendpower() diagnostics skipped for `ptpty'."
 91.       continue
 92.     }
 93.     if `ptpkeff' < `ptpk' dis as text "Caution: the `ptpty' pre-period variance-covariance block is rank-deficient (rank `ptpkeff' of `ptpk'). The slope, its CI, the joint test (now `ptpkeff' degrees of freedom), and the detectable-tre
> nd columns then reflect only the linearly independent subset of pre-period coefficients a generalized inverse retains - NOT a summary of all pre-period evidence - and can differ arbitrarily from statistics built on the discarded coefficie
> nts; interpret with care."
 94.     matrix `ptpwork' = `ptpm''*`ptpSi'*`ptpm'
 95.     local ptpc2 = `ptpwork'[1, 1]
 96.     if missing(`ptpc2') | `ptpc2' <= 0 {
 97.       dis as text "Caution: the linear-trend information m'V^(-1)m for `ptpty' is not positive; pretrendpower() diagnostics skipped for `ptpty'."
 98.       continue
 99.     }
100.     matrix `ptpwork' = `ptpm''*`ptpSi'*`ptpbp'
101.     local ptpslope = `ptpwork'[1, 1]/`ptpc2'
102.     local ptpse = 1/sqrt(`ptpc2')
103.     local ptpll = `ptpslope' - `ptpcrit'*`ptpse'
104.     local ptpul = `ptpslope' + `ptpcrit'*`ptpse'
105.     matrix `ptpwork' = `ptpbp''*`ptpSi'*`ptpbp'
106.     local ptpW = `ptpwork'[1, 1]
107.     if `ptpdfok' local ptpprep = Ftail(`ptpkeff', `dfr', `ptpW'/`ptpkeff')
108.     else local ptpprep = chi2tail(`ptpkeff', `ptpW')
109.     local ptphbar `ptphbar_att'
110.     if "`ptpty'" == "att_it" | "`ptpty'" == "ame_it" local ptphbar `ptphbar_it'
111. 
.     * NIS setup: the pre-test Roth's pretrends package powers - reject when ANY pre
.     * coefficient is individually significant (using wooldid's own critical value)
.     * exact quadrature cost explodes with dimension (~2.9s per evaluation at k=6, ~85
.     * evaluations per power level per type); cap the NIS column at k <= 4 and point
.     * larger designs at the pretrends package, which consumes e(b_es_*)/e(V_es_*)
.     local ptpnisok = (`ptpk' <= 4)
112.     local ptpnissize .
113.     if `ptpnisok' {
114.       tempname ptpsd ptpmrow
115.       matrix `ptpsd' = J(1, `ptpk', 0)
116.       forval ptpr = 1/`ptpk' {
117.         matrix `ptpsd'[1, `ptpr'] = sqrt(`ptpS'[`ptpr', `ptpr'])
118.       }
119.       matrix `ptpmrow' = `ptpm''
120.       cap mata: st_local("ptpnissize", strofreal(1 - mvnormalcvqp(-`ptpcrit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), J(1, `ptpk', 0), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
121.       if _rc != 0 local ptpnisok 0
122.       else if missing(real("`ptpnissize'")) local ptpnisok 0
123.     }
124. 
.     local ptpnlev : word count `levels'
125.     tempname ptpmat
126.     matrix `ptpmat' = J(`ptpnlev', 5, .)
127.     local ptprn
128.     local ptplr 0
129.     foreach ptplev of local levels {
130.       local ++ptplr
131.       local ptprn `ptprn' p`ptplev'
132.       matrix `ptpmat'[`ptplr', 1] = `ptplev'
133.       * Wald-based minimum detectable trend: powers the joint pre-trend test above,
.       * using the F distribution with the regression's residual df (a chi-squared
.       * shortcut is optimistic by ~25 percent at 10 clusters)
.       if `ptpdfok' local ptplam = npnF(`ptpkeff', `dfr', invF(`ptpkeff', `dfr', .95), 1 - `ptplev'/100)
134.       else local ptplam = npnchi2(`ptpkeff', invchi2(`ptpkeff', .95), 1 - `ptplev'/100)
135.       if !missing(`ptplam') {
136.         matrix `ptpmat'[`ptplr', 2] = sqrt(`ptplam'/`ptpc2')
137.         if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 4] = sqrt(`ptplam'/`ptpc2')*(`ptphbar' - `ptpref')
138.       }
139.       * NIS-based minimum detectable trend, by bisection on the exact rejection
.       * probability (deterministic quadrature; self-checked against the target)
.       if `ptpnisok' {
140.         * NFPTP-04: a requested power level at or below the NIS test's null rejection
.         * rate (its size) is achieved by a zero trend - the mathematically exact boundary
.         * answer. formerly these cells were left missing, indistinguishable from a
.         * numerical failure
.         if `ptplev'/100 <= real("`ptpnissize'") {
141.           matrix `ptpmat'[`ptplr', 3] = 0
142.           if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 5] = 0
143.         }
144.         if `ptplev'/100 > real("`ptpnissize'") {
145.           local ptpglo = 0
146.           local ptpghi = 8*`ptpse'
147.           local ptpiter 0
148.           local ptppw 0
149.           while `ptppw' < `ptplev'/100 & `ptpiter' < 60 {
150.             local ptpghi = 2*`ptpghi'
151.             cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`ptpcrit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpghi'*st_matrix("`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
152.             if _rc != 0 local ptpiter 999
153.             else local ptppw = real("`ptppw2'")
154.             local ++ptpiter
155.           }
156.           if `ptpiter' < 999 {
157.             forval ptpbi = 1/80 {
158.               local ptpgmid = (`ptpglo' + `ptpghi')/2
159.               cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`ptpcrit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpgmid'*st_matrix("`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
160.               if _rc == 0 {
161.                 if real("`ptppw2'") < `ptplev'/100 local ptpglo = `ptpgmid'
162.                 else local ptpghi = `ptpgmid'
163.               }
164.             }
165.             local ptpgn = (`ptpglo' + `ptpghi')/2
166.             cap mata: st_local("ptppw2", strofreal(1 - mvnormalcvqp(-`ptpcrit'*st_matrix("`ptpsd'"), `ptpcrit'*st_matrix("`ptpsd'"), `ptpgn'*st_matrix("`ptpmrow'"), vech(st_matrix("`ptpS'"))', 1000), "%21.0g"))
167.             if _rc == 0 {
168.               if abs(real("`ptppw2'") - `ptplev'/100) < 1e-4 {
169.                 matrix `ptpmat'[`ptplr', 3] = `ptpgn'
170.                 if !missing(`ptphbar') matrix `ptpmat'[`ptplr', 5] = `ptpgn'*(`ptphbar' - `ptpref')
171.               }
172.             }
173.           }
174.         }
175.       }
176.     }
177.     matrix rownames `ptpmat' = `ptprn'
178.     matrix colnames `ptpmat' = power mdt_wald mdt_nis bias_wald bias_nis
179. 
.     * display
.     if `ptpheader' == 0 {
180.       dis as result " "
181.       dis as result "Pre-Trend Power Diagnostics (Roth 2022):"
182.       local ptpheader 1
183.     }
184.     dis as result "  `ptpty': GLS linear pre-trend fit on `ptpk' pre-treatment coefficient(s); reference relative period = `ptpref'"
185.     dis as result "    slope = " %-9.0g `ptpslope' " (se " %-9.0g `ptpse' "; 95% CI " %-9.0g `ptpll' " to " %-9.0g `ptpul' ")"
186.     if `ptpdfok' dis as result "    joint pre-trend test: F(`ptpkeff', `dfr') = " %-8.0g `=`ptpW'/`ptpkeff'' ", p = " %-6.4f `ptpprep'
187.     else dis as result "    joint pre-trend test: chi2(`ptpkeff') = " %-8.0g `ptpW' ", p = " %-6.4f `ptpprep'
188.     if `ptpnisok' dis as result "    size of the any-pre-period-individually-significant pre-test: " %-6.4f real("`ptpnissize'")
189.     if !`ptpnisok' & `ptpk' > 4 dis as text "    note: mdt_nis and the NIS-test size are omitted (`ptpk' pre-periods exceed the exact-quadrature budget of 4); mdt_wald is unaffected. For the NIS convention at larger k, feed e(b_es_`ptp
> ty')/e(V_es_`ptpty')/e(numpre_`ptpty') to Roth's pretrends package."
190.     dis as result "    weighted mean post-treatment relative period (hbar) = " %-9.0g `ptphbar'
191.     dis as result "    minimum detectable linear trend, and the bias such a trend would imply for the"
192.     dis as result "    `ptpty' pooled estimand if it continued into the post-treatment period:"
193.     * NFPTP-03: the att_it/ame_it block is the shared event-study curve; when the user
.     * requested att_i/att_itime the block stands in for them but its hbar/bias columns
.     * use att_it-family post-period weights - say so rather than implying the requested
.     * pooled estimand's own weighting. exact-token match (att_i is a prefix of att_it
.     * and att_itime; cf. the cfxplottypes exact-token precedent)
.     if inlist("`ptpty'", "att_it", "ame_it") {
194.       local ptpsurr
195.       local ptpests `e(wdid_estimands)'
196.       if `: list posof "att_i" in ptpests' > 0 local ptpsurr att_i
197.       if `: list posof "att_itime" in ptpests' > 0 local ptpsurr `ptpsurr' att_itime
198.       if "`ptpsurr'" != "" {
199.         if "`ptpty'" == "ame_it" local ptpsurr = subinstr("`ptpsurr'", "att", "ame", .)
200.         dis as text "    note: this `ptpty'-weighted diagnostic stands in for the requested `ptpsurr' estimand(s); its hbar and bias columns use `ptpty' post-period weights."
201.       }
202.     }
203.     matlist `ptpmat', format(%12.4g)
204.     dis as text "    note: mdt_wald powers the joint pre-trend test above; mdt_nis powers the test that any"
205.     dis as text "    pre-period coefficient is individually significant (the convention of Roth's pretrends package)."
206.     if "`pois'" == "poisson" & "`poisexp'" == "" dis as text "    note: poisson event-study coefficients are on the linear-index (xb) scale, and so are these diagnostics."
207. 
.     * ereturns (matrix uses copy so the object survives if this block is ever resited)
.     cap ereturn matrix roth_power_`ptpty' = `ptpmat', copy
208.     cap ereturn scalar roth_slope_`ptpty' = `ptpslope'
209.     cap ereturn scalar roth_slope_se_`ptpty' = `ptpse'
210.     cap ereturn scalar roth_slope_ll_`ptpty' = `ptpll'
211.     cap ereturn scalar roth_slope_ul_`ptpty' = `ptpul'
212.     cap ereturn scalar roth_prep_`ptpty' = `ptpprep'
213.     cap ereturn scalar roth_hbar_`ptpty' = `ptphbar'
214.     cap ereturn scalar roth_npre_`ptpty' = `ptpk'
215.     cap ereturn scalar roth_keff_`ptpty' = `ptpkeff'
216.     if `ptpnisok' cap ereturn scalar roth_nissize_`ptpty' = real("`ptpnissize'")
217.     * F11: the joint-test statistic, so replay can re-render the F/chi2 line from e()
.     cap ereturn scalar roth_W_`ptpty' = `ptpW'
218.   }
219.   if `ptpheader' == 0 dis as text "Caution: pretrendpower() was requested, but no event-study coefficient vector with a valid variance-covariance matrix was available (e.g. under timetrends); no diagnostics were computed."
220.   * completion marker: the caller runs this program under cap noi and every ereturn
.   * above is individually cap'd, so an abort partway through the type loop would leave
.   * the earlier types' roth_* returns in e() with nothing marking the run incomplete.
.   * e(roth_ok) is set only here, after the loop has finished; any roth_* return present
.   * without e(roth_ok) therefore identifies a partially populated diagnostics pass.
.   cap ereturn scalar roth_ok = 1
221. end

. 
. 
. * F11: all result presentation lives here, out of wooldid_worker (which is near stata's
. * per-program compiled-size ceiling), reading ONLY e() - the live estimation path and
. * replay (wooldid typed alone after estimation) both call this, so their output is
. * identical by construction. non-eclass on purpose: ereturn inside a non-eclass program
. * is a hard error, so this program is structurally incapable of altering the posted
. * results. part(1) = header through the adversarial lines; part(2) = subgroup tables
. * through the pairwise comparisons (split so the eclass wooldid_ptp call can stay in
. * the caller between them); part(roth) redisplays the Roth diagnostics from e(roth_*)
. * on replay without re-running the quadrature.
. * NFFAST-02: rename CFX matrix row stripes from margins' tempvar-embedded subnames
. * (e.g. "1bn.__000ABC" - volatile every run) to stable lattice_# keys, and null the row
. * equations. lives outside wooldid_worker (compiled-size ceiling). the lattice level is
. * read from the matrix's own row subnames - no r() capture (margins' r(by#) is not a
. * documented stored result). validation guarantees nonnegative integer levels, so the
. * generated names are always valid; a parse failure is loud, never silent
. cap prog drop wooldid_cfxstripe

. prog def wooldid_cfxstripe
  1. version 16.0
  2.   args cfxm
  3.   local rn : rowfullnames `cfxm'
  4.   local newnames
  5.   foreach rtok of local rn {
  6.     local rsub `rtok'
  7.     if strpos("`rtok'", ":") > 0 local rsub = substr("`rtok'", strpos("`rtok'", ":") + 1, .)
  8.     if !regexm("`rsub'", "^([0-9]+)(bn|b|o)?\.") {
  9.       dis as error "Error: wooldid could not parse the CFX matrix row name '`rtok'' into a lattice level; please report this."
 10.       error 498
 11.     }
 12.     local newnames `newnames' lattice_`=regexs(1)'
 13.   }
 14.   matrix rownames `cfxm' = `newnames'
 15.   matrix roweq `cfxm' = _
 16. end

. 
. cap prog drop wooldid_display

. prog def wooldid_display
  1. version 16.0
  2.   syntax , part(string)
  3.   * replay contract gate: e(wdid_replayv) is the version of the display contract the
.   * store was written under. bump the posted value (in wooldid_worker) whenever the
.   * display contract changes; the exact match here refuses cross-version replays
.   * instead of misrendering a store this code no longer understands
.   if "`e(wdid_replayv)'" != "1" {
  4.     dis as error "Error: the stored results were posted by a wooldid version without replay support or with a different replay contract (e(wdid_replayv)='`e(wdid_replayv)'', this version requires '1'); nothing can be redisplayed. Refit
>  wooldid."
  5.     error 301
  6.   }
  7.   * NFRPL-03: mirror wooldid_esplots' existence guard - on a corrupt/fabricated store the
.   * matlist below would otherwise render a synthetic 1x1 "." table (an absent e() matrix
.   * reads as a missing scalar). every genuine wooldid post carries the matrix, so this
.   * cannot fire on a valid store. scope decision (deliberate, realistic-vs-pathological):
.   * the central matrix only - the summarystats/wdidsgresults/pwsgs matlist sites remain
.   * fabrication-exposed
.   cap confirm matrix e(wdidmainresults)
  8.   if _rc != 0 {
  9.     dis as error "Error: the stored results no longer contain e(wdidmainresults); rerun wooldid."
 10.     error 301
 11.   }
 12. 
.   * rehydrate the display state from e(). each local below mirrors the worker local of
.   * the same meaning byte-for-byte: option/label strings come from the hidden wdid_*
.   * macros (string-exact by construction), data-derived values from posted e() scalars
.   * (locals were themselves "= e(...)" evaluations upstream, so re-evaluating here
.   * reproduces the same strings, including "." for a never-set value)
.   local y `e(depvar)'
 13.   local vcespecifier `"`e(wdid_vcespec)'"'
 14.   local poisson `e(wdid_poisson)'
 15.   local contreat `e(wdid_contreat)'
 16.   local subgroups `e(wdid_sgvar)'
 17.   local sglist `e(wdid_sglist)'
 18.   local estimandlist `e(wdid_estimands)'
 19.   local customweightmultiplier `e(wdid_cwm)'
 20.   local semielasticity `e(wdid_semielas)'
 21.   local contreatelasticitytype `e(wdid_cetype)'
