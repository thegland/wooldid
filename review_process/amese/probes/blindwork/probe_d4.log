824.       if "`att_i'" == "att_i" |  "`att'" == "att"  {
825.         matrix `___hist' = (`___hist',`___hist2')
826.       }
827.       else{
828.         matrix `___hist' = `___hist2'
829.       }
830.       cap matrix drop `___hist2'
831.     }
832.     if "`verbose'" == "verbose" dis as text "Wooldid has finished producing histograms."
