1651.             if "`att'" == "att" {
1652.               qui margins  [`weight'=`w_att'] ,`contreatelasticitytype'(`contreat') noestimcheck over(`_t') subpop(if `ifstatement' & `t' < `ttre' & `ttre' != . & `subgroups' == `sgcase'   &  (`_t' == 0 |`_t' >= `horizonstarter')   ) 
> contrast(overjoint) `poismarginstext' `marginsdof'
1653.               cap confirm matrix r(p)
1654.               if _rc == 0 {
1655.                 local joint_Choriz_s`sgcase' = r(p)[1,2]
1656.               }
1657.               else{
1658.                 local joint_Choriz_s`sgcase'
1659.               }
1660.             }
1661. 
.             if ("`att_it'" == "att_it" | "`att_itime'" == "att_itime" | "`att_i'" == "att_i" ) & "`joint_Choriz_i_s`sgcase''" == "" {
1662.               qui margins [`weight'=`w_att_it'] ,`contreatelasticitytype'(`contreat') noestimcheck over(`_t') subpop(if `ifstatement' & `t' < `ttre' & `ttre' != . & `subgroups' == `sgcase'  &  (`_t' == 0 |`_t' >= `horizonstarter')    
> ) contrast(overjoint) `poismarginstext' `marginsdof'
1663.               cap confirm matrix r(p)
1664.               if _rc == 0 {
1665.                 local joint_Choriz_i_s`sgcase' = r(p)[1,2]
1666.               }
1667.               else{
1668.                 local joint_Choriz_i_s`sgcase'
1669.               }
1670.             }
1671.             * these parameters give you the 2nd half of the sg-specific joint test matrix, minus the joint test of all sgs
.           }
1672.         }
1673. 
.       }
1674. 
. 
. 
.       *************** joint test the sg AMEs  against each other -
.       * E1: see the binary twin above - one posted pwcompare pass per (estimand x pre/post)
.       * serves both the pairwise table and the all-subgroups-equal joint test
.       if wordcount("`sglist'") > 1 {
1675.         * F9: see the binary twin - no post, no joint test under fast mode
.         local sgpost post
1676.         if "`fastnose'" != "" local sgpost
1677. 
.         foreach item in `att' `att_it' `att_i' `att_itime' {
1678. 
.           qui margins [`weight'=`w_`item''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') `poismarginstext' noestimcheck over(`subgroups') pwcompare(effects) `marginsdof' `sgpost'
1679.           tempname pwsgs_C`item'
1680.           matrix `f9tab' = r(table_vs)
1681.           if rowsof(`f9tab') < 6 {
1682.             matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1683.             matrix rownames `f9tab' = b se t pvalue ll ul
1684.           }
1685.           matrix `pwsgs_C`item''  = `f9tab'[1..6,1..`=colsof(r(table_vs))']'
1686.           if "`sgpost'" != "" {
1687.             wooldid_sgchain
1688.             * rank guard: see the binary twin
.             local sgfallback
1689.             if `sgchainn' > 1 {
1690.               qui test `sgchain'
1691.               if r(df) == `sgchainn' - 1 local joint_C`item'_sdiff = r(p)
1692.               else {
1693.                 local joint_C`item'_sdiff
1694.                 local sgfallback 1
1695.               }
1696.             }
1697.             else local joint_C`item'_sdiff
1698.             qui est restore ___wooldidfullmodel
1699.             if "`sgfallback'" != "" {
1700.               qui margins [`weight'=`w_`item''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') `poismarginstext' noestimcheck over(`subgroups') contrast(overjoint) `marginsdof'
1701.               local joint_C`item'_sdiff = r(p)[1,1]
1702.             }
1703.           }
1704.           else local joint_C`item'_sdiff
1705. 
.           * repeat for pre-treatment
.           if (`espre' > 0 & "`esfixedbaseperiod'" == "") | ("`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativeto' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == "")))) {
1706.             cap qui margins [`weight'=`w_`item''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0 & `ttre' != .) noestimcheck over(`subgroups')  pwcompare(effects) `poismargi
> nstext' `marginsdof' `sgpost'
1707.             if _rc != 0 {
1708.               local prejoint_C`item'_sdiff
1709.               if "`sgpost'" != "" qui est restore ___wooldidfullmodel
1710.             }
1711.             else {
1712.               tempname prepwsgs_C`item'
1713.               matrix `f9tab' = r(table_vs)
1714.               if rowsof(`f9tab') < 6 {
1715.                 matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1716.                 matrix rownames `f9tab' = b se t pvalue ll ul
1717.               }
1718.               matrix `prepwsgs_C`item''  =  `f9tab'[1..6,1..`=colsof(r(table_vs))']'
1719.               * see the binary twin: stacking is gated on this flag, not the joint p
.               local prepwok_C`item' 1
1720.               if "`sgpost'" != "" {
1721.                 wooldid_sgchain
1722.                 * rank guard: see the binary twin
.                 local sgfallback
1723.                 if `sgchainn' > 1 {
1724.                   cap qui test `sgchain'
1725.                   if _rc == 0 & r(df) == `sgchainn' - 1 local prejoint_C`item'_sdiff = r(p)
1726.                   else {
1727.                     local prejoint_C`item'_sdiff
1728.                     local sgfallback 1
1729.                   }
1730.                 }
1731.                 else local prejoint_C`item'_sdiff
1732.                 qui est restore ___wooldidfullmodel
1733.                 if "`sgfallback'" != "" {
1734.                   qui margins [`weight'=`w_`item''] , `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0 & `ttre' != .) noestimcheck over(`subgroups') contrast(overjoint)  `poisma
> rginstext' `marginsdof'
1735.                   cap local prejoint_C`item'_sdiff = r(p)[1,1]
1736.                   if _rc != 0 local prejoint_C`item'_sdiff
1737.                 }
1738.               }
1739.               else local prejoint_C`item'_sdiff
1740.             }
1741.           }
1742.         }
1743.       }
1744. 
. 
.     }
1745.   }
1746. 
