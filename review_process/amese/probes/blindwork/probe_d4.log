1900.             local sgkeeprow : word `sgnonesidx' of `sgrowkeep'
1901.             if "`sgkeeprow'" == "1" local rownamessg `rownamessg' `rownametest'
1902.           }
1903.           else{
1904.             local testtext = subinstr("`rownametest'","ES_att_it:","",.)
1905.             local testtext = subinstr("`testtext'","ES_ame_it:","",.)
1906.             local testtext = subinstr("`testtext'","ES_ame:","",.)
1907.             local testtext = subinstr("`testtext'","ES_att:","",.)
1908.             local testtext = subinstr("`testtext'"," ","",.)
1909.             if strpos("`relyrlist_s`sgcase'' ","`testtext' ") != 0 local rownamessg `rownamessg' `rownametest'
1910.             * note: the spaces above are required to avoid triggering "1 is present" when presented with "11"
.           }
1911.         }
1912.         matrix rownames `wdid_sg`sgcase'' = `rownamessg'
1913.         local rownamessg`sgcase' `rownamessg'
1914.         if "`poisson'" == "" matrix colnames `wdid_sg`sgcase'' =  estimate se t p lb_95ci ub_95ci   relyr
1915.         if "`poisson'" == "poisson" matrix colnames `wdid_sg`sgcase'' =  estimate se z p lb_95ci ub_95ci   relyr
1916. 
. 
.       }
1917. 
