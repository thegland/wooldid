.   ***************************************************************************************************
.   *****************************         GATHER MAIN EFFECTS AND HORIZON EFFECTS       ****************************
.   ******************************************************************************************
.   * the text below ensures margins produces p-values using t-tests with same dof as reghdfe; default is a z test w/ dof = infinity
.   local marginsdof df(`df_r')
835. 
.   * ensure that we request unconditional SEs where sought
.   if "`unconditionalse'" == "unconditionalse" local marginsdof `marginsdof' vce(unconditional)
836. 
.   * E1b: the two whole-sample pre-treatment horizon joint tests below hard-coded
.   * df(`df_r') where every other margins call threads `marginsdof', so under
.   * unconditionalse they silently used the conditional (delta) VCE. they cannot take
.   * `marginsdof' itself: under impvalues `marginsdof' becomes `nose', which would leave
.   * the joint test with no VCE at all (unreachable today - jointtests and impvalues are
.   * mutually exclusive - but a latent trap), so the dof/vce pair is built separately
.   local jointmarginsdof df(`df_r')
837.   if "`unconditionalse'" == "unconditionalse" local jointmarginsdof `jointmarginsdof' vce(unconditional)
838. 
.   * F9: fast (no-SE) mode - every margins call runs with nose, so margins skips the
.   * delta-method VCE (the dominant cost of a margins call in wooldid's design). r(table)
.   * then comes back with ONE row instead of nine, which is why every six-row slice below
.   * is padded through `f9tab' first. (the jointmarginsdof sites above are unreachable
.   * under fastnose: jointtests + fastnose is refused at parse time)
.   if "`fastnose'" != "" local marginsdof nose
839.   tempname f9tab
840. 
.   * initialize the joint-test p-value locals
.   local joint_horiz_i
841.   local joint_Choriz_i
842. 
.   * do not calculate traditional SEs if producing Ibragimov and Muller style p-values
.   if "`impvalues'" != "" {
843.     local marginsdof nose
844.     * --- IM (Ibragimov-Muller) degeneracy guard: shared tolerance + one-time caution flag ---
.     * consumed by all six IM ttest sites. a collapsed cross-cluster spread (per-cluster estimates
.     * numerically identical, e.g. noiseless/deterministic data) makes the IM SE not identified;
.     * detect on the reported SE relative to the estimate (ttest returns r(se)/r(sd_1), NOT r(sd)),
.     * strict relative only -- an absolute floor would false-fire on structural-zero estimands
.     local imdegtol_rel = 1e-10
845.     local imdegwarned
846.     local imdegmsg "Caution: for one or more Ibragimov-Muller estimates the per-cluster estimates were numerically identical, so the cross-cluster (IM) standard error is not identified; wooldid has set the standard error, test statisti
> c, p-value, and 95% confidence interval to missing for the affected estimate(s) while retaining the point estimate. A collapsed IM standard error usually reflects deterministic or noiseless data - please verify your input if this was not 
> expected."
847.   }
848. 
. 
.   * loop through requested estimate types - basically just different weights
.   foreach item in `att' `att_it' `att_i' `att_itime' {
849.     if "`verbose'" == "verbose" dis as text "Wooldid is now computing `item' estimates for the full sample, including event study estimates."
850. 
.     tempname ___`item'
851.     * use margins to produce the post treatment average effect within the treated group. captured via targetflag = 1 & t >= treatment period
.     * do this for the non-impvalues case
.     if "`impvalues'" == "" {
852.       qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') noestimcheck `poismarginstext' `marginsdof'
853.       matrix `f9tab' = r(table)
854.       if rowsof(`f9tab') < 6 {
855.         matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
856.         matrix rownames `f9tab' = b se t pvalue ll ul
857.       }
858.       matrix `___`item'' = `f9tab'[1..6,2]'
859.     }
860.     * this block below produces IM p-values
.     * basic principle: ignore normal SEs, get treatment effects per cluster. then, t-test the set of cluster-specific effects
.     if "`impvalues'" == "impvalues" {
861.       *semielasticity injector here is constrained to dydx and eyex b/c x is binary
.       qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') noestimcheck `poismarginstext' nose over(`cluster')
862.       tempname ibmucoefs
863.       tempname ibmuframe
864.       * this column count / 2 object will appear frequently - it exists in the non-contreat margins commands b/c it is required to skip over a large slate of null estimates
.       *     specifically, estimates for targetflag==0 have to be jumped over
.       local matrixstartgrab = floor(`=colsof(r(b))'/2)+1
865.       matrix `ibmucoefs' =  r(b)[1, `matrixstartgrab'..`=colsof(r(b))']'
866.       frame create `ibmuframe'
867.       frame change `ibmuframe'
868.       qui svmat double `ibmucoefs'
869.       qui gstats sum `ibmucoefs'1, meanonly
870.       local b = r(mean)
871.       qui ttest `ibmucoefs'1 == 0
872.       local se = r(se)
873.       local imt = r(t)
874.       local imp = r(p)
875.       local im_ll = `b' + invt(r(df_t),.025)*`se'
876.       local im_ul = `b' - invt(r(df_t),.025)*`se'
877.       if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
878.         local se .
879.         local imt .
880.         local imp .
881.         local im_ll .
882.         local im_ul .
883.         if "`imdegwarned'" == "" {
884.           dis as text "`imdegmsg'"
885.           local imdegwarned 1
886.         }
887.       }
888.       matrix `___`item'' = (`b',`se', `imt', `imp', `im_ll', `im_ul')
889.       frame change `defaultframe'
890.       frame drop `ibmuframe'
891.       matrix drop `ibmucoefs'
892.     }
893. 
.     * average pre-treatment effect
.     if (`espre' > 0 & "`esfixedbaseperiod'" == "") | ("`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativeto' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == "")))) {
894.       tempname ___`item'_pre
895. 
.       if "`impvalues'" == "" {
896.         qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0) noestimcheck `poismarginstext' `marginsdof'
897.         matrix `f9tab' = r(table)
898.         if rowsof(`f9tab') < 6 {
899.           matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
900.           matrix rownames `f9tab' = b se t pvalue ll ul
901.         }
902.         matrix `___`item'_pre' = `f9tab'[1..6,2]'
903.       }
904. 
.       * this produces an IM p-values
.       if "`impvalues'" == "impvalues" {
905.         qui  margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0) noestimcheck `poismarginstext' nose over(`cluster')
906.         tempname ibmucoefs
907.         tempname ibmuframe
908.         local matrixstartgrab floor(`=colsof(r(b))'/2)+1
909.         matrix `ibmucoefs' =  r(b)[1, `matrixstartgrab'..`=colsof(r(b))']'
910.         frame create `ibmuframe'
911.         frame change `ibmuframe'
912.         qui svmat double `ibmucoefs'
913.         qui gstats sum `ibmucoefs'1, meanonly
914.         local b = r(mean)
915.         qui ttest `ibmucoefs'1 == 0
916.         local se = r(se)
917.         local imt = r(t)
918.         local imp = r(p)
919.         local im_ll = `b' + invt(r(df_t),.025)*`se'
920.         local im_ul = `b' - invt(r(df_t),.025)*`se'
921.         if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
922.           local se .
923.           local imt .
924.           local imp .
925.           local im_ll .
926.           local im_ul .
927.           if "`imdegwarned'" == "" {
928.             dis as text "`imdegmsg'"
929.             local imdegwarned 1
930.           }
931.         }
932.         matrix `___`item'_pre' = (`b',`se', `imt', `imp', `im_ll', `im_ul')
933.         frame change `defaultframe'
934.         frame drop `ibmuframe'
935.         matrix drop `ibmucoefs'
936.       }
937.       local mainpre 1
938.     }
939. 
.     * effect by horizons
.     if `espre' + `espl' > 0   {
940.       * att_i and att_itime are not particularly valuable concepts to bring to a horizons estimate
.       * the reason: each i will only present once in a given horizon anyway
.       * so the only way to get estimates where each i has an equal representation at each horizon
.       * is to use att_it, which is how I address this
.       local horizitem att
941.       if "`item'" != "att" local horizitem att_it
942.       cap confirm  matrix `___`horizitem'_horiz'
943.       * this prevents estimating horizons if done already for a non att - relevant b/c some weight types will always yield the same horizon specific estimate
.       if _rc != 0 {
944.         * the idea behind this margins statement is to use the information in horizonstarter and horizonend to figure out which relative periods are requested
.         * and then calculate all relative period effects in that range
.         tempname ___`horizitem'_horiz
945. 
.         if "`impvalues'" == "" {
946.           qui margins [`weight'=`w_`horizitem''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `_t' >= `horizonstarter' & `_t' <= `horizonend' ) noestimcheck   over(`_t') `poismarginstext' `marginsdof'
947.           local matrixstartgrab = floor(`=colsof(r(b))'/2)+1
948.           matrix `f9tab' = r(table)
949.           if rowsof(`f9tab') < 6 {
950.             matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
951.             matrix rownames `f9tab' = b se t pvalue ll ul
952.           }
953.           matrix `___`horizitem'_horiz' = ( `f9tab'[1..6, `matrixstartgrab'..`=colsof(r(b))']',`relyrcolumn')
954.           * F2: capture event-study b/V (relyr-labeled) for honestdid/lincom/test [pure-add]
.           if "`marginsdof'" != "nose" {
955.             tempname f2bmat f2vmat
956.             matrix `f2bmat' = r(b)[1, `matrixstartgrab'..`=colsof(r(b))']
957.             matrix `f2vmat' = r(V)[`matrixstartgrab'..`=colsof(r(b))', `matrixstartgrab'..`=colsof(r(b))']
958.             local f2k `horizitem'
959.             local f2b_`f2k' `f2bmat'
960.             local f2v_`f2k' `f2vmat'
961.             local f2keys `f2keys' `f2k'
962.             local f2rl_`f2k'
963.             forval f2ri = 1/`=rowsof(`relyrcolumn')' {
964.               local f2rv = `relyrcolumn'[`f2ri',1]
965.               if `f2rv' < 0  local f2rl_`f2k' `f2rl_`f2k'' pre`=abs(`f2rv')'
966.               else          local f2rl_`f2k' `f2rl_`f2k'' post`f2rv'
967.             }
968.           }
969.           * NFADV-01/02/05: the adversarial statistics and display line live in
.           * wooldid_advstat (worker size headroom); the finaladvtest estimability guard
.           * stays here - mainly an issue w/ SGs later: sometimes we have enough coefs to
.           * do the test overall, but not in a particular sg. since this is the overall
.           * section, if it triggers badly here, call off adversarial as a whole
.           *     threshold of 2 here b/c that corresponds w/ 1 coef (targetflag==0 will get dummy columns )
.           local finaladvtest
970.           cap confirm matrix r(b)
971.           if _rc == 0 {
972.             local finaladvtest  `=colsof(r(b))'
973.           }
974.           if "`finaladvtest'" == ""  | "`finaladvtest'" == "." local finaladvtest 0
975.           if `finaladvtest' <= 2 {
976.             * this branch also runs when adversarial was never requested (or was already
.             * cancelled upstream) - the clearing is a no-op then, so only Caution when
.             * an actually-pending adversarial test is being called off here
.             if "`adversarial'" == "adversarial" dis as text "Caution: adversarial pre-trend testing was cancelled: too few event-study coefficients were estimated to fit the reference line."
977.             local adversarial
978.           }
979.           if "`adversarial'" == "adversarial"     {
980.             wooldid_advstat , b(`f2bmat') v(`f2vmat') relyr(`relyrcolumn') mint(`min_t') esrel(`esrelativeto') dfr(`df_r') esf(`esfixedbaseperiod') tt(`timetrends') alt(`altmethod_adversarial')
981.             local advstatus `r(status)'
982.             * a gap-cancelled altmethod fit calls off adversarial as a whole (overall section)
.             if "`advstatus'" == "gapskip" local adversarial
983.             else {
984.               if "`advstatus'" == "ok" local adversarialP_`horizitem' = r(p)
985.               tempname adversarialB_`horizitem'
986.               matrix `adversarialB_`horizitem'' = r(line)
987.             }
988.           }
989.           * end adversarial pre-trend handling
.         }
990. 
.         *constraints on margins setup requires looping through horizons for doing the impvalues approach. reason is you aren't allowed to do over (two sets of variables) without extra setup
.         if "`impvalues'" == "impvalues" {
991.           local currenthoriz 1
992.           tempname horizhold
993.           foreach horizon in `horizlist' {
994.             qui  margins [`weight'=`w_`horizitem''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `_t' == `horizon' & `targetflag'==1  & `_t' != 0) noestimcheck `poismarginstext' nose over(`cluster')
995.             tempname ibmucoefs
996.             tempname ibmuframe
997.             local matrixstartgrab floor(`=colsof(r(b))'/2)+1
998.             matrix `ibmucoefs' =  r(b)[1, `matrixstartgrab'..`=colsof(r(b))']'
999.             frame create `ibmuframe'
1000.             frame change `ibmuframe'
1001.             qui svmat double `ibmucoefs'
1002.             qui gstats sum `ibmucoefs'1, meanonly
1003.             local b = r(mean)
1004.             qui ttest `ibmucoefs'1 == 0
1005.             local se = r(se)
1006.             local imt = r(t)
1007.             local imp = r(p)
1008.             local im_ll = `b' + invt(r(df_t),.025)*`se'
1009.             local im_ul = `b' - invt(r(df_t),.025)*`se'
1010.             if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
1011.               local se .
1012.               local imt .
1013.               local imp .
1014.               local im_ll .
1015.               local im_ul .
1016.               if "`imdegwarned'" == "" {
1017.                 dis as text "`imdegmsg'"
1018.                 local imdegwarned 1
1019.               }
1020.             }
1021.             if `currenthoriz' == 1 matrix `horizhold' = (`b',`se', `imt', `imp', `im_ll', `im_ul')
1022.             if `currenthoriz' >1  matrix `horizhold' = `horizhold' \ (`b',`se', `imt', `imp', `im_ll', `im_ul')
1023.             frame change `defaultframe'
1024.             frame drop `ibmuframe'
1025.             local ++currenthoriz
1026.             matrix drop `ibmucoefs'
1027.           }
1028.           matrix `___`horizitem'_horiz' = ( `horizhold',`relyrcolumn')
1029.         }
1030.       }
1031.     }
1032.   }
1033. 
. 
.   **** produce joint test of significance for pre-treatment horizons using the contrast option
.   if (  ("`esfixedbaseperiod'" == "" & `espre' > 1) |  ( `espre' > 1 & "`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativeto' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == "")))) )  & "`suppressjointtests'"=="" {
1034.     if "`verbose'" == "verbose" dis as text "Wooldid is now computing pre-treatment horizon effect joint tests."
1035.     if "`att'" == "att" {
1036.       * contrast(overjoint) joint-tests the hypothesis that each estimate by group specified in over() is the same
.       * since we have specified our subpop to include _t == 0, which is the omitted case, this is a joint test vs 0
.       qui margins [`weight'=`w_att'] ,`semielasticity'(`targetflag') noestimcheck over(`_t') subpop(if `ifstatement' & `t' < `ttre' & `ttre' != . & (`_t' == 0 | `_t' >= `horizonstarter')   ) contrast(overjoint) `poismarginstext' `jointmar
> ginsdof'
1037.       local joint_horiz = r(p)[1,2]
1038.     }
1039.     if "`joint_horiz_i'" == "" & (  "`att_i'" != "" | "`att_itime'" != "" | "`att_it'" != "" ){
1040.       qui margins [`weight'=`w_att_it'],`semielasticity'(`targetflag') noestimcheck over(`_t') subpop(if `ifstatement' & `t' < `ttre' & `ttre' != . &  (`_t' == 0 | `_t' >= `horizonstarter')   ) contrast(overjoint) `poismarginstext' `j
> ointmarginsdof'
1041.       local joint_horiz_i = r(p)[1,2]
1042.     }
1043.   }
1044. 
. 
.   if "`verbose'" == "verbose" dis as text "Wooldid has completed production of all main average treatment effects for the full sample."
1045. 
