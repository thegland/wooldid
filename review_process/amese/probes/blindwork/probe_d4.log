.     * bundle these for conceptually both generating the same histograms
.     if "`att_itime'" == "att_itime" |  "`att_it'" == "att_it"  {
797.       qui margins [`weight'=`w_att_it'], `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `_i' != 0 & `t' >= `ttre') noestimcheck over(`_i') nose `poismarginstext'
798.       local matrixstartgrab floor(`=colsof(r(b))'/2)+1
