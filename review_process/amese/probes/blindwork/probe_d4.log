.     local sgmaxlen 0
337.     foreach sgcase in `sglist' {
338.       if strlen("`sgcase'") > `sgmaxlen' local sgmaxlen = strlen("`sgcase'")
339.     }
340.     if `sgmaxlen' >= 8 | (`sgmaxlen' == 7 & "`makecfxplotsbysg'" != "") {
341.       dis as text "Caution: the subgroup variable takes values up to `sgmaxlen' digits long. wooldid embeds subgroup values in the names of stored results, matrices, and plots, and Stata caps such names at 31-32 characters, so values 8
>  or more digits long (7, with makecfxplotsbysg and 3-digit relative-year plot requests) can sometimes cause unexplained r(198) invalid-name crashes; att_itime results tables, adversarial, and makecfxplotsbysg are most exposed. Values abov
> e 2,147,483,647 will generally fail outright at Stata's factor-variable level cap."
342.       dis as text "If wooldid crashes, recode ID-style subgroup values to small integers first (e.g., egen newsg = group(oldsg))."
343.     }
344.     * initialize these for later
.     foreach sgcase in `sglist' {
345.       local joint_horiz_i_s`sgcase'
346.       local joint_Choriz_i_s`sgcase'
347.     }
348.   }
349. 
. 
. 
. 
. 
. 
.   *********************************************************************************************************************************
.   ***********************************  PRODUCE LATTICE FOR CONTREAT, CONTINUOUS TREATMENT VARIABLES  ******************************
.   *********************************************************************************************************************************
. 
.   * first, create targetflag, a variable that is 1 in relative periods for which we are interested in producing treatment effects, and 0 otherwise
.   * this ends up being needed in various places as a matter of convenience in building the regressions as well as elsewhere in making these variables
.   tempvar targetflag
350.   qui gen `targetflag' = `_t' > 0 & `_t' < . if `ifstatement'
351. 
. 
. 
.   * prepare the continuous treatment materials  - this must be done after ttre is fully updated and bad treatments are missinged out
.   * lattice is a thing that allows piecewise estimation of the effect of your continuous treatment
.   * you can pass through any lattice variable you like, or autogenerate one
.   * if you autogenerate, the key concepts here are:
.   * latticenum tells us how many chunks to split the sample into for the piecewise continuous treatment function
.   * latticetype -- specifies how to compute quantiles. all implies over the whole sample, otherwise they are calculated within subsets of the sample specified by the by variable.
.   *     e.g., if baseX is specified, quantiles are formed in a base period and the boundaries in the base period are used to define the lattice everywhere
.   * the code block below handles autogenerating: it is largely a matter of generating percentiles within the correct group of variables
.   * note that piecewise functions threaten the concept of derivatives, so don't expect clean interpretation of AMEs when using a lattice
. 
.   local latticevar
352.   local latticepart2hash
353.   local latticepart1hash
354.   local contreatinj
355. 
.   * note that this thing will first work on making lattices
.   * then work on making the continuous treatment variable text will add it to the regression
.   if "`contreat'" != "" {
356.     * work on the lattice
.     if "`lattice'" != ""  {
357.       * wordcount = 2 implies generate a lattice; wordcount of 1 means you just had the name of the lattice var directly passed through
.       if wordcount("`lattice'") == 2 {
358.         * ignore weights in lattice percentile computation - useful in some situations where weights are not very uniform
.         local latticeweightinserter `weightinserter'
359.         if "`latticeignoreweights'" == "latticeignoreweights" local latticeweightinserter
360. 
.         * begin specifying commands to construct the different types of lattice variables / create ancillary supporting variables
.         tempvar latticevar
361.         local byable
362.         local xtileif
363.         if "`latticetype'" == "baseTreated" local xtileif & `ttre' != .
364.         if "`latticetype'" == "baseTreatedPost" local xtileif & `t' >= `ttre' & `ttre' != .
365.         if "`latticetype'" == "baseTreatedPre" local xtileif & `t' < `ttre' & `ttre' != .
366.         if "`latticetype'" == "baseTreatedRef" local xtileif & `t' < `ttre' & `ttre' != . & `_t' == 0
367.         if "`latticetype'" == "byCohort" local byable `i'
368.         if "`latticetype'" == "byTime" local byable `t'
369.         if "`latticetype'" == "byCohortByTime" local byable `i' `t'
370.         if  "`latticetype'" == "byTreated" | "`latticetype'" == "byTreatedByTime" {
371.           tempvar evertreated
372.           qui gen `evertreated' = `ttre' != .
373.         }
374.         if   strpos("`latticetype'", "byTtre")!=0 {
375.           tempvar modified_ttre
376.           qui gen double `modified_ttre' = `ttre'
377.           qui replace `modified_ttre' = `minyearobserved' if `ttre' == .
378.           * minyearobserved is just any value not appearing in ttre; ttre is guaranteed to not include that value
.         }
379.         if "`latticetype'" == "byTreated" local byable `evertreated'
380.         if "`latticetype'" == "byTreatedByTime" local byable  `evertreated' `t'
381.         if "`latticetype'" == "byTtre" local byable `modified_ttre'
382.         if "`latticetype'" == "byTtreByTime" local byable  `modified_ttre' `t'
383. 
.         * make the 'base' style lattices - these compute percentiles in the specified base period (treated units only, treated units post treatment, treated units pre treatment)
.         * base type needs to be handled special b/c we code this variable with a loop through the grabbed list of percentiles
.         * for the others, we just use a percentile generator to create them under the specified conditions
.         if "`latticetype'" == "baseTreatedPost" | "`latticetype'" == "baseTreated" | "`latticetype'" == "baseTreatedPre" | "`latticetype'" == "baseTreatedRef" {
384.           gquantiles `contreat' `latticeweightinserter' if `ifstatement' `xtileif', _pctile   nquantiles(`latticenum')
385.           gen `latticevar' = 1
386.           forval latticecase = 2(1)`latticenum'{
387.             local percentiletograb = `latticecase'-1
388.             qui replace `latticevar' = `latticevar' + 1 if `contreat' > r(r`percentiletograb')
389.           }
390.         }
391.         else {
392.           if "`latticetype'" != "all" qui gquantiles `latticevar' = `contreat' `latticeweightinserter' if `ifstatement' , xtile nquantiles(`latticenum') by(`byable')
393.           if "`latticetype'" == "all"  qui gquantiles `latticevar' = `contreat' `latticeweightinserter' if `ifstatement' ,   nquantiles(`latticenum') xtile
394.         }
395.         qui replace `latticevar' = 0 if `latticevar' == . & `ifstatement'
396.         * null lattice points are sent to 0
.       }
397.       else{
398.         local latticevar `lattice'
399.       }
400.       * build some macros for inserting the lattice variable where needed
.       local latticepart2hash ##i.`latticevar'
401.       local latticepart1hash #i.`latticevar'
402.     }
403.     else{
404.       local latticepart2hash
405.       local latticepart1hash
406.     }
407. 
.     * lattice is done, work on making the continuous treatment variable work
.     * finish up making contreatadder - the code chunk that injects into the regression statement the correct variables needed for estimating continuous treatment effects
.     * an important part of this is partialling out the base effect of the continuous treatment variable in a fashion that is invisible to margins
.     * that is to say, when we control for the continuous treatment variable outside of the treated/pre-treated observations, we don't want that to contribute to treatment effect estimation
.     * we can do that by creating a ringer variable that is equal to contreat but with a different name, or by pushing stuff into the absorb() command
.     * we handle requests for contreat polynomials using c.#c. interactions so that the polynomial terms are legible to margins; we don't care about doing so for the ringer variable though
.     * the ringer copies must be double: gen defaults to float, and a float-truncated copy of a
.     * double contreat is only approximately collinear with it, weakening the engineered
.     * collinearity drop that keeps the base effect out of the margins-visible terms
.     tempvar ringer
408.     qui gen double `ringer' = `contreat'
409.     local contreatpolypart c.`contreat'
410.     local ringerpoly c.(`ringer'
411.       if `contreatpoly' > 1 {
412.         forval polycount = 2(1)`contreatpoly' {
413.           local contreatpolypart `contreatpolypart'##c.`contreat'
414.           tempvar ringer`polycount'
415.           qui gen double `ringer`polycount'' = `ringer'^`polycount'
416.           local ringerpoly `ringerpoly' `ringer`polycount''
417.         }
418.       }
419.     local ringerpoly `ringerpoly')
420.     local contreatinj   `latticepart2hash'##`contreatpolypart'
421.     local ringerinj   `latticepart1hash'#`ringerpoly'
422.     * the macros above will be used for constructing the contreatcontrols below and the main regression statement
.     * this parens below closes the if contreat == contreat if statement
.   }
423. 
. 
. 
. 
.   *******************************************************************************************************************
.   ******************************  HANDLE CONTROLS, CRITICALLY, THE CONTREATCONTROLS  ******************************
.   *******************************************************************************************************************
. 
.   ************ HANDLE REGULAR CONTROLS ****************
.   * direct controls and direct fe don't require modification
. 
.   * controls for coarse case - i.e., where we interacted them with the treatment dummies. ccc_absorb puts them into absorb - only viable for continuous controls of course
.   * the astute eye will notice that coarsecontrolinserter w/ categorical controls should partial out the main treatment effects
.   * this does not occur b/c this statement is placed toward the end of the regression statement, meaning multicollinearity forces drops among the controls
.   local coarsecontrolinserter
424.   local ccc_absorbinserter
425.   if "`coarsecohortcontrols'" != "" local coarsecontrolinserter i.`_i'#i.`_t'#(`coarsecohortcontrols')
426. 
.   if "`ccc_absorb'" != "" {
427.     local ccc_absorbinserter i.`_i'#i.`_t'#c.(`ccc_absorb')
428.   }
429. 
.   * handle interactive controls - these are closer to the object that wooldridge covers in his paper for covariates
.   if "`interactivecontrols'" != "" {
430.     * center the variables by cohort i
.     local interlist
431.     local iter 1
432.     foreach intercon in `interactivecontrols' {
433.       tempvar ic`iter'
434.       qui gen double `ic`iter'' = `intercon'
435.       local interlist `interlist' `ic`iter''
436.       local ++iter
437.     }
438.     qui gstats transform (demean) `interlist'    `weightinserter'   if   `ifstatement', by(`i') replace
439. 
.     * there are two sets of objects to introduce:
.     * interactions between the time variable and the raw interactive controls
.     * interactinos between the de-meaned interactive controls and the dummies for treated units' treatment periods
.     * (I think the null untreated dummy X interactive controls object included should be harmless to include / appears to exist in some of Wooldridge's example files)
.     local interinject i.`_i'#i.`_t'#i.`targetflag'#c.(`interlist')  i.`t'#c.(`interactivecontrols')
440.   }
441. 
. 
.   * handle the time trend option
.   local trendinjector
442.   * the trend enters through a mean-centered double copy of t: with raw calendar codes
.   * the demeaned i.i#c.t columns lose all precision and the trends go numerically inert
.   * (silently - rc 0, no caution; measured as low as t ~ 5e5, panel-dependent), and even
.   * at 4-digit years the raw form drifts under affine shifts of t where the centered
.   * form is exactly shift-invariant. centering is a pure reparameterization absorbed by
.   * the unit intercepts; measured movement on ordinary panels is machine precision.
.   * t is used as a continuous regressor NOWHERE else - every other formula use is
.   * factor/absorb/grouping and must stay raw
.   if "`timetrends'" == "timetrends" {
443.     tempvar tcen
444.     qui gstats sum `t' if `ifstatement', meanonly
445.     qui gen double `tcen' = `t' - r(mean)
446.     local trendinjector i.`i'##c.`tcen'
447.   }
448.         *note that we dont absorb this - pooled continuous variabels is a tricky matter sometimes
. 
. 
.   ************** CREATE CONTREAT CONTROLS ***********
.   * this covers how we control for continuous treatment/treatment intensity outside of treated/pre-treatment observations
.   * we probably want to control for the continuous treatment variable in a flexible way, possibly in a way that varies by period or by cohort or by period separately in the treatment and control groups
.   * this section enables that by creating appropriate controls (using alternate varnames or absorb, so as to remain invisible to margins)
.   * with interactions to allow the specified degree of flexibility - eg, have controls vary by period vs by cohort vs etc.
. 
.   if "`contreatcontrols'" != ""   {
449.     * setup missing helper variables (only if not created earlier)
.     if strpos("`contreatcontrols'" , "byTreated" ) != 0 & strpos( "`latticetype'" , "byTreated") == 0  {
450.       tempvar evertreated
451.       qui gen `evertreated' = `ttre' == .
452.     }
453.     if strpos("`contreatcontrols'" , "byTtre" ) != 0 & strpos("`latticetype'", "byTtre")==0{
454.       tempvar modified_ttre
455.       qui gen double `modified_ttre' = `ttre'
456.       qui replace `modified_ttre' = `minyearobserved' if `ttre' == .
457.       * minyearobserved is just any value not appearing in ttre; ttre is guaranteed to not include that value
.     }
458. 
.     * initialize
.                 local contreatcontrolinserterFE
459.                 local contreatcontrolinserter
460. 
.     * handle basic, byTreated, byTtre, and byCohort in order since these are successively more intensive and supersede each other
. 
.     * basic just partials out the baseline effect of your contreat control. implicitly, this effect is pooled in your control group and reference period
.     * this text initializes contreatcontrolinserterfe correctly if using basic w/o a lattice
.     * and also initializes it this way if there is any chance that this FE object might get kicked outside of an HDFE absorb, in which case this section being included
.     * is necessary in order to correctly manipulate the behavior of reg and poisson's colinearity drop rules (nothing in an HDFE is dropped b/c of colinearity with something not in the FE)
.                 * re: the nature of the manipulation, specifying null##ringer and lattice##ringer (as opposed to ringer alone or lattice#ringer) -- and doing so explicitly, rather than
.                 *     implicitly like in the other control types -- ensures that the base level of contreat gets partialled out. if not specified, it does not always get partialled out, and
.                 *     instead one of the contreat control coefficients gets dropped for colinearity instead
.     if (strpos("`contreatcontrols'",  "basic") != 0 & "`latticepart2hash'" == "" ) | "`unconditionalse'" == "unconditionalse" | "`customvce'" != "" | "`poisson'" == "poisson" {
461.       tempvar null
462.       qui gen `null' = 1
463.       local contreatcontrolinserterFE  i.`null'##`ringerpoly'
464.                         if "`latticepart2hash'" != ""  local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`latticevar'##`ringerpoly'
465.                         *using latticepart2hash as a check here is arbitrary and a different lattice byproduct could be used
.     }
466. 
.     * built on top of the initialized contreatcontrolisnerterFE -- add lattice components only if useful
.     if strpos("`contreatcontrols'",  "byTreated") != 0  local contreatcontrolinserterFE `contreatcontrolinserterFE' i.`evertreated'`ringerinj'
467.     if strpos("`contreatcontrols'",  "byTreated") != 0 & "`latticepart2hash'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`evertreated'`latticepart2hash'
468.     if strpos("`contreatcontrols'",  "byTtre") != 0  local contreatcontrolinserterFE `contreatcontrolinserterFE' i.`modified_ttre'`ringerinj'
469.     if strpos("`contreatcontrols'",  "byTtre") != 0  & "`latticepart2hash'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`modified_ttre'`latticepart2hash'
470.     if strpos("`contreatcontrols'",  "byCohort") != 0  local contreatcontrolinserterFE `contreatcontrolinserterFE'  i.`i'`ringerinj'
471.     if strpos("`contreatcontrols'",  "byCohort") != 0  & "`latticepart2hash'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'   i.`i'`latticepart2hash'
472. 
.     * handle by period - this is in addition to, not in lieu of the others
.     if strpos("`contreatcontrols'",  "byTime") != 0  local contreatcontrolinserterFE `contreatcontrolinserterFE' i.`t'`ringerinj'
473.     if strpos("`contreatcontrols'",  "byTime") != 0  & "`latticepart2hash'" != "" local contreatcontrolinserterFE `contreatcontrolinserterFE'     i.`t'`latticepart2hash'
474. 
. 
.     * in terms of interpreting these control measures, note that allow each cohort to have its own contreat control function can have some interesting consequences
.     * more aggressive controlling can reduce the amount of cross-group comparisons that occur
.     * adding byTime implicitly says "compare the contreat effect in treated units in period 1 to controls in period 1"
.     * but allowing contreat effects to vary by cohort and period simultaneously would not have this effect
. 
. 
.     * if always zero when not treated, the only thing to do is not control for anything! this results in no contreat controls
.     * it is implemented via modifying the contreatinj statement and just not having contreatcontrols of any kind
.     if "`contreatcontrols'" == "untreatedZero" {
475.       local contreatinj   `latticepart1hash'#`contreatpolypart' i.`_i'#i.`_t'#i.`targetflag'`latticepart1hash'
476.     }
477. 
.   }
478. 
.   if "`ccnoabsorb'" == "ccnoabsorb"   {
479.                 local contreatcontrolinserter `contreatcontrolinserterFE'
480.                 local contreatcontrolinserterFE
481.         }
482. 
. 
. 
. 
. 
. 
.   ***************************************************************************************************
.   ********************************         ESTIMATE THE MODELS        *******************************
.   ******************************* (And Extract Information From Them) *******************************
.   ***************************************************************************************************
. 
.   if "`verbose'" == "verbose" dis as text "Wooldid is now estimating its regression."
483. 
.   * handle SEs
.   local vcespecifier
484.   if "`robust'" == "robust" local vcespecifier vce(robust)
485.   if "`cluster'" != "" local vcespecifier cluster(`cluster')
486. 
.   * Regression!
.   * unconditionalse and customvce punts us to using reg or poisson; otherwise, use reghdfe or ppmlhdfe
.   * the transition is fairly easy in that you can get the same results by placing any absorbed FE before the treatment variable specification in the reg equation
.   * since colinear terms get dropped in the order in which they appear (mostly)
. 
.   *Re regtol - it is set to 9 by default, is is the reghdfe default.
.   if "`unconditionalse'" == "" & "`customvce'" == "" {
487.     * ppmlhdfe specification is different from reghdfe b/c it is more hostile to partialling out continuous variables
.     * ppmlhdfe requires d for predict, which margins requires
.     if "`poisson'" == "poisson" {
488.       if "`verbose'" != "" dis "ppmlhdfe `y' `contreatcontrolinserter' `trendinjector'    i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'    `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , absorb(
> i.`i' i.`t' `fe'   `contreatcontrolinserterFE'     `ccc_absorbinserter'  ) `vcespecifier' tol(1e-`regtol') d "
489.       qui cap ppmlhdfe `y' `contreatcontrolinserter' `trendinjector'    i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'    `interinject'    `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , absorb(i.`i' i.`t' `fe' 
>    `contreatcontrolinserterFE'  `ccc_absorbinserter' ) `vcespecifier' tol(1e-`regtol') d
490.       if _rc == 3200 {
491.         dis as text "Caution: initial estimation of ppmlhdfe failed, possibly due to inclusion of an absorbed categorical fixed effect with only 1 level."
492.         dis as text "Falling back to estimation with ppmlhdfe, but with any included time-trend controls, ccc_absorb controls, and/or continuous treatment controls pulled out of the absorb() statement and placed in the main regression.
> "
493.         dis as text "In principle, this fallback solution should usually yield the same results, but will be computationally less efficient."
494.         dis as text "If estimation still fails, the issue could be either with the fe() specified or a result of having few cohorts/time-periods."
495.         qui ppmlhdfe `y' `contreatcontrolinserter' `contreatcontrolinserterFE'  `ccc_absorbinserter'  `trendinjector'  i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'    `coarsecontrolinserter'  `weightinserter'  
>  if   `ifstatement' , absorb(i.`i' i.`t' `fe'   ) `vcespecifier' tol(1e-`regtol') d
496.       }
497.       else {
498.         if _rc != 0 error _rc
499.       }
500.     }
501.     else{
502.       if "`verbose'" != "" dis "reghdfe `y' `contreatcontrolinserter' `trendinjector' i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'   `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , absorb(i.`i'
>  i.`t' `fe'     `contreatcontrolinserterFE'   `ccc_absorbinserter'  ) `vcespecifier' tol(1e-`regtol')  "
503.       qui reghdfe `y' `contreatcontrolinserter' `trendinjector'  i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'     `coarsecontrolinserter'  `weightinserter'   if   `ifstatement' , absorb(i.`i' i.`t' `fe'     `co
> ntreatcontrolinserterFE'   `ccc_absorbinserter'  ) `vcespecifier' tol(1e-`regtol')
504.     }
505.   }
506.   else{
507.     * run the reg/poisson version, places all absorbed FE at the front of the reg equation
.     if "`customvce'" != "" local vcespecifier vce(`customvce')
508.     local regtype reg
509.     if "`poisson'" == "poisson" local regtype poisson
510.     if "`verbose'" != "" dis "`regtype' `y' i.`i' i.`t' `fe'   `trendinjector' `contreatcontrolinserter' `contreatcontrolinserterFE'   `ccc_absorbinserter'   i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'   `interinject'    `coa
> rsecontrolinserter'  `weightinserter'   if   `ifstatement' ,  `vcespecifier'  "
511.     qui `regtype' `y' i.`i' i.`t' `fe'   `trendinjector' `contreatcontrolinserter' `contreatcontrolinserterFE'   `ccc_absorbinserter'   i.`_i'#i.`_t'#i.`targetflag'`contreatinj'  `controls'    `interinject'    `coarsecontrolinserter'  
> `weightinserter'   if   `ifstatement' ,  `vcespecifier'
512.   }
513. 
.   * save the model; will be useful later
.   * register the data-variable obligation with the shell's error-path cleanup epilogue
.   * BEFORE storing: _ppmlhdfe_d already exists in the data at this point, and est sto
.   * itself can fail (a real trigger: the estimates directory at Stata's 300-store
.   * limit), which previously leaked the variable through the unregistered window
.   if "`poisson'" == "poisson" & "`unconditionalse'" == "" & "`customvce'" == "" global WOOLDID_CLEANUP $WOOLDID_CLEANUP ppml
514.   qui est sto ___wooldidfullmodel
515.   global WOOLDID_CLEANUP $WOOLDID_CLEANUP fullmodel
516.   if "`verbose'" == "verbose" dis as text "Wooldid has finished regression estimation and is preparing to begin margins calculations."
517. 
.         * check on dropped obs
.         qui count if `dropcount' & e(sample) == 0
518.         local droppedobs = r(N)
519. 
.   * grab some items from the model - sample indicator variable, residual degrees of freedom, etc
.   tempvar esamp
520.   qui gen byte `esamp' = e(sample)
521.   local df_r = e(df_r)
522. 
.   *****************************************************************************************************************
.   ******************************  PRODUCE THE WEIGHTS FOR CREATING VARIOUS OUTCOMES  ******************************
.   *****************************************************************************************************************
.   * special weights are required to go beyond a simple ATT; this generates them
.   * note: constructed after estimation, on the realized estimation sample (esamp), so that cell/cohort
.   * normalizations only count observations that actually entered the regression (estimators can drop
.   * observations - e.g. reghdfe singletons, ppmlhdfe separation - after the initial sample screens)
. 
.   * handle custom weight multipliers that the user specifies
.   local customweighttext
523.   if "`customweightmultiplier'" != "" local customweighttext * `customweightmultiplier'
524. 
.   ***** begin manufacturing weights to produce averages of interest
.   * 4 weight concepts to target
.   * att is the "do nothing but use sample weights" weight
.   * att_i says give the average of cohort-specific effects, obtaining said effects using sample weights
.   * att_it says "calculate cohort-period specific effects using weights, then average those"
.   * att_itime says "calculate cohort-period specific effects using weights, then average those by cohort, then average the cohort averages"
. 
.   foreach item in tag posttreatment   w_per_it w_per_i  t_per_i   w_att  w_att_it w_att_i w_att_itime   {
525.     tempvar `item'
526.   }
527. 
.   * create necessary supporting object for computing att_i and att_itime weights
.   * this object is 1 if in the treated period for treated units,
.   * 2 if in the pre-treatment period for treated units and we are reporting effects for that time period
.   * 0 if in the pre-treatment period for treated units and we are not reporting effects for that period (i.e., the reference period)
.   * 3 if untreated and in sample
.   * 4 if out of sample
.   if "`att_i'" == "att_i" | "`att_itime'" == "att_itime" {
528.     qui gen `posttreatment' = `t' >= `ttre' if `esamp' == 1
529.     qui replace `posttreatment' = 2 if `t' < `ttre' & `ttre' != . & `_i' != 0 & `_t' != 0 & `esamp' == 1
530.     qui replace `posttreatment' = 3 if `ttre' == .  & `esamp' == 1
531.     qui replace `posttreatment' = 4 if `posttreatment' == .
532.   }
533. 
.   * this variable helps count the number of i-t cells that exist in various subsets - useful for att_itime weights
.   if "`att_itime'" == "att_itime" {
534.     qui gegen `tag' = tag(`i' `t') if  `esamp' == 1
535.     qui replace `tag' = 0 if `tag' == .
536.   }
537. 
.   * generate some inputs for weights calculation
.   * w_per_it contains the amount of weight falling into each i-t cell
.   * w per i gives the total amount of sample weight associated for each i falling into the categories specified by posttreatment
.   * t per i is the total number of periods appearing for i in each posttreatment-defined period
.   * in each case, we only make the input if needed for a weight type the user actually requested
.   * that said, we always produce w_att_it whenever a non att weight is requested, since they are needed for the event horizon estimates and sometimes for histogram
.   if "`att_it'" == "att_it" | "`att_itime'" == "att_itime" | "`att_i'" == "att_i" qui gegen `w_per_it' = total(`esamp' * `w')  , by(`i' `t')
538.   if "`att_i'" == "att_i"  qui gegen `w_per_i' = total(`w'*`esamp')      , by(`posttreatment' `i')
539.   if "`att_itime'" == "att_itime" qui gegen `t_per_i' = total(`tag')    , by(`posttreatment' `i')
540. 
.   * att requires no special weights - it gets to stay as the given weight (w), albeit with the customweight text multiplier coming through
.   * dividing w by w_per_it weights all i-t cells equally, but still lets w be influential within i-t cells (att_it)
.   * dividing w by total w in i weights all i equally, but still lets w be influential within i-t cells and across i-t cells within i (att_i)
.   * dividing w by total w in i-t cells * number of t in the i, yields w_att_itime. this lets w be influential inside i-t cells, but then
.   *        weights every i-t cell equally when contributing to estimates of i-specific effects, which are themselves then averaged
. 
.   if "`att_i'" == "att_i" {
541.     qui gen double `w_att_i' = `w' `customweighttext'/`w_per_i'
542.     qui replace `w_att_i' = 0 if `w_att_i' == .
543.     qui drop `w_per_i'
544.     qui drop  `posttreatment'
545.   }
546. 
.   if "`att_itime'" == "att_itime" {
547.     qui gen double `w_att_itime' = `w' `customweighttext' /(`w_per_it'*`t_per_i')
548.     qui replace `w_att_itime' = 0 if `w_att_itime' == .
549.     qui drop `tag' `t_per_i'
550.     qui cap drop  `posttreatment'
551.   }
552. 
.   if "`att_it'" == "att_it" | "`att_itime'" == "att_itime"  | "`att_i'" == "att_i" {
553.     qui gen double `w_att_it' = `w' `customweighttext'/`w_per_it'
554.     qui replace `w_att_it' = 0 if `w_att_it' == .
555.     qui drop `w_per_it'
556.   }
557. 
.   * generate w_att whenever att is requested
.   if "`att'" == "att" qui gen double `w_att' = `w' `customweighttext'
558. 
.   * some comments on the weights:
.   * provided each i is always wholly contained in a given sg, we have no issues using these weights for sg purposes
.   * since we don't allow fw type weights, weight scale here actually doesn't matter - no need to multiply weights by scalar adjustment factors
.   * for event study estimates, note that att_i and att_itime are not conceptually all that sensible --
.   *       we substitute att_it for them since it retains a spirit of 'all same across i'
. 
.   * save the name of the current frame  - will be useful going forward
.   qui frame
559.   local defaultframe `r(currentframe)'
560. 
.   * create the matrix relyrcolumn containing all relative periods of interest appearing in the regression - needed for constructing the results
.   * do this by processing the column names of e(b)
.   if `espre' + `espl' > 0 {
561.     local relyrlist
562.     tempname relyrcolumn
563.     local bvars: colnames e(b)
564.     local horizlist
565.     local horizonend = `horizonstarter' + `espre' + `espl' -1
566.     forval horiz = `horizonstarter'(1)`horizonend' {
567.       if regexm("`bvars'","[0-9].`_i'#`horiz'.`_t'#1.`targetflag'") {
568.         * the above regular expression resolves to 1 only if you see the following:
.         * (anynumber not followed by a o or a b)._it#(horiz)._t#1.targetflag   <- so a valid, included in the model estimate at the given horizon
.         local relyr = `horiz'-`min_t'-1
569.         local horizlist `horizlist' `horiz'
570.         if "`relyrlist'" != "" local relyrlist `relyrlist' , `relyr'
571.         if "`relyrlist'" == "" local relyrlist `relyrlist' `relyr'
572.       }
573.     }
574.     matrix `relyrcolumn' = (`relyrlist')'
575.   }
576. 
. 
.   * here, we check and see if the main treatment effects have been dropped from the regression for multicollinearity - my tests for this are imperfect, but still useful
.   if "`safety'" != "off"  {
577.     local bvars: colnames e(b)
578.     local catastrophe 0
579.     local bigcatastrophe 0
580.     * "o." appears in e(b) colnames iff some term carries an omission flag (a dot only ever
.     * follows a factor operator, and a token cannot straddle whitespace), so when it is
.     * absent the loop below provably cannot fire -- skip the whole interpreted scan
.     if strpos("`bvars'", "o.") != 0 {
581.     tokenize `bvars'
582.     local maxwordcount = wordcount("`bvars'")
583.     forval testbvar = 1(1)`maxwordcount' {
584.       if strpos("``testbvar''", "o.") != 0   & strpos("``testbvar''", "0b.") == 0 & strpos("``testbvar''", "`_i'") != 0 & strpos("``testbvar''", "`_t'") != 0  & ( strpos("``testbvar''", "1o.`targetflag'") != 0 | strpos("``testbvar''", 
> "1.`targetflag'") != 0)  {
585.         * the above triggers if and only if (a) the variable has an omission flag (and thus was dropped), and
.         * (b) it contains _i, _t, and targetflag (and thus is associated with a main treatment effect), and
.         * (c) targetflag (omitted or not) has a value of 1 (meaning it is supposed to correspond with a treatment effect), and
.         * (d) base values of 0 are not present anywhere (meaning it is supposed to correspond with a treatment effect)
.         * note that these conditions are required in combination since some nonsense cells can form with values like "treatflag = 1 for _i == 0 ", which can't occur in the data
.         * note also that this doesn't always work very well for continuous treatments - it is really only high value for the regular non contreat items
. 
.         * below, we will test to confirm that there isnt just something weird going on w/ duplicative entries --
.         * check that the variable minus the omitteds isn't present somewhere.
.         * note that the white space below actually matters!
.         local checkifpresent = subinstr("``testbvar''","o.",".",.)
586.         local checkifpresent = subinstr("`checkifpresent'"," ","",.)
587.         if strpos("`bvars'"," `checkifpresent' ") == 0 {
588.           * passing into this if means that the omitted object isn't just a duplicate of any actually existing object (which shouldn't usually happen anyway)
.           * next, figure out exactly where the problem occurred
.           * proceed only if there is serious reason to believe the coef should've existed
. 
.           * strip out the _i _t targetflag etc from the word as well as the hashes
.           * what's left behind should be the values of _i and _t associated with the missing object
.           foreach word in b. . `_i' `_t' `targetflag' {
589.             local checkifpresent = subinstr("`checkifpresent'","`word'","",.)
590.           }
591.           local checkifpresent = subinstr("`checkifpresent'","#"," ",.)
592.           local problem_i = word("`checkifpresent'",1)
593.           local problem_t = word("`checkifpresent'",2)
594.           * 2 remaining cases. wordcount = 3, in which case what we have is probably a dropped i-t dummy
.           * or wordcount > 3, in which case we have something else, like a contreat interaction
.           local wordcountproblem = wordcount("`checkifpresent'")
595. 
.           * are there observations falling in the _i _t cell associated with the missing coefficient? if not, this isn't a problem
.           * note: this regrettably is a bit computationally intensive -- and its result is
.           * consumed only through the r(N) gate below, whose branches ALL require
.           * wordcount <= 3, no lattice, or verbose: when the flagged term is an interaction
.           * (wordcount > 3) with a lattice active and verbose off, nothing can consume the
.           * count, so skip the full-data pass entirely (lattice drops there are expected)
.           if `wordcountproblem' <= 3 | "`lattice'" == "" | "`verbose'" != "" {
596.           qui count if `_i' == `problem_i' & `_t' == `problem_t' & `targetflag' == 1 & `w' > 0 & `ifstatement'
597.           if r(N) > 0 {
598.             * if we proceeded to this point, then the omitted object has associated observations, so this is an actual problem!
. 
.             if `wordcountproblem' <= 3 {
599.               local problem_t = `problem_t' - `min_t' - 1
600.               dis as error  "Error: a treated cohort-period dummy coefficient was dropped for multicollinearity."
601.               if "`verbose'" != "" dis as error  "The specific problematic coefficient is: ``testbvar''"
602.               if "`verbose'" != "" dis as error  "For reference, _i is `_i', _t is `_t', and targetflag is `targetflag'"
603.               dis as error  "The problem seems to be with the treatment dummy for `i' == `problem_i', relative-`t' == `problem_t'"
604.               dis as error  "Specify contreatwithin if you have a continuous treatment intensity variable and wish to partial out any effect of treatment when the treatment intensity is 0."
605.               dis as error  "You can ignore this check if you specify safety(off), but be careful."
606.               dis as error  " "
607.               * verbose not specified triggers error here (rather than later after looping through them all )
.               if "`verbose'" == "" error 322
608.               local bigcatastrophe 1
609.             }
610.             if `wordcountproblem' > 3  & ("`lattice'" == "" | "`verbose'" == "verbose"){
611.               * > 3 implies we have more than _i, _t, and targetflag (the variable that is 1 for obs contributed to an estimate and 0 otherwise) forming the dropped variable
.               * this implies it is not a main effect treatment dummy
.               local problem_t = `problem_t' - `min_t' - 1
612.               if `catastrophe' == 0 dis as text  "Caution: a treatment period coefficient interacted with something (likely, a term implementing a continuous treatment variable or an interactive control variable) was dropped for multic
> ollinearity."
613.               if `catastrophe' == 0 & "`lattice'" != "" dis as text  "If using a lattice, this is likely innocuous."
614.               if `catastrophe' == 0 dis as text  "This could imply your results are not identified, depending on exactly what was dropped."
615.               if `catastrophe' == 0 dis as text  "Re-estimate with option verbose for details on what was dropped."
616.               if "`verbose'" != "" dis as text " "
617.               if "`verbose'" != "" dis as text  "The specific problematic coefficient is: ``testbvar''"
618.               if "`verbose'" != "" dis as text  "For reference, _i is `_i', _t is `_t', and targetflag is `targetflag'"
619.               if "`verbose'" != "" dis as text  "Given we are looking at something with an _i _t (other items here) structure,"
620.               if "`verbose'" != "" dis as text  "the problem values of `i' and relative-`t' are `problem_i', `problem_t'."
621.               local catastrophe = `catastrophe' + 1
622.             }
623.           }
624.           }
625.         }
626.       }
627.     }
628.     }
629.     if `catastrophe' > 0 dis as text "Note: the multicollinearity caution above was triggered `catastrophe' times total."
630.     if `bigcatastrophe' == 1 error 322
631.   }
632. 
. 
. 
. 
.   **** extract important parameters from the model  - N, R2, etc
.   * first, extract general parameters of interest from the regression
.   local N = e(N)
633.   local Nclus = e(N_clust)
634.   local ll = e(ll)
635.   local ll_0 = e(ll_0)
636.   if "`regtype'" != "poisson" local rmse = e(rmse)
637.   if "`regtype'" != "poisson" local rss = e(rss)
638.   if "`poisson'" == "poisson" {
639.     local r2pseud = e(r2_p)
640.     local chi2 = e(chi2)
641.   }
642.   else {
643.     local r2 = e(r2)
644.     local r2adj = e(r2_a)
645.     local r2_within = e(r2_within)
646.     local r2_withinadj = e(r2_a_within)
647.     local F = e(F)
648.   }
649. 
. 
. 
. 
. 
. 
.   ***************************************************************************************************
.   ***********************  F3: ATT(g,t) BUILDING BLOCKS (gteffects)  ********************************
.   ***************************************************************************************************
.   * runs inside the "clean e() window": the stage-1 model stored above is still the ACTIVE e()
.   * here, so this reads e(b)/e(V)/e(sample) directly - no restore, no e-class command, and no
.   * effect on anything downstream. binary designs only (wooldid_validate refuses contreat):
.   * the <g>._i#<t>._t#1.targetflag coefficients ARE the cohort-by-relative-period effects on
.   * the regression scale. the name parse and table assembly live in the wooldid_gtx mata
.   * function at the bottom of this file to conserve worker compiled-size headroom.
.   local gtn 0
650.   if "`gteffects'" != "" {
651.     tempvar gtin gttag gtnob gtw1 gtw2 gtw3 gtw4
652.     qui gen byte `gtin' = e(sample) & `targetflag' == 1
653.     qui gegen double `gtnob' = total(`gtin') if `gtin', by(`_i' `_t')
654.     local gtj 0
655.     foreach gtwv in `w_att' `w_att_it' `w_att_i' `w_att_itime' {
656.       local ++gtj
657.       cap confirm variable `gtwv'
658.       if _rc == 0 qui gegen double `gtw`gtj'' = total(`gtwv') if `gtin', by(`_i' `_t')
659.       else qui gen double `gtw`gtj'' = .
660.     }
661.     qui gegen byte `gttag' = tag(`_i' `_t') if `gtin'
662.     tempname gtraw gtsed gtm
663.     cap mkmat `_i' `_t' `ttre' `t' `gtnob' `gtw1' `gtw2' `gtw3' `gtw4' if `gttag' == 1, matrix(`gtraw')
664.     if _rc == 0 {
665.       cap matrix `gtsed' = vecdiag(e(V))
666.       if _rc != 0 matrix `gtsed' = J(1, colsof(e(b)), .)
667.       local gthstart = 1 + `min_t' - `espre'
668.       if "`esfixedbaseperiod'" == "" local gthstart 1
669.       local gthend = `gthstart' + `espre' + `espl' - 1
670.       mata: wooldid_gtx("`_i'", "`_t'", "`targetflag'", "`gtraw'", "`gtsed'", `min_t', `gthstart', `gthend', "`df_r'", "`gtm'")
671.     }
672.     qui drop `gtin' `gtnob' `gtw1' `gtw2' `gtw3' `gtw4' `gttag'
673.   }
674. 
.   **************************************************************************************************
.   *****************************         PRODUCE SUMMARY STATS       ********************************
.   **************************************************************************************************
.   if "`summarystats'" == "summarystats" {
675. 
.     * include among the summary stats information on size of reference period where relevant
.     if "`esfixedbaseperiod'" == "" &  `espre' > 0  {
676.       qui count if e(sample) & `_t' == 0 & `ttre' < .
677.       local Npre_trebase = r(N)
678.       qui count if e(sample) & `_t' != 0 & `ttre' < . & `t' < `ttre'
679.       local Npre_treused = r(N)
680.       local Npre_rat = round(100*`Npre_trebase' / (`Npre_trebase' + `Npre_treused'),.01)
681.       tempvar overt
682.       qui gen `overt' = `_t' == 0
683.       qui total `w' if e(sample) & `ttre' < . & `t' < `ttre',over(`overt')
684.       drop `overt'
685.       local Wpre_trebase = e(b)[1,2]
686.       local Wpre_treused = e(b)[1,1]
687.       local Wpre_rat = round(100*`Wpre_trebase' / (`Wpre_trebase' + `Wpre_treused'),.01)
688.       qui est restore ___wooldidfullmodel
689.     }
690. 
. 
.     * get some summary statistics on the outcome variable and the continuous treatment variable (if existent) in the estimation sample
.     * this code block is inefficient / a result of some legacy choices
.     local rownamessum
691.     if "`contreat'" == "" local sumvarlist y
692.     if "`contreat'" != "" local sumvarlist y contreat
693.     * gstats sum accepts pweights directly, so the regression weights pass through to these descriptive computations unchanged
.     foreach sumvar in `sumvarlist' {
694.       local sumvar2 c
695.       if "`sumvar'" == "y" local sumvar2 y
696.       qui gstats sum ``sumvar'' `weightinserter' if e(sample), detail
697.       local `sumvar'_mean = r(mean)
698.       local `sumvar'_med = r(p50)
699.       local `sumvar'_sd = r(sd)
700.       local `sumvar'_p25 = r(p25)
701.       local `sumvar'_p75 = r(p75)
702.       local `sumvar'_iqr = ``sumvar'_p75' - ``sumvar'_p25'
703.       local `sumvar'_min = r(min)
704.       local `sumvar'_max = r(max)
705.       local rownamessum `rownamessum' `sumvar2'_insample
706. 
.       * do the same in the pre-treatment treated sample
.       if "`sumvar'" == "y" | ("`contreatcontrols'" != "untreatedZero" & "`sumvar'" == "contreat") {
707.         qui gstats sum ``sumvar'' `weightinserter' if e(sample) & `ttre' <. & `t' < `ttre', detail
708.         local `sumvar'pre_mean = r(mean)
709.         local `sumvar'pre_med = r(p50)
710.         local `sumvar'pre_sd = r(sd)
711.         local `sumvar'pre_p25 = r(p25)
712.         local `sumvar'pre_p75 = r(p75)
713.         local `sumvar'pre_iqr = ``sumvar'pre_p75' - ``sumvar'pre_p25'
714.         local `sumvar'pre_min = r(min)
715.         local `sumvar'pre_max = r(max)
716.         local rownamessum `rownamessum' `sumvar2'_pretreat
717.       }
718. 
.       * do the same in the post-treatment treated sample
.       qui gstats sum ``sumvar'' `weightinserter' if e(sample) & `ttre' <. & `t' >= `ttre', detail
719.       local `sumvar'post_mean = r(mean)
720.       local `sumvar'post_med = r(p50)
721.       local `sumvar'post_sd = r(sd)
722.       local `sumvar'post_p25 = r(p25)
723.       local `sumvar'post_p75 = r(p75)
724.       local `sumvar'post_iqr = ``sumvar'post_p75' - ``sumvar'post_p25'
725.       local `sumvar'post_min = r(min)
726.       local `sumvar'post_max = r(max)
727.       local rownamessum `rownamessum' `sumvar2'_posttreat
728. 
.       * do the same in the control group (units never treated in-window: `ttre' == . covers never-treated and out-of-window-treated units)
.       if "`contreatwithin'" == "" & ("`sumvar'" == "y" | ("`contreatcontrols'" != "untreatedZero" & "`sumvar'" == "contreat"))  {
729.         qui gstats sum ``sumvar'' `weightinserter' if e(sample) & `ttre' == ., detail
730.         local `sumvar'con_mean = r(mean)
731.         local `sumvar'con_med = r(p50)
732.         local `sumvar'con_sd = r(sd)
733.         local `sumvar'con_p25 = r(p25)
734.         local `sumvar'con_p75 = r(p75)
735.         local `sumvar'con_iqr = ``sumvar'con_p75' - ``sumvar'con_p25'
736.         local `sumvar'con_min = r(min)
737.         local `sumvar'con_max = r(max)
738.         local rownamessum `rownamessum' `sumvar2'_control
739. 
.       }
740.     }
741. 
.     * store these into a summary stats matrix
.     tempname summarystats
742.     matrix `summarystats' = (`y_mean' , `y_med', `y_sd', `y_iqr', `y_p25', `y_p75', `y_min', `y_max')
743.     matrix `summarystats' = `summarystats' \ (`ypre_mean' , `ypre_med', `ypre_sd', `ypre_iqr', `ypre_p25', `ypre_p75', `ypre_min', `ypre_max')
744.     matrix `summarystats' = `summarystats' \ (`ypost_mean' , `ypost_med', `ypost_sd', `ypost_iqr', `ypost_p25', `ypost_p75', `ypost_min', `ypost_max')
745.     if "`contreatwithin'" == "" matrix `summarystats' = `summarystats' \ (`ycon_mean' , `ycon_med', `ycon_sd', `ycon_iqr', `ycon_p25', `ycon_p75', `ycon_min', `ycon_max')
746. 
.     if "`contreat'" != "" {
747.       matrix `summarystats' = `summarystats' \ (`contreat_mean' , `contreat_med', `contreat_sd', `contreat_iqr', `contreat_p25', `contreat_p75', `contreat_min', `contreat_max')
748.       if "`contreatcontrols'" != "untreatedZero"  matrix `summarystats' = `summarystats' \ (`contreatpre_mean' , `contreatpre_med', `contreatpre_sd', `contreatpre_iqr', `contreatpre_p25', `contreatpre_p75', `contreatpre_min', `contreat
> pre_max')
749.       matrix `summarystats' = `summarystats' \ (`contreatpost_mean' , `contreatpost_med', `contreatpost_sd', `contreatpost_iqr', `contreatpost_p25', `contreatpost_p75', `contreatpost_min', `contreatpost_max')
750.       if "`contreatwithin'" == "" & "`contreatcontrols'" != "untreatedZero"  matrix `summarystats' = `summarystats' \ (`contreatcon_mean' , `contreatcon_med', `contreatcon_sd', `contreatcon_iqr', `contreatcon_p25', `contreatcon_p75', `
> contreatcon_min', `contreatcon_max')
751.     }
752. 
.     matrix colnames `summarystats' = mean median sd iqr p25 p75 min max
753.     matrix rownames `summarystats' = `rownamessum'
754.   }
755. 
. 
.   ****** set some parameters that margins will rely on later
.   local poismarginstext
756.   if "`poisson'" == "poisson" & "`poisexpresults'" == "" local poismarginstext expression(predict(xb))
757. 
. 
. 
. 
.   ******************************************************************************************
.   *****************************         PRODUCE HISTOGRAMS       ***************************
.   ******************************************************************************************
. 
.   * since semielasticities are allowed, we need text for inserting that info into plots
.   local effecttype Effects
758.   local Ceffecttype Effects
759.   if "`semielasticity'" == "eydx" local effecttype Semi-elasticities
760.   if "`contreatelasticitytype'" == "eyex" local Ceffecttype Elasticities
761.   if "`contreatelasticitytype'" == "eydx" local Ceffecttype Semi-elasticities (eydx)
762.   if "`contreatelasticitytype'" == "dyex" local Ceffecttype Semi-elasticities (dyex)
763. 
.   * for histograms of i-level effects, we do the following:
.   * ask for a margins estimation to give us treated cohort specific effects without SEs
.   * stick them into a matrix
.   * use the matrix to populate a dataset that we will use to make the histogram
.   if "`histogramcohorteffects'" != "" {
764.     if "`verbose'" == "verbose" dis as text "Wooldid is now producing histograms."
765.     tempname ___hist
766.     * graph window management: graphs are created with name(..., replace) so re-runs overwrite wooldid's own prior graphs; wooldid no longer clears the user's unrelated graphs from memory
. 
.     * we pool att with att_i b/c they conceptually should match into the same histograms
.     if "`att_i'" == "att_i" |  "`att'" == "att"  {
767.       local whichweight w_att
768.       if "`att'" == "" local whichweight w_att_i
769.       qui margins [`weight'=``whichweight''], `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `_i' != 0 & `t' >= `ttre') noestimcheck over(`_i') nose `poismarginstext'
770.       local matrixstartgrab floor(`=colsof(r(b))'/2)+1
771.       matrix `___hist' = r(b)[1, `matrixstartgrab'..`=colsof(r(b))']'
772.       matrix colnames `___hist' = att_i
773.       if "`contreat'" != "" {
774.         qui margins [`weight'=``whichweight''], `contreatelasticitytype'(`contreat') subpop(if `ifstatement' & `targetflag'==1 & `_i' != 0 & `t' >= `ttre') noestimcheck over(`_i') nose `poismarginstext'
775.         tempname ___Chist
776.         matrix `___Chist' = r(b)[1, 1..`=colsof(r(b))']'
777.         matrix `___hist' = (`___hist',`___Chist')
778.         matrix drop `___Chist'
779.         matrix colnames `___hist' = att_i ame_i
780.       }
781.       tempname wooldidframe
782.       frame create `wooldidframe'
783.       frame change `wooldidframe'
784.       qui svmat double `___hist'
785.       rename `___hist'1 att_i
786.       if "`contreat'" != "" rename `___hist'2 ame_i
787.       local bininserter
788.       if _N < 100 local bininserter bin(20)
789.       qui hist att_i, freq   xtitle("Cohort-Specific Average Treatment `effecttype'") name(hist_att_i, replace) gap(5) `bininserter' color(navy)
790.       if "`saveplots'" != "" qui graph save "`saveplots'_hist_att_i.gph", `replace'
