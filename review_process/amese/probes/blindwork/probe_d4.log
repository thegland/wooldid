1243.               if "`item'" == "att_itime" local ytext "AME_itime on `y'"
1244.               if "`item'" == "att_i" local ytext "AME_i on `y'"
1245. 
.               if "`cfxplotcase'" == "cfxpost" & `cfxpost' ==1 {
