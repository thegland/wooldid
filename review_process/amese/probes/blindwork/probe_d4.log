1110.           qui gstats sum `ibmucoefs'1, meanonly
1111.           local b = r(mean)
1112.           qui ttest `ibmucoefs'1 == 0
1113.           local se = r(se)
1114.           local imt = r(t)
1115.           local imp = r(p)
1116.           local im_ll = `b' + invt(r(df_t),.025)*`se'
1117.           local im_ul = `b' - invt(r(df_t),.025)*`se'
1118.           if !missing(`se') & `se' < `imdegtol_rel'*abs(`b') {
1119.             local se .
1120.             local imt .
1121.             local imp .
1122.             local im_ll .
1123.             local im_ul .
1124.             if "`imdegwarned'" == "" {
1125.               dis as text "`imdegmsg'"
1126.               local imdegwarned 1
1127.             }
1128.           }
1129.           matrix `___C`item'_pre' = (`b',`se', `imt', `imp', `im_ll', `im_ul')
1130.           frame change `defaultframe'
1131.           frame drop `ibmuframe'
1132.           matrix drop `ibmucoefs'
1133.         }
1134.       }
