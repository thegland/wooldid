1142.         if "`cfxlattice'" == "" & wordcount("`lattice'")==2 {
1143.           local cfx_xtitle xtitle("`latticenum' quantiles (type: `latticetype')")
1144.         }
1145. 
.         * use the lattice var for the plots if cfxlattice is not specified; a per-iteration copy
.         * keeps the user's cfxlattice local pristine, so later iterations' x-axis titles do not
.         * pick up the auto-lattice tempvar's internal name
.         local cfxlatticeplot `cfxlattice'
1146.         if "`cfxlatticeplot'" == "" local cfxlatticeplot `latticevar'
1147. 
.         * loop through plot types to make
.         * note that we never apply impvalues here - except in rare cases, it probably (even more severely than normal) violates IM assumptions to do this at specific lattice points like this
.         local cfxplotcaselist
1148.         if `cfxpost' == 1 local cfxplotcaselist cfxpost
1149.         if `cfxpre' == 1 local cfxplotcaselist `cfxplotcaselist'  cfxpre
1150.         foreach cfxplotcase in `cfxplotcaselist'  `cfxrelyrlist' {
1151.           local cfxif
1152.           local nametext `cfxplotcase'
1153.           if "`cfxplotcase'" == "cfxpost" & `cfxpost' ==1 {
1154.             local cfxif & `t' >= `ttre' & `ttre' != .
1155.             local titletext "Post-treatment `effecttype' Across the `contreat' distribution"
1156.           }
1157.           if "`cfxplotcase'" == "cfxpre" & `cfxpre' ==1 {
1158.             local cfxif & `t' < `ttre' & `ttre' != .
1159.             local titletext "Pre-treatment `effecttype' Across the `contreat' distribution"
1160.           }
1161.           if "`cfxplotcase'" != "cfxpre" & "`cfxplotcase'" != "cfxpost" {
1162.             local cfxif & `_t' - `min_t' - 1 == `cfxplotcase' & `ttre' != .
1163.             local nametext = "relyr" + subinstr("`cfxplotcase'","-","n",.)
1164.             local titletext "`effecttype' Across the `contreat' distribution at Relative Time `cfxplotcase'"
1165.           }
1166. 
.           if "`item'" == "att" local ytext "ATT on `y'"
1167.           if "`item'" == "att_it" local ytext "ATT_it on `y'"
1168.           if "`item'" == "att_itime" local ytext "ATT_itime on `y'"
1169.           if "`item'" == "att_i" local ytext "ATT_i on `y'"
1170. 
.           * conceptually, all we are doing is asking for treatment effects to be generated using over(cfxlattice) - but this tends to be a pretty taxing request, actually
.           * we then ask margins plot to handle plot production for us here
.           qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1  `cfxif') noestimcheck over(`cfxlatticeplot') `cfxseopt' `poismarginstext'
1171.           tempname cfx`item'_`nametext'
1172.           matrix `f9tab' = r(table)
1173.           if rowsof(`f9tab') < 6 {
1174.             matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1175.             matrix rownames `f9tab' = b se t pvalue ll ul
1176.           }
1177.           matrix `cfx`item'_`nametext'' = `f9tab'[1..`cfxmatendpoint',floor(`=colsof(r(table))'/2)+1..`=colsof(r(table))']'
1178.           qui marginsplot, recastci(rarea) plotopts(color(navy)) ciopts(color(navy%50)) `cfx_xtitle'  scale(.85) ytitle("`ytext'") title("`titletext'") name("cfx`item'_`nametext'", replace)
1179.           if "`saveplots'" != "" qui graph save "`saveplots'_cfx`item'_`nametext'.gph", `replace'
1180. 
.           * this code here just handles text to switch to contreat
.           if "`item'" == "att" local ytext "AME on `y'"
1181.           if "`item'" == "att_it" local ytext "AME_it on `y'"
1182.           if "`item'" == "att_itime" local ytext "AME_itime on `y'"
1183.           if "`item'" == "att_i" local ytext "AME_i on `y'"
1184. 
.           if "`cfxplotcase'" == "cfxpost" & `cfxpost' ==1 {
1185.             local titletext "Post-treatment `Ceffecttype' Across the `contreat' distribution"
1186.           }
1187.           if "`cfxplotcase'" == "cfxpre" & `cfxpre' ==1 {
1188.             local titletext "Pre-treatment `Ceffecttype' Across the `contreat' distribution"
1189.           }
1190.           if "`cfxplotcase'" != "cfxpre" & "`cfxplotcase'" != "cfxpost" {
