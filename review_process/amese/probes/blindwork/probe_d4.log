.     * joint test the sg effect estimates against each other - are they the same or different?
.     * do not suppress these like normal joint tests; this is a key point of using SGs
.     * in theory this could be expanded further as well
.     * E1: ONE posted margins pass per (estimand x pre/post) now serves BOTH the pairwise
.     * comparison table and the all-subgroups-equal joint test. the joint p comes from a
.     * chain `test` on the posted margins, whose coefficient names are read back off the
.     * posted e(b) (never built from subgroup values); contrast(overjoint) is not allowed
.     * after a posted pwcompare (r322), so the separate contrast pass is gone. every post
.     * is followed by est restore, and the pre-period pass is capture-wrapped because
.     * pwcompare hard-errors (r111) where contrast(overjoint) merely no-ops when only one
.     * subgroup level is realized in the pre-period subpopulation
.     if wordcount("`sglist'") > 1 {
1508.       * F9: under fast mode the pairwise table keeps its point estimates ("." SE cells)
.       * but no joint test runs: the pass is not posted (a chain test after a nose post
.       * would be r321), so the sgchain/test/restore machinery is skipped entirely
.       local sgpost post
1509.       if "`fastnose'" != "" local sgpost
1510.       foreach item in `att' `att_it' `att_i' `att_itime' {
1511.         * pairwise comparisons among the sgs AND the joint test that all sgs are the same
.         qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') noestimcheck over(`subgroups')  pwcompare(effects) `poismarginstext' `marginsdof' `sgpost'
1512.         tempname pwsgs_`item'
1513.         matrix `f9tab' = r(table_vs)
1514.         if rowsof(`f9tab') < 6 {
1515.           matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1516.           matrix rownames `f9tab' = b se t pvalue ll ul
1517.         }
1518.         matrix `pwsgs_`item''  =  `f9tab'[1..6,floor(`=colsof(r(table_vs))'/2)+1..`=colsof(r(table_vs))']'
1519.         if "`sgpost'" != "" {
1520.           wooldid_sgchain, half
1521.           * rank guard (verifier e1_v1): on a rank-deficient posted VCE, -test- silently
.           * drops redundant constraints and reports a residual-rank p where
.           * contrast(overjoint) reported missing (a silent "." -> 0.0000 flip). when the
.           * chain test is not provably full rank, defer to the old contrast engine so
.           * the reported p is identical to the pre-E1 build by construction
.           local sgfallback
1522.           if `sgchainn' > 1 {
1523.             qui test `sgchain'
1524.             if r(df) == `sgchainn' - 1 local joint_`item'_sdiff = r(p)
1525.             else {
1526.               local joint_`item'_sdiff
1527.               local sgfallback 1
1528.             }
1529.           }
1530.           else local joint_`item'_sdiff
1531.           qui est restore ___wooldidfullmodel
1532.           if "`sgfallback'" != "" {
1533.             qui  margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' >= `ttre') noestimcheck over(`subgroups') contrast(overjoint)  `poismarginstext' `marginsdof'
1534.             local joint_`item'_sdiff = r(p)[1,2]
1535.           }
1536.         }
1537.         else local joint_`item'_sdiff
1538. 
.         * repeat for pre-treatment
.         if (`espre' > 0 & "`esfixedbaseperiod'" == "") | ("`esfixedbaseperiod'" == "esfixedbaseperiod" & (`esrelativeto' < -1 | (`min_t' > 2 | (`min_t' > 1 & "`timetrends'" == "")))) {
1539.           cap qui margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0 & `ttre' != .) noestimcheck over(`subgroups')  pwcompare(effects) `poismarginstext' 
> `marginsdof' `sgpost'
1540.           if _rc != 0 {
1541.             * the pre-ame only exists for 1 sg (or margins otherwise refused): no joint
.             * test and no pairwise rows, exactly as under the previous contrast-first order
.             local prejoint_`item'_sdiff
1542.             if "`sgpost'" != "" qui est restore ___wooldidfullmodel
1543.           }
1544.           else {
1545.             tempname prepwsgs_`item'
1546.             matrix `f9tab' = r(table_vs)
1547.             if rowsof(`f9tab') < 6 {
1548.               matrix `f9tab' = `f9tab' \ J(`=6-rowsof(`f9tab')', `=colsof(`f9tab')', .)
1549.               matrix rownames `f9tab' = b se t pvalue ll ul
1550.             }
1551.             matrix `prepwsgs_`item''  =  `f9tab'[1..6,floor(`=colsof(r(table_vs))'/2)+1..`=colsof(r(table_vs))']'
1552.             * the pairwise rows are stacked into e(pwsgs) iff THIS flag is set - not iff
.             * the joint p exists - so a chain-test failure after a successful pwcompare
.             * cannot silently shorten e(pwsgs)
.             local prepwok_`item' 1
1553.             if "`sgpost'" != "" {
1554.               wooldid_sgchain, half
1555.               * rank guard: see the post-period twin above; a failed or not-full-rank
.               * chain test defers to the old contrast engine (whose r(p) read keeps the
.               * old cap semantics)
.               local sgfallback
1556.               if `sgchainn' > 1 {
1557.                 cap qui test `sgchain'
1558.                 if _rc == 0 & r(df) == `sgchainn' - 1 local prejoint_`item'_sdiff = r(p)
1559.                 else {
1560.                   local prejoint_`item'_sdiff
1561.                   local sgfallback 1
1562.                 }
1563.               }
1564.               else local prejoint_`item'_sdiff
1565.               qui est restore ___wooldidfullmodel
1566.               if "`sgfallback'" != "" {
1567.                 qui  margins [`weight'=`w_`item''] , `semielasticity'(`targetflag') subpop(if `ifstatement' & `targetflag'==1 & `t' < `ttre' & `_t' != 0 & `ttre' != .) noestimcheck over(`subgroups') contrast(overjoint)  `poismarginste
> xt' `marginsdof'
1568.                 cap local prejoint_`item'_sdiff = r(p)[1,2]
1569.                 if _rc != 0 local prejoint_`item'_sdiff
1570.               }
1571.             }
1572.             else local prejoint_`item'_sdiff
1573.           }
1574.         }
1575.       }
1576.     }
