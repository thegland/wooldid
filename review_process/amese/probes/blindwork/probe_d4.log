.         cap confirm matrix e(escomp_s`sgcase')
205.         if "`summarystats'" != "" & _rc == 0 {
206.           dis as result  "Event-Study Composition by Horizon, Subgroup `subgroups' == `sgcase' (also in e(escomp_s`sgcase')):"
207.           matlist e(escomp_s`sgcase'), format(%12.4g)
208.           dis as result  " "
209.         }
210.         * show the joint  tests
.         if "`suppressjointtests'" == "" {
211. 
.           if "`e(joint_horiz_s`sgcase')'" != "" {
212.             dis as result  "p-value for joint test that sg=`sgcase' pre-treatment att horizon estimates are 0: " %-6.4f `e(joint_horiz_s`sgcase')'
213.           }
214.           if "`e(joint_horiz_i_s`sgcase')'" != ""  {
215.             dis as result  "p-value for joint test that sg=`sgcase' pre-treatment att_it horizon estimates are 0: " %-6.4f `e(joint_horiz_i_s`sgcase')'
216.           }
217. 
. 
.           if "`e(joint_Choriz_s`sgcase')'" != "" {
218.             dis as result  "p-value for joint test that sg=`sgcase' pre-treatment ame horizon estimates are 0: " %-6.4f `e(joint_Choriz_s`sgcase')'
219.           }
220. 
.           if "`e(joint_Choriz_i_s`sgcase')'" != ""  {
221.             dis as result  "p-value for joint test that sg=`sgcase' pre-treatment ame_it horizon estimates are 0: " %-6.4f `e(joint_Choriz_i_s`sgcase')'
222.           }
223. 
.           dis as result  " "
224.         }
225.         if "`adversarial'" != "" {
226.           foreach typetext in att att_it ame ame_it {
227.             if "`e(adversarial_pval_`typetext'_s`sgcase')'" != "" {
228.               dis as result "p-value for joint test of null that all (non-reference) `typetext' coefficients for sg=`sgcase' are on a single line: " %-6.4f e(adversarial_pval_`typetext'_s`sgcase')
229.             }
230.           }
231.         }
232.         dis as result " "
233.       }
234.     }
235.     * having shown the main sg materials, show the pairwise comparisons
.     if wordcount("`sglist'") > 1 {
236.       dis as result  "Pairwise Comparisons of Different Subgroups' Estimates: `elasinj'"
237.       matlist e(pwsgs)
238.       dis as result " "
239.       foreach item in `estimandlist' {
240.         if "`e(joint_`item'_allsgssame)'" != "" dis as result  "p-value for joint test that all SGs have the same `item': " %-6.4f e(joint_`item'_allsgssame)
241.         if "`e(joint_pre_`item'_allsgssame)'" != "" dis as result  "p-value for joint test that all SGs have the same pre-treatment `item': " %-6.4f e(joint_pre_`item'_allsgssame)
242.       }
243.       dis as result  " "
244.       if "`contreat'" != "" {
245.         foreach item in `estimandlist' {
246.           local itemtext = subinstr("`item'","att","ame",.)
247.           if "`e(joint_`itemtext'_allsgssame)'" != "" dis as result  "p-value for joint test that all SGs have the same `itemtext': " %-6.4f e(joint_`itemtext'_allsgssame)
248.           if "`e(joint_pre_`itemtext'_allsgssame)'" != "" dis as result  "p-value for joint test that all SGs have the same pre-treatment `itemtext': " %-6.4f e(joint_pre_`itemtext'_allsgssame)
249.         }
250.         dis as result  " "
251.       }
252.     }
253.   }
254. 
.   * F3: cohort-by-relative-period building blocks - existence-gated on e(gteffects),
.   * so replay reproduces it and older stores simply print nothing
.   cap confirm matrix e(gteffects)
255.   if _rc == 0 {
256.     tempname gtd
257.     matrix `gtd' = e(gteffects)
258.     local gtrows = rowsof(`gtd')
259.     dis as result " "
260.     dis as result "Cohort-by-Relative-Period Effects (regression scale; full table incl. weight totals in e(gteffects)):"
261.     if "`poisson'" == "poisson" dis as text "Note: under poisson these are on the linear-index (xb) scale; poisexpresults/semielasticity adjustments are not applied."
262.     dis as text "Note: standard errors are the stage-1 regression's coefficient-level VCE; rows outside the reported event-study window have inwindow = 0."
263.     if `gtrows' <= 200 {
264.       tempname gtds
265.       matrix `gtds' = `gtd'[1..., 1..9]
266.       matlist `gtds', format(%9.0g)
267.     }
268.     else dis as text "  (`gtrows' rows; table not printed - see e(gteffects))"
269.   }
270.   }
271.   * F6: permutation-inference block - existence-gated on e(perm_method), so replay
.   * reproduces it and older stores print nothing
.   if "`part'" == "perm" {
272.     if "`e(perm_method)'" != "" {
273.       dis as result "Randomization Inference (permute(`e(perm_method)')): `e(perm_completed)' of `e(perm_reps)' replications completed; `e(perm_npossible_str)' possible assignments."
274.       dis as text "Two-sided permutation p-values; the interval is the 5th-95th percentile band of the permuted-effect distribution (a null band, not a parameter CI); SD is the permuted-effect standard deviation."
275.       if "`e(perm_stat)'" == "t" dis as text "Statistics are randomized on t-ratios (permtstat)."
276.       local wdptcihedge 0
277.       foreach wdpe in `e(wdid_permest)' {
278.         local wdpsc = cond("`e(perm_stat)'" == "t", " (t-scale)", "")
279.         dis as result "  `wdpe': estimate " %10.0g e(b)[1, colnumb(e(b), "main_`wdpe'")] "   p " %6.4f e(perm_p_`wdpe') "   null band`wdpsc' [" %10.0g e(perm_lb_`wdpe') ", " %10.0g e(perm_ub_`wdpe') "]   SD`wdpsc' " %10.0g e(perm_sd_`w
> dpe')
280.         if e(perm_tlb_`wdpe') < . {
281.           dis as result "        inverted-t 95% CI [" %10.0g e(perm_tlb_`wdpe') ", " %10.0g e(perm_tub_`wdpe') "]"
282.           local wdptcihedge 1
283.         }
284.       }
285.       * NFPERM-08 (honesty hedge, once per run): the inverted-t CI is an approximation,
.       * not a sharp-null randomization-test inversion
.       if `wdptcihedge' dis as text "The inverted-t CI is a fixed-zero-null pivotality approximation (it relies on the permuted t-ratio distribution approximating the t-ratio's distribution under shifted nulls); it is not a sharp-null rand
> omization-test inversion."
286.       dis as result " "
287.     }
288.   }
289. 
. end

. 
. * NFADV-01/02/05: the adversarial pre-trend machinery. One caller replaces the four
. * near-identical frame/svmat/`test' blocks in wooldid_worker (per-program size ceiling).
. * Inputs are the F2 event-study capture of the SAME margins run (b 1xk, V kxk full
. * covariance), the aligned relative-time column relyr (kx1), min_t, esrelativeto, and
. * the reference-regime/timetrends/altmethod flags. It does two things:
. *  (1) fits the DISPLAY LINE by the same unweighted OLS `reg b t' the old in-worker
. *      frames ran - identical rows (real horizon coefficients in horizon order, then
. *      the planted zero-valued reference row(s)) and the identical internal regressor
. *      t = relyr + min_t + 1 (the worker's LOAD-BEARING identity), so the published
. *      slope is bit-identical to the old one - and re-expresses the intercept at
. *      relative time 0 (NFADV-05: the old _cons was the fitted value at relyr =
. *      -min_t-1), publishing columns [slope, intercept_rt0];
. *  (2) computes a CALIBRATED p-value on the event-study covariance, esfixedbaseperiod
. *      only (the pooled reference has no single omitted period; the worker prints one
. *      Caution per run and the line is returned without inference). Primary = a
. *      minimum-distance test of the composite null that all horizon effects lie on
. *      SOME line (NFADV-01: the old code froze the fitted line as text constants in
. *      `test', a weighted chi-square whose null size depends on the margins VCV).
. *      Altmethod = the post coefficients tested against the pre-period-line forecasts
. *      using the FULL forecast covariance S = V_QQ + A V_PP A' - A V_PQ - V_QP A'
. *      (NFADV-02: the old code used V_QQ alone, anti-conservative). The statistics
. *      live in mata (wooldid_advx, end of file); F vs chi-squared reference follows
. *      the wooldid_ptp df_r convention.
. * Returns r(status): "ok" (line + p), "nop" (line only), "gapskip" (nothing - the B16
. * gap backstop: the altmethod fit sample has no real pre-period coefficient).
. cap prog drop wooldid_advstat

. prog def wooldid_advstat, rclass
  1. version 16.0
  2.   syntax , b(string) v(string) relyr(string) mint(string) esrel(string) [dfr(string) esf(string) tt(string) alt(string) sg(string)]
  3. 
.   * B16 gap backstop (altmethod): the planted reference row(s) always satisfy the
.   * pre-period cut, so require at least one REAL pre-period coefficient beyond them
.   * (both regimes' cuts reduce to relyr <= -1: esf uses t <= min_t and the pooled
.   * regime uses t <= espre with espre = min_t)
.   if "`alt'" != "" {
  4.     mata: st_local("advnpre", strofreal(sum(st_matrix("`relyr'") :<= -1)))
  5.     if `advnpre' < 1 {
  6.       if "`sg'" == "" dis as text "Caution: adversarial pre-trend testing was cancelled: after accounting for gaps in the data, too few pre-treatment coefficients remain to fit the adversarial reference line."
  7.       else dis as text "Caution: the adversarial pre-trend test was skipped for subgroup `sg': after accounting for gaps in the data, too few pre-treatment coefficients remain to fit the reference line."
  8.       return local status gapskip
  9.       exit
 10.     }
 11.   }
 12. 
.   * the display line. rows are assembled exactly as the old adversarial frames were:
.   * real coefficients first (b transposed against t = relyr + min_t + 1), then the
.   * planted reference row(s) - esf: relyr = esrelativeto (preceded by esrelativeto - 1
.   * under timetrends); pooled: one horizon below the earliest real horizon present.
.   * missing coefficients become 0, as the old frame's `replace b = 0 if b == .' did.
.   local k = rowsof(`relyr')
 13.   tempname advF advB advL
 14.   matrix `advF' = `b'' , (`relyr' + J(`k',1,`mint'+1))
 15.   forval advi = 1/`k' {
 16.     if `advF'[`advi',1] >= . matrix `advF'[`advi',1] = 0
 17.   }
 18.   if "`esf'" != "" {
 19.     if "`tt'" != "" matrix `advF' = `advF' \ (0, `esrel'+`mint')
 20.     matrix `advF' = `advF' \ (0, `esrel'+`mint'+1)
 21.   }
 22.   else {
 23.     mata: st_local("advminr", strofreal(min(st_matrix("`relyr'"))))
 24.     matrix `advF' = `advF' \ (0, `advminr'+`mint')
 25.   }
 26.   qui frame
 27.   local advfr0 `r(currentframe)'
 28.   tempname advfr
 29.   frame create `advfr'
 30.   frame change `advfr'
 31.   qui svmat double `advF'
 32.   local advcut
 33.   if "`alt'" != "" local advcut if `advF'2 <= `mint'
 34.   qui reg `advF'1 `advF'2 `advcut'
 35.   matrix `advB' = e(b)
 36.   frame change `advfr0'
 37.   frame drop `advfr'
 38.   * the little reg clobbered e(); put the main model back (stored at worker start)
.   qui est restore ___wooldidfullmodel
 39.   matrix `advL' = (`advB'[1,1], `advB'[1,2] + (`mint'+1)*`advB'[1,1])
 40.   matrix colnames `advL' = slope intercept_rt0
 41.   matrix rownames `advL' = y1
 42. 
.   * inference (esf only; on the F2 covariance, in mata)
.   local advstatus nop
 43.   if "`esf'" != "" {
 44.     local advdfr .
 45.     if "`dfr'" != "" & "`dfr'" != "." {
 46.       if real("`dfr'") > 0 & real("`dfr'") < . local advdfr `dfr'
 47.     }
 48.     tempname advP
 49.     local advpstat
 50.     mata: wooldid_advx("`b'", "`v'", "`relyr'", `esrel', ("`tt'"!=""), ("`alt'"!=""), `advdfr', "`advP'")
 51.     if "`advpstat'" == "ok" {
 52.       return scalar p = scalar(`advP')
 53.       local advstatus ok
 54.     }
 55.     else {
 56.       * covers rank-0/degenerate covariance (e.g. timetrends), missing entries, a
.       * residual outside the covariance's column space, and no testable residual
.       * dimensions (e.g. only two real horizons under the primary composite null)
.       if "`sg'" == "" dis as text "Caution: adversarial: the composite-null covariance is degenerate; no p-value computed."
 57.       else dis as text "Caution: adversarial: the composite-null covariance is degenerate for subgroup `sg'; no p-value computed."
 58.     }
 59.   }
 60.   return local status `advstatus'
 61.   return matrix line = `advL'
 62. end

. 
. 
. * F11: event-study plots, moved out of wooldid_worker (per-program size ceiling). reads
. * e() plus the two per-call options only; runs inside its own tempname frame and returns
. * to the caller's frame on the normal path. on an error inside this program, stata
. * auto-drops the tempname frame and the wooldid shell's rc-gated epilogue restores the
. * caller's frame - the same net behavior as the pre-F11 inline code.
. cap prog drop wooldid_esplots

. prog def wooldid_esplots
  1. version 16.0
  2.   syntax [, SAVEplots(name) replace]
  3.   * guard the hand-call surface: without a posted wooldid result, the body would die
.   * later inside its own tempname frame with a misleading "relyr not found" (an absent
.   * e() matrix silently reads as a 1x1 missing scalar), stranding a caller who typed
.   * this directly from a non-default frame in the default frame
.   * exact-match on the replay contract version, mirroring the wooldid_display gate
.   if "`e(wdid_replayv)'" != "1" {
  4.     dis as error "Error: wooldid_esplots is internal to wooldid and needs a stored wooldid estimation (replay contract '1') in e(); run wooldid first."
  5.     error 301
  6.   }
  7.   cap confirm matrix e(wdidmainresults)
  8.   if _rc != 0 {
  9.     dis as error "Error: the stored results no longer contain e(wdidmainresults); rerun wooldid."
 10.     error 301
 11.   }
 12.   qui frame
 13.   local defaultframe `r(currentframe)'
 14. 
.   * rehydrate what the plot code reads from e()
.   local y `e(depvar)'
 15.   local esrelativeto `e(wdid_esrel)'
 16.   local timetrends `e(wdid_timetrends)'
 17.   local semielasticity `e(wdid_semielas)'
 18.   local contreatelasticitytype `e(wdid_cetype)'
 19.   local subgroups `e(wdid_sgvar)'
 20.   local sglist `e(wdid_sglist)'
 21.   local suppresssgprimaryeffects `e(wdid_suppresssgpe)'
 22.   local esfixedbaseperiod
 23.   if "`e(estimate_type)'" == "fixed_reference_period" local esfixedbaseperiod esfixedbaseperiod
 24.   tempname wdidpooled
 25.   matrix `wdidpooled' = e(wdidmainresults)
 26. 
. 
. 
.     * this creates and enters a frame where we will produce graphs using wdidpooled and similar for sgs
.     tempname __wooldidframe
 27.     frame create `__wooldidframe'
 28.     frame change `__wooldidframe'
 29.     qui svmat double `wdidpooled', names(col)
 30.     qui gen rownamesvar = ""
 31.     local names : roweq `wdidpooled'
 32.     forvalues i=1/`: word count `names'' {
 33.       qui replace rownamesvar=`"`: word `i' of `names''"' in `i'
 34.     }
 35.     qui drop if relyr == .
 36.     qui glevelsof(rownamesvar), clean local(graphtypes)
 37.     qui gen postperiod =  relyr >= 0
 38.     keep   postperiod relyr  estimate lb_95ci ub_95ci rownamesvar
 39. 
.     * add the pre treatment observation / reference period
.     if "`esfixedbaseperiod'" == "" {
 40.       local newN = _N + 1
 41.       qui gstats sum relyr, meanonly
 42.       local max = r(max)
 43.       local min = r(min)
 44.       local initialflagt = r(min) - 1
 45.       qui set obs `newN'
 46.       qui replace relyr = `initialflagt' if _n == _N
 47.       qui replace lb_95ci = 0 if _n == _N
 48.       qui replace ub_95ci = 0 if _n == _N
 49.       qui replace estimate = 0 if _n == _N
 50.       qui replace rownamesvar = "reference" if _n == _N
 51.       local xlabelstarter xlabel(`initialflagt' "*"
 52.         forval xlabeltick = `min'(1)`max' {
 53.           local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'"
 54.         }
 55.         local xlabelstarter `xlabelstarter' )
 56. 
.     }
 57.     else{
 58.       qui   gstats sum relyr, meanonly
 59.       local max = r(max)
 60.       local min = r(min)
 61.       local newN = _N + 1
 62.                         if "`timetrends'" == "timetrends" local ++newN
 63.       qui set obs `newN'
 64.                         qui replace relyr = `esrelativeto' if _n == _N
 65.                         if "`timetrends'" == "timetrends" qui replace relyr = `esrelativeto' - 1 if _n == _N - 1
 66.       qui replace lb_95ci = 0 if _n == _N
 67.       qui replace ub_95ci = 0 if _n == _N
 68.       qui replace estimate = 0 if _n == _N
 69.                         qui replace rownamesvar = "reference" if _n == _N
 70.                         if "`timetrends'" == "timetrends" qui replace lb_95ci = 0 if _n == _N -1
 71.                         if "`timetrends'" == "timetrends" qui replace ub_95ci = 0 if _n == _N -1
 72.                         if "`timetrends'" == "timetrends" qui replace estimate = 0 if _n == _N -1
 73.                         if "`timetrends'" == "timetrends" qui replace rownamesvar = "reference" if _n == _N - 1
 74.                         if `esrelativeto' < `min' local min `esrelativeto'
 75.                         if "`timetrends'" == "timetrends" if `esrelativeto' -1  < `min' local min = `esrelativeto' - 1
 76.       local xlabelstarter xlabel(
 77.         forval xlabeltick = `min'(1)`max' {
 78.           local asterisk
 79.                                         if `xlabeltick' == `esrelativeto' local asterisk *
 80.                                         if "`timetrends'" == "timetrends" & `xlabeltick' == `esrelativeto' -1 local asterisk *
 81.           local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'`asterisk'"
 82.         }
 83.         local xlabelstarter `xlabelstarter' )
 84.     }
 85.     sort  relyr
 86. 
. 
.     local xlineinserter
 87.     qui   gstats sum relyr, meanonly
 88.     if r(min) < 0 local xlineinserter xline(-0.5,   lpattern(dash) lcolor(black))
 89. 
.     * inject elasticity info
.     local elasinj Effects
 90.     if "`semielasticity'" == "eydx" local elasinj "Semi-elasticities"
 91.     local elasinj2 Effects
 92.     if "`contreatelasticitytype'" == "eyex" local elasinj2 Elasticities
 93.     if "`contreatelasticitytype'" == "eydx" local elasinj2 Semi-elasticities (eydx)
 94.     if "`contreatelasticitytype'" == "dyex" local elasinj2 Semi-elasticities (dyex)
 95. 
.     * generate and save the actual graphs; then save the data
.     foreach graph in `graphtypes' {
 96.       local graphtext = subinstr("`graph'","ES_","",.)
 97.       local att_it_text ATT_it `elasinj'
 98.       local att_text ATT `elasinj'
 99.       local ame_it_text AME_it `elasinj2'
100.       local ame_text AME `elasinj2'
101.       twoway (connected estimate relyr, color(navy)) (rarea lb_95ci ub_95ci relyr,color(navy%50)) if (rownamesvar =="reference" | rownamesvar=="`graph'")  , `xlineinserter' xtitle("Time Relative to Time of Initial Treatment") ytitle("`
> `graphtext'_text' on `y' by Horizon") legend(off)   name(`graphtext'_fullmodel, replace) `xlabelstarter'
102.       if "`saveplots'" != "" qui graph save "`saveplots'_`graph'.gph", `replace'
103.     }
104. 
. 
.     if "`saveplots'" != "" qui save "`saveplots'_ES.dta", `replace'
105.     clear
106. 
.     * repeat by SG if appropriate
.     if "`subgroups'" != "" & "`suppresssgprimaryeffects'" == "" {
107.       foreach sgcase in `sglist' {
108.         tempname wdidsgmat
109.         matrix `wdidsgmat' = e(wdidsgresults_`sgcase')
110.         qui svmat double `wdidsgmat', names(col)
111.         qui gen rownamesvar = ""
112.         local names : roweq `wdidsgmat'
113.         forvalues i=1/`: word count `names'' {
114.           qui replace rownamesvar=`"`: word `i' of `names''"' in `i'
115.         }
116.         qui drop if relyr == .
117.         qui glevelsof(rownamesvar), clean local(graphtypes)
118.         qui gen postperiod =  relyr >= 0
119.         keep  rownamesvar postperiod relyr  estimate lb_95ci ub_95ci
120. 
.         * add the pre treatment observation
.         if "`esfixedbaseperiod'" == "" {
121.           local newN = _N + 1
122.           qui   gstats sum relyr, meanonly
123.           local max = r(max)
124.           local min = r(min)
125.           local initialflagt = r(min) - 1
126.           qui set obs `newN'
127.           qui replace relyr = `initialflagt' if _n == _N
128.           qui replace lb_95ci = 0 if _n == _N
129.           qui replace ub_95ci = 0 if _n == _N
130.           qui replace estimate = 0 if _n == _N
131.           qui replace rownamesvar = "reference" if _n == _N
132. 
.           local xlabelstarter xlabel(`initialflagt' "*"
133.             forval xlabeltick = `min'(1)`max' {
134.               local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'"
135.             }
136.             local xlabelstarter `xlabelstarter' )
137.         }
138.         else{
139.           qui   gstats sum relyr, meanonly
140.           local max = r(max)
141.           local min = r(min)
142.           local newN = _N + 1
143.                                         if "`timetrends'" == "timetrends" local ++newN
144.           qui set obs `newN'
145.           qui replace relyr = `esrelativeto' if _n == _N
146.                                         if "`timetrends'" == "timetrends" qui replace relyr = `esrelativeto' - 1 if _n == _N - 1
147.                                         qui replace lb_95ci = 0 if _n == _N
148.           qui replace ub_95ci = 0 if _n == _N
149.           qui replace estimate = 0 if _n == _N
150.                                         qui replace rownamesvar = "reference" if _n == _N
151.                                         if "`timetrends'" == "timetrends" qui replace lb_95ci = 0 if _n == _N -1
152.           if "`timetrends'" == "timetrends" qui replace ub_95ci = 0 if _n == _N -1
153.           if "`timetrends'" == "timetrends" qui replace estimate = 0 if _n == _N -1
154.                                         if "`timetrends'" == "timetrends" qui replace rownamesvar = "reference" if _n == _N - 1
155. 
.           if `esrelativeto' < `min' local min `esrelativeto'
156.           if "`timetrends'" == "timetrends" if `esrelativeto' -1  < `min' local min = `esrelativeto' - 1
157.           local xlabelstarter xlabel(
158.             forval xlabeltick = `min'(1)`max' {
159.               local asterisk
160.                                                         if `xlabeltick' == `esrelativeto' local asterisk *
161.                                                         if "`timetrends'" == "timetrends" & `xlabeltick' == `esrelativeto' -1 local asterisk *
162.               local xlabelstarter `xlabelstarter' `xlabeltick' "`xlabeltick'`asterisk'"
163.             }
164.             local xlabelstarter `xlabelstarter' )
165.         }
166. 
.         sort relyr
167.         foreach graph in `graphtypes' {
168.           local graphtext = subinstr("`graph'","ES_","",.)
169.           local att_it_text ATT_it `elasinj'
170.           local att_text ATT `elasinj'
171.           local ame_it_text AME_it `elasinj2'
172.           local ame_text AME `elasinj2'
173.           twoway (connected estimate relyr, color(navy)) (rarea lb_95ci ub_95ci relyr,color(navy%50)) if (rownamesvar =="reference" | rownamesvar=="`graph'")  , `xlineinserter' xtitle("Time Relative to Time of Initial Treatment") ytitl
> e("``graphtext'_text' on `y' by Horizon") legend(off)   name(`graphtext'_sg`sgcase', replace) `xlabelstarter'   title("`subgroups' == `sgcase'")
174.           if "`saveplots'" != "" qui graph save "`saveplots'_`graph'_sg`sgcase'.gph", `replace'
175.         }
176. 
.         if "`saveplots'" != ""  qui save "`saveplots'_ES_`subgroups'_`sgcase'.dta", `replace'
177.         clear
178.       }
179.     }
180. 
.     frame change `defaultframe'
181.     frame drop `__wooldidframe'
182. end

. 
. 
. *** F3: mata worker for the gteffects extraction (name parse + table assembly; kept out
. *** of wooldid_worker to conserve compiled-size headroom). the cap mata drop makes the
. *** file safely re-loadable within a session (two-build harnesses, dev reloads)
. cap mata: mata drop wooldid_gtx()

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
: void wooldid_gtx(string scalar gtiv, string scalar gttv, string scalar gttf,
>                  string scalar rawname, string scalar sedname, real scalar gtmint,
>                  real scalar gthstart, real scalar gthend, string scalar gtdfr,
>                  string scalar outname)
> {
>     real matrix cells, raw, out
>     real matrix b, sed
>     string matrix names
>     string scalar pat
>     real scalar j, r, q, df, g, tt, est, v, se, z, p, lb, ub, crit, n
>     names = st_matrixcolstripe("e(b)")[., 2]
>     b = st_matrix("e(b)")
>     sed = st_matrix(sedname)
>     raw = st_matrix(rawname)
>     pat = "^([0-9]+)\." + gtiv + "#([0-9]+)\." + gttv + "#1\." + gttf + "$"
>     cells = J(0, 3, .)
>     for (j = 1; j <= rows(names); j++) {
>         if (regexm(names[j], pat)) cells = cells \ (strtoreal(regexs(1)), strtoreal(regexs(2)), j)
>     }
>     n = rows(cells)
>     st_local("gtn", strofreal(n))
>     if (n == 0) return
>     df = strtoreal(gtdfr)
>     out = J(n, 15, .)
>     for (r = 1; r <= n; r++) {
>         g = cells[r, 1]
>         tt = cells[r, 2]
>         j = cells[r, 3]
>         est = b[1, j]
>         v = sed[1, j]
>         se = (v < . & v > 0) ? sqrt(v) : .
>         p = lb = ub = .
>         if (se < .) {
>             z = est / se
>             if (df < .) {
>                 p = 2 * ttail(df, abs(z))
>                 crit = invttail(df, .025)
>             }
>             else {
>                 p = 2 * normal(-abs(z))
>                 crit = invnormal(.975)
>             }
>             lb = est - crit * se
>             ub = est + crit * se
>         }
>         out[r, 1] = g
>         out[r, 4] = tt - gtmint - 1
>         out[r, 5] = est
>         out[r, 6] = se
>         out[r, 7] = p
>         out[r, 8] = lb
>         out[r, 9] = ub
>         out[r, 10] = (tt >= gthstart & tt <= gthend)
>         for (q = 1; q <= rows(raw); q++) {
>             if (raw[q, 1] == g & raw[q, 2] == tt) {
>                 out[r, 2] = raw[q, 3]
>                 out[r, 3] = raw[q, 4]
>                 out[r, 11] = raw[q, 5]
>                 out[r, 12] = raw[q, 6]
>                 out[r, 13] = raw[q, 7]
>                 out[r, 14] = raw[q, 8]
>                 out[r, 15] = raw[q, 9]
>                 break
>             }
>         }
>     }
>     out = sort(out, (1, 4))
>     st_matrix(outname, out)
>     st_matrixcolstripe(outname, (J(15, 1, ""), ("i", "onset", "caltime", "relyr", "estimate", "se", "p", "lb_95ci", "ub_95ci", "inwindow", "nobs", "w_att", "w_att_it", "w_att_i", "w_att_itime")'))
> }

: end
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. 
. *** F6: assignment generation for permutation inference. fills <assignname> (C x R,
. *** frame row order) and c_locals: wdp_R, wdp_npd/wdp_nps (possible-assignment count,
. *** double and string), wdp_caut0/1/2 (cautions), wdp_err (fatal message, caller raises)
. cap mata: mata drop wooldid_permx()

. cap mata: mata drop wooldid_permx_enum()

. cap mata: mata drop wooldid_permx_msp()

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
: void wooldid_permx(string scalar fr, string scalar onsv, string scalar strv,
>                    real scalar reps, real scalar exact, string scalar assignname,
>                    string scalar pname, string scalar lname)
> {
>     real matrix A
>     real colvector ons, str, idx, levels, v
>     real scalar C, si, lnM, M, R, r, k, capexact, capwarn
>     string scalar nps
>     st_local("wdp_err", "")
>     st_local("wdp_caut1", "")
>     st_local("wdp_caut2", "")
>     string scalar curfr
>     curfr = st_framecurrent()
>     st_framecurrent(fr)
>     ons = st_data(., onsv)
>     str = st_data(., strv)
>     st_framecurrent(curfr)
>     C = rows(ons)
>     st_local("wdp_caut0", "")
>     if (pname != "" & rows(st_matrix(pname)) > 0) {
>         wooldid_permxp(ons, st_matrix(pname), st_matrix(lname), reps, assignname)
>         return
>     }
>     // possible-assignment count: product over strata of multiset-permutation counts
>     lnM = 0
>     for (si = 1; si <= rows(uniqrows(str)); si++) {
>         v = select(ons, str :== uniqrows(str)[si])
>         lnM = lnM + lnfactorial(rows(v))
>         levels = uniqrows(v)
>         for (k = 1; k <= rows(levels); k++) {
>             lnM = lnM - lnfactorial(sum(v :== levels[k] :| (v :>= . :& levels[k] :>= .)))
>         }
>     }
>     M = (lnM < 700 ? round(exp(lnM)) : .)
>     if (lnM < 34) nps = strofreal(round(exp(lnM)), "%20.0f")
>     else nps = strofreal(exp(lnM - floor(lnM/ln(10))*ln(10)), "%9.4f") + "e+" + strofreal(floor(lnM/ln(10)), "%3.0f")
>     st_local("wdp_npd", strofreal(M, "%20.0f"))
>     st_local("wdp_nps", strtrim(nps))
>     capexact = 10000
>     capwarn = 1000
>     if (exact) {
>         if (M >= . | M > capexact) {
>             st_local("wdp_err", "Error: permexact requires enumerating every assignment, but there are " + strtrim(nps) + " (ceiling: " + strofreal(capexact) + "). Use permreps().")
>             return
>         }
>         if (M > capwarn) st_local("wdp_caut1", "permexact is enumerating " + strtrim(nps) + " assignments (over " + strofreal(capwarn) + "); this may be slow.")
>         R = M
>     }
>     else {
>         R = reps
>         if (M < . & reps > 0.1*M) st_local("wdp_caut2", "permreps(" + strofreal(reps) + ") exceeds 10% of the " + strtrim(nps) + " possible assignments; consider permexact.")
>     }
>     st_local("wdp_R", strofreal(R))
>     A = J(C, R, .)
>     if (exact) {
>         // enumerate per-stratum multiset permutations, then take the cartesian product
>         A = wooldid_permx_enum(ons, str)
>     }
>     else {
>         for (r = 1; r <= R; r++) {
>             v = ons
>             for (si = 1; si <= rows(uniqrows(str)); si++) {
>                 idx = selectindex(str :== uniqrows(str)[si])
>                 v[idx] = jumble(ons[idx])
>             }
>             A[., r] = v
>         }
>     }
>     st_matrix(assignname, A)
> }

: 
: real matrix wooldid_permx_enum(real colvector ons, real colvector str)
> {
>     real matrix A, B, S1
>     real colvector idx
>     real scalar si, n1, n2, a, b
>     // per-stratum enumerations, combined by cartesian product
>     A = J(rows(ons), 0, .)
>     for (si = 1; si <= rows(uniqrows(str)); si++) {
>         idx = selectindex(str :== uniqrows(str)[si])
>         S1 = wooldid_permx_msp(sort(ons[idx], 1))
>         if (cols(A) == 0) {
>             A = J(rows(ons), cols(S1), .)
>             for (b = 1; b <= cols(S1); b++) A[idx, b] = S1[., b]
>         }
>         else {
>             n1 = cols(A)
>             n2 = cols(S1)
>             B = J(rows(ons), n1*n2, .)
>             for (a = 1; a <= n1; a++) {
>                 for (b = 1; b <= n2; b++) {
>                     B[., (a-1)*n2 + b] = A[., a]
>                     B[idx, (a-1)*n2 + b] = S1[., b]
>                 }
>             }
>             A = B
>         }
>     }
>     return(A)
> }

: 
: real matrix wooldid_permx_msp(real colvector v)
> {
>     real matrix R, S
>     real colvector rest, lv
>     real scalar k, j
>     // all distinct permutations of multiset v (v sorted), columns = permutations
>     if (rows(v) == 1) return(v)
>     lv = uniqrows(v)
>     R = J(rows(v), 0, .)
>     for (k = 1; k <= rows(lv); k++) {
>         j = selectindex(v :== lv[k] :| (v :>= . :& lv[k] :>= .))[1]
>         if (j == rows(v)) rest = v[|1 \ j-1|]
>         else if (j == 1) rest = v[|2 \ .|]
>         else rest = v[|1 \ j-1|] \ v[|j+1 \ .|]
>         S = wooldid_permx_msp(rest)
>         R = R, (J(1, cols(S), lv[k]) \ S)
>     }
>     return(R)
> }

: end
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. 
. *** F6: probabilities-method draws (design distribution): per-cluster categorical
. *** draws from user-specified probabilities; count = product of support sizes
. cap mata: mata drop wooldid_permxp()

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
: void wooldid_permxp(real colvector ons, real matrix P, real rowvector lvl,
>                     real scalar reps, string scalar assignname)
> {
>     real matrix A
>     real colvector cum
>     real scalar C, K, c, r, k, u, lnS, zp, obsk
>     string scalar nps
>     C = rows(ons)
>     K = cols(lvl)
>     lnS = 0
>     zp = 0
>     for (c = 1; c <= C; c++) {
>         lnS = lnS + ln(sum(P[c, .] :> 0))
>         obsk = 0
>         for (k = 1; k <= K; k++) {
>             if (ons[c] == lvl[k]) obsk = k
>         }
>         if (obsk == 0 | (obsk > 0 ? P[c, obsk] <= 0 : 0)) zp = 1
>     }
>     if (lnS < 34) nps = strofreal(round(exp(lnS)), "%20.0f")
>     else nps = strofreal(exp(lnS - floor(lnS/ln(10))*ln(10)), "%9.4f") + "e+" + strofreal(floor(lnS/ln(10)), "%3.0f")
>     st_local("wdp_npd", strofreal((lnS < 700 ? round(exp(lnS)) : .), "%20.0f"))
>     st_local("wdp_nps", strtrim(nps))
>     st_local("wdp_R", strofreal(reps))
>     if (exp(lnS) < . & reps > 0.1*exp(lnS)) st_local("wdp_caut2", "permreps(" + strofreal(reps) + ") exceeds 10% of the " + strtrim(nps) + " possible assignments in the design's support.")
>     if (zp) st_local("wdp_caut0", "the OBSERVED assignment has zero probability under the specified design, so the reported p-value is a tail probability under that design distribution, not a randomization test that includes the observed 
> assignment.")
>     A = J(C, reps, .)
>     for (r = 1; r <= reps; r++) {
>         for (c = 1; c <= C; c++) {
>             cum = runningsum(P[c, .])'
>             u = runiform(1, 1)
>             for (k = 1; k <= K; k++) {
>                 if (u <= cum[k] + 1e-12) {
>                     A[c, r] = lvl[k]
>                     k = K + 1
>                 }
>             }
>         }
>     }
>     st_matrix(assignname, A)
> }

: end
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. *** F6: the shared permprobs() parser: validates the grammar against the data's onset
. *** levels and cluster values; in engine mode (pname != "") also emits the probability
. *** matrix with rows in ascending cluster order and the level vector in user order.
. *** on any violation, sets the local permperr (caller raises r(198))
. cap mata: mata drop wooldid_permp()

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
: void wooldid_permp(string scalar spec, string scalar onsname, string scalar lvlstr,
>                    string scalar clusstr, string scalar pname, string scalar lname)
> {
>     string vector grp, groups
>     string scalar cur
>     string rowvector tok, dlv, dcl
>     real rowvector lvl, seen, dl, dc
>     real matrix P
>     real colvector cval, ord
>     real scalar G, g, K, C, c, k, j, ssum, v, ing, hit
>     st_local("permperr", "")
>     grp = tokens(subinstr(subinstr(spec, "(", " __GRP__ ", .), ")", " __END__ ", .))
>     // regroup
>     groups = J(0, 1, "")
>     cur = ""
>     ing = 0
>     for (g = 1; g <= cols(grp); g++) {
>         if (grp[g] == "__GRP__") {
>             if (ing) {
>                 st_local("permperr", "Error: permprobs() has a '(' inside a group; check the parentheses.")
>                 return
>             }
>             ing = 1
>             cur = ""
>         }
>         else if (grp[g] == "__END__") {
>             if (!ing) {
>                 st_local("permperr", "Error: permprobs() has an unmatched ')'.")
>                 return
>             }
>             ing = 0
>             groups = groups \ cur
>         }
>         else if (ing) cur = cur + " " + grp[g]
>         else {
>             st_local("permperr", "Error: permprobs() has text outside parenthesized groups: " + grp[g])
>             return
>         }
>     }
>     if (ing) {
>         st_local("permperr", "Error: permprobs() has an unmatched '('.")
>         return
>     }
>     G = rows(groups)
>     if (G < 2) {
>         st_local("permperr", "Error: permprobs() needs the onset-level group plus one group per cluster.")
>         return
>     }
>     // group 1: onset varname + level order
>     tok = tokens(groups[1])
>     if (cols(tok) < 3) {
>         st_local("permperr", "Error: permprobs() first group must be (onsetvar level level ...).")
>         return
>     }
>     if (tok[1] != onsname) {
>         st_local("permperr", "Error: permprobs() first group names '" + tok[1] + "' but the timing variable is '" + onsname + "'.")
>         return
>     }
>     K = cols(tok) - 1
>     lvl = J(1, K, .)
>     for (k = 1; k <= K; k++) {
>         // NFPERM-05: strict token rule. only the literal "." names the never-treated
>         // level; any other token must parse to a nonmissing number. previously a garbage
>         // token strtoreal'd to missing, silently aliasing the never-treated level, and a
>         // duplicate listed level passed the one-way membership check - either way a
>         // realized onset level silently vanished from the randomization design (rc 0)
>         if (tok[k+1] == ".") lvl[k] = .
>         else {
>             lvl[k] = strtoreal(tok[k+1])
>             if (lvl[k] >= .) {
>                 st_local("permperr", "Error: permprobs() onset level token '" + tok[k+1] + "' is not a number or the never-treated marker '.'.")
>                 return
>             }
>         }
>         // duplicate rejection (mata missing == missing is true, so this also catches a
>         // second '.'); together with the count and exactly-once membership checks below
>         // this makes listed-vs-realized levels a bijection
>         for (j = 1; j < k; j++) {
>             if (lvl[j] == lvl[k]) {
>                 st_local("permperr", "Error: permprobs() lists onset level '" + tok[k+1] + "' more than once.")
>                 return
>             }
>         }
>     }
>     // level set must equal the data's level set
>     dlv = tokens(lvlstr)
>     if (cols(dlv) != K) {
>         st_local("permperr", "Error: permprobs() lists " + strofreal(K) + " onset levels but the data (within sample) has " + strofreal(cols(dlv)) + ".")
>         return
>     }
>     dl = strtoreal(dlv)
>     for (k = 1; k <= K; k++) {
>         if (sum(dl :== lvl[k]) != 1) {
>             st_local("permperr", "Error: permprobs() onset level '" + tok[k+1] + "' does not match the data's onset levels (" + lvlstr + ").")
>             return
>         }
>     }
>     // cluster groups
>     C = G - 1
>     dcl = tokens(clusstr)
>     if (cols(dcl) != C) {
>         st_local("permperr", "Error: permprobs() has " + strofreal(C) + " cluster group(s) but the data (within sample) has " + strofreal(cols(dcl)) + " cluster value(s).")
>         return
>     }
>     cval = J(C, 1, .)
>     P = J(C, K, .)
>     for (g = 2; g <= G; g++) {
>         tok = tokens(groups[g])
>         if (cols(tok) != K + 1) {
>             st_local("permperr", "Error: permprobs() cluster group (" + groups[g] + " ) must have the cluster value plus exactly " + strofreal(K) + " probabilities.")
>             return
>         }
>         cval[g-1] = strtoreal(tok[1])
>         ssum = 0
>         for (k = 1; k <= K; k++) {
>             v = strtoreal(tok[k+1])
>             if (v >= . | v < 0) {
>                 st_local("permperr", "Error: permprobs() has an invalid probability in group (" + groups[g] + " ).")
>                 return
>             }
>             P[g-1, k] = v
>             ssum = ssum + v
>         }
>         if (abs(ssum - 1) > 1e-6) {
>             st_local("permperr", "Error: permprobs() probabilities for cluster value " + tok[1] + " sum to " + strofreal(ssum) + ", not 1.")
>             return
>         }
>         // NFPERM-06: normalize the row so its cumulative sum ends exactly at 1 (within
>         // ~K*eps, absorbed by the draw loop's +1e-12 cushion). rows accepted a hair
>         // under 1 by the tolerance formerly left a deficit tail where a uniform draw
>         // matched no probability column, leaving the assignment cell missing - which
>         // downstream is wooldid's never-treated code (silent). division by a positive
>         // ssum preserves zero/positive sign patterns, so the observed-support check and
>         // support counts are unaffected; exact-sum rows are bitwise unchanged (ssum==1)
>         if (ssum != 1) P[g-1, .] = P[g-1, .] :/ ssum
>     }
>     // cluster set must equal the data's, no duplicates
>     dc = strtoreal(dcl)
>     seen = J(1, C, 0)
>     for (c = 1; c <= C; c++) {
>         hit = 0
>         for (k = 1; k <= C; k++) {
>             if (dc[k] == cval[c]) {
>                 if (seen[k]) {
>                     st_local("permperr", "Error: permprobs() lists cluster value " + strofreal(cval[c]) + " more than once.")
>                     return
>                 }
>                 seen[k] = 1
>                 hit = 1
>             }
>         }
>         if (!hit) {
>             st_local("permperr", "Error: permprobs() cluster value " + strofreal(cval[c]) + " is not a value of the cluster variable (within sample).")
>             return
>         }
>     }
>     if (pname != "") {
>         // rows in ascending cluster order = the engine's map-frame order
>         ord = order(cval, 1)
>         st_matrix(pname, P[ord, .])
>         st_matrix(lname, lvl)
>     }
> }

: end
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. 
. *** NFADV-01/02: the adversarial p-value statistics, called by wooldid_advstat (kept
. *** out of wooldid_worker to conserve compiled-size headroom; the cap mata drop makes
. *** the file safely re-loadable within a session). Inputs are the F2 event-study
. *** capture (b 1xk, V kxk) and the aligned relative-time column vector; planted
. *** reference rows carry b = 0 with zero variance. Sets st_local advpstat = "ok" and
. *** the scalar `pn' on success, advpstat = "degen" otherwise (never errors).
. ***
. *** alt == 0, primary (NFADV-01): minimum-distance test of the composite null that
. *** all horizon effects lie on SOME line, E[b] = X gamma with X = [1, relyr] and
. *** gamma unknown. gamma is estimated by GLS under a generalized inverse of V; the
. *** minimized distance W = min_g (b - Xg)' V^+ (b - Xg) is computed in the whitened
. *** eigenspace of V (z = L^-1/2 U' b, M = L^-1/2 U' X, W = ||z - M ghat||^2), which
. *** is exactly chi-squared with q = rank(V) - rank(M) degrees of freedom under the
. *** null. The planted zero-variance reference rows receive zero weight under V^+ and
. *** so are mathematically inert here (they are constants equal to their expectation);
. *** omitting them from the computation is identical to including them.
. ***
. *** alt == 1, altmethod (NFADV-02): the forecast test. P = the altmethod fit set
. *** (real relyr <= -1 plus the planted reference row(s)), Q = the real post horizons.
. *** A = Z_Q (Z_P' Z_P)^-1 Z_P' is the unweighted-OLS forecast operator (the same fit
. *** as the display line's pre-period cut), d = b_Q - A b_P, and the test covariance
. *** propagates the fitted line's uncertainty and the pre/post covariance:
. *** S = V_QQ + A V_PP A' - A V_PQ - V_QP A'; W = d' S^+ d, q = rank(S). The S^+,
. *** rank, and the residual-in-column-space check share one eigensystem and one
. *** scale-aware tolerance (a residual component outside col(S) is a degeneracy, not
. *** a testable direction).
. ***
. *** Both statistics use Ftail(q, dfr, W/q) when dfr is a valid residual df and
. *** chi2tail(q, W) otherwise (the wooldid_ptp convention).
. cap mata: mata drop wooldid_advx()

. mata:
------------------------------------------------- mata (type end to exit) ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
: void wooldid_advx(string scalar bn, string scalar vn, string scalar rn,
>                   real scalar esrel, real scalar tt, real scalar alt,
>                   real scalar dfr, string scalar pn)
> {
>     real colvector b, rel, z, g, r, sel, idxP, idxQ, bP, relP, d, c, resid
>     real matrix V, X, U, T, M, ZP, ZQ, ZZi, Aop, VPP, VPQ, VQQ, S, US
>     real rowvector lam, sv, lamS
>     real scalar k1, np, npr, nq, scale, tol, rankM, q, W, p
>     st_local("advpstat", "degen")
>     b = st_matrix(bn)'
>     V = st_matrix(vn)
>     rel = st_matrix(rn)
>     if (hasmissing(V) | hasmissing(b) | hasmissing(rel)) return
>     if (alt == 0) {
>         X = J(rows(rel), 1, 1), rel
>         V = (V + V')/2
>         U = .
>         lam = .
>         symeigensystem(V, U, lam)
>         scale = max(abs(lam))
>         if (scale <= 0 | scale >= .) return
>         tol = scale*1e-12
>         sel = selectindex(lam' :> tol)
>         k1 = rows(sel)
>         if (k1 == 0) return
>         T = diag(1:/sqrt(lam[sel]')) * U[., sel]'
>         z = T*b
>         M = T*X
>         sv = svdsv(M)
>         rankM = sum(sv :> max(sv)*1e-12)
>         q = k1 - rankM
>         if (q <= 0) return
>         g = svsolve(M, z)
>         r = z - M*g
>         W = r'r
>     }
>     else {
>         idxP = selectindex(rel :<= -1)
>         idxQ = selectindex(rel :>= 0)
>         npr = rows(idxP)
>         nq = rows(idxQ)
>         if (npr == 0 | nq == 0) return
>         bP = b[idxP] \ 0
>         relP = rel[idxP] \ esrel
>         if (tt) {
>             bP = bP \ 0
>             relP = relP \ (esrel - 1)
>         }
>         np = rows(relP)
>         ZP = J(np, 1, 1), relP
>         ZQ = J(nq, 1, 1), rel[idxQ]
>         ZZi = invsym(ZP'ZP)
>         if (ZZi[1,1] == 0 | ZZi[2,2] == 0) return
>         Aop = ZQ*ZZi*ZP'
>         VPP = J(np, np, 0)
>         VPP[|1,1 \ npr,npr|] = V[idxP, idxP]
>         VPQ = J(np, nq, 0)
>         VPQ[|1,1 \ npr,nq|] = V[idxP, idxQ]
>         VQQ = V[idxQ, idxQ]
>         d = b[idxQ] - Aop*bP
>         S = VQQ + Aop*VPP*Aop' - Aop*VPQ - VPQ'*Aop'
>         S = (S + S')/2
>         US = .
>         lamS = .
>         symeigensystem(S, US, lamS)
>         scale = max(abs(lamS))
>         if (scale <= 0 | scale >= .) return
>         tol = scale*1e-12
>         sel = selectindex(lamS' :> tol)
>         q = rows(sel)
>         if (q == 0) return
>         c = US[., sel]'d
>         resid = d - US[., sel]*c
>         if (norm(resid) > 1e-8*max((norm(d), sqrt(scale)))) return
>         W = sum(c:^2 :/ lamS[sel]')
>     }
>     if (W >= .) return
>     if (dfr < .) p = Ftail(q, dfr, W/q)
>     else p = chi2tail(q, W)
>     if (p >= .) return
>     st_numscalar(pn, p)
>     st_local("advpstat", "ok")
> }

: end
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
end of do-file

. do /Users/hegland/Documents/Research/wooldid_dev/test/suite/mc/amese_cases.doh

. * amese_cases.doh — shared case definitions for the AME-SE diagnosis grid (SI-1..SI-5
. * deep dive). Include-file used by amese_structure.do and mc_amese.do.
. * Defines two programs:
. *   amese_mkdata <dcode>   — builds the panel for data code d1|d2|d3|d1c
. *       (30 cohorts i=1..30, even i treated at t=6, 6 units/cohort, t=1..12,
. *        unitid distinct from i, y = cohort FE + .05*t + noise, NO dose effect):
. *       d1  = dose varies ACROSS units within cohort-period cells, constant within
. *             unit over time (the demo_vesame_pathology shape)
. *       d2  = dose varies WITHIN units over time (persistent unit level + i.t noise)
. *       d3  = dose constant within cohorts (varies only across cohorts)
. *       d1c = d1 data but errors carry a common cohort-by-period shock (cluster-
. *             dependent errors: the case where cohort-level clustering is the
. *             conceptually correct VCE)
. *   amese_opts <cc> <vce>  — leaves the wooldid option string in r(opts):
. *       cc: basic | bycoh | bytime | within     vce: ci | cu | rb
. *       d4  = TRUE contreatwithin-style panel: ALL 30 cohorts treated (staggered
. *             onsets 5/7/9 by mod(i,3)), dose varies within units over time
. *       d5  = d4's assignment but dose CONSTANT within units (the user's
. *             "dose constant within units" variant of the within-style example)
. cap program drop amese_mkdata

. program define amese_mkdata
  1.   args dcode
  2.   clear
  3.   qui set obs 30
  4.   gen i = _n
  5.   if "`dcode'" == "d4" | "`dcode'" == "d5" gen ttre = 5 + 2*mod(_n, 3)
  6.   else gen ttre = cond(mod(_n, 2) == 0, 6, .)
  7.   gen a = rnormal()
  8.   qui expand 6
  9.   bysort i: gen unit = _n
 10.   gen unitid = (i - 1)*6 + unit
 11.   if "`dcode'" == "d1" | "`dcode'" == "d1c" | "`dcode'" == "d5" gen dose = exp(0.8*runiform() + 0.2*mod(i, 5))
 12.   if "`dcode'" == "d2" | "`dcode'" == "d4" gen uu = runiform()
 13.   if "`dcode'" == "d3" gen dose = 0.5 + 0.3*mod(i, 7)
 14.   qui expand 12
 15.   bysort i unit: gen t = _n
 16.   if "`dcode'" == "d2" | "`dcode'" == "d4" {
 17.     gen dose = exp(0.4*uu + 0.5*runiform())
 18.     drop uu
 19.   }
 20.   if "`dcode'" == "d1c" {
 21.     * common cohort-by-period shock: robust is conceptually wrong here, cluster(i) right
.     tempvar cshock
 22.     bysort i t: gen `cshock' = rnormal() if _n == 1
 23.     bysort i t: replace `cshock' = `cshock'[1]
 24.     gen y = a + .05*t + .8*`cshock' + .6*rnormal()
 25.   }
 26.   else gen y = a + .05*t + rnormal()
 27.   drop a
 28.   sort i unitid t
 29.   ereturn clear
 30. end

. 
. cap program drop amese_opts

. program define amese_opts, rclass
  1.   args cc vce
  2.   local o "att contreat(dose) esprelength(4) espostlength(4) esfixedbaseperiod"
  3.   if "`cc'" == "basic" local o "`o' contreatcontrols(basic)"
  4.   if "`cc'" == "bycoh" local o "`o' contreatcontrols(byCohort)"
  5.   if "`cc'" == "bytime" local o "`o' contreatcontrols(byTime)"
  6.   if "`cc'" == "within" local o "`o' contreatcontrols(basic) contreatwithin safety(off)"
  7.   if "`vce'" == "ci" local o "`o' cluster(i)"
  8.   if "`vce'" == "cu" local o "`o' cluster(unitid)"
  9.   if "`vce'" == "rb" local o "`o' robust"
 10.   return local opts "`o'"
 11. end

. 
end of do-file

