1876.           if "`att'" == "att" {
1877.             matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \ `___att_horiz_s`sgcase''
1878.             matrix drop `___att_horiz_s`sgcase''
1879.           }
1880.           if "`att_i'" == "att_i"  |  "`att_it'" == "att_it" |  "`att_itime'" == "att_itime" {
1881.             matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \ `___att_it_horiz_s`sgcase''
1882.             matrix drop `___att_it_horiz_s`sgcase''
1883.           }
1884.           if "`contreat'" != "" {
1885.             if "`att'" == "att" {
1886.               matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \  `___att_Choriz_s`sgcase''
1887.               matrix drop `___att_Choriz_s`sgcase''
1888.             }
1889.             if "`att_i'" == "att_i"  |  "`att_it'" == "att_it" |  "`att_itime'" == "att_itime" {
1890.               matrix `wdid_sg`sgcase'' = `wdid_sg`sgcase'' \  `___att_it_Choriz_s`sgcase''
1891.               matrix drop `___att_it_Choriz_s`sgcase''
1892.             }
1893.           }
1894.         }
1895. 
.         * ensure sg rownames are stripped of irrelevant es levels
.         local rownamessg
1896.         local sgnonesidx 0
1897.         foreach rownametest in `rownamespool' {
1898.           if strpos("`rownametest'","ES_")==0 {
1899.             * the pooled non-ES rownames were generated by the same (round x object) loop that
.             * fills `wdid_sg`sgcase'' above, in the same order, so the k-th pooled non-ES name is
