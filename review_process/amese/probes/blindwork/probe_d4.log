1067.         qui gstats sum `ibmucoefs'1, meanonly
1068.         local b = r(mean)
1069.         qui ttest `ibmucoefs'1 == 0
1070.         local se = r(se)
1071.         local imt = r(t)
1072.         local imp = r(p)
