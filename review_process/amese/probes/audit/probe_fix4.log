. *===== POSTEXP: which V property triggers Stata's ereturn-post zeroing? =====
. cap program drop postexp

. program define postexp, eclass
  1.   args case
  2.   tempname b V
  3.   matrix `b' = (1, 2, 3)
  4.   if "`case'" == "S1" matrix `V' = (1, 0, 0 \ 0, 1e-30, 0 \ 0, 0, 0)
  5.   if "`case'" == "S2" matrix `V' = (1, 0, 0 \ 0, -1e-22, 0 \ 0, 0, 1)
  6.   if "`case'" == "S3" matrix `V' = (1, .5, 0 \ .5 + 1e-12, 1, 0 \ 0, 0, 1)
  7.   if "`case'" == "S4" matrix `V' = (1, .5, 0 \ .5 + 1e-6, 1, 0 \ 0, 0, 1)
  8.   if "`case'" == "S5" matrix `V' = (1, 0, 0 \ 0, 1e-260, 0 \ 0, 0, 1)
  9.   matrix colnames `b' = x1 x2 x3
 10.   matrix colnames `V' = x1 x2 x3
 11.   matrix rownames `V' = x1 x2 x3
 12.   ereturn post `b' `V'
 13. end

. foreach c in S1 S2 S3 S4 S5 {
  2.   cap noi postexp `c'
  3.   dis "POSTEXP|`c'|rc=" _rc
  4.   cap noi mata: d = diagonal(st_matrix("e(V)")); printf("POSTEXP|`c'|eV diag: %12.0g %12.0g %12.0g|allzero=%g\n", d[1], d[2], d[3], all(st_matrix("e(V)") :== 0))
  5. }
