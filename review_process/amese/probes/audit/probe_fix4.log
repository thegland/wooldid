 10.   local m2 .
 11.   if _rc == 0 mata: st_local("m2", strofreal(colmissing(st_matrix("r(table)")[2,.]')))
 12.   dis "E_SEEDX|s=`s'|evzero=`z' of `kk'|ameSEmiss=`m2'"
 13. }
