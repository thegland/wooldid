. * d1 parallel sweep (same seeds, iid errors): does d1 basic+ci ever black out?
. forval s = 0/15 {
  2.   clear
  3.   set seed `=60000001+`s''
  4.   amese_mkdata d1
  5.   mkvars
  6.   qui reghdfe y i._i#i._t#i.targetflag##c.dose, absorb(i.i i.t i.null##c.(ringer)) cluster(i) tol(1e-9)
  7.   local dfr = e(df_r)
  8.   cap qui margins [iw=1], dydx(targetflag) subpop(if targetflag==1 & _t >= $HS & _t <= $HE) noestimcheck over(_t) df(`dfr')
  9.   local m1 .
 10.   if _rc == 0 mata: st_local("m1", strofreal(colmissing(st_matrix("r(table)")[2,.]')))
 11.   cap qui margins [iw=1], dydx(dose) subpop(if targetflag==1 & _t >= $HS & _t <= $HE) noestimcheck over(_t) df(`dfr')
 12.   local m2 .
 13.   local minv2 .
 14.   if _rc == 0 {
 15.     mata: st_local("m2", strofreal(colmissing(st_matrix("r(table)")[2,.]'))); st_local("minv2", strofreal(min(diagonal(st_matrix("r(V)"))), "%21.0g"))
 16.   }
 17.   dis "C_D1SWEEP|s=`s'|attSEmiss=`m1'|ameSEmiss=`m2'|ameminV=`minv2'"
 18. }
