* ======== SIA4: config trig_d3void ========
fresh
clear
qui set obs 12
qui gen i = _n
qui gen ttre = cond(_n <= 4, 5, cond(_n <= 8, 7, .))
qui expand 4
qui bysort i: gen unit = _n
qui gen dose = 0.5 + 0.1*i
qui expand 10
qui bysort i unit: gen t = _n
qui gen y = 0.05*i + 0.04*t + 0.3*dose*(ttre < . & t >= ttre) + 0.3*sin(2.2*i + 1.1*t + 0.7*unit)
sort i unit t
ereturn clear
cap noi wooldid y i t ttre, att robust contreat(dose) contreatcontrols(basic) esprelength(2) espostlength(2)
local rc = _rc
dis "SIA4_rc=`rc'"
dis "SIA4_cmdline=[`e(cmdline)']"
dis "SIA4_properties=[`e(properties)']"
dumpres trig_d3void `rc' "`W'/old_dumps"
pcell SIA4_main_att_est wdidmainresults 1 1
pcell SIA4_main_att_se wdidmainresults 1 2
pcell SIA4_main_ame_est wdidmainresults 3 1
pcell SIA4_main_ame_se wdidmainresults 3 2
