  "replace cohort = . in 2",
  "replace t = . in 3",
  "replace x1 = . in 4",
  "replace person_id = . in 5",
  "replace analytic_weight = . in 6",
  "replace analytic_weight = 0 in 7",
  "replace dose = . in 8",
  "replace custom_lattice = . in 9"
 ],
 "ext_val10_fractional_ttre": [
