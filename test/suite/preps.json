 ],
 "esfsup_refdrop": [
  "qui set obs 14",
  "qui gen i = _n",
  "qui gen ttre = cond(_n <= 4, 4, cond(_n <= 8, 5, .))",
  "qui expand 6",
  "qui bysort i: gen t = _n",
  "qui gen y = 1.5*(t >= ttre & ttre < .) + 0.07*i + 0.3*sin(2.7*i + 1.3*t)",
  "qui drop if ttre >= . & t == 3",
  "ereturn clear"
 ],
 "icbad8": [
  "qui replace icbad = icbad*100"
 ],
 "tm2_sgjoint": [
  "qui set obs 15",
  "qui gen i = _n",
  "qui gen ttre = cond(_n <= 4, 8, cond(_n <= 8, 10, cond(_n <= 12, 12, .)))",
  "qui expand 6",
  "qui bysort i: gen unit = _n",
  "qui gen sg = mod(i, 3) + 1",
  "qui gen dose = exp(0.11*mod(i*7 + unit*3, 10) + 0.05*mod(unit, 4))",
  "qui expand 12",
  "qui bysort i unit: gen t = _n",
  "qui gen rel = t - ttre",
  "qui gen y = 0.05*i + 0.04*t + 0.35*dose*(rel >= 0 & rel < .) + 0.06*(sg == 2)*dose*cond(rel < 0 & rel < ., rel + 8, 0) + 0.10*(sg == 3)*dose*cond(rel < 0 & rel < ., rel + 8, 0) + 0.3*sin(2.7*i + 1.3*t + 0.9*unit)",
  "sort i unit t",
  "ereturn clear"
 ],
 "d3void": [
  "qui set obs 12",
  "qui gen i = _n",
  "qui gen ttre = cond(_n <= 4, 5, cond(_n <= 8, 7, .))",
  "qui expand 4",
  "qui bysort i: gen unit = _n",
  "qui gen dose = 0.5 + 0.1*i",
  "qui expand 10",
  "qui bysort i unit: gen t = _n",
  "qui gen y = 0.05*i + 0.04*t + 0.3*dose*(ttre < . & t >= ttre) + 0.3*sin(2.2*i + 1.1*t + 0.7*unit)",
  "sort i unit t",
  "ereturn clear"
 ],
 "covars_coh": [
  "qui gen coh = cond(ttre==5,1,cond(ttre==9,2,3))"
 ],
 "perm_probs10": [
  "qui keep if inlist(i, 1, 2, 3, 26, 27, 28, 51, 52, 53, 54)",
