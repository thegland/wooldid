 ],
 "ext_cov10_skewed_cost": [
  "generate double y_cost = exp(2 + .03 * cohort + .025 * t + .30 * treated + .02 * cond(treated, relative_time, 0) + 1.40 * (unit_in_cohort == 12))"
 ],
 "ext_cov10_technical_options": [
