# Regenerable test outputs — never commit run artifacts.
# Battery/suite run directories (each holds %21x dumps from one run):
run_*/
# Comprehensive-suite run outputs (dumps, logs, reports):
suite/out/
# MC calibration run outputs (per-rep CSVs, shard logs, judged report):
suite/mc/out/
# Stata batch transcripts and scratch logs:
*.log
# Log-scrape sentinel artifacts written by the targeted test_*.do suites:
advg_*.txt
advstat_*.txt
cfxlat_*.txt
cfxtok_*.txt
esfsup_*.txt
fn_*.txt
gt_*.txt
perm_*.txt
perm2_*.txt
ptpd_*.txt
ptpr_*.txt
sgdom_*.txt
sgsp_*.txt
vald_*.txt
w3f_*.txt
# Plot outputs from test_fastnose.do:
fnplot_ES*
# Stata SMCL transcripts and graph files written by the targeted test_*.do suites
# (nothing tracked in this repo is .smcl or .gph, so these are always run artifacts):
*.smcl
*.gph
# Scratch datasets/transcripts test_permute3.do and the L6 probe write into test/:
perm3_*
l6probe_*
# Shard scheduling and log scratch under the TRACKED suite/mc/out2 result tree
# (the .csv/.md results there are tracked on purpose; these are not):
suite/mc/out2/*/logs/
suite/mc/out2/*/*.sched
suite/mc/out2/*/START.txt
.DS_Store
